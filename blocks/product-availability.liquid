{% stylesheet %}
.product-availability {
  font-size: 10px;
  display: flex;
  gap: 9px;
  align-items: center;
  margin: 30px 0 7px;
}

.product-availability__indicator {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: #2DCA7C;
  display: inline-block;
  flex-shrink: 0;
}

.product-availability__delivery {
  display: flex;
  align-items: center;
  font-size: 10px;
  margin: 0;
  gap: 2px;
}

.product-availability__delivery-label {
  margin-left: 3px;
}

.product-availability__delivery-date {
  font-weight: 700;
}
{% endstylesheet %}

{% javascript %}
(function () {
  var dateEl = document.querySelector('.product-availability__delivery-date');
  if (!dateEl) return;
  var d = new Date();
  d.setDate(d.getDate() + 7);
  var dd = String(d.getDate()).padStart(2, '0');
  var mm = String(d.getMonth() + 1).padStart(2, '0');
  var yyyy = d.getFullYear();
  dateEl.textContent = dd + '/' + mm + '/' + yyyy;
})();
{% endjavascript %}

