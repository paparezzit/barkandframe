{% doc %}
  @prompt
    3 column layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-column-layout-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-three-column-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-three-column-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
  }

  .ai-three-column-item-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-three-column-image-wrapper-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.content_spacing }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-three-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-three-column-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4/3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-three-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-three-column-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.content_spacing }}px;
    line-height: 1.2;
  }

  .ai-three-column-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    margin: 0 0 {{ block.settings.content_spacing }}px;
  }

  .ai-three-column-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: 1px solid {{ block.settings.button_background_color }};
  }

  .ai-three-column-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_background_color }};
  }

  @media screen and (max-width: 990px) {
    .ai-three-column-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-three-column-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap | times: 0.75 }}px;
    }

    .ai-three-column-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-three-column-layout-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.75 }}px 0 {{ block.settings.section_padding_bottom | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div class="ai-three-column-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-column-container-{{ ai_gen_id }}">
    <div class="ai-three-column-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'column_' | append: i | append: '_image'
          assign heading_key = 'column_' | append: i | append: '_heading'
          assign text_key = 'column_' | append: i | append: '_text'
          assign button_text_key = 'column_' | append: i | append: '_button_text'
          assign button_link_key = 'column_' | append: i | append: '_button_link'

          assign column_image = block.settings[image_key]
          assign column_heading = block.settings[heading_key]
          assign column_text = block.settings[text_key]
          assign column_button_text = block.settings[button_text_key]
          assign column_button_link = block.settings[button_link_key]
        %}

        <div class="ai-three-column-item-{{ ai_gen_id }}">
          {% if column_image != blank %}
            <div class="ai-three-column-image-wrapper-{{ ai_gen_id }}">
              <img
                src="{{ column_image | image_url: width: 600 }}"
                alt="{{ column_image.alt | escape }}"
                class="ai-three-column-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ column_image.width }}"
                height="{{ column_image.height }}"
              >
            </div>
          {% else %}
            <div class="ai-three-column-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-three-column-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            </div>
          {% endif %}

          {% if column_heading != blank %}
            <h3 class="ai-three-column-heading-{{ ai_gen_id }}">{{ column_heading }}</h3>
          {% endif %}

          {% if column_text != blank %}
            <div class="ai-three-column-text-{{ ai_gen_id }}">{{ column_text }}</div>
          {% endif %}

          {% if column_button_text != blank and column_button_link != blank %}
            <a href="{{ column_button_link }}" class="ai-three-column-button-{{ ai_gen_id }}">
              {{ column_button_text }}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

