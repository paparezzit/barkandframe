

{% liquid
  assign block_settings = block.settings
  assign ratio = 1

  case block_settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'adapt'
      assign ratio = block_settings.image.aspect_ratio
  endcase

  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
%}

{% capture class %}
  image-block image-block--{{ block.id }} image-block--height-{{ block_settings.height }} spacing-style size-style
{% endcapture %}

{% capture style %}
  --ratio: {{ ratio }};
  {% render 'size-style', settings: block_settings %}
  {% render 'spacing-style', settings: block_settings %}
{% endcapture %}

{% capture image_border_style %}
  --ratio: {{ ratio }};
  {% render 'border-override', settings: block_settings %}
{% endcapture %}

{% liquid
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign mobile_widths = ''
  assign image_render_width = 3840
  assign image_loading = ''
  assign image_decoding = ''
  assign image_fetchpriority = ''
  assign image_asset = block_settings.image_asset | default: '' | strip
  assign mobile_image_asset = block_settings.mobile_image_asset | default: '' | strip
  assign image_alt = block_settings.alt | default: block_settings.image.alt | default: ''
  assign parent_main_text = section.settings['main-text'] | default: ''
  assign section_title = section.settings.title | default: ''
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '240, 352, 480, 640, 832, 1200, 1600, 1920, 2560, 3840'

  if request.page_type == 'index' and section_title == 'See it at home'
    assign media_width_desktop = '180px'
    assign media_width_mobile = '150px'
    assign image_render_width = 240
    assign widths = '160, 200, 240'
    assign mobile_widths = '160, 200'
    assign image_loading = 'lazy'
    assign image_decoding = 'async'
    assign image_fetchpriority = 'low'
    assign sizes = '(min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile

    if block_settings.link contains 'style=studio_pencil'
      assign image_asset = 'overview-see-it-at-home-studio-pencil-desktop.jpg'
      assign mobile_image_asset = 'overview-see-it-at-home-studio-pencil-mobile.jpg'
      assign image_alt = 'Studio Pencil'
    elsif block_settings.link contains 'style=dream'
      assign image_asset = 'overview-see-it-at-home-dream-desktop.jpg'
      assign mobile_image_asset = 'overview-see-it-at-home-dream-mobile.jpg'
      assign image_alt = 'Dream'
    elsif block_settings.link contains 'style=indigo'
      assign image_asset = 'overview-see-it-at-home-indigo-desktop.jpg'
      assign mobile_image_asset = 'overview-see-it-at-home-indigo-mobile.jpg'
      assign image_alt = 'Indigo'
    elsif block_settings.link contains 'style=studio_pop'
      assign image_asset = 'overview-see-it-at-home-studio-pop-desktop.jpg'
      assign mobile_image_asset = 'overview-see-it-at-home-studio-pop-mobile.jpg'
      assign image_alt = 'Studio Pop'
    elsif block_settings.link contains 'style=the_gentleman'
      assign image_asset = 'overview-see-it-at-home-the-gentleman-desktop.jpg'
      assign mobile_image_asset = 'overview-see-it-at-home-the-gentleman-mobile.jpg'
      assign image_alt = 'The Gentleman'
    elsif block_settings.link contains 'style=la_parisienne'
      assign image_asset = 'overview-see-it-at-home-la-parisienne-desktop.jpg'
      assign mobile_image_asset = 'overview-see-it-at-home-la-parisienne-mobile.jpg'
      assign image_alt = 'La Parisienne'
    elsif block_settings.link contains 'style=the_duchess'
      assign image_asset = 'overview-see-it-at-home-the-duchess-desktop.jpg'
      assign mobile_image_asset = 'overview-see-it-at-home-the-duchess-mobile.jpg'
      assign image_alt = 'The Duchess'
    elsif block_settings.link contains 'style=pure_portrait'
      assign image_asset = 'overview-see-it-at-home-pure-portrait-desktop.jpg'
      assign mobile_image_asset = 'overview-see-it-at-home-pure-portrait-mobile.jpg'
      assign image_alt = 'Pure Portrait'
    elsif block_settings.link contains 'style=studio_watercolour'
      assign image_asset = 'overview-see-it-at-home-studio-watercolour-desktop.jpg'
      assign mobile_image_asset = 'overview-see-it-at-home-studio-watercolour-mobile.jpg'
      assign image_alt = 'Studio Watercolour'
    endif
  elsif parent_main_text contains 'beyond portraits'
    assign media_width_desktop = '400px'
    assign media_width_mobile = '60vw'
    assign image_render_width = 900
    assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
    assign widths = '160, 240, 320, 400, 480, 600, 720, 900'
  endif
%}

{% capture image %}
  {%- if image_asset != blank -%}
    <picture class="image-block__picture">
      {%- if mobile_image_asset != blank -%}
        <source media="(max-width: 749px)" srcset="{{ mobile_image_asset | asset_url }}">
      {%- endif -%}
      <img
        src="{{ image_asset | asset_url }}"
        alt="{{ image_alt | escape }}"
        width="1534"
        height="2048"
        class="image-block__image border-style"
        style="{{ image_border_style }}"
        sizes="{{ sizes }}"
        {% if image_loading != blank %}loading="{{ image_loading }}"{% endif %}
        {% if image_decoding != blank %}decoding="{{ image_decoding }}"{% endif %}
        {% if image_fetchpriority != blank %}fetchpriority="{{ image_fetchpriority }}"{% endif %}
        draggable="false"
      >
    </picture>
  {%- elsif block_settings.image -%}
    <picture class="image-block__picture">
      {% render 'mobile-image-source', image: block_settings.image, sizes: media_width_mobile, widths: mobile_widths %}
      {% if image_loading != blank %}
        {{
          block_settings.image
          | image_url: width: image_render_width
          | image_tag:
            width: block_settings.image.width,
            widths: widths,
            height: block_settings.image.height,
            class: 'image-block__image border-style',
            style: image_border_style,
            sizes: sizes,
            loading: image_loading,
            decoding: image_decoding,
            fetchpriority: image_fetchpriority
        }}
      {% else %}
        {{
          block_settings.image
          | image_url: width: image_render_width
          | image_tag:
            width: block_settings.image.width,
            widths: widths,
            height: block_settings.image.height,
            class: 'image-block__image border-style',
            style: image_border_style,
            sizes: sizes
        }}
      {% endif %}
    </picture>
  {%- else -%}
    <div class="placeholder-image border-style size-style" style="{{ image_border_style }}">
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'hero__image' }}
    </div>
  {%- endif -%}
{% endcapture %}

{% if block_settings.link == blank %}
  <div
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </div>
{% else %}
  <a
    href="{{ block_settings.link }}"
    class="{{ class }}"
    style="{{ style }}"
    {% if block_settings.link contains 'instagram.com' %}
      target="_blank"
      rel="noopener noreferrer"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </a>
{% endif %}

{% stylesheet %}
  .placeholder-image {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
  }

  placeholder-image img {
    width: 100%;
    height: 100%;
    aspect-ratio: var(--ratio);
  }

  .image-block {
    display: flex;

    /* When the image is nested in a group, section, etc, respect the parent’s horizontal alignment */
    justify-content: var(--horizontal-alignment, 'inline-start');
  }

  .image-block--height-fill .image-block__image {
    height: 100%;
  }

  .image-block__picture {
    display: block;
    width: 100%;
  }

  .image-block--height-fill .image-block__picture {
    height: 100%;
  }

  .image-block__image {
    object-fit: cover;
    aspect-ratio: var(--ratio);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.image",
  "tag": null,
  "settings": [
	{
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "adapt",
      "label": "t:settings.aspect_ratio"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.image_ratio == 'adapt' }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.image",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
