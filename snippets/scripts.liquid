{% else %}
  <script>
    (() => {
      const scripts = [
        {{ 'popover-polyfill.js' | asset_url | json }},
        {{ 'quick-add.js' | asset_url | json }},
        {% if settings.show_add_discount_code %}{{ 'cart-discount.js' | asset_url | json }},{% endif %}
        {{ 'dialog.js' | asset_url | json }},
        {{ 'variant-picker.js' | asset_url | json }},
        {{ 'product-card.js' | asset_url | json }},
        {{ 'baf-order-sync.js' | asset_url | json }},
        {{ 'baf-entry-sync.js' | asset_url | json }},
        {{ 'product-form.js' | asset_url | json }},
        {{ 'disclosure-custom.js' | asset_url | json }},
        {{ 'media.js' | asset_url | json }},
        {{ 'product-price.js' | asset_url | json }},
        {{ 'product-title-truncation.js' | asset_url | json }},
        {{ 'product-inventory.js' | asset_url | json }},
        {{ 'show-more.js' | asset_url | json }},
        {{ 'slideshow.js' | asset_url | json }},
        {{ 'anchored-popover.js' | asset_url | json }},
        {{ 'floating-panel.js' | asset_url | json }},
        {{ 'video-background.js' | asset_url | json }},
        {{ 'component-quantity-selector.js' | asset_url | json }},
        {{ 'media-gallery.js' | asset_url | json }},
        {{ 'rte-formatter.js' | asset_url | json }},
        {{ 'gift-card-recipient-form.js' | asset_url | json }}
        {% if settings.transition_to_main_product %},{{ 'product-card-link.js' | asset_url | json }}{% endif %}
        {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %},{{ 'localization.js' | asset_url | json }}{% endif %}
      ];
      let started = false;

      const loadScript = (src) => new Promise((resolve) => {
        const script = document.createElement('script');
        script.src = src;
        script.type = 'module';
        script.fetchPriority = 'low';
        script.onload = resolve;
        script.onerror = resolve;
        document.head.appendChild(script);
      });

      const loadDeferredThemeModules = () => {
        if (started) return;
        started = true;
        scripts.reduce((chain, src) => chain.then(() => loadScript(src)), Promise.resolve());
      };

      const scheduleDeferredThemeModules = () => {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadDeferredThemeModules, { timeout: 4000 });
          return;
        }
        window.setTimeout(loadDeferredThemeModules, 2500);
      };

      window.addEventListener('load', () => {
        window.setTimeout(scheduleDeferredThemeModules, 1200);
      }, { once: true });

      ['pointerdown', 'keydown', 'touchstart', 'wheel'].forEach((eventName) => {
        window.addEventListener(eventName, loadDeferredThemeModules, { once: true, passive: true });
      });
    })();
  </script>
{% endunless %}

