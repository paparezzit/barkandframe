{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block, featured product block, and the product card block.
  The product object is null or when placeholders are rendered.

  @param {object} product - The product object
  @param {object} children - The children of the product card
  @param {object} [block] - The block object
  @param {number} [product_card_gap] - The gap between the product card children (overrides block settings)
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% liquid
  assign has_quick_add = false
  if settings.quick_add and product.available
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if has_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif

  assign product_card_id = 'product-card-link-' | append: block.id | append: '-' | append: product.id
  assign product_card_gap_value = product_card_gap | default: block_settings.product_card_gap

  # Logic to determine which variant URL to use (matching swatch selection logic)
  assign variant_to_link = product.selected_or_first_available_variant
  assign combined_listing_count = product.options_with_values | map: 'values' | map: 'product_url' | compact | size
  assign no_swatch_selected = null

  unless combined_listing_count > 0
    # Simple direct check: which variant owns the featured image?
    if product.featured_media
      assign found_variant = false

      for variant in product.variants
        if variant.featured_media.id == product.featured_media.id
          assign variant_to_link = variant
          assign found_variant = true
          break
        endif
      endfor

      # Check if we need to set no_swatch_selected
      unless found_variant
        # Featured image is not a variant image
        # Check if product has swatches
        for option in product.options_with_values
          assign swatch_count = option.values | map: 'swatch' | compact | size
          if swatch_count > 1
            # Multiple swatches exist but featured image doesn’t match any
            assign no_swatch_selected = true
            break
          endif
        endfor
      endunless
    endif
  endunless

  if settings.transition_to_main_product
    assign featured_image = variant_to_link.featured_image
    if featured_image == blank
      assign featured_image = product.featured_media.preview_image
    endif

    if featured_image != blank
      assign featured_media_url = featured_image | image_url: width: 500
    endif
  endif

  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif

  capture product_card_url
    render 'product-card-variant-url', product: product
  endcapture
  assign product_card_url = product_card_url | strip
%}

<product-card--custom
  class="product-card--custom"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-parallax
  data-product-variants-size="{{ product.variants.size }}"
  id="product-card-{{ block.id }}"
  data-product-transition="{{ settings.transition_to_main_product }}"
  {{ block.shopify_attributes }}
  {% if no_swatch_selected %}
    data-no-swatch-selected="true"
  {% endif %}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
  style="
    top: {{ block_settings.position_y }}%;
    left: {{ block_settings.position_x }}%;
  "
>
  <div class="product-card__content">
    {{ children }}

    <a
      id="{{ product_card_id | md5 }}"
      {% unless onboarding %}
        href="{{ product_card_url }}"
      {% endunless %}
      class="product-card__link"
      ref="productCardLink"
    >
      Show
    </a>
  </div>
</product-card--custom>

{% stylesheet %}
  product-card--custom{
    border-radius: 10px;
    background-color: var(--beige);
    display: block;
    overflow: hidden;
    position: absolute;
    transform: translate(-50%, -50%);
    transition: width .3s, height .3s, opacity .3s;
    box-shadow: 0px 0px 9px 0px #4C443F17;

    &:not(:hover){
      height: 24px;
      width: auto;

      .product-card__content{
        padding: 4px 12px;

        product-price, .product-card__link{
          opacity: 0;
          pointer-events: auto;
        }

        .product-title div > :is(p, span, h1, h2, h3, h4, h5, h6){
          width: fit-content;
          white-space: nowrap;
          text-align: center;
        }
      }

      .card-gallery{
        opacity: 0;
        pointer-events: none;
      }
    }

    &:hover{
      width: 220px !important;
      height: 140px;
    }

    .quick-add{
      display: none;
    }

    .product-card__content{
      position: relative;
      padding: 10px;
      height: 100%;
      width: 100%;

      .card-gallery{
        width: 100px;
        position: absolute;
        top: 10px;
        right: 10px;
        height: calc(100% - 20px);
        border-radius: 10px;
        transition: opacity .3s;

        slideshow-arrows{
          display: none;
        }

        slideshow-component{
          height: 100%;

          slideshow-container{
            height: 100%;

            slideshow-slides{
              height: 100%;
            }
          }
        }
      }

      .product-title{
        div{
          padding: 0;
          margin-bottom: 5px;

          p{
            font-size: 14px;
            line-height: 100%;
            font-weight: 700;
            width: 90px;
            font-family: var(--font-paragraph--family) !important;
          }
        }
      }

      product-price{
        width: 90px;

        .price{
          font-size: 12px !important;
          letter-spacing: normal !important;
          color: var(--brown) !important;
          text-transform: uppercase !important;
        }
      }

      .product-card__link{
        position: absolute;
        bottom: 10px;
        left: 10px;
        top: auto;
        right: auto;
        display: block;
        color: var(--brown);
        font-size: 12px;
        font-weight: 700;
      }
    }

  }
  
{% endstylesheet %}

{% javascript %}
  const cards = document.querySelectorAll(".portrait-formats .product-card--custom");
  const formatsWrapper = document.querySelector(".portrait-formats");

  cards.forEach(card => {
    card.addEventListener("mouseover", () => {
      formatsWrapper.classList.add("hovered");
    });

    card.addEventListener("mouseout", () => {
      formatsWrapper.classList.remove("hovered");
    });

    card.style.width = card.querySelector(".product-title div > :is(p, span, h1, h2, h3, h4, h5, h6)").offsetWidth + 24 + "px";

    const handle = card.dataset.productHandle;
    if (handle) {
      const portraitProductDefaults = {
        "framed-canvas-1": {
          category: "canvas",
          size: "33 × 43 cm | 13.0 × 16.9 in",
          framing: "framed",
          color: "black",
        },
        "canvas-framed": {
          category: "canvas",
          size: "33 × 43 cm | 13.0 × 16.9 in",
          framing: "framed",
          color: "black",
        },
        "unframed-canvas": {
          category: "canvas",
          size: "30 × 40 cm | 11.8 × 15.7 in",
          framing: "unframed",
        },
        "canvas-unframed": {
          category: "canvas",
          size: "30 × 40 cm | 11.8 × 15.7 in",
          framing: "unframed",
        },
        "framed-poster": {
          category: "paper",
          size: "33 × 43 cm | 13.0 × 16.9 in",
          border: "no-border",
          color: "black",
        },
        "fine-art-paper-framed": {
          category: "paper",
          size: "33 × 43 cm | 13.0 × 16.9 in",
          border: "no-border",
          color: "black",
        },
      };
      const defaultParams = portraitProductDefaults[handle];
      if (!defaultParams) return;

      const params = new URLSearchParams({
        style: "the_gentleman",
        step: "3",
        ...defaultParams,
      });
      const configuratorUrl = "/pages/portrait?" + params.toString();
      card.querySelectorAll("a.card-gallery__link, a.card-gallery__slide-link, .card-gallery a").forEach(link => {
        link.href = configuratorUrl;
      });
    }
  });
{% endjavascript %}
