{%- comment -%}
  Bark & Frame uses three local font files in production:
  PP Acma for display text, Inter 500 for regular UI/body text, and Inter 700 for bold UI/body text.
  Keep these local preloads stable so Shopify's hosted font URLs do not compete with them.
{%- endcomment -%}

<link
  rel="preload"
  as="font"
  href="{{ 'PPAcma-Semibold.woff2' | asset_url }}"
  type="font/woff2"
  crossorigin
>
<link
  rel="preload"
  as="font"
  href="{{ 'Inter-500.woff2' | asset_url }}"
  type="font/woff2"
  crossorigin
>
<link
  rel="preload"
  as="font"
  href="{{ 'Inter-700.woff2' | asset_url }}"
  type="font/woff2"
  crossorigin
>
