{%- doc -%}
  Returns the configurator URL for products that should not open their product detail page.

  @param {object} product - The product object
{%- enddoc -%}

{%- liquid
  case product.handle
    when 'framed-canvas-1', 'canvas-framed'
      echo '/pages/portrait?step=3&style=the_gentleman&category=canvas&size=33%20%C3%97%2043%20cm%20%7C%2013.0%20%C3%97%2016.9%20in&framing=framed&color=black'
    when 'unframed-canvas', 'canvas-unframed'
      echo '/pages/portrait?step=3&style=the_gentleman&category=canvas&size=30%20%C3%97%2040%20cm%20%7C%2011.8%20%C3%97%2015.7%20in&framing=unframed'
    when 'framed-poster', 'fine-art-paper-framed'
      echo '/pages/portrait?step=3&style=the_gentleman&category=paper&size=33%20%C3%97%2043%20cm%20%7C%2013.0%20%C3%97%2016.9%20in&border=no-border&color=black'
  endcase
-%}
