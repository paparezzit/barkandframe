{%- doc -%}
  Renders the cart drawer, a slide-out panel that displays the contents of the cart. It includes the cart icon that acts as a trigger.

  @param {object} [settings] - An object containing theme settings.

  @param {boolean} [settings.auto_open_cart_drawer] - If `true`, the cart drawer opens automatically after an item is
  added.
  @param {string} [settings.drawer_color_scheme] - The color scheme for the drawer.
{%- enddoc -%}

<script
  src="{{ 'cart-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<cart-drawer-component
  class="cart-drawer"
  {{ block.shopify_attributes }}
  {% if settings.auto_open_cart_drawer %}
    auto-open
  {% endif %}
>
  <button
    class="button header-actions__action button-unstyled"
    on:click="/open"
    aria-label="{{ 'accessibility.open_cart_drawer' | t }} {{ 'accessibility.cart_count' | t}}: {{ cart.item_count }}"
  >
    {% render 'cart-icon-component' %}
  </button>

  <dialog
    ref="dialog"
    class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{%endif%}"
    scroll-lock
  >
    <div class="cart-drawer__inner">
      <cart-items-component
        class="cart-items-component"
        data-section-id="{{ section.id }}"
      >
        {%- if cart.empty? -%}
          <div class="cart-drawer__header">
            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
          >
            <h2 class="cart-drawer__heading h3 cart-drawer__heading--empty">
              {{ 'content.your_cart_is_empty' | t }}
            </h2>

            <div class="cart-drawer__items">
              {% render 'cart-products' %}
            </div>
          </div>
        {%- else -%}
          <div
            class="cart-drawer__header"
            id="cart-drawer-header"
          >
            <h2 class="cart-drawer__heading h3">
              <span class="svg-wrapper cart-drawer__heading-icon">{{- 'icon-cart.svg' | inline_asset_content -}}</span>
              {{ 'content.cart_title' | t }}
            </h2>

            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
            style="--header-height: 60px;"
          >
            <scroll-hint
              class="cart-drawer__items"
            >
              {% render 'cart-products' %}
            </scroll-hint>

            <div
              class="cart-drawer__summary"
            >
              {%- liquid
                assign upsell_p1 = section.settings.cart_upsell_product_1
                assign upsell_p2 = section.settings.cart_upsell_product_2
                assign upsell_p3 = section.settings.cart_upsell_product_3
                assign upsell_p4 = section.settings.cart_upsell_product_4
                assign has_upsell = false
                assign upsell_count = 0
                if upsell_p1 != blank
                  assign has_upsell = true
                  assign upsell_count = upsell_count | plus: 1
                endif
                if upsell_p2 != blank
                  assign has_upsell = true
                  assign upsell_count = upsell_count | plus: 1
                endif
                if upsell_p3 != blank
                  assign has_upsell = true
                  assign upsell_count = upsell_count | plus: 1
                endif
                if upsell_p4 != blank
                  assign has_upsell = true
                  assign upsell_count = upsell_count | plus: 1
                endif
              -%}
              {%- if has_upsell -%}
                <div class="cart-drawer__upsell">
                  <div class="cart-drawer__upsell-products">
                    {%- for product in (1..4) -%}
                      {%- liquid
                        case forloop.index
                          when 1
                            assign upsell_product = upsell_p1
                          when 2
                            assign upsell_product = upsell_p2
                          when 3
                            assign upsell_product = upsell_p3
                          when 4
                            assign upsell_product = upsell_p4
                        endcase
                      -%}
                      {%- if upsell_product != blank -%}
                        {%- assign first_variant = upsell_product.selected_or_first_available_variant -%}
                        {%- capture upsell_merch_order_items -%}
                          {%- render 'baf-merch-printful-map', product: upsell_product -%}
                        {%- endcapture -%}
                        {%- assign upsell_merch_order_items = upsell_merch_order_items | strip -%}
                        <div class="cart-drawer__upsell-card__wrapper">
                          <div
                            class="cart-drawer__upsell-card"
                            {% if upsell_merch_order_items != blank %}
                              data-baf-merch-order-items="{{ upsell_merch_order_items | escape }}"
                            {% endif %}
                          >
                            <a
                              href="{{ upsell_product.url }}"
                              class="cart-drawer__upsell-card-image-link"
                              tabindex="-1"
                              aria-hidden="true"
                            >
                              {%- if upsell_product.featured_image -%}
                                {{-
                                  upsell_product.featured_image
                                  | image_url: width: 300
                                  | image_tag: loading: 'lazy', widths: '150, 300', alt: upsell_product.featured_image.alt
                                  | escape
                                -}}
                              {%- endif -%}
                            </a>
                            <div class="cart-drawer__upsell-card-content">
                              <a href="{{ upsell_product.url }}" class="cart-drawer__upsell-card-title">
                                {{- upsell_product.title -}}
                              </a>
                              <div class="cart-drawer__upsell-card-prices">
                                {%- if upsell_product.compare_at_price > upsell_product.price -%}
                                  <s class="cart-drawer__upsell-card-compare">{{- upsell_product.compare_at_price | money -}}</s>
                                {%- endif -%}
                                <span class="cart-drawer__upsell-card-price">{{ upsell_product.price | money }}</span>
                              </div>
                              <div class="cart-drawer__upsell-card-actions">
                                {%- if upsell_product.variants.size > 1 -%}
                                  <div class="cart-drawer__upsell-card-variant-wrap">
                                    <select class="cart-drawer__upsell-card-variant">
                                      {%- for variant in upsell_product.variants -%}
                                        {%- liquid
                                          assign variant_size = variant.option2 | strip
                                          if upsell_product.type == 'Crewneck' or upsell_product.type == 'T-Shirt'
                                            unless variant_size == 'S' or variant_size == 'M' or variant_size == 'L' or variant_size == 'XL' or variant_size == '2XL' or variant_size == 'XXL'
                                              continue
                                            endunless
                                          endif
                                        -%}
                                        <option
                                          value="{{ variant.id }}"
                                          {% unless variant.available %}disabled{% endunless %}
                                        >{{ variant.title | replace: '2XL', 'XXL' }}</option>
                                      {%- endfor -%}
                                    </select>
                                    <span class="cart-drawer__upsell-card-variant-chevron">
                                      {{- 'icon-caret.svg' | inline_asset_content -}}
                                    </span>
                                  </div>
                                {%- endif -%}
                                <button
                                  class="cart-drawer__upsell-card-add"
                                  data-upsell-add
                                  data-variant-id="{{ first_variant.id }}"
                                  type="button"
                                >Add</button>
                              </div>
                            </div>
                          </div>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {%- if upsell_count > 1 -%}
                    <div class="cart-drawer__upsell-dots">
                      {%- for i in (1..upsell_count) -%}
                        <button
                          class="cart-drawer__upsell-dot{% if forloop.first %} is-active{% endif %}"
                          data-dot-index="{{ forloop.index0 }}"
                          aria-label="Product {{ forloop.index }}"
                          type="button"
                        ></button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {% render 'cart-summary' %}
            </div>
          </div>
        {%- endif -%}
      </cart-items-component>
    </div>
  </dialog>
</cart-drawer-component>

<script>
  (function () {
    document.addEventListener('change', (e) => {
      const select = e.target.closest('.cart-drawer__upsell-card-variant');
      if (!select) return;
      const card = select.closest('.cart-drawer__upsell-card');
      const btn = card?.querySelector('[data-upsell-add]');
      if (btn) btn.dataset.variantId = select.value;
    });

    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-upsell-add]');
      if (!btn) return;

      const variantId = btn.dataset.variantId;
      if (!variantId) return;

      btn.disabled = true;

      try {
        const sectionId = document.querySelector('cart-items-component')?.dataset.sectionId;
        const body = { id: Number(variantId), quantity: 1 };
        const card = btn.closest('.cart-drawer__upsell-card');
        const merchOrderItem = getMerchOrderItem(card, variantId);
        if (merchOrderItem) body.properties = getMerchLineProperties(merchOrderItem);
        if (sectionId) body.sections = sectionId;

        const res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });

        if (!res.ok) throw new Error('add failed');

        const data = await res.json();
        if (merchOrderItem && window.BAFOrderSync?.syncCartOrder) {
          await window.BAFOrderSync.syncCartOrder();
        }

        document.dispatchEvent(new CustomEvent('cart:update', {
          bubbles: true,
          detail: { data: { sections: data.sections ?? null } },
        }));
      } catch (err) {
        console.error('Upsell add to cart error:', err);
        btn.disabled = false;
      }
    });

    function getMerchOrderItem(card, variantId) {
      if (!card?.dataset.bafMerchOrderItems) return null;

      try {
        const merchOrderItems = JSON.parse(card.dataset.bafMerchOrderItems);
        const merchOrderItem = merchOrderItems[variantId];
        return merchOrderItem && typeof merchOrderItem === 'object' ? merchOrderItem : null;
      } catch (err) {
        return null;
      }
    }

    function getMerchLineProperties(merchOrderItem) {
      return {
        _baf_order_type: 'merch',
        _baf_design_name: merchOrderItem.design_name || '',
        _baf_product_name: merchOrderItem.product_name || '',
        _baf_production_line: merchOrderItem.production_line || '',
        _baf_product_color: merchOrderItem.product_color || '',
        _baf_size: merchOrderItem.size || '',
        _baf_artwork_colorway: merchOrderItem.artwork_colorway || '',
        _baf_production_name: merchOrderItem.production_name || '',
        _baf_printful_variant_id: String(merchOrderItem.printful_variant_id || ''),
        ...(merchOrderItem.production && typeof merchOrderItem.production === 'object'
          ? { _baf_production: JSON.stringify(merchOrderItem.production) }
          : {}),
      };
    }

    // Dots: click → scroll to card, scroll → update active dot
    document.addEventListener('click', (e) => {
      const dot = e.target.closest('.cart-drawer__upsell-dot');
      if (!dot) return;
      const index = Number(dot.dataset.dotIndex);
      const upsell = dot.closest('.cart-drawer__upsell');
      const container = upsell?.querySelector('.cart-drawer__upsell-products');
      const cards = container?.querySelectorAll('.cart-drawer__upsell-card');
      if (!cards?.[index]) return;
      container.scrollTo({ left: cards[index].offsetLeft - container.offsetLeft, behavior: 'smooth' });
    });

    function initUpsellDots(container) {
      const upsell = container.closest('.cart-drawer__upsell');
      const dots = upsell?.querySelectorAll('.cart-drawer__upsell-dot');
      if (!dots?.length) return;
      const cards = container.querySelectorAll('.cart-drawer__upsell-card');

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const index = Array.from(cards).indexOf(entry.target);
            if (index === -1) return;
            dots.forEach((d, i) => d.classList.toggle('is-active', i === index));
          });
        },
        { root: container, threshold: 0.5 }
      );

      cards.forEach((card) => observer.observe(card));
    }

    document.querySelectorAll('.cart-drawer__upsell-products').forEach(initUpsellDots);

    // Re-init after cart section re-renders
    document.addEventListener('cart:refresh', () => {
      document.querySelectorAll('.cart-drawer__upsell-products').forEach(initUpsellDots);
    });
  })();
</script>

{% stylesheet %}
  .cart-items-component {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
  }

  .cart-drawer__heading-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .cart-drawer__heading-icon svg {
    width: 22px;
    height: 22px;
  }

  .cart-drawer {
    .button {
      padding: 0;

      &:hover,
      &:focus {
        background-color: transparent;
      }
    }
  }

  .cart-drawer__heading .cart-bubble {
    width: fit-content;
    border-radius: var(--style-border-radius-buttons-primary);
    aspect-ratio: auto;
    padding: var(--cart-padding);
  }

  .cart-drawer__heading .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
    min-width: 26px;
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 20px;
    position: sticky;
    top: 0;
    z-index: 1;

    .cart-drawer__heading {
      font-size: 14px;
    }

    .close-button {
      width: var(--minimum-touch-target);
      height: var(--minimum-touch-target);
      top: 20px;
      right: 30px !important;
      border-radius: 50%;
      background-color: var(--cream);
      color: var(--brown);

      &:hover,
      &:focus {
        background-color: var(--cream);
        color: var(--brown);
      }
    }
  }

  .cart-drawer__dialog {
    overflow: hidden;
    width: 440px !important;
  }

  .cart-drawer__inner {
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__summary {
    background-color: var(--color-background);
    position: sticky;
    bottom: 0;
    z-index: 1;
    padding: 0 !important;
    gap: 0 !important;
    mask-image: none !important;

    .cart__ctas {
      padding: var(--cart-drawer-summary-padding);
    }
  }

  .cart-drawer__upsell {
    padding: 30px 0 15px;
    background: var(--cream);
    width: 100%;
  }

  .cart-drawer__upsell-products {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    padding: 0 20px;
  }

  .cart-drawer__upsell-card__wrapper{
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .cart-drawer__upsell-card {
    flex: 0 0 calc(100% - 40px);
    display: flex;
    flex-direction: row;
    gap: 15px;
    background-color: var(--beige);
    border-radius: 20px;
    padding: 15px;
    align-items: flex-start;
    margin-left: 20px;
    height: 150px;
  }

  .cart-drawer__upsell-card-image-link {
    flex-shrink: 0;
    display: block;
    border-radius: 10px;
    overflow: hidden;
    background-color: var(--cream);

    img {
      height: 120px;
      aspect-ratio: 5/6;
      object-fit: cover;
      display: block;
    }
  }

  .cart-drawer__upsell-card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
  }

  .cart-drawer__upsell-card-title {
    font-size: 14px;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-drawer__upsell-card-prices {
    display: flex;
    align-items: end;
    gap: 6px;
    flex-wrap: wrap;
    font-family: "display", serif;
    font-weight: 400;
    font-size: var(--baf-display-small-size);
    line-height: 1;
    margin-top: 8px;
  }

  .cart-drawer__upsell-card-compare {
    font-size: 14px;
    opacity: .45;
    text-decoration: line-through;
  }

  .cart-drawer__upsell-card-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
  }

  .cart-drawer__upsell-card-variant-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .cart-drawer__upsell-card-variant {
    appearance: none;
    background: var(--cream);
    border: none;
    border-radius: 999px;
    padding: 7px 28px 7px 12px;
    font-size: var(--baf-text-medium-size);
    font-family: inherit;
    cursor: pointer;
    color: inherit;
  }

  .cart-drawer__upsell-card-variant-chevron {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    display: flex;
    align-items: center;

    svg {
      width: 12px;
      height: 12px;
    }
  }

  .cart-drawer__upsell-card-add {
    background: var(--brown);
    color: var(--cream);
    border: none;
    border-radius: 999px;
    padding: 7px 14px;
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    text-align: center;
    transition: opacity 0.15s;
    margin-left: auto;
    width: fit-content;

    &:disabled {
      opacity: 0.6;
      cursor: wait;
    }
  }

  .cart-drawer__upsell-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    padding: 10px 20px 0;
  }

  .cart-drawer__upsell-dot {
    height: 2px;
    width: 100%;
    flex: 1;
    padding: 10px 0;
    cursor: pointer;
    opacity: .27;
    border: 0;
    background-color: transparent;
    transition: opacity 0.2s;

    &::after{
      height: 2px;
      width: 100%;
      content: "";
      background-color: var(--brown);
      border-radius: 1000px;
      display: block;
    }

    &.is-active {
      opacity: 1;
    }
  }
{% endstylesheet %}
