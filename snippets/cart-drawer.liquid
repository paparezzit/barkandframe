{%- doc -%}
  Renders the cart drawer, a slide-out panel that displays the contents of the cart. It includes the cart icon that acts as a trigger.

  @param {object} [settings] - An object containing theme settings.

  @param {boolean} [settings.auto_open_cart_drawer] - If `true`, the cart drawer opens automatically after an item is
  added.
  @param {string} [settings.drawer_color_scheme] - The color scheme for the drawer.
{%- enddoc -%}

<script
  src="{{ 'cart-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<cart-drawer-component
  class="cart-drawer"
  {{ block.shopify_attributes }}
  {% if settings.auto_open_cart_drawer %}
    auto-open
  {% endif %}
>
  <button
    class="button header-actions__action button-unstyled"
    on:click="/open"
    aria-label="{{ 'accessibility.open_cart_drawer' | t }} {{ 'accessibility.cart_count' | t}}: {{ cart.item_count }}"
  >
    {% render 'cart-icon-component' %}
  </button>

  <dialog
    ref="dialog"
    class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{%endif%}"
    scroll-lock
  >
    <div class="cart-drawer__inner">
      <cart-items-component
        class="cart-items-component"
        data-section-id="{{ section.id }}"
      >
        {%- if cart.empty? -%}
          <div class="cart-drawer__header">
            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <div
            class="cart-drawer__content cart-drawer__content--empty motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
          >
            <div class="cart-drawer__empty-state">
              <h2 class="cart-drawer__heading cart-drawer__heading--empty">
                {{ 'content.your_cart_is_empty' | t }}
              </h2>

              <div class="cart-drawer__items">
                {% render 'cart-products' %}
              </div>
            </div>
          </div>
        {%- else -%}
          <div
            class="cart-drawer__header"
            id="cart-drawer-header"
          >
            <h2 class="cart-drawer__heading">
              <span class="svg-wrapper cart-drawer__heading-icon">{{- 'icon-cart.svg' | inline_asset_content -}}</span>
              {{ 'content.cart_title' | t }}
            </h2>

            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
            style="--header-height: 60px;"
          >
            <scroll-hint
              class="cart-drawer__items"
            >
              {% render 'cart-products' %}
            </scroll-hint>

            <div
              class="cart-drawer__summary"
            >
              {%- liquid
                assign upsell_products = section.settings.cart_upsell_products
                assign upsell_discount_percent = section.settings.cart_upsell_discount_percent | default: 15
                assign upsell_discount_multiplier = 100 | minus: upsell_discount_percent
              -%}
              {%- if upsell_products != blank -%}
                <div class="cart-drawer__upsell">
                  <h2 class="cart-drawer__upsell-heading">Add and save</h2>
                  <div class="cart-drawer__upsell-products">
                    {%- for upsell_product in upsell_products -%}
                      {%- liquid
                        assign upsell_product_handle = upsell_product.handle | default: upsell_product
                        assign upsell_product_handle = upsell_product_handle | remove: 'shopify://products/'
                        if upsell_product.title == blank and upsell_product_handle != blank
                          assign upsell_product = all_products[upsell_product_handle]
                        endif
                      -%}
                      {%- if upsell_product != blank -%}
                        {%- liquid
                          assign upsell_default_color = ''
                          case upsell_product.type
                            when 'T-Shirt'
                              assign upsell_default_color = section.settings.cart_upsell_default_tshirt_color | default: 'Black'
                            when 'Crewneck'
                              assign upsell_default_color = section.settings.cart_upsell_default_crewneck_color | default: 'Heather Grey'
                            when 'Cap'
                              assign upsell_default_color = section.settings.cart_upsell_default_cap_color | default: 'Black'
                          endcase

                          assign selected_upsell_variant = blank
                          for variant in upsell_product.variants
                            assign variant_size = variant.option2 | strip
                            if upsell_product.type == 'Crewneck' or upsell_product.type == 'T-Shirt'
                              unless variant_size == 'S' or variant_size == 'M' or variant_size == 'L' or variant_size == 'XL' or variant_size == '2XL' or variant_size == 'XXL'
                                continue
                              endunless
                            endif

                            assign variant_color = variant.option1 | strip
                            if selected_upsell_variant == blank and variant.available and upsell_default_color != blank and variant_color == upsell_default_color
                              assign selected_upsell_variant = variant
                              break
                            endif
                          endfor

                          if selected_upsell_variant == blank
                            assign selected_upsell_variant = upsell_product.selected_or_first_available_variant
                          endif

                          assign first_variant = selected_upsell_variant
                          assign selected_upsell_color = first_variant.option1 | strip
                          assign selected_upsell_size = first_variant.option2 | strip
                          assign upsell_card_image = first_variant.featured_image | default: upsell_product.featured_image
                          assign upsell_original_price = first_variant.price | default: upsell_product.price
                          assign upsell_sale_price = upsell_original_price | times: upsell_discount_multiplier | divided_by: 100.0
                          assign upsell_sale_price = upsell_sale_price | divided_by: 100.0 | round | times: 100

                          assign upsell_seen_colors = ''
                          assign upsell_color_count = 0
                          assign upsell_seen_sizes = ''
                          assign upsell_size_count = 0
                          for variant in upsell_product.variants
                            assign variant_size = variant.option2 | strip
                            if upsell_product.type == 'Crewneck' or upsell_product.type == 'T-Shirt'
                              unless variant_size == 'S' or variant_size == 'M' or variant_size == 'L' or variant_size == 'XL' or variant_size == '2XL' or variant_size == 'XXL'
                                continue
                              endunless
                            endif

                            assign variant_color = variant.option1 | strip
                            assign variant_color_marker = '|' | append: variant_color | append: '|'
                            unless upsell_seen_colors contains variant_color_marker
                              assign upsell_seen_colors = upsell_seen_colors | append: variant_color_marker
                              assign upsell_color_count = upsell_color_count | plus: 1
                            endunless

                            assign variant_size_marker = '|' | append: variant_size | append: '|'
                            if variant_size != blank
                              unless upsell_seen_sizes contains variant_size_marker
                                assign upsell_seen_sizes = upsell_seen_sizes | append: variant_size_marker
                                assign upsell_size_count = upsell_size_count | plus: 1
                              endunless
                            endif
                          endfor
                        -%}
                        {%- capture upsell_merch_order_items -%}
                          {%- render 'baf-merch-printful-map', product: upsell_product -%}
                        {%- endcapture -%}
                        {%- assign upsell_merch_order_items = upsell_merch_order_items | strip -%}
                        <div class="cart-drawer__upsell-card__wrapper">
                          <div
                            class="cart-drawer__upsell-card"
                            {% if upsell_merch_order_items != blank %}
                              data-baf-merch-order-items="{{ upsell_merch_order_items | escape }}"
                            {% endif %}
                          >
                            <a
                              href="{{ upsell_product.url }}"
                              class="cart-drawer__upsell-card-image-link"
                              tabindex="-1"
                              aria-hidden="true"
                            >
                              {%- if upsell_card_image -%}
                                {{-
                                  upsell_card_image
                                  | image_url: width: 300
                                  | image_tag: loading: 'lazy', widths: '150, 300', alt: upsell_card_image.alt
                                -}}
                              {%- endif -%}
                            </a>
                            <div class="cart-drawer__upsell-card-content">
                              <a href="{{ upsell_product.url }}" class="cart-drawer__upsell-card-title">
                                {{- upsell_product.title -}}
                              </a>
                              <div class="cart-drawer__upsell-card-prices">
                                <span class="cart-drawer__upsell-card-price price">{{ upsell_sale_price | money_without_trailing_zeros }}</span>
                                {%- if upsell_discount_percent > 0 -%}
                                  <s class="cart-drawer__upsell-card-compare compare-at-price">{{- upsell_original_price | money_without_trailing_zeros -}}</s>
                                {%- endif -%}
                              </div>
                              <div class="cart-drawer__upsell-card-actions">
                                {%- if upsell_product.variants.size > 1 -%}
                                  <select class="cart-drawer__upsell-card-variant" hidden aria-hidden="true" tabindex="-1">
                                    {%- for variant in upsell_product.variants -%}
                                      {%- liquid
                                        assign variant_size = variant.option2 | strip
                                        if upsell_product.type == 'Crewneck' or upsell_product.type == 'T-Shirt'
                                          unless variant_size == 'S' or variant_size == 'M' or variant_size == 'L' or variant_size == 'XL' or variant_size == '2XL' or variant_size == 'XXL'
                                            continue
                                          endunless
                                        endif

                                        assign variant_color = variant.option1 | strip
                                        assign variant_image = variant.featured_image | default: upsell_product.featured_image
                                        assign variant_original_price = variant.price
                                        assign variant_sale_price = variant_original_price | times: upsell_discount_multiplier | divided_by: 100.0
                                        assign variant_sale_price = variant_sale_price | divided_by: 100.0 | round | times: 100
                                      -%}
                                      <option
                                        value="{{ variant.id }}"
                                        data-color="{{ variant_color | escape }}"
                                        data-size="{{ variant_size | escape }}"
                                        data-price="{{ variant_sale_price | money_without_trailing_zeros | escape }}"
                                        data-compare="{{ variant_original_price | money_without_trailing_zeros | escape }}"
                                        {% if variant_image %}
                                          data-image="{{ variant_image | image_url: width: 300 }}"
                                          data-image-srcset="{{ variant_image | image_url: width: 150 }} 150w, {{ variant_image | image_url: width: 300 }} 300w"
                                          data-image-alt="{{ variant_image.alt | default: upsell_product.title | escape }}"
                                        {% endif %}
                                        {% unless variant.available %}disabled{% endunless %}
                                        {% if variant.id == first_variant.id %}selected{% endif %}
                                      ></option>
                                    {%- endfor -%}
                                  </select>
                                {%- endif -%}
                                {%- if upsell_color_count > 1 -%}
                                  <div class="cart-drawer__upsell-card-variant-wrap">
                                    <select class="cart-drawer__upsell-card-select cart-drawer__upsell-card-color" data-upsell-color-select aria-label="Color">
                                      {%- assign rendered_upsell_colors = '' -%}
                                      {%- for variant in upsell_product.variants -%}
                                        {%- liquid
                                          assign variant_size = variant.option2 | strip
                                          if upsell_product.type == 'Crewneck' or upsell_product.type == 'T-Shirt'
                                            unless variant_size == 'S' or variant_size == 'M' or variant_size == 'L' or variant_size == 'XL' or variant_size == '2XL' or variant_size == 'XXL'
                                              continue
                                            endunless
                                          endif

                                          assign variant_color = variant.option1 | strip
                                          assign variant_color_marker = '|' | append: variant_color | append: '|'
                                          if rendered_upsell_colors contains variant_color_marker
                                            continue
                                          endif
                                          assign rendered_upsell_colors = rendered_upsell_colors | append: variant_color_marker
                                          assign display_variant_title = variant_color
                                          case upsell_product.type
                                            when 'Cap'
                                              assign display_variant_title = display_variant_title | replace: 'Black', 'Onyx' | replace: 'Oyster', 'Biscuit'
                                            when 'T-Shirt'
                                              assign display_variant_title = display_variant_title | replace: 'Black', 'Onyx' | replace: 'Heather Grey', 'Greyhound' | replace: 'Pure White', 'White'
                                            when 'Crewneck'
                                              assign display_variant_title = display_variant_title | replace: 'Black', 'Onyx' | replace: 'Carbon Grey', 'Greyhound' | replace: 'Heather Grey', 'Greyhound'
                                          endcase
                                        -%}
                                        <option
                                          value="{{ variant_color | escape }}"
                                          {% if variant_color == selected_upsell_color %}selected{% endif %}
                                        >{{ display_variant_title }}</option>
                                      {%- endfor -%}
                                    </select>
                                    <span class="cart-drawer__upsell-card-variant-chevron">
                                      {{- 'icon-caret.svg' | inline_asset_content -}}
                                    </span>
                                  </div>
                                {%- endif -%}
                                {%- if upsell_size_count > 1 -%}
                                  <div class="cart-drawer__upsell-card-variant-wrap">
                                    <select class="cart-drawer__upsell-card-select cart-drawer__upsell-card-size" data-upsell-size-select aria-label="Size">
                                      {%- assign rendered_upsell_sizes = '' -%}
                                      {%- for variant in upsell_product.variants -%}
                                        {%- liquid
                                          assign variant_size = variant.option2 | strip
                                          if upsell_product.type == 'Crewneck' or upsell_product.type == 'T-Shirt'
                                            unless variant_size == 'S' or variant_size == 'M' or variant_size == 'L' or variant_size == 'XL' or variant_size == '2XL' or variant_size == 'XXL'
                                              continue
                                            endunless
                                          endif
                                          assign variant_size_marker = '|' | append: variant_size | append: '|'
                                          if rendered_upsell_sizes contains variant_size_marker
                                            continue
                                          endif
                                          assign rendered_upsell_sizes = rendered_upsell_sizes | append: variant_size_marker
                                          assign display_variant_size = variant_size | replace: '2XL', 'XXL'
                                        -%}
                                        <option
                                          value="{{ variant_size | escape }}"
                                          {% if variant_size == selected_upsell_size %}selected{% endif %}
                                        >{{ display_variant_size }}</option>
                                      {%- endfor -%}
                                    </select>
                                    <span class="cart-drawer__upsell-card-variant-chevron">
                                      {{- 'icon-caret.svg' | inline_asset_content -}}
                                    </span>
                                  </div>
                                {%- endif -%}
                                <button
                                  class="cart-drawer__upsell-card-add"
                                  data-upsell-add
                                  data-variant-id="{{ first_variant.id }}"
                                  type="button"
                                >Add</button>
                              </div>
                            </div>
                          </div>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  <div class="cart-drawer__upsell-scrollbar" aria-hidden="true">
                    <span class="cart-drawer__upsell-scrollbar-thumb"></span>
                  </div>
                </div>
              {%- endif -%}

              {% render 'cart-summary' %}
            </div>
          </div>
        {%- endif -%}
      </cart-items-component>
    </div>
  </dialog>
</cart-drawer-component>

<script>
  (function () {
    document.addEventListener('change', (e) => {
      const select = e.target.closest('.cart-drawer__upsell-card-select');
      if (!select) return;
      const card = select.closest('.cart-drawer__upsell-card');
      updateUpsellCardVariant(card);
    });

    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-upsell-add]');
      if (!btn) return;

      const variantId = btn.dataset.variantId;
      if (!variantId) return;

      btn.disabled = true;

      try {
        const sectionId = document.querySelector('cart-items-component')?.dataset.sectionId;
        const body = { id: Number(variantId), quantity: 1 };
        const card = btn.closest('.cart-drawer__upsell-card');
        const merchOrderItem = getMerchOrderItem(card, variantId);
        if (merchOrderItem) body.properties = getMerchLineProperties(merchOrderItem);
        if (sectionId) body.sections = sectionId;

        const res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });

        if (!res.ok) throw new Error('add failed');

        const data = await res.json();
        if (merchOrderItem && window.BAFOrderSync?.syncCartOrder) {
          await window.BAFOrderSync.syncCartOrder();
        }

        document.dispatchEvent(new CustomEvent('cart:update', {
          bubbles: true,
          detail: { data: { sections: data.sections ?? null } },
        }));
      } catch (err) {
        console.error('Upsell add to cart error:', err);
        btn.disabled = false;
      }
    });

    function getMerchOrderItem(card, variantId) {
      if (!card?.dataset.bafMerchOrderItems) return null;

      try {
        const merchOrderItems = JSON.parse(card.dataset.bafMerchOrderItems);
        const merchOrderItem = merchOrderItems[variantId];
        return merchOrderItem && typeof merchOrderItem === 'object' ? merchOrderItem : null;
      } catch (err) {
        return null;
      }
    }

    function getMerchLineProperties(merchOrderItem) {
      return {
        _baf_order_type: 'merch',
        _baf_design_name: merchOrderItem.design_name || '',
        _baf_product_name: merchOrderItem.product_name || '',
        _baf_production_line: merchOrderItem.production_line || '',
        _baf_product_color: merchOrderItem.product_color || '',
        _baf_size: merchOrderItem.size || '',
        _baf_artwork_colorway: merchOrderItem.artwork_colorway || '',
        _baf_production_name: merchOrderItem.production_name || '',
        _baf_printful_variant_id: String(merchOrderItem.printful_variant_id || ''),
        ...(merchOrderItem.production && typeof merchOrderItem.production === 'object'
          ? { _baf_production: JSON.stringify(merchOrderItem.production) }
          : {}),
      };
    }

    function updateUpsellCardVariant(card) {
      if (!card) return;

      const colorSelect = card.querySelector('[data-upsell-color-select]');
      const sizeSelect = card.querySelector('[data-upsell-size-select]');
      const variantSelect = card.querySelector('.cart-drawer__upsell-card-variant');
      const variantOptions = Array.from(variantSelect?.options || []);
      if (!variantOptions.length) return;

      const selectedColor = colorSelect?.value || '';
      const selectedSize = sizeSelect?.value || '';
      let selectedOption = variantOptions.find((option) => {
        if (option.disabled) return false;
        return (!selectedColor || option.dataset.color === selectedColor)
          && (!selectedSize || option.dataset.size === selectedSize);
      });

      if (!selectedOption) {
        selectedOption = variantOptions.find((option) => {
          if (option.disabled) return false;
          return !selectedColor || option.dataset.color === selectedColor;
        });
      }

      if (!selectedOption) {
        selectedOption = variantOptions.find((option) => !option.disabled) || variantOptions[0];
      }

      if (!selectedOption) return;

      variantSelect.value = selectedOption.value;

      if (sizeSelect && selectedOption.dataset.size) {
        sizeSelect.value = selectedOption.dataset.size;
      }

      const btn = card.querySelector('[data-upsell-add]');
      if (btn) btn.dataset.variantId = selectedOption.value;

      const image = card.querySelector('.cart-drawer__upsell-card-image-link img');
      if (image && selectedOption.dataset.image) {
        image.src = selectedOption.dataset.image;
        if (selectedOption.dataset.imageSrcset) image.srcset = selectedOption.dataset.imageSrcset;
        if (selectedOption.dataset.imageAlt) image.alt = selectedOption.dataset.imageAlt;
      }

      const price = card.querySelector('.cart-drawer__upsell-card-price');
      if (price && selectedOption.dataset.price) price.textContent = selectedOption.dataset.price;

      const compare = card.querySelector('.cart-drawer__upsell-card-compare');
      if (compare && selectedOption.dataset.compare) compare.textContent = selectedOption.dataset.compare;
    }

    function updateUpsellScrollbar(container) {
      const scrollbar = container.closest('.cart-drawer__upsell')?.querySelector('.cart-drawer__upsell-scrollbar');
      const thumb = scrollbar?.querySelector('.cart-drawer__upsell-scrollbar-thumb');
      if (!scrollbar || !thumb) return;

      const maxScroll = container.scrollWidth - container.clientWidth;
      if (maxScroll <= 0) {
        thumb.style.width = '100%';
        thumb.style.transform = 'translateX(0)';
        return;
      }

      const trackWidth = scrollbar.clientWidth;
      const thumbWidth = Math.max((container.clientWidth / container.scrollWidth) * trackWidth, 34);
      const left = ((trackWidth - thumbWidth) * container.scrollLeft) / maxScroll;
      thumb.style.width = `${thumbWidth}px`;
      thumb.style.transform = `translateX(${left}px)`;
    }

    function scrollUpsellFromScrollbar(container, scrollbar, clientX) {
      const maxScroll = container.scrollWidth - container.clientWidth;
      if (maxScroll <= 0) return;

      const rect = scrollbar.getBoundingClientRect();
      const thumb = scrollbar.querySelector('.cart-drawer__upsell-scrollbar-thumb');
      const thumbWidth = thumb?.offsetWidth || 34;
      const usableWidth = Math.max(rect.width - thumbWidth, 1);
      const progress = Math.min(Math.max((clientX - rect.left - thumbWidth / 2) / usableWidth, 0), 1);
      container.scrollLeft = progress * maxScroll;
      updateUpsellScrollbar(container);
    }

    function initUpsellScrollbars() {
      document.querySelectorAll('.cart-drawer__upsell-products').forEach((container) => {
        if (container.dataset.scrollbarReady === 'true') {
          updateUpsellScrollbar(container);
          return;
        }

        container.dataset.scrollbarReady = 'true';
        updateUpsellScrollbar(container);
        container.addEventListener('scroll', () => updateUpsellScrollbar(container), { passive: true });
      });
    }

    function refreshUpsellScrollbars() {
      initUpsellScrollbars();
      requestAnimationFrame(() => {
        initUpsellScrollbars();
        requestAnimationFrame(initUpsellScrollbars);
      });
    }

    document.addEventListener('wheel', (event) => {
      const upsell = event.target.closest('.cart-drawer__upsell');
      if (!upsell || event.target.closest('button, select, input, textarea')) return;

      const container = upsell.querySelector('.cart-drawer__upsell-products');
      if (!container) return;

      const maxScroll = container.scrollWidth - container.clientWidth;
      if (maxScroll <= 0) return;

      const delta = Math.abs(event.deltaX) >= Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
      if (!delta) return;

      const atStart = container.scrollLeft <= 0 && delta < 0;
      const atEnd = container.scrollLeft >= maxScroll - 1 && delta > 0;
      if (atStart || atEnd) return;

      event.preventDefault();
      container.scrollLeft += delta;
      updateUpsellScrollbar(container);
    }, { passive: false, capture: true });

    let activeScrollbarDrag = null;

    document.addEventListener('pointerdown', (event) => {
      const scrollbar = event.target.closest('.cart-drawer__upsell-scrollbar');
      if (!scrollbar) return;

      const container = scrollbar.closest('.cart-drawer__upsell')?.querySelector('.cart-drawer__upsell-products');
      if (!container) return;

      activeScrollbarDrag = { container, scrollbar };
      scrollbar.setPointerCapture?.(event.pointerId);
      scrollUpsellFromScrollbar(container, scrollbar, event.clientX);
      event.preventDefault();
    });

    document.addEventListener('pointermove', (event) => {
      if (!activeScrollbarDrag) return;
      scrollUpsellFromScrollbar(activeScrollbarDrag.container, activeScrollbarDrag.scrollbar, event.clientX);
      event.preventDefault();
    });

    document.addEventListener('pointerup', () => {
      activeScrollbarDrag = null;
    });

    document.addEventListener('pointercancel', () => {
      activeScrollbarDrag = null;
    });

    document.querySelectorAll('.cart-drawer__dialog').forEach((dialog) => {
      new MutationObserver(() => {
        if (dialog.hasAttribute('open')) refreshUpsellScrollbars();
      }).observe(dialog, { attributes: true, attributeFilter: ['open'] });
    });

    refreshUpsellScrollbars();
    window.addEventListener('resize', refreshUpsellScrollbars);
    document.addEventListener('cart:update', refreshUpsellScrollbars);
    document.addEventListener('cart:refresh', refreshUpsellScrollbars);
  })();
</script>

{% stylesheet %}
  .cart-items-component {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--font-paragraph--family, var(--font-body--family));
    font-size: var(--baf-text-medium-size);
    font-weight: 400;
    line-height: 1.2;
  }

  .cart-drawer__heading-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .cart-drawer__heading-icon svg {
    width: 22px;
    height: 22px;
  }

  .cart-drawer {
    .button {
      padding: 0;

      &:hover,
      &:focus {
        background-color: transparent;
      }
    }
  }

  .cart-drawer__heading .cart-bubble {
    width: fit-content;
    border-radius: var(--style-border-radius-buttons-primary);
    aspect-ratio: auto;
    padding: var(--cart-padding);
  }

  .cart-drawer__heading .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
    min-width: 26px;
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 20px;
    position: sticky;
    top: 0;
    z-index: 1;

    .close-button {
      width: var(--minimum-touch-target);
      height: var(--minimum-touch-target);
      top: 20px;
      right: 30px !important;
      border-radius: 50%;
      background-color: var(--cream);
      color: var(--brown);

      &:hover,
      &:focus {
        background-color: var(--cream);
        color: var(--brown);
      }
    }
  }

  .cart-drawer__dialog {
    overflow: hidden;
    width: 440px !important;
  }

  .cart-drawer__dialog::backdrop {
    background: rgba(255, 255, 255, 0.81);
    backdrop-filter: none;
  }

  .cart-drawer__dialog[open]::backdrop {
    animation: none;
  }

  .cart-drawer__inner {
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__content--empty {
    position: absolute;
    inset: 0;
    height: auto;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 80px 40px;
  }

  .cart-drawer__empty-state {
    width: 100%;
  }

  .cart-drawer__content--empty .cart-drawer__heading {
    justify-content: center;
  }

  .cart-drawer__content--empty .cart-drawer__items {
    display: flex;
    justify-content: center;
  }

  .cart-drawer__summary {
    background-color: var(--color-background);
    position: sticky;
    bottom: 0;
    z-index: 1;
    padding: 0 !important;
    gap: 0 !important;
    mask-image: none !important;

    .cart__ctas {
      padding: var(--cart-drawer-summary-padding);
    }
  }

  .cart-drawer__upsell {
    padding: 12px 0 15px;
    background: var(--cream);
    width: 100%;
  }

  .cart-drawer__upsell-heading {
    margin: 0 20px 12px;
    color: inherit;
    font-family: var(--baf-display-family);
    font-size: var(--baf-display-extra-small-size);
    font-weight: var(--baf-display-weight);
    line-height: 1;
  }

  .cart-drawer__upsell-products {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: none;
    gap: 14px;
    padding: 0 20px;
    overscroll-behavior-inline: contain;
  }

  .cart-drawer__upsell-products::-webkit-scrollbar {
    display: none;
  }

  .cart-drawer__upsell-card__wrapper{
    flex: 0 0 auto;
    min-width: calc(100% - 40px);
  }

  .cart-drawer__upsell-card {
    width: max-content;
    min-width: 100%;
    max-width: none;
    display: flex;
    flex-direction: row;
    gap: 15px;
    background-color: var(--beige);
    border-radius: 20px;
    padding: 15px;
    align-items: flex-start;
    min-height: 150px;
    height: auto;
    box-sizing: border-box;
  }

  .cart-drawer__upsell-card-image-link {
    flex-shrink: 0;
    display: block;
    height: 120px;
    aspect-ratio: 5 / 6;
    width: auto;
    border-radius: 10px;
    overflow: hidden;
    background-color: var(--cream);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  .cart-drawer__upsell-card-content {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    min-width: 180px;
    width: max-content;
    height: 100%;
  }

  .cart-drawer__upsell-card-title {
    font-size: 14px;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-drawer__upsell-card-prices {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    font-family: "display", serif;
    font-weight: 400;
    font-size: var(--baf-display-small-size);
    line-height: 1;
    margin-top: 8px;
  }

  .cart-drawer__upsell-card-compare {
    font-size: 14px;
    text-decoration: line-through;
  }

  .cart-drawer__upsell-card-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
    width: max-content;
    min-width: max-content;
  }

  .cart-drawer__upsell-card-variant-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .cart-drawer__upsell-card-select {
    appearance: none;
    background: var(--cream);
    border: none;
    border-radius: 999px;
    padding: 7px 28px 7px 12px;
    font-size: var(--baf-text-medium-size);
    font-family: inherit;
    cursor: pointer;
    color: inherit;
  }

  .cart-drawer__upsell-card-select:focus,
  .cart-drawer__upsell-card-select:focus-visible,
  .cart-drawer__upsell-card-add:focus,
  .cart-drawer__upsell-card-add:focus-visible,
  .cart-drawer__upsell-card-title:focus,
  .cart-drawer__upsell-card-title:focus-visible,
  .cart-drawer__upsell-card-image-link:focus,
  .cart-drawer__upsell-card-image-link:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }

  .cart-drawer__upsell-card-variant-chevron {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    display: flex;
    align-items: center;

    svg {
      width: 12px;
      height: 12px;
    }
  }

  .cart-drawer__upsell-card-add {
    background: var(--brown);
    color: var(--cream);
    border: none;
    border-radius: 999px;
    padding: 7px 14px;
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    text-align: center;
    transition: opacity 0.15s;
    margin-left: auto;
    width: fit-content;

    &:disabled {
      opacity: 0.6;
      cursor: wait;
    }
  }

  .cart-drawer__upsell-scrollbar {
    position: relative;
    height: 22px;
    margin: 12px 20px 0;
    cursor: pointer;
  }

  .cart-drawer__upsell-scrollbar::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 10px;
    height: 2px;
    background: rgb(76 68 63 / 0.18);
    border-radius: 1000px;
  }

  .cart-drawer__upsell-scrollbar-thumb {
    display: block;
    position: absolute;
    left: 0;
    top: 10px;
    height: 2px;
    width: 34px;
    background: var(--brown);
    border-radius: 1000px;
    transform: translateX(0);
    transition: width 0.1s linear;
  }

{% endstylesheet %}
