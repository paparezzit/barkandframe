<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>

<dialog-component
  id="search-modal"
  class="search-modal"
  {{ block.shopify_attributes }}
>
  <dialog
    ref="dialog"
    on:click="/closeDialogOnClickOutside"
    on:keydown="/closeDialogOnEscapePress"
    class="search-modal__content dialog-modal"
    scroll-lock
  >
    {% render 'predictive-search',
      input_id: 'cmdk-input',
      search_test_id: 'search-component--modal',
      products_test_id: 'products-list-default--modal',
      load_empty_state: true
    %}
  </dialog>
</dialog-component>

<script>
  (() => {
    const modal = document.getElementById('search-modal');
    if (!modal || modal.dataset.scrollFallbackBound === 'true') return;
    modal.dataset.scrollFallbackBound = 'true';

    let touchStartY = 0;
    let touchStartScrollTop = 0;
    let activeScroller = null;

    const getScroller = () =>
      modal.querySelector('.predictive-search-form__content') ||
      modal.querySelector('.search-modal__content');

    const canScroll = (scroller) => scroller && scroller.scrollHeight > scroller.clientHeight + 1;

    modal.addEventListener('touchstart', (event) => {
      activeScroller = getScroller();
      if (!canScroll(activeScroller) || !event.touches.length) return;
      touchStartY = event.touches[0].clientY;
      touchStartScrollTop = activeScroller.scrollTop;
    }, { passive: true });

    modal.addEventListener('touchmove', (event) => {
      if (!canScroll(activeScroller) || !event.touches.length) return;
      activeScroller.scrollTop = touchStartScrollTop + touchStartY - event.touches[0].clientY;
      event.preventDefault();
      event.stopPropagation();
    }, { passive: false });

    modal.addEventListener('wheel', (event) => {
      const scroller = getScroller();
      if (!canScroll(scroller)) return;
      scroller.scrollTop += event.deltaY;
      event.preventDefault();
      event.stopPropagation();
    }, { passive: false });
  })();
</script>

{% stylesheet %}
  /* Search modal style */
  .search-modal {
    --search-border-radius: 40px;
    --search-border-width: var(--style-border-width);
  }

  .search-modal__button {
    display: flex;
    align-items: center;
    justify-content: center;

    svg{
      width: 20px;
      height: 20px;
    }
  }

  .search-modal__content {
    /* Approx set the top so when the content is at max height, the modal is centered */
    --search-modal-inner-gap: var(--padding-xl);
    --search-modal-viewport-gap: clamp(16px, 4vw, 48px);
    --modal-top-margin: max(20px, calc((100vh - var(--modal-max-height)) / 2 - 2rem));

    position: fixed;
    inset-block-start: var(--modal-top-margin);
    inset-inline: var(--search-modal-viewport-gap);
    width: auto;
    inline-size: auto;
    max-width: 1020px;
    max-inline-size: 1020px;
    margin: 0 auto;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--search-border-radius) !important;
    background: #fffaf1;
    color: #4c443f;
    box-sizing: border-box;
    overflow: hidden;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    overscroll-behavior-x: contain;

    @media screen and (min-width: 750px) {
      height: min(var(--modal-max-height), calc(100dvh - (var(--modal-top-margin) * 2)));
      block-size: min(var(--modal-max-height), calc(100dvh - (var(--modal-top-margin) * 2)));
      max-height: calc(100vh - (var(--modal-top-margin) * 2));
      max-block-size: calc(100dvh - (var(--modal-top-margin) * 2));
    }

    @media screen and (max-width: 749px) {
      inset: 0;
      width: auto;
      inline-size: auto;
      max-width: none;
      max-inline-size: none;
      height: auto;
      block-size: auto;
      max-height: none;
      max-block-size: none;
      margin: 0;
    }
  }

  .search-modal__content:focus,
  .search-modal__content:focus-visible {
    outline: none;
  }

  .search-modal__content[open],
  .dialog-modal[open].search-modal__content,
  .dialog-modal.search-modal__content.dialog-closing {
    border-radius: var(--search-border-radius) !important;
  }

  .search-modal__content predictive-search-component,
  .search-modal__content .predictive-search-form,
  .search-modal__content .predictive-search-form__content,
  .search-modal__content .predictive-search-form__content-wrapper,
  .search-modal__content .predictive-search-form__header,
  .search-modal__content .predictive-search-form__header-inner {
    min-width: 0;
    max-width: 100%;
    background: #fffaf1;
    color: #4c443f;
    overflow-x: hidden;
  }

  .search-modal__content predictive-search-component,
  .search-modal__content .predictive-search-form,
  .search-modal__content .predictive-search-form__content-wrapper,
  .search-modal__content .predictive-search-dropdown {
    border-radius: inherit;
  }

  .search-modal__content predictive-search-component,
  .search-modal__content .predictive-search-form {
    overflow: hidden;
  }

  .search-modal__content .predictive-search-form__header,
  .search-modal__content .predictive-search-form__header-inner {
    border-color: transparent !important;
  }

  .search-modal__content .predictive-search-form__header {
    border: 0 !important;
    padding: var(--search-modal-inner-gap) var(--search-modal-inner-gap) 0;
  }

  .search-modal__content .predictive-search-form__header-inner {
    border-radius: 999px !important;
    overflow: hidden;
  }

  .search-modal__content .predictive-search-form__header-inner:focus-within,
  .search-modal__content .predictive-search-form__header-inner:has(.search-input:is(:focus, :focus-visible)) {
    background: #f4efe5;
    border-radius: 999px !important;
    outline: none;
  }

  .search-modal__content .search-input {
    border-radius: 999px !important;
  }

  .search-modal__content .search-input,
  .search-modal__content .predictive-search-results__inner,
  .search-modal__content :is(.predictive-search__reset-button, .predictive-search__close-modal-button) {
    color: #4c443f;
  }

  .search-modal__content .search-input::placeholder {
    color: rgb(76 68 63 / 70%);
  }

  .search-modal__content .predictive-search-results__title {
    font-family: var(--baf-display-family);
    font-size: var(--baf-display-small-size);
    font-weight: var(--baf-display-weight);
    line-height: var(--line-height--display);
  }

  .search-modal__content .resource-card[data-resource-type='product'] .resource-card__title {
    font-family: var(--baf-text-bold-family);
    font-size: var(--baf-text-bold-medium-size);
    font-weight: var(--baf-text-bold-weight);
    line-height: var(--line-height--body);
  }

  .search-modal__content .predictive-search-results__inner > * + * {
    margin-block-start: 40px;
  }

  .search-modal__content :is(
    .predictive-search-dropdown,
    .predictive-search-results__inner,
    .predictive-search-results__products,
    .recently-viewed-wrapper,
    .predictive-search-results__wrapper,
    .predictive-search-results__wrapper-products,
    .predictive-search-results__card,
    .resource-card,
    slideshow-component,
    slideshow-slides
  ) {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .search-modal__content :is(
    .predictive-search-form__content,
    .predictive-search-results__products,
    .recently-viewed-wrapper,
    .predictive-search-results__wrapper,
    .predictive-search-results__wrapper-products
  ) {
    overflow-x: hidden !important;
    overscroll-behavior-x: contain;
    touch-action: pan-y;
  }

  .search-modal__content .predictive-search-results__wrapper {
    scroll-snap-type: none;
  }

  .search-modal__content .predictive-search-results__products > .recently-viewed-wrapper + .predictive-search-results__title,
  .search-modal__content :is(.predictive-search-results__products, .predictive-search-results__wrapper, slideshow-component)
    + :is(.predictive-search-results__products, .predictive-search-results__wrapper, slideshow-component) {
    margin-block-start: 40px;
  }

  .search-modal__content .predictive-search__icon {
    left: calc(var(--search-modal-inner-gap) + var(--margin-xl));

    @media screen and (min-width: 750px) {
      left: calc(var(--search-modal-inner-gap) + var(--margin-md));
    }
  }

  .search-modal__content .predictive-search__reset-button-icon:hover,
  .search-modal__content .predictive-search__close-modal-button:hover {
    background-color: #f9f3ea;
    border-radius: 15px;
  }

  .search-modal__content .predictive-search-results__pill:focus,
  .search-modal__content .predictive-search-results__pill:hover,
  .search-modal__content .predictive-search-results__card--query:is([aria-selected='true'], :focus-within) .predictive-search-results__pill {
    background-color: #f9f3ea;
    border-radius: 15px;
    outline: none;
    border-color: transparent;
  }

  .search-modal__content .predictive-search-results__clear:hover {
    background-color: transparent;
  }

  .search-modal__content predictive-search-component {
    --product-corner-radius: 15px;
    --card-corner-radius: 15px;
    --resource-card-corner-radius: 15px;
  }

  .search-modal__content .predictive-search-results__card {
    border-radius: 15px;
    overflow: visible;
  }

  .search-modal__content .predictive-search-results__card:is(:hover, :focus-within, [aria-selected='true']) {
    background-color: transparent;
    border-radius: 0;
    margin: 0;
    overflow: visible;
    padding: 0;
  }

  .search-modal__content .predictive-search-results__card--product:hover,
  .search-modal__content .predictive-search-results__card--product:is([aria-selected='true'].keyboard-focus, :focus-visible, :has(.resource-card:focus-visible)) {
    background-color: transparent;
    border-color: transparent;
    border-radius: 0;
    margin: 0;
    outline: none;
    padding: 0;
  }

  .search-modal__content :is(
    .resource-card,
    .resource-card__media,
    .resource-card__image,
    .resource-card__image--secondary,
    .resource-card__image-placeholder,
    .resource-card__image-wrapper,
    .resource-card__collection-image
  ) {
    border-radius: 15px;
  }

  .search-modal__content :is(
    .resource-card__media,
    .resource-card__image-wrapper
  ) {
    overflow: hidden;
  }

  .search-modal__content .resource-card:is(
    [data-product-handle='framed-canvas-1'],
    [data-product-handle='canvas-framed'],
    [data-product-handle='unframed-canvas'],
    [data-product-handle='canvas-unframed'],
    [data-product-handle='framed-poster'],
    [data-product-handle='fine-art-paper-framed']
  ) .resource-card__media {
    background: var(--cream);
    aspect-ratio: var(--resource-card-aspect-ratio, 4 / 5);
  }

  .search-modal__content .resource-card:is(:hover, :focus-within) .resource-card__image {
    opacity: 1 !important;
  }

  .search-modal__content .resource-card:is(:hover, :focus-within) .resource-card__image--secondary {
    opacity: 0 !important;
  }

  /* Hide the default dialog backdrop on small screens */
  @media screen and (max-width: 749px) {
    .search-modal__content::backdrop {
      display: none;
    }
  }

  .search-modal__content::backdrop {
    background: rgba(255, 255, 255, 0.81);
    backdrop-filter: none;
  }

  .search-modal__content[open]::backdrop {
    animation: none;
  }

  .dialog-modal[open].search-modal__content {
    transform-origin: bottom center;
    animation: search-element-slide-in-bottom 300ms var(--ease-out-quad) forwards;
    border-radius: var(--search-border-radius);
    box-shadow: var(--shadow-popover);
  }

  .dialog-modal.search-modal__content.dialog-closing {
    animation: search-element-slide-out-bottom 200ms var(--ease-out-quad) forwards;
  }

  .search-modal__content[open] {
    display: flex;
    flex-direction: column;
  }

  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .search-modal__content .predictive-search__close-modal-button {
      display: flex !important;
      flex: 0 0 var(--minimum-touch-target);
    }
  }

  .search-modal__content :is(.predictive-search-dropdown, .predictive-search-form__content-wrapper) {
    position: relative;
    inset: auto;
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
  }

  .search-modal__content predictive-search-component,
  .search-modal__content .predictive-search-form {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
    max-height: 100%;
  }

  .search-modal__content .predictive-search-form__header {
    flex: 0 0 auto;
  }

  .search-modal__content .predictive-search-form__content-wrapper {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    max-height: none;
    overflow: hidden;
  }

  .search-modal__content .predictive-search-form__content {
    flex: 1 1 auto;
    min-height: 0;
    max-height: none;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  .search-modal__content .predictive-search-results__inner {
    overflow: visible;
  }

  .search-modal__content .predictive-search-form__footer {
    background: #fffaf1;
    background-image: none !important;
  }

  /* Predictive search header tweaks for small screens */
  @media screen and (max-width: 749px) {
    .dialog-modal
      .predictive-search-form__header:has(
        .predictive-search__reset-button:not(.predictive-search__reset-button[hidden])
      )::before {
      content: '';
      position: absolute;
      right: calc(var(--padding-sm) + var(--minimum-touch-target));
      top: 0;
      bottom: 0;
      width: var(--border-width-sm);
      background-color: var(--color-border);
    }

    .dialog-modal
      .predictive-search-form__header:has(
        .predictive-search__reset-button:not(.predictive-search__reset-button[hidden])
      )
      > .predictive-search__close-modal-button {
      &::before {
        content: none;
      }
    }
  }

  @media screen and (max-width: 749px), screen and (min-width: 750px) and (max-width: 989px) and (orientation: portrait) {
    .search-modal {
      --search-border-radius: 0;
    }

    .search-modal__content,
    .dialog-modal[open].search-modal__content,
    .dialog-modal.search-modal__content.dialog-closing {
      --search-modal-inner-gap: clamp(16px, 5vw, 28px);

      position: fixed !important;
      inset: 0 !important;
      width: 100vw !important;
      inline-size: 100vw !important;
      max-width: 100vw !important;
      max-inline-size: 100vw !important;
      height: 100dvh !important;
      block-size: 100dvh !important;
      max-height: 100dvh !important;
      max-block-size: 100dvh !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: #fffaf1;
      box-shadow: none !important;
      overflow: hidden !important;
      transform: none !important;
      animation: none !important;
    }

    .search-modal__content::backdrop {
      display: none !important;
    }

    .search-modal__content[open] {
      display: flex !important;
      flex-direction: column;
    }

    .search-modal__content predictive-search-component,
    .search-modal__content .predictive-search-form {
      display: flex !important;
      flex: 1 1 auto;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      height: 100%;
      min-height: 0;
      max-height: none;
      overflow: hidden !important;
      border-radius: 0 !important;
    }

    .search-modal__content .predictive-search-form__header {
      flex: 0 0 auto;
      position: relative;
      top: auto;
      padding: max(16px, env(safe-area-inset-top)) var(--search-modal-inner-gap) 0;
      background: #fffaf1;
      border: 0 !important;
      border-radius: 0 !important;
    }

    .search-modal__content .predictive-search-form__header-inner {
      min-height: 56px;
      border-radius: 999px !important;
      background: #f4efe5;
      overflow: hidden;
    }

    .search-modal__content .search-input {
      min-height: 56px;
      font-size: 16px !important;
      line-height: 1.3;
      border-radius: 999px !important;
    }

    .search-modal__content .predictive-search__close-modal-button {
      display: flex !important;
      flex: 0 0 var(--minimum-touch-target);
    }

    .search-modal__content .predictive-search__icon {
      left: calc(var(--search-modal-inner-gap) + var(--margin-md));
    }

    .search-modal__content .predictive-search-form__content-wrapper {
      position: static !important;
      inset: auto !important;
      display: flex;
      flex: 1 1 auto;
      min-height: 0;
      max-height: none !important;
      border-radius: 0 !important;
      overflow: hidden !important;
      transform: none !important;
    }

    .search-modal__content .predictive-search-form__content {
      display: block;
      flex: 1 1 auto;
      width: 100%;
      min-height: 0;
      height: auto;
      max-height: none !important;
      overflow-x: hidden !important;
      overflow-y: auto !important;
      -webkit-overflow-scrolling: touch;
      padding: 0 var(--search-modal-inner-gap) max(32px, env(safe-area-inset-bottom));
      overscroll-behavior: contain;
      touch-action: pan-y;
    }

    .search-modal__content .predictive-search-results__inner {
      overflow: visible;
      padding-block: 32px;
    }

    .search-modal__content .predictive-search-form__footer {
      position: sticky;
      bottom: 0;
      padding: 12px var(--search-modal-inner-gap) max(16px, env(safe-area-inset-bottom));
      background: #fffaf1;
    }
  }

{% endstylesheet %}
