<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>

<dialog-component
  id="search-modal"
  class="search-modal"
  {{ block.shopify_attributes }}
>
  <dialog
    ref="dialog"
    on:click="/closeDialogOnClickOutside"
    on:keydown="/closeDialogOnEscapePress"
    class="search-modal__content dialog-modal"
    scroll-lock
  >
    {% render 'predictive-search',
      input_id: 'cmdk-input',
      search_test_id: 'search-component--modal',
      products_test_id: 'products-list-default--modal',
      load_empty_state: true
    %}
  </dialog>
</dialog-component>

{% stylesheet %}
  /* Search modal style */
  .search-modal {
    --search-border-radius: 40px;
    --search-border-width: var(--style-border-width);
  }

  .search-modal__button {
    display: flex;
    align-items: center;
    justify-content: center;

    svg{
      width: 20px;
      height: 20px;
    }
  }

  .search-modal__content {
    /* Approx set the top so when the content is at max height, the modal is centered */
    --search-modal-inner-gap: var(--padding-xl);
    --modal-top-margin: calc(50dvh - var(--modal-max-height) / 2 - 2rem);
    --modal-width: 66dvw;

    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--search-border-radius);
    background: #fffaf1;
    color: #4c443f;
    overflow: hidden;

    @media screen and (min-width: 750px) {
      width: var(--modal-width);
      margin-block-start: var(--modal-top-margin);
    }
  }

  .search-modal__content predictive-search-component,
  .search-modal__content .predictive-search-form__content,
  .search-modal__content .predictive-search-form__content-wrapper,
  .search-modal__content .predictive-search-form__header,
  .search-modal__content .predictive-search-form__header-inner {
    background: #fffaf1;
    color: #4c443f;
  }

  .search-modal__content .predictive-search-form__header,
  .search-modal__content .predictive-search-form__header-inner {
    border-color: transparent !important;
  }

  .search-modal__content .predictive-search-form__header {
    border: 0 !important;
    padding: var(--search-modal-inner-gap) var(--search-modal-inner-gap) 0;
  }

  .search-modal__content .predictive-search-form__header-inner {
    border-radius: 10px;
  }

  .search-modal__content .predictive-search-form__header-inner:focus-within {
    background: #f4efe5;
    outline: none;
  }

  .search-modal__content .search-input,
  .search-modal__content .predictive-search-results__inner,
  .search-modal__content :is(.predictive-search__reset-button, .predictive-search__close-modal-button) {
    color: #4c443f;
  }

  .search-modal__content .search-input::placeholder {
    color: rgb(76 68 63 / 70%);
  }

  .search-modal__content .predictive-search-results__title {
    font-family: var(--baf-display-family);
    font-size: var(--baf-display-small-size);
    font-weight: var(--baf-display-weight);
    line-height: var(--line-height--display);
  }

  .search-modal__content .resource-card[data-resource-type='product'] .resource-card__title {
    font-family: var(--baf-text-bold-family);
    font-size: var(--baf-text-bold-medium-size);
    font-weight: var(--baf-text-bold-weight);
    line-height: var(--line-height--body);
  }

  .search-modal__content .predictive-search-results__inner > * + * {
    margin-block-start: 40px;
  }

  .search-modal__content .predictive-search__icon {
    left: calc(var(--search-modal-inner-gap) + var(--margin-xl));

    @media screen and (min-width: 750px) {
      left: calc(var(--search-modal-inner-gap) + var(--margin-md));
    }
  }

  .search-modal__content .predictive-search__reset-button-icon:hover,
  .search-modal__content .predictive-search__close-modal-button:hover {
    background-color: #f9f3ea;
    border-radius: 15px;
  }

  .search-modal__content .predictive-search-results__pill:focus,
  .search-modal__content .predictive-search-results__pill:hover,
  .search-modal__content .predictive-search-results__card--query:is([aria-selected='true'], :focus-within) .predictive-search-results__pill {
    background-color: #f9f3ea;
    border-radius: 15px;
    outline: none;
    border-color: transparent;
  }

  .search-modal__content .predictive-search-results__clear:hover {
    background-color: transparent;
  }

  .search-modal__content predictive-search-component {
    --product-corner-radius: 15px;
    --card-corner-radius: 15px;
    --resource-card-corner-radius: 15px;
  }

  .search-modal__content .predictive-search-results__card {
    border-radius: 15px;
    overflow: visible;
  }

  .search-modal__content .predictive-search-results__card:is(:hover, :focus-within, [aria-selected='true']) {
    background-color: transparent;
    border-radius: 0;
    margin: 0;
    overflow: visible;
    padding: 0;
  }

  .search-modal__content .predictive-search-results__card--product:hover,
  .search-modal__content .predictive-search-results__card--product:is([aria-selected='true'].keyboard-focus, :focus-visible, :has(.resource-card:focus-visible)) {
    background-color: transparent;
    border-color: transparent;
    border-radius: 0;
    margin: 0;
    outline: none;
    padding: 0;
  }

  .search-modal__content :is(
    .resource-card,
    .resource-card__media,
    .resource-card__image,
    .resource-card__image--secondary,
    .resource-card__image-placeholder,
    .resource-card__image-wrapper,
    .resource-card__collection-image
  ) {
    border-radius: 15px;
  }

  .search-modal__content :is(
    .resource-card__media,
    .resource-card__image-wrapper
  ) {
    overflow: hidden;
  }

  .search-modal__content .resource-card:is(:hover, :focus-within) .resource-card__image {
    opacity: 1 !important;
  }

  .search-modal__content .resource-card:is(:hover, :focus-within) .resource-card__image--secondary {
    opacity: 0 !important;
  }

  /* Hide the default dialog backdrop on small screens */
  @media screen and (max-width: 749px) {
    .search-modal__content::backdrop {
      display: none;
    }
  }

  .dialog-modal[open].search-modal__content {
    transform-origin: bottom center;
    animation: search-element-slide-in-bottom 300ms var(--ease-out-quad) forwards;
    border-radius: var(--search-border-radius);
    box-shadow: var(--shadow-popover);
  }

  .dialog-modal.search-modal__content.dialog-closing {
    animation: search-element-slide-out-bottom 200ms var(--ease-out-quad) forwards;
  }

  .search-modal__content[open] {
    display: flex;
  }

  .search-modal__content :is(.predictive-search-dropdown, .predictive-search-form__content-wrapper) {
    position: relative;
  }

  /* Predictive search header tweaks for small screens */
  @media screen and (max-width: 749px) {
    .dialog-modal
      .predictive-search-form__header:has(
        .predictive-search__reset-button:not(.predictive-search__reset-button[hidden])
      )::before {
      content: '';
      position: absolute;
      right: calc(var(--padding-sm) + var(--minimum-touch-target));
      top: 0;
      bottom: 0;
      width: var(--border-width-sm);
      background-color: var(--color-border);
    }

    .dialog-modal
      .predictive-search-form__header:has(
        .predictive-search__reset-button:not(.predictive-search__reset-button[hidden])
      )
      > .predictive-search__close-modal-button {
      &::before {
        content: none;
      }
    }
  }
{% endstylesheet %}
