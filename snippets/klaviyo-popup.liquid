{%- liquid
  assign klaviyo_public_key = 'V6mwd3'
  assign klaviyo_list_id    = 'XGb23F'
  assign popup_delay_ms     = settings.klaviyo_popup_delay | times: 1000 | default: 3000
  assign show_klaviyo_sticky = false
  if template.name == 'index'
    assign show_klaviyo_sticky = true
  endif
-%}

{%- if settings.klaviyo_popup_enabled -%}

<dialog
  id="klav-popup"
  class="klav-popup"
  aria-label="Get 10% off your first order"
>
  <!-- Logo -->
  <div class="klav-popup__brand">
    {%- if settings.logo != blank -%}
      {{- settings.logo | image_url: width: 160 | image_tag: loading: 'lazy', class: 'klav-popup__brand-img' -}}
    {%- else -%}
      <span class="klav-popup__brand-text">{{ shop.name }}</span>
    {%- endif -%}
  </div>

  <div class="klav-popup__inner">
    <div class="klav-popup__col klav-popup__col--content">
      <button
        class="klav-popup__close"
        id="klav-close-btn"
        type="button"
        aria-label="Close"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>

      <!-- Step 1: Offer prompt -->
      <div id="klav-step-1" class="klav-step">
        <div class="klav-step__icon" aria-hidden="true">
          <svg width="57" height="39" viewBox="0 0 57 39" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M56.3479 4.56847C55.3231 3.87238 53.4111 3.55914 52.0621 2.94427C51.1194 2.51501 49.9943 3.00016 49.7779 4.00316C49.7363 4.19512 49.715 4.39445 49.7128 4.59273C49.7075 4.98191 50.1394 6.15682 50.0253 6.30659L47.1673 7.50048C46.6725 7.01216 46.3782 6.28655 45.8951 5.72651C43.035 2.41376 38.168 2.68165 34.5785 4.60644C32.8701 5.5219 31.6331 6.92041 30.2926 8.27673C28.9458 4.75199 25.3733 1.93283 21.8734 0.595495C17.258 -1.16687 10.7978 1.04162 10.3734 6.43737C10.0566 10.4768 13.9821 18.273 16.1042 21.783C16.4262 22.3166 17.0927 23.1055 17.3305 23.6202C17.3775 23.7225 17.4638 23.7594 17.3913 23.9124L11.106 27.3053C9.78364 26.4436 7.92918 26.1451 6.30398 26.2506C4.42392 26.3719 1.25992 26.3582 0.328949 27.9908C-0.977389 30.2816 1.89976 32.4964 3.83314 32.4521C3.13464 33.8685 2.45428 35.1225 2.84245 36.7583C3.37032 38.9816 5.33463 39.6851 7.1667 38.2592C8.96572 36.8596 10.2934 34.3463 11.0367 32.2422C11.2254 31.7075 11.347 30.6391 11.6786 30.2837L19.1797 26.4668L19.3226 26.51C19.6276 27.203 20.1725 27.9043 20.6406 28.5245C21.9694 30.2868 26.0644 35.8313 27.8346 36.5843C28.5213 36.8765 29.3446 37.0958 30.057 36.7626C31.5243 36.076 34.7928 32.5417 36.0192 31.2181C39.8646 27.0701 43.6919 22.2734 46.0956 17.1424C47.1929 14.7999 47.6728 12.5619 47.6301 9.97371L51.2911 8.88211C51.6313 8.9011 51.7432 9.45691 51.9885 9.73851C52.5526 10.385 53.3503 10.5749 54.0435 10.018C54.4946 9.65519 56.6892 6.84553 56.8801 6.36459C57.152 5.67694 56.9558 4.97769 56.349 4.56531L56.3479 4.56847ZM42.1531 17.2151C38.8857 23.3439 34.0442 28.3462 29.1868 33.2442C28.917 33.4213 28.6728 33.0469 28.4702 32.8666C26.5261 31.1358 24.1672 28.0383 22.574 25.9205C22.4535 25.7612 21.883 25.0514 22.0088 24.9227L29.7861 21.1617C30.6093 20.6861 31.7408 19.6936 31.1703 18.6453C30.3449 17.1276 27.2768 18.7381 26.1859 19.2644C24.196 20.2241 22.2946 21.3969 20.2834 22.3229C20.1938 22.3704 20.1448 22.3451 20.0691 22.2892C19.8782 22.1489 18.7723 20.5026 18.5494 20.1661C16.5563 17.1571 12.9615 10.4019 12.9359 6.85818C12.9178 4.41976 15.6531 2.89048 17.8648 2.7597C20.9072 2.57935 25.6186 5.79296 27.2086 8.31891C27.6767 9.06352 28.4851 11.3912 29.1612 11.6696C29.6752 11.8816 30.3236 11.8521 30.7981 11.5642C33.3596 8.79035 37.944 4.97241 42.0315 6.7949C46.0284 8.57731 43.6183 14.4614 42.1521 17.213L42.1531 17.2151Z" fill="#4C443F"/>
          </svg>
        </div>
        <h2 class="klav-step__heading">Welcome, dog person</h2>
        <p class="klav-step__text">
          10% off your first order. We’ll email the code.
        </p>
        <button class="klav-btn klav-btn--primary" id="klav-yes-btn" type="button">Send me the code</button>
      </div>

      <!-- Step 2: Email input -->
      <div id="klav-step-2" class="klav-step" hidden>
        <h2 class="klav-step__heading">Enter your email<br>to get your discount</h2>
        <form id="klav-form" class="klav-form" novalidate>
          <input
            type="email"
            id="klav-email-input"
            class="klav-form__input"
            placeholder="your@email.com"
            autocomplete="email"
            required
          >
          <button class="klav-btn klav-btn--primary" type="submit">Get 10% off</button>
          <p class="klav-form__error" id="klav-error" hidden>Something went wrong, please try again.</p>
        </form>
      </div>

      <!-- Step 3: Success -->
      <div id="klav-step-3" class="klav-step" hidden>
        <div class="klav-step__icon" aria-hidden="true">
          <svg width="46" height="46" viewBox="0 0 46 46" fill="none">
            <circle cx="23" cy="23" r="18" stroke="currentColor" stroke-width="1.5"/>
            <path d="M14 23l7 7 11-13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2 class="klav-step__heading">You’re in!</h2>
        <p class="klav-step__subtext">Check your inbox for<br>your 10% discount code.</p>
        <button class="klav-btn klav-btn--primary" id="klav-done-btn" type="button">Continue shopping</button>
      </div>

    </div>
  </div>
</dialog>

<!-- Sticky reopener (shown after popup is dismissed) -->
{%- if show_klaviyo_sticky -%}
  <div class="klav-sticky" id="klav-sticky" hidden>
    <button class="klav-sticky__open" id="klav-sticky-open" type="button">
      Your <br>welcome <br>offer
    </button>
    <button class="klav-sticky__dismiss" id="klav-sticky-dismiss" type="button" aria-label="Hide offer">×</button>
  </div>
{%- endif -%}

<style>
.klav-popup{
  padding: 0;
  border: none;
  border-radius: 36px;
  max-width: 520px;
  width: calc(100vw - 2rem);
  overflow: hidden;
  background: transparent;
  background-color: var(--beige);
}

.klav-popup::backdrop {
  background: rgb(255 255 255 / 0.45);
}

.klav-popup__inner {
  display: block;
  background-color: color-mix(in srgb, var(--purple) 45%, transparent);
}

/* Image column */
.klav-popup__col--image {
  overflow: hidden;
  display: none;
}


.klav-popup__portrait-wrap {
  flex: 1;
  display: flex;
  align-items: flex-end;
  width: 100%;
}

.klav-popup__portrait {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 40px;
  object-fit: cover;
}

/* Content column */
.klav-popup__col--content {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 430px;
  padding: 70px 48px 52px;
  position: relative;
  box-sizing: border-box;
}

/* Brand logo in content column */
.klav-popup__brand {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 40px;
  background-color: var(--beige);
  border-radius: 0 0 1000px 1000px;
  text-align: center;
}

.klav-popup__brand-img {
  height: 30px;
  width: auto;
  display: block;
  margin: 3px auto 0;
}

.klav-popup__brand-text {
  font-family: var(--font-heading--family);
  font-size: var(--font-size--sm);
  color: var(--brown);
  text-transform: lowercase;
}

/* Close button */
.klav-popup__close {
  position: absolute;
  top: 20px;
  right: 20px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--brown);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s, color .2s;
  border-radius: 50%;
  background-color: var(--purple);
  padding: 10px;
}

.klav-popup__close:hover {
  background-color: var(--brown);
  color: var(--beige);
}

/* Steps */
.klav-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 32px;
  width: 100%;
}

.klav-step[hidden] { display: none; }

.klav-step__icon {
  color: var(--brown);
  line-height: 0;
  margin: 10px 0 -8px;
}

.klav-step__heading {
  font-family: var(--font-heading--family);
  font-size: 36px;
  font-weight: var(--font-h2--weight, 400);
  color: var(--brown);
  line-height: 1;
  margin: 0;
}

.klav-step__text {
  font-size: 18px;
  color: var(--brown);
  margin: 0;
  line-height: 1.25;
}

.klav-step__subtext {
  font-size: 18px;
  color: var(--brown);
  margin: 0;
  line-height: 1.25;
}

/* Buttons */
.klav-btn {
  border: none;
  cursor: pointer;
  font-family: var(--font-body--family);
  font-size: 18px;
  transition: background 0.2s, color .2s;
  width: 100%;

}

.klav-btn--primary {
  color: var(--brown);
  border-radius: 100px;
  padding: 0.875rem 1.5rem;
  font-weight: 700;
  background: var(--purple);
}

.klav-btn--primary:hover {
  background-color: var(--brown);
  color: var(--beige);
}

.klav-btn--primary:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}


/* Form */
.klav-form {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  width: 100%;
}

.klav-form__input {
  width: 100%;
  padding: 0.875rem 1.25rem;
  border: 1.5px solid rgb(76 68 63 / 0.25);
  border-radius: 100px;
  background: rgb(255 255 255 / 0.5);
  font-family: var(--font-body--family);
  font-size: var(--font-size--sm);
  color: var(--brown);
  outline: none;
  transition: border-color 0.15s, background 0.15s;
  box-sizing: border-box;
}

.klav-form__input:focus {
  border-color: var(--brown);
  background: rgb(255 255 255 / 0.8);
}

.klav-form__input::placeholder { opacity: 0.4; }

.klav-form__error {
  font-size: var(--font-size--xs);
  color: var(--color-error, #8B0000);
  margin: 0;
  text-align: center;
}

.klav-form__error[hidden] { display: none; }

/* ================================================
   Sticky tab
================================================ */
.klav-sticky {
  position: fixed;
  left: 0;
  top: 80px;
  z-index: calc(var(--layer-overlay, 16) - 1);
  display: flex;
  align-items: center;
  gap: 0.25rem;
  background: var(--purple);
  border-radius: 0 1000px 1000px 0;
  padding: 15px 20px;
  transform: translateX(0);
  transition: transform 0.4s ease, padding-left 0.2s ease;
}

.klav-sticky[hidden] { display: none; }

.klav-sticky--out {
  transform: translateX(calc(-100% - 2px));
}

.klav-sticky__open {
  
  color: var(--brown);
  border: none;
  
  font-family: var(--font-body--family);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  cursor: pointer;
  line-height: 1;
  text-align: left;
  background-color: transparent;
  
}

.klav-sticky:hover { padding-left: 30px; }

.klav-sticky__dismiss {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 14px;
  color: var(--brown);
  padding: 5px;
  line-height: 1;
  transition: opacity 0.15s;
  font-weight: 700;
}

.klav-sticky__dismiss:hover { opacity: 0.9; }

#klav-step-3 .klav-step__icon{
  margin: 20px 0 -10px;
}

@media(max-width: 749px){
  .klav-sticky {
    top: 50svh;
    transform: translateY(-50%);
  }

  .klav-sticky--out {
    transform: translate(calc(-100% - 2px), -50%);
  }
}

@media(max-width: 1559px){
  body {
    --klav-sticky-bar-height: calc(var(--header-height, 60px) * 2 / 3);
  }

  html.klav-sticky-visible body {
    padding-top: var(--klav-sticky-bar-height);
  }

  html.klav-sticky-visible .header[transparent] {
    top: var(--klav-sticky-bar-height);
  }

  html.klav-sticky-visible .header-section:has(> #header-component[sticky='always']),
  html.klav-sticky-visible .header-section:has(> #header-component[sticky='scroll-up'][data-sticky-state='active']) {
    top: calc(var(--klav-sticky-bar-height) - 1px);
  }

  .klav-sticky {
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    min-height: var(--klav-sticky-bar-height);
    justify-content: center;
    box-sizing: border-box;
    border-radius: 0;
    padding: 0 52px 0 18px;
    transform: translateY(0);
    z-index: calc(var(--layer-overlay, 16) + 2);
  }

  .klav-sticky--out {
    transform: translateY(-100%);
  }

  .klav-sticky:hover {
    padding-left: 18px;
  }

  .klav-sticky__open {
    width: 100%;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .klav-sticky__open br {
    display: none;
  }

  .klav-sticky__dismiss {
    position: absolute;
    top: 50%;
    right: 16px;
    transform: translateY(-50%);
    font-size: 20px;
  }
}

@media(min-width: 750px){
  .klav-popup{
    border-radius: 56px;
  }

  .klav-popup__close{
    right: 32px;
    top: 32px;
  }
}

@media(min-width: 1560px){
  .klav-sticky {
    top: 0;
  }
}

</style>

<script>
(function () {
  var PUBLIC_KEY  = {{ klaviyo_public_key | json }};
  var LIST_ID     = {{ klaviyo_list_id | json }};
  var DELAY_MS    = {{ popup_delay_ms }};
  var STORAGE_KEY = 'bnf_klav_v1';

  var popup  = document.getElementById('klav-popup');
  var sticky = document.getElementById('klav-sticky');
  var step1  = document.getElementById('klav-step-1');
  var step2  = document.getElementById('klav-step-2');
  var step3  = document.getElementById('klav-step-3');

  function getState() {
    try { return localStorage.getItem(STORAGE_KEY); } catch (e) { return null; }
  }
  function setState(s) {
    try { localStorage.setItem(STORAGE_KEY, s); } catch (e) {}
  }

  function showStep(el) {
    [step1, step2, step3].forEach(function (s) { s.hidden = true; });
    el.hidden = false;
  }

  function stickySlideOut() {
    if (!sticky) return;
    document.documentElement.classList.remove('klav-sticky-visible');
    if (sticky.hidden) return;
    sticky.classList.add('klav-sticky--out');
  }

  function stickySlideIn() {
    if (!sticky) return;
    sticky.classList.add('klav-sticky--out');
    sticky.hidden = false;
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        sticky.classList.remove('klav-sticky--out');
        document.documentElement.classList.add('klav-sticky-visible');
      });
    });
  }

  function openPopup() {
    showStep(step1);
    popup.showModal();
    stickySlideOut();
  }

  function closePopup(newState) {
    popup.close();
    if (newState) setState(newState);
    if (newState !== 'subscribed' && newState !== 'hidden') {
      stickySlideIn();
    }
  }

  function init() {
    var state = getState();
    if (state === 'subscribed' || state === 'hidden') return;
    if (state === 'dismissed') { stickySlideIn(); return; }
    setTimeout(openPopup, DELAY_MS);
  }

  // Close X button
  document.getElementById('klav-close-btn')?.addEventListener('click', function () {
    closePopup('dismissed');
  });

  // Escape key (browser default closes dialog, we just handle state)
  popup?.addEventListener('cancel', function () {
    setState('dismissed');
    stickySlideIn();
  });

  // Click outside dialog
  popup?.addEventListener('click', function (e) {
    if (e.target === popup) closePopup('dismissed');
  });

  // Step 1 buttons
  document.getElementById('klav-yes-btn')?.addEventListener('click', function () {
    showStep(step2);
    document.getElementById('klav-email-input')?.focus();
  });

  document.getElementById('klav-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var email     = document.getElementById('klav-email-input').value.trim();
    var errorEl   = document.getElementById('klav-error');
    var submitBtn = this.querySelector('[type="submit"]');

    if (!email) return;
    submitBtn.disabled = true;
    errorEl.hidden = true;

    fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + PUBLIC_KEY, {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'revision': '2023-12-15' },
      body: JSON.stringify({
        data: {
          type: 'subscription',
          attributes: {
            profile: {
              data: { type: 'profile', attributes: { email: email, properties: { signup_source: 'popup' } } }
            }
          },
          relationships: {
            list: { data: { type: 'list', id: LIST_ID } }
          }
        }
      })
    })
    .then(function (res) {
      if (res.ok || res.status === 202) {
        setState('subscribed');
        showStep(step3);
      } else {
        throw new Error('api');
      }
    })
    .catch(function () {
      errorEl.hidden = false;
      submitBtn.disabled = false;
    });
  });

  // Step 3
  document.getElementById('klav-done-btn').addEventListener('click', function () {
    popup.close();
  });

  // Sticky
  document.getElementById('klav-sticky-open')?.addEventListener('click', openPopup);
  document.getElementById('klav-sticky-dismiss')?.addEventListener('click', function () {
    if (sticky) sticky.hidden = true;
    document.documentElement.classList.remove('klav-sticky-visible');
    setState('hidden');
  });

  init();
})();
</script>

{%- endif -%}
