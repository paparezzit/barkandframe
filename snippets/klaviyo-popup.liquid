{%- liquid
  assign klaviyo_public_key = 'V6mwd3'
  assign klaviyo_list_id    = 'XGb23F'
  assign show_klaviyo_sticky = false
  if template.name == 'index'
    assign show_klaviyo_sticky = true
  endif
-%}

{%- if settings.klaviyo_popup_enabled -%}

<dialog
  id="klav-popup"
  class="klav-popup"
  aria-label="Get 5% off your first order"
>
  <div class="klav-popup__inner">
    <div class="klav-popup__col klav-popup__col--content">
      <button
        class="klav-popup__close"
        id="klav-close-btn"
        type="button"
        aria-label="Close"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>

      <!-- Step 1: Offer prompt -->
      <div id="klav-step-1" class="klav-step">
        <div class="klav-step__illustration-card" aria-hidden="true">
          <img
            src="{{ 'klaviyo-popup-circle.svg' | asset_url }}"
            alt=""
            class="klav-step__illustration"
            width="229"
            height="229"
            loading="lazy"
          >
        </div>
        <h2 class="klav-step__heading klav-step__heading--welcome">Welcome, dog person</h2>
        <p class="klav-step__text">
          5% off your first order. We’ll email the code.
        </p>
        <button class="klav-btn klav-btn--primary" id="klav-yes-btn" type="button">Send me the code</button>
      </div>

      <!-- Step 2: Email input -->
      <div id="klav-step-2" class="klav-step" hidden>
        <div class="klav-step__illustration-card" aria-hidden="true">
          <img
            src="{{ 'klaviyo-popup-circle.svg' | asset_url }}"
            alt=""
            class="klav-step__illustration"
            width="229"
            height="229"
            loading="lazy"
          >
        </div>
        <h2 class="klav-step__heading klav-step__heading--welcome">Enter your email<br>to get your discount</h2>
        <form id="klav-form" class="klav-form" novalidate>
          <input
            type="email"
            id="klav-email-input"
            class="klav-form__input"
            placeholder="your@email.com"
            autocomplete="email"
            required
          >
          <button class="klav-btn klav-btn--primary" type="submit">Get 5% off</button>
          <p class="klav-form__error" id="klav-error" hidden>Something went wrong, please try again.</p>
        </form>
      </div>

      <!-- Step 3: Success -->
      <div id="klav-step-3" class="klav-step" hidden>
        <div class="klav-step__icon" aria-hidden="true">
          <svg width="46" height="46" viewBox="0 0 46 46" fill="none">
            <circle cx="23" cy="23" r="18" stroke="currentColor" stroke-width="1.5"/>
            <path d="M14 23l7 7 11-13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2 class="klav-step__heading">You’re in!</h2>
        <p class="klav-step__subtext">Check your inbox for<br>your 5% discount code.</p>
        <button class="klav-btn klav-btn--primary" id="klav-done-btn" type="button">Continue shopping</button>
      </div>

    </div>
  </div>
</dialog>

<!-- Sticky reopener (shown after popup is dismissed) -->
{%- if show_klaviyo_sticky -%}
  <div class="klav-sticky" id="klav-sticky" hidden>
    <button class="klav-sticky__open" id="klav-sticky-open" type="button">
      Your <br>welcome <br>offer
    </button>
    <button class="klav-sticky__dismiss" id="klav-sticky-dismiss" type="button" aria-label="Hide offer">×</button>
  </div>
{%- endif -%}

<style>
.klav-popup{
  padding: 0;
  border: none;
  border-radius: 36px;
  max-width: 520px;
  width: calc(100vw - 2rem);
  overflow: hidden;
  background: transparent;
  background-color: var(--beige);
}

.klav-popup::backdrop {
  background: rgb(255 255 255 / 0.45);
}

.klav-popup__inner {
  display: block;
  background-color: color-mix(in srgb, var(--purple) 45%, transparent);
}

/* Image column */
.klav-popup__col--image {
  overflow: hidden;
  display: none;
}


.klav-popup__portrait-wrap {
  flex: 1;
  display: flex;
  align-items: flex-end;
  width: 100%;
}

.klav-popup__portrait {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 40px;
  object-fit: cover;
}

/* Content column */
.klav-popup__col--content {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 430px;
  padding: 56px 48px 52px;
  position: relative;
  box-sizing: border-box;
}

/* Close button */
.klav-popup__close {
  position: absolute;
  top: 20px;
  right: 20px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--brown);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s, color .2s;
  border-radius: 50%;
  background-color: var(--purple);
  padding: 10px;
  outline: none !important;
  box-shadow: none !important;
}

.klav-popup__close:focus,
.klav-popup__close:focus-visible {
  outline: none !important;
  box-shadow: none !important;
}

/* Steps */
.klav-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 32px;
  width: 100%;
}

.klav-step[hidden] { display: none; }

.klav-step__icon {
  color: var(--brown);
  line-height: 0;
  margin: 10px 0 -8px;
}

.klav-step__illustration-card {
  width: 176px;
  height: 176px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: -2px 0 -8px;
  padding: 0;
  border-radius: 50%;
  background-color: transparent;
  box-sizing: border-box;
}

.klav-step__illustration {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.klav-step__heading {
  font-family: var(--font-heading--family);
  font-size: 36px;
  font-weight: var(--font-h2--weight, 400);
  color: var(--brown);
  line-height: 1;
  margin: 0;
}

.klav-step__heading--welcome {
  font-family: var(--font-h3--family, var(--font-heading--family));
  font-size: var(--baf-display-medium-size);
  font-weight: var(--font-h3--weight, var(--font-h2--weight, 400));
  line-height: var(--font-h3--line-height, 1);
  letter-spacing: var(--font-h3--letter-spacing, 0);
  text-transform: var(--font-h3--case, none);
}

.klav-step__text {
  font-size: 18px;
  color: var(--brown);
  margin: 0;
  line-height: 1.25;
}

.klav-step__subtext {
  font-size: 18px;
  color: var(--brown);
  margin: 0;
  line-height: 1.25;
}

/* Buttons */
.klav-btn {
  border: none;
  cursor: pointer;
  font-family: var(--font-body--family);
  font-size: 18px;
  transition: background 0.2s, color .2s;
  width: 100%;

}

.klav-btn--primary {
  color: var(--brown);
  border-radius: 100px;
  padding: 0.875rem 1.5rem;
  font-weight: 700;
  background: var(--purple);
}

.klav-btn--primary:hover {
  background-color: var(--brown);
  color: var(--beige);
}

.klav-btn--primary:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}


/* Form */
.klav-form {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  width: 100%;
}

.klav-form__input {
  width: 100%;
  padding: 0.875rem 1.25rem;
  border: 1.5px solid rgb(76 68 63 / 0.25);
  border-radius: 100px;
  background: rgb(255 255 255 / 0.5);
  font-family: var(--font-body--family);
  font-size: var(--font-size--sm);
  color: var(--brown);
  outline: none;
  transition: border-color 0.15s, background 0.15s;
  box-sizing: border-box;
}

.klav-form__input:focus {
  border-color: var(--brown);
  background: rgb(255 255 255 / 0.8);
}

.klav-form__input::placeholder { opacity: 0.4; }

.klav-form__error {
  font-size: var(--font-size--xs);
  color: var(--color-error, #8B0000);
  margin: 0;
  text-align: center;
}

.klav-form__error[hidden] { display: none; }

/* ================================================
   Sticky tab
================================================ */
.klav-sticky {
  position: fixed;
  left: 0;
  top: 80px;
  z-index: calc(var(--layer-overlay, 16) - 1);
  display: flex;
  align-items: center;
  gap: 0.25rem;
  background: var(--purple);
  border-radius: 0 1000px 1000px 0;
  padding: 15px 20px;
  transform: translateX(0);
  transition: transform 0.4s ease, padding-left 0.2s ease;
}

.klav-sticky[hidden] { display: none; }

.klav-sticky--out {
  transform: translateX(calc(-100% - 2px));
}

.klav-sticky__open {
  
  color: var(--brown);
  border: none;
  
  font-family: var(--font-body--family);
  font-size: 12px;
  font-weight: 700;
  text-transform: none;
  cursor: pointer;
  line-height: 1;
  text-align: left;
  background-color: transparent;
  
}

.klav-sticky:hover { padding-left: 30px; }

.klav-sticky__dismiss {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 14px;
  color: var(--brown);
  padding: 5px;
  line-height: 1;
  transition: opacity 0.15s;
  font-weight: 700;
}

.klav-sticky__dismiss:hover { opacity: 0.9; }

#klav-step-3 .klav-step__icon{
  margin: 20px 0 -10px;
}

@media(max-width: 749px){
  .klav-sticky {
    top: 50svh;
    transform: translateY(-50%);
  }

  .klav-sticky--out {
    transform: translate(calc(-100% - 2px), -50%);
  }
}

@media(max-width: 1559px){
  body {
    --klav-sticky-bar-height: calc(var(--header-height, 60px) * 2 / 3);
  }

  html.klav-sticky-visible body {
    padding-top: var(--klav-sticky-bar-height);
  }

  html.klav-sticky-visible .header[transparent] {
    top: var(--klav-sticky-bar-height);
  }

  html.klav-sticky-visible .header-section:has(> #header-component[sticky='always']),
  html.klav-sticky-visible .header-section:has(> #header-component[sticky='scroll-up'][data-sticky-state='active']) {
    top: calc(var(--klav-sticky-bar-height) - 1px);
  }

  .klav-sticky {
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    min-height: var(--klav-sticky-bar-height);
    justify-content: center;
    box-sizing: border-box;
    border-radius: 0;
    padding: 0 52px 0 18px;
    transform: translateY(0);
    z-index: calc(var(--layer-overlay, 16) + 2);
  }

  .klav-sticky--out {
    transform: translateY(-100%);
  }

  .klav-sticky:hover {
    padding-left: 18px;
  }

  .klav-sticky__open {
    width: 100%;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .klav-sticky__open br {
    display: none;
  }

  .klav-sticky__dismiss {
    position: absolute;
    top: 50%;
    right: 16px;
    transform: translateY(-50%);
    font-size: 20px;
  }
}

@media(min-width: 750px){
  .klav-popup{
    border-radius: 56px;
  }

  .klav-popup__close{
    right: 32px;
    top: 32px;
  }
}

@media(min-width: 1560px){
  .klav-sticky {
    top: 0;
  }
}

</style>

<script>
(function () {
  var PUBLIC_KEY  = {{ klaviyo_public_key | json }};
  var LIST_ID     = {{ klaviyo_list_id | json }};
  var STORAGE_KEY = 'bnf_klav_v1';

  var popup  = document.getElementById('klav-popup');
  var sticky = document.getElementById('klav-sticky');
  var step1  = document.getElementById('klav-step-1');
  var step2  = document.getElementById('klav-step-2');
  var step3  = document.getElementById('klav-step-3');

  function getState() {
    try { return localStorage.getItem(STORAGE_KEY); } catch (e) { return null; }
  }
  function setState(s) {
    try { localStorage.setItem(STORAGE_KEY, s); } catch (e) {}
  }

  function showStep(el) {
    [step1, step2, step3].forEach(function (s) { s.hidden = true; });
    el.hidden = false;
  }

  function stickySlideOut() {
    if (!sticky) return;
    document.documentElement.classList.remove('klav-sticky-visible');
    if (sticky.hidden) return;
    sticky.classList.add('klav-sticky--out');
  }

  function stickySlideIn() {
    if (!sticky) return;
    sticky.classList.add('klav-sticky--out');
    sticky.hidden = false;
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        sticky.classList.remove('klav-sticky--out');
        document.documentElement.classList.add('klav-sticky-visible');
      });
    });
  }

  function openPopup() {
    showStep(step1);
    popup.showModal();
    stickySlideOut();
  }

  function closePopup(newState) {
    popup.close();
    if (newState) setState(newState);
    if (newState !== 'subscribed' && newState !== 'hidden') {
      stickySlideIn();
    }
  }

  function init() {
    var state = getState();
    if (state === 'subscribed' || state === 'hidden') return;
    if (state === 'dismissed') { stickySlideIn(); return; }
    stickySlideIn();
  }

  // Close X button
  document.getElementById('klav-close-btn')?.addEventListener('click', function () {
    closePopup('dismissed');
  });

  // Escape key (browser default closes dialog, we just handle state)
  popup?.addEventListener('cancel', function () {
    setState('dismissed');
    stickySlideIn();
  });

  // Click outside dialog
  popup?.addEventListener('click', function (e) {
    if (e.target === popup) closePopup('dismissed');
  });

  // Step 1 buttons
  document.getElementById('klav-yes-btn')?.addEventListener('click', function () {
    showStep(step2);
    document.getElementById('klav-email-input')?.focus();
  });

  document.getElementById('klav-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var email     = document.getElementById('klav-email-input').value.trim();
    var errorEl   = document.getElementById('klav-error');
    var submitBtn = this.querySelector('[type="submit"]');

    if (!email) return;
    submitBtn.disabled = true;
    errorEl.hidden = true;

    fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + PUBLIC_KEY, {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'revision': '2023-12-15' },
      body: JSON.stringify({
        data: {
          type: 'subscription',
          attributes: {
            profile: {
              data: { type: 'profile', attributes: { email: email, properties: { signup_source: 'popup' } } }
            }
          },
          relationships: {
            list: { data: { type: 'list', id: LIST_ID } }
          }
        }
      })
    })
    .then(function (res) {
      if (res.ok || res.status === 202) {
        setState('subscribed');
        showStep(step3);
      } else {
        throw new Error('api');
      }
    })
    .catch(function () {
      errorEl.hidden = false;
      submitBtn.disabled = false;
    });
  });

  // Step 3
  document.getElementById('klav-done-btn').addEventListener('click', function () {
    popup.close();
  });

  // Sticky
  document.getElementById('klav-sticky-open')?.addEventListener('click', openPopup);
  document.getElementById('klav-sticky-dismiss')?.addEventListener('click', function () {
    if (sticky) sticky.hidden = true;
    document.documentElement.classList.remove('klav-sticky-visible');
    setState('hidden');
  });

  init();
})();
</script>

{%- endif -%}
