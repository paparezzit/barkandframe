{%- doc -%}
  Renders the cart summary totals.
{%- enddoc -%}

{%- liquid
  assign adjusted_total_price = 0
  for item in cart.items
    assign line_price = item.final_line_price
    assign sale_cp = item.properties['_Sale_Price'] | times: 1
    if sale_cp > 0
      assign property_line_price = sale_cp | times: item.quantity
      if line_price > property_line_price
        assign line_price = property_line_price
      endif
    endif
    assign adjusted_total_price = adjusted_total_price | plus: line_price
  endfor
  assign total_price = adjusted_total_price | money
-%}

<div class="cart__ctas">
  <button
    type="submit"
    id="checkout"
    class="cart__checkout-button button"
    name="checkout"
    {% if cart == empty %}
      disabled
    {% endif %}
    form="cart-form"
  >
    {{ 'content.checkout' | t }} —
    <text-component
      ref="cartTotal"
      value="{{ total_price | strip_html }}"
      data-cart-subtotal
    >{{ total_price }}</text-component>
  </button>

  {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons %}
    <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
      {{ content_for_additional_checkout_buttons }}
    </div>
  {% endif %}
</div>

{% stylesheet %}{% endstylesheet %}
