{%- doc -%}
  Returns a hex color for a given color name.
  Add new colors below in the format: 'Name: #hex'

  @param {string} color_name - The option value name to look up
  @output Outputs the hex color string, or nothing if not found
{%- enddoc -%}

{%- liquid
  assign name_lower = color_name | downcase | strip

  case name_lower
    when 'desert dust'
      assign swatch_hex = '#c4a882'
    when 'heather grey'
      assign swatch_hex = '#9e9e9e'
    when 'carbon grey'
      assign swatch_hex = '#575757'
    when 'black'
      assign swatch_hex = '#1a1a1a'
    when 'pure white', 'white'
      assign swatch_hex = '#ffffff'
    when 'oyster'
      assign swatch_hex = '#ded4c2'
    when 'red'
      assign swatch_hex = '#e03131'
    when 'navy'
      assign swatch_hex = '#1c3461'
    when 'green'
      assign swatch_hex = '#2f7a3b'
    else
      assign swatch_hex = nil
  endcase

  echo swatch_hex
-%}
