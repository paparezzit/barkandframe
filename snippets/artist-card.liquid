{%- doc -%}
  Renders the artist "bubble" card used in the configurator and on the Artist page.
  @param {object} artist - Artist metaobject
{%- enddoc -%}
{%- assign heading_tag = heading_tag | default: 'h2' -%}
{%- assign image_width = image_width | default: 200 -%}
<div class="artist-card">
  {%- if artist.photo.value != blank -%}
    <img
      class="artist-card__photo"
      src="{{ artist.photo.value | image_url: width: image_width }}"
      alt="{{ artist.name.value }}"
      width="72"
      height="72"
      loading="lazy"
    >
  {%- endif -%}
  <div class="artist-card__body">
    <{{ heading_tag }} class="artist-card__heading">
      <strong class="artist-card__name">{{ artist.name.value }}</strong>
    </{{ heading_tag }}>
    {%- unless about_long_only -%}
      {%- if artist.hero.value != blank -%}
        <p class="artist-card__description">{{ artist.hero.value | newline_to_br }}</p>
      {%- endif -%}
    {%- endunless -%}
    {%- if artist['about-long'].value != blank -%}
      <p class="artist-card__description">{{ artist['about-long'].value | newline_to_br }}</p>
    {%- endif -%}
    {%- unless about_long_only -%}
      {%- if artist.description != blank -%}
        <div class="artist-card__description">{{ artist.description | metafield_tag }}</div>
      {%- endif -%}
    {%- endunless -%}
  </div>
  {%- if artist.signature.value != blank -%}
    <img
      class="artist-card__signature"
      src="{{ artist.signature.value | image_url: width: 160 }}"
      alt=""
      width="160"
      height="40"
      loading="lazy"
    >
  {%- endif -%}
</div>

{% stylesheet %}
  .artist-card {
    background: color-mix(in srgb, var(--purple) 45%, transparent);
    border-radius: 1000px;
    padding: 20px;
    display: flex;
    align-items: start;
    gap: 20px;
    position: relative;
    overflow: hidden;
    font-family: var(--font-body--family);
    font-size: 14px;
    color: var(--brown);
  }

  .artist-card__photo {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .artist-card__body {
    flex: 1;
    min-width: 0;
    max-width: calc(80% - 110px);

    .artist-card__heading{
      display: flex;
      gap: 15px;
      margin: 0;
      font-family: var(--font-paragraph--family);
      font-size: var(--font-paragraph--size);
      font-weight: var(--font-paragraph--weight);
      line-height: var(--font-paragraph--line-height);
      letter-spacing: 0;
      text-transform: none;
      color: var(--brown);
    }
  }

  .artist-card__name {
    font-weight: 700;
    margin-bottom: 1em;
  }

  .artist-card__description {
    margin: 0;
    padding-bottom: 1em;

    &:last-child{
      padding-bottom: 2em;
    }
  }

  .artist-card__signature {
    position: absolute;
    bottom: 20px;
    right: 60px;
    width: 70px;
  }
{% endstylesheet %}
