{%- doc -%}
  Renders a contact form with radio-based type switching, conditional fields, and photo upload.
{%- enddoc -%}

{%- assign form_id = block.id | default: section.id | prepend: 'ContactForm-' -%}

<script>
  window.ContactFormCloudinary = {
    cloudName: {{ settings.cloudinary_cloud_name | default: '' | json }},
    uploadPreset: {{ settings.cloudinary_upload_preset | default: '' | json }}
  };
</script>

<div
  class="contact-form spacing-style size-style{% if settings.inherit_color_scheme == false %} color-{{ settings.color_scheme }}{% endif %}"
  style="{% render 'spacing-style', settings: settings %}{% render 'size-style', settings: settings %}"
  {{ block.shopify_attributes }}
>
  {%- form 'contact', id: form_id, class: 'contact-form__form' -%}

    {%- if form.posted_successfully? -%}
      <div class="contact-form__success" tabindex="-1" autofocus data-generate-lead-success="{{ form_id }}">
        <h4>
          Thanks for reaching out.
        </h4>
        <div class="content">
          <p>We’ve got your message and our team is on it. We’ll get back to you as soon as we can.</p>
        </div>
        <a class="button cf-success-back" href="/collections/all-products">Shop the Collection</a>
      </div>
    {%- else -%}

    {%- if form.errors -%}
      <div class="contact-form__error" tabindex="-1" autofocus>
        {{- 'icon-error.svg' | inline_asset_content -}}
        {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
      </div>
    {%- endif -%}

    <!-- ——— Radio type selector ——— -->
    <div class="cf-type-selector" role="group" aria-label="Request type">
      <label class="cf-type-option">
        <input class="cf-type-radio" type="radio" name="contact[request_type]" value="general-inquiry" checked>
        <span class="cf-type-label">General Enquiry</span>
      </label>
      <label class="cf-type-option">
        <input class="cf-type-radio" type="radio" name="contact[request_type]" value="order-issue">
        <span class="cf-type-label">Order Issue / Complaint</span>
      </label>
      <label class="cf-type-option">
        <input class="cf-type-radio" type="radio" name="contact[request_type]" value="withdrawal-form">
        <span class="cf-type-label">Withdrawal Form</span>
      </label>
    </div>

    <!-- ——— Two-column layout ——— -->
    <div class="cf-columns" id="cf-columns">

      <!-- Left column -->
      <div class="cf-col cf-col--left">

        <!-- Order Number (hidden for General Inquiry) -->
        <div class="cf-field cf-field--labeled" id="cf-field-order-number">
          <input
            type="text"
            id="cf-order-number"
            name="contact[order_number]"
            class="contact-form__input"
            placeholder=" "
          >
          <label class="cf-label" for="cf-order-number">Order Number <span class="cf-req">*</span></label>
        </div>

        <!-- Email -->
        <div class="cf-field cf-field--labeled">
          <input
            type="email"
            id="cf-email"
            name="contact[email]"
            class="contact-form__input"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            placeholder=" "
            required
            aria-required="true"
          >
          <label class="cf-label" for="cf-email">Email <span class="cf-req">*</span></label>
        </div>

        <!-- Full Name (Withdrawal Form only) -->
        <div class="cf-field cf-field--labeled" id="cf-field-full-name" hidden>
          <input
            type="text"
            id="cf-full-name"
            name="contact[full_name]"
            class="contact-form__input"
            autocomplete="name"
            placeholder=" "
          >
          <label class="cf-label" for="cf-full-name">Full Name <span class="cf-req">*</span></label>
        </div>

        <!-- Textarea -->
        <div class="cf-field cf-field--labeled">
          <textarea
            id="cf-textarea"
            name="contact[body]"
            class="contact-form__input contact-form__input--textarea"
            rows="6"
            placeholder=" "
          >{{- form.body -}}</textarea>
          <label class="cf-label" for="cf-textarea" id="cf-textarea-label">Tell us what happened</label>
        </div>

        <label class="cf-checkbox" id="cf-withdrawal-consent" hidden>
          <input
            type="checkbox"
            id="cf-withdrawal-consent-input"
            name="contact[withdrawal_confirmation]"
            value="I hereby withdraw from the contract for the purchase of the above-listed goods."
          >
          <span>I hereby withdraw from the contract for the purchase of the above-listed goods.</span>
        </label>

      </div>

      <!-- Right column -->
      <div class="cf-col cf-col--right">

        <!-- Photo upload (first 3 types only) -->
        <div id="cf-field-upload">
          <div class="photo-upload">
            <div
              class="photo-upload__zone"
              id="cf-upload-zone"
              role="button"
              tabindex="0"
              aria-label="Upload photos – click or drag and drop"
            >
              <p class="photo-upload__instruction">Upload photos</p>
              <p class="photo-upload__sub">JPG / PNG / HEIC – Max 10 MB per file</p>
              <label class="button button--secondary photo-upload__browse" for="cf-file-input">Browse files</label>
              <input
                type="file"
                id="cf-file-input"
                accept=".jpg,.jpeg,.png,.heic,.heif,image/jpeg,image/png,image/heic,image/heif"
                multiple
                class="photo-upload__input"
                aria-label="Upload photos"
              >
            </div>
            <div class="photo-upload__previews" id="cf-photo-previews" aria-live="polite"></div>
            <p id="cf-upload-error" class="cf-upload-error" hidden></p>
          </div>
        </div>

        <div class="cf-additional-info" id="cf-withdrawal-info" hidden>
          <p class="cf-additional-info__heading">Additional Information</p>
          <p>If the contract for provision of personalized goods has already entered production following your approval of the design, the right of withdrawal does not apply.</p>
          <p>After receiving your notice, we will promptly acknowledge receipt and inform you If you need help with the form or are unsure how to proceed, please contact us at of the next steps.</p>
          <p><a href="mailto:customercare@barkandframe.com">customercare@barkandframe.com</a></p>
        </div>

        <!-- Notices -->
        <p class="cf-notice cf-notice--warning">Fields marked with <span class="cf-req">*</span> are required.</p>

        <!-- Submit -->
        <button type="submit" class="button cf-submit">Submit request</button>

      </div>
    </div>

    {%- endif -%}

  {%- endform -%}

  <section class="contact-company-info" aria-label="BARK AND FRAME company information">
    <div class="contact-company-info__inner">
      <div class="contact-company-info__icon" aria-hidden="true">
        <img src="{{ 'logo-icon.svg' | asset_url }}" alt="" width="101" height="70" loading="lazy">
      </div>

      <h2 class="contact-company-info__title">BARK AND FRAME s.r.o.</h2>

      <div class="contact-company-info__group">
        <p><strong>Company ID:</strong> 23808926</p>
        <p><strong>VAT ID:</strong> CZ23808926</p>
      </div>

      <div class="contact-company-info__group">
        <p><strong>Registered Office</strong></p>
        <p>Příčná 1892/4, Nové Město, 110 00 Prague 1,</p>
        <p>Czech Republic</p>
      </div>

      <div class="contact-company-info__group">
        <p>Registered in the Commercial Register kept by the Municipal Court in Prague, File No. C 432302</p>
      </div>

      <div class="contact-company-info__group">
        <p><strong>Contact Email</strong></p>
        <p><a href="mailto:customercare@barkandframe.com">customercare@barkandframe.com</a></p>
      </div>
    </div>
  </section>

</div>

{% render 'generate-lead-analytics' %}

<script>
(function () {
  var CF_CONFIG = {
    'order-issue': {
      textareaPlaceholder: 'Tell us what happened',
      textareaRequired: true,
      showOrderNumber: true,
      showFullName: false,
      showWithdrawalConsent: false,
      showWithdrawalInfo: false,
      showUpload: true
    },
    'withdrawal-form': {
      textareaPlaceholder: 'Item(s) you wish to withdraw from *',
      textareaRequired: true,
      showOrderNumber: true,
      showFullName: true,
      showWithdrawalConsent: true,
      showWithdrawalInfo: true,
      showUpload: false
    },
    'general-inquiry': {
      textareaPlaceholder: 'Message *',
      textareaRequired: true,
      showOrderNumber: false,
      showFullName: false,
      showWithdrawalConsent: false,
      showWithdrawalInfo: false,
      showUpload: false
    }
  };

  var photoUrls = [];
  var pendingUploads = 0;
  var failedUploads = 0;
  var SCROLL_STORAGE_KEY = 'bafContactFormScroll:{{ form_id }}';
  var GENERATE_LEAD_STORAGE_KEY = 'bafGenerateLead:contact:{{ form_id }}';
  var GENERATE_LEAD_FORM_TYPES = {
    'general-inquiry': 'General inquiry',
    'order-issue': 'Order issue',
    'withdrawal-form': 'Withdrawal form'
  };

  function getSelectedFormType() {
    var selected = document.querySelector('.cf-type-radio:checked');
    var value = selected ? selected.value : 'general-inquiry';

    return GENERATE_LEAD_FORM_TYPES[value] || 'Other';
  }

  function storeGenerateLead() {
    var emailInput = document.getElementById('cf-email');
    if (!emailInput || !window.BAFGenerateLead) return;

    window.BAFGenerateLead.store(GENERATE_LEAD_STORAGE_KEY, {
      formType: getSelectedFormType(),
      email: emailInput.value
    });
  }

  function publishGenerateLeadOnSuccess() {
    if (!document.querySelector('[data-generate-lead-success="{{ form_id }}"]')) return;
    if (!window.BAFGenerateLead) return;

    window.BAFGenerateLead.publishStored(GENERATE_LEAD_STORAGE_KEY);
  }

  function saveScrollPosition() {
    try {
      sessionStorage.setItem(SCROLL_STORAGE_KEY, JSON.stringify({
        path: window.location.pathname,
        x: window.pageXOffset || document.documentElement.scrollLeft || 0,
        y: window.pageYOffset || document.documentElement.scrollTop || 0,
        time: Date.now()
      }));
    } catch (e) {}
  }

  function restoreScrollPosition() {
    var data;
    try {
      data = JSON.parse(sessionStorage.getItem(SCROLL_STORAGE_KEY) || 'null');
      sessionStorage.removeItem(SCROLL_STORAGE_KEY);
    } catch (e) {
      data = null;
    }
    if (!data || data.path !== window.location.pathname || Date.now() - data.time > 600000) return;

    if ('scrollRestoration' in window.history) {
      window.history.scrollRestoration = 'manual';
    }
    if (window.location.hash) {
      window.history.replaceState(null, document.title, window.location.pathname + window.location.search);
    }

    var left = Number(data.x) || 0;
    var top = Number(data.y) || 0;
    var restore = function () {
      window.scrollTo(left, top);
    };

    restore();
    requestAnimationFrame(function () {
      restore();
      requestAnimationFrame(restore);
    });
    setTimeout(restore, 120);
  }

  function updateSubmitButton() {
    var btn = document.querySelector('.cf-submit');
    if (!btn) return;
    if (pendingUploads > 0) {
      btn.disabled = true;
      btn.textContent = 'Uploading photos…';
    } else if (failedUploads > 0) {
      btn.disabled = true;
      btn.textContent = 'Remove failed photos to continue';
    } else {
      btn.disabled = false;
      btn.textContent = 'Submit request';
    }
  }

  function updateForm(type) {
    var cfg = CF_CONFIG[type];
    if (!cfg) return;

    var columns = document.getElementById('cf-columns');
    if (columns) columns.hidden = false;

    // Toggle order number
    var orderField = document.getElementById('cf-field-order-number');
    var orderInput = document.getElementById('cf-order-number');
    if (orderField) {
      orderField.hidden = !cfg.showOrderNumber;
      if (orderInput) orderInput.required = cfg.showOrderNumber;
    }

    // Toggle full name
    var fullNameField = document.getElementById('cf-field-full-name');
    var fullNameInput = document.getElementById('cf-full-name');
    if (fullNameField) {
      fullNameField.hidden = !cfg.showFullName;
      if (fullNameInput) fullNameInput.required = !!cfg.showFullName;
    }

    var withdrawalConsent = document.getElementById('cf-withdrawal-consent');
    var withdrawalConsentInput = document.getElementById('cf-withdrawal-consent-input');
    if (withdrawalConsent) {
      withdrawalConsent.hidden = !cfg.showWithdrawalConsent;
      if (withdrawalConsentInput) {
        withdrawalConsentInput.required = !!cfg.showWithdrawalConsent;
        if (!cfg.showWithdrawalConsent) withdrawalConsentInput.checked = false;
      }
    }

    var withdrawalInfo = document.getElementById('cf-withdrawal-info');
    if (withdrawalInfo) withdrawalInfo.hidden = !cfg.showWithdrawalInfo;

    // Update textarea
    var ta = document.getElementById('cf-textarea');
    var taLabel = document.getElementById('cf-textarea-label');
    if (ta) {
      ta.required = cfg.textareaRequired;
    }
    if (taLabel) {
      var labelText = cfg.textareaPlaceholder.replace(' *', '');
      taLabel.innerHTML = cfg.textareaRequired
        ? labelText + ' <span class="cf-req">*</span>'
        : labelText;
    }

    // Toggle upload
    var uploadField = document.getElementById('cf-field-upload');
    if (uploadField) uploadField.hidden = !cfg.showUpload;

  }

  // ——— Cloudinary upload ———
  var ALLOWED_TYPES = ['image/jpeg','image/png','image/heic','image/heif'];
  var MAX_FILE_SIZE = 10 * 1024 * 1024;

  function showUploadError(msg) {
    var el = document.getElementById('cf-upload-error');
    if (!el) return;
    el.textContent = msg;
    el.hidden = false;
    setTimeout(function () { el.hidden = true; }, 5000);
  }



  function markUploadFailed(previewEl, spinner) {
    spinner.classList.add('photo-preview__spinner--error');
    previewEl.classList.add('photo-preview--failed');
    failedUploads++;
    updateSubmitButton();

    var errMsg = document.createElement('p');
    errMsg.className = 'cf-upload-error cf-upload-error--inline';
    errMsg.textContent = 'Upload failed. Remove this photo and try again.';
    previewEl.insertAdjacentElement('afterend', errMsg);
    previewEl.dataset.errorEl = 'true';
    previewEl._errorEl = errMsg;
  }

  function publishPhotoUpload(source) {
    if (
      !window.Shopify ||
      !window.Shopify.analytics ||
      typeof window.Shopify.analytics.publish !== 'function'
    ) {
      return;
    }

    try {
      window.Shopify.analytics.publish('photo_upload', {
        source: source
      });
    } catch (e) {
      // Analytics must not block the form upload flow.
    }
  }

  function uploadToCloudinary(file, previewEl) {
    var cfg = window.ContactFormCloudinary;
    if (!cfg || !cfg.cloudName || !cfg.uploadPreset) return;

    pendingUploads++;
    updateSubmitButton();

    var spinner = document.createElement('div');
    spinner.className = 'photo-preview__spinner';
    previewEl.appendChild(spinner);

    var fd = new FormData();
    fd.append('file', file);
    fd.append('upload_preset', cfg.uploadPreset);

    fetch('https://api.cloudinary.com/v1_1/' + cfg.cloudName + '/image/upload', {
      method: 'POST',
      body: fd
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.secure_url) {
          photoUrls.push(data.secure_url);
          previewEl.dataset.photoUrl = data.secure_url;
          spinner.remove();
          publishPhotoUpload('contact_form');
        } else {
          markUploadFailed(previewEl, spinner);
        }
      })
      .catch(function () {
        markUploadFailed(previewEl, spinner);
      })
      .finally(function () {
        pendingUploads = Math.max(0, pendingUploads - 1);
        updateSubmitButton();
      });
  }

  function handleFiles(files) {
    var previews = document.getElementById('cf-photo-previews');
    if (!previews) return;

    Array.from(files).forEach(function (file) {
      var ext = file.name.split('.').pop().toLowerCase();
      var typeOk = ALLOWED_TYPES.includes(file.type) || ext === 'heic' || ext === 'heif';
      if (!typeOk) {
        showUploadError('Unsupported file: ' + file.name + '. Use JPG, PNG, HEIC or WebP.');
        return;
      }
      if (file.size > MAX_FILE_SIZE) {
        showUploadError(file.name + ' exceeds 10 MB limit.');
        return;
      }

      var reader = new FileReader();
      reader.onload = function (e) {
        var preview = document.createElement('div');
        preview.className = 'photo-preview';

        var img = document.createElement('img');
        img.src = e.target.result;
        img.alt = '';
        preview.appendChild(img);

        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'photo-preview__remove';
        removeBtn.textContent = '×';
        removeBtn.setAttribute('aria-label', 'Remove photo');
        removeBtn.addEventListener('click', function () {
          if (preview.dataset.photoUrl) {
            var idx = photoUrls.indexOf(preview.dataset.photoUrl);
            if (idx > -1) photoUrls.splice(idx, 1);
          }
          if (preview.classList.contains('photo-preview--failed')) {
            failedUploads = Math.max(0, failedUploads - 1);
          }
          if (preview._errorEl) preview._errorEl.remove();
          preview.remove();
          updateSubmitButton();
        });
        preview.appendChild(removeBtn);
        previews.appendChild(preview);

        uploadToCloudinary(file, preview);
      };
      reader.readAsDataURL(file);
    });
  }

  // ——— Init ———
  function init() {

    // Radio change
    document.querySelectorAll('.cf-type-radio').forEach(function (radio) {
      radio.addEventListener('change', function () {
        if (this.checked) updateForm(this.value);
      });
    });

    // Set initial state if a radio is pre-selected (e.g. after form error)
    var checked = document.querySelector('.cf-type-radio:checked');
    if (checked) updateForm(checked.value);

    // File input
    var fileInput = document.getElementById('cf-file-input');
    if (fileInput) {
      fileInput.addEventListener('change', function () {
        handleFiles(this.files);
        this.value = '';
      });
    }

    // On submit: append photo URLs to body
    var form = document.getElementById('{{ form_id }}');
    if (form) {
      form.addEventListener('submit', function (e) {
        if (pendingUploads > 0) {
          e.preventDefault();
          return;
        }
        saveScrollPosition();
        storeGenerateLead();
        if (photoUrls.length > 0) {
          var ta = document.getElementById('cf-textarea');
          if (ta) {
            var sep = ta.value.trim() ? '\n\n' : '';
            ta.value = ta.value + sep + 'Photos:\n' + photoUrls.join('\n');
          }
        }
      });
    }

    // Drag & drop
    var zone = document.getElementById('cf-upload-zone');
    if (zone) {
      zone.addEventListener('dragover', function (e) {
        e.preventDefault();
        zone.classList.add('drag-over');
      });
      zone.addEventListener('dragleave', function () {
        zone.classList.remove('drag-over');
      });
      zone.addEventListener('drop', function (e) {
        e.preventDefault();
        zone.classList.remove('drag-over');
        handleFiles(e.dataTransfer.files);
      });
      zone.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          document.getElementById('cf-file-input').click();
        }
      });
    }

  }

  publishGenerateLeadOnSuccess();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      restoreScrollPosition();
      init();
    });
  } else {
    restoreScrollPosition();
    init();
  }
})();
</script>
