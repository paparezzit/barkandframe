{%- liquid
  assign product_handle = product_handle_override | strip
  if product_handle == blank and product != blank
    assign product_handle = product.handle
  endif
  assign preset_product_category = preset_product_category | strip
  assign preset_size = preset_size | strip
  assign preset_border = preset_border | strip
  assign preset_framing = preset_framing | strip
  assign preset_color = preset_color | strip

  assign portrait_url = '/pages/portrait?step=3'
  if style_id != blank
    assign style_id_encoded = style_id | url_encode
    assign portrait_url = portrait_url | append: '&style=' | append: style_id_encoded
  endif
  if product_handle != blank and preset_product_category == blank
    assign product_handle_encoded = product_handle | url_encode
    assign portrait_url = portrait_url | append: '&product=' | append: product_handle_encoded
  endif
  if preset_product_category != blank
    assign preset_product_category_encoded = preset_product_category | url_encode
    assign portrait_url = portrait_url | append: '&category=' | append: preset_product_category_encoded
  endif
  if preset_size != blank
    assign preset_size_encoded = preset_size | url_encode
    assign portrait_url = portrait_url | append: '&size=' | append: preset_size_encoded
  endif
  if preset_border != blank
    assign preset_border_encoded = preset_border | url_encode
    assign portrait_url = portrait_url | append: '&border=' | append: preset_border_encoded
  endif
  if preset_framing != blank
    assign preset_framing_encoded = preset_framing | url_encode
    assign portrait_url = portrait_url | append: '&framing=' | append: preset_framing_encoded
  endif
  if preset_color != blank
    assign preset_color_encoded = preset_color | url_encode
    assign portrait_url = portrait_url | append: '&color=' | append: preset_color_encoded
  endif

  if product_label == blank and product != blank
    assign product_label = product.title
  endif
-%}

<article class="shop-products__portrait-card">
  <span class="shop-products__portrait-badges" aria-hidden="true">
    {%- if style_label != blank -%}
      <span class="shop-products__portrait-badge shop-products__portrait-badge--style">
        {{- style_label -}}
      </span>
    {%- endif -%}
    {%- if product_label != blank -%}
      <span class="shop-products__portrait-badge shop-products__portrait-badge--product">
        {{- product_label -}}
      </span>
    {%- endif -%}
  </span>

  <a class="shop-products__portrait-media" href="{{ portrait_url }}">
    {%- if image != blank -%}
      <img
        src="{{ image | image_url: width: 900 }}"
        alt="{{ style_label | escape }} {{ product_label | escape }}"
        loading="lazy"
        width="900"
        height="1140"
      >
    {%- elsif product.featured_media != blank -%}
      <img
        src="{{ product.featured_media.preview_image | image_url: width: 900 }}"
        alt="{{ product.title | escape }}"
        loading="lazy"
        width="900"
        height="1140"
      >
    {%- else -%}
      <img
        src="{{ fallback_image | asset_url }}"
        alt="{{ style_label | escape }} {{ product_label | escape }}"
        loading="lazy"
        width="900"
        height="1140"
      >
    {%- endif -%}
  </a>

  <a class="shop-products__portrait-button" href="{{ portrait_url }}">
    {{- button_label | default: 'Make a portrait' -}}
  </a>
</article>
