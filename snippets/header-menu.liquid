{% liquid
  assign block_settings = block.settings
  assign menu_content_type = block_settings.menu_style | default: 'text'
  assign image_border_radius = block_settings.image_border_radius
  assign color_scheme_classes = ''
  assign color_scheme_setting_id = 'color_scheme_' | append: section.settings.menu_row
  assign current_color_scheme = block_settings.color_scheme
  assign parent_color_scheme = section.settings[color_scheme_setting_id]

  if parent_color_scheme.id != current_color_scheme.id
    assign color_scheme_classes = ' color-' | append: current_color_scheme
  endif

  # Check if header and menu colors match. This is used to apply different padding styles in css
  if parent_color_scheme.settings.background.rgb == current_color_scheme.settings.background.rgb
    assign color_scheme_classes = color_scheme_classes | append: ' color-scheme-matches-parent'
  endif

  if block_settings.menu_style == 'featured_collections'
    assign ratio = block_settings.featured_collections_aspect_ratio
  elsif block_settings.menu_style == 'featured_products'
    assign ratio = block_settings.featured_products_aspect_ratio
  endif

  assign about_path = '/pages/about-us'
  assign about_url = pages['about-us'].url | default: about_path
  assign about_title = 'About us'
  assign artists_path = '/pages/our-artists'
  assign artists_url = pages['our-artists'].url | default: artists_path
  assign artists_title = 'Our artists'
  assign has_about_link = false
  assign has_artists_link = false
  for link in block_settings.menu.links
    assign link_title = link.title | strip | downcase
    if link_title == 'about us' or link.url == about_url or link.url == about_path or link.url == '/pages/about-us'
      assign has_about_link = true
    endif
    if link_title == 'our artists' or link_title == 'our artist' or link.url == artists_url or link.url == artists_path
      assign has_artists_link = true
    endif
  endfor
%}

{% capture children %}
  {% assign visible_menu_index = 0 %}
  {% for link in block_settings.menu.links %}
    {% if block_settings.hide_empty_collection_links and link.type == 'collection_link' and link.object.all_products_count == 0 and link.object.template_suffix != 'with-portrait-cta' %}
      {% continue %}
    {% endif %}
    {% assign visible_menu_index = visible_menu_index | plus: 1 %}
    {% assign link_title = link.title | strip | downcase %}
    {% assign is_about_link = false %}
    {% if link_title == 'about us' or link.url == about_url or link.url == about_path or link.url == '/pages/about-us' %}
      {% assign is_about_link = true %}
    {% endif %}
    {% assign is_artists_link = false %}
    {% if link_title == 'our artists' or link_title == 'our artist' or link.url == artists_url or link.url == artists_path %}
      {% assign is_artists_link = true %}
    {% endif %}
    {% assign menu_link_url = link.url %}
    {% assign menu_link_active = link.active %}
    {% if is_about_link %}
      {% assign menu_link_url = about_url %}
      {% assign menu_link_active = false %}
      {% if request.path == about_path or request.path == about_url %}
        {% assign menu_link_active = true %}
      {% endif %}
    {% elsif is_artists_link %}
      {% assign menu_link_url = artists_url %}
      {% assign menu_link_active = false %}
      {% if request.path == artists_path or request.path == artists_url %}
        {% assign menu_link_active = true %}
      {% endif %}
    {% endif %}
    <li
      role="presentation"
      class="menu-list__list-item"
      on:focus="/activate"
      on:blur="/deactivate"
      on:pointerenter="/activate"
      on:pointerleave="/deactivate"
    >
      <a
        href="{{ menu_link_url }}"
        data-skip-node-update="true"
        class="menu-list__link{% if menu_link_active %} menu-list__link--active{% endif %}"
        {%- if link.links != blank -%}
          aria-controls="submenu-{{ forloop.index }}"
          aria-haspopup="true"
          aria-expanded="false"
        {%- endif -%}
        ref="menuitem"
      >
        <span class="menu-list__link-title">{{- link.title -}}</span>
      </a>
      {%- if link.links != blank -%}
        <div class="menu-list__submenu{{ color_scheme_classes }}" ref="submenu[]">
          <div
            id="submenu-{{ forloop.index }}"
            class="menu-list__submenu-inner"
            style="{% render 'submenu-font-styles', settings: block_settings %}"
          >
            {% assign list_id = 'MegaMenuList-' | append: forloop.index %}
            {% render 'mega-menu',
              section: section,
              parent_link: link,
              id: list_id,
              menu_content_type: menu_content_type,
              content_aspect_ratio: ratio,
              image_border_radius: image_border_radius,
              cta_label: block_settings.cta_label,
              cta_url: block_settings.cta_url,
              hide_empty_collection_links: block_settings.hide_empty_collection_links
            %}
          </div>
        </div>
      {%- endif -%}
    </li>
    {% if has_about_link == false and visible_menu_index == 2 %}
      <li
        role="presentation"
        class="menu-list__list-item"
        on:focus="/activate"
        on:blur="/deactivate"
        on:pointerenter="/activate"
        on:pointerleave="/deactivate"
      >
        <a
          href="{{ about_url }}"
          data-skip-node-update="true"
          class="menu-list__link{% if request.path == about_path or request.path == about_url %} menu-list__link--active{% endif %}"
          {% if request.path == about_path or request.path == about_url %}
            aria-current="page"
          {% endif %}
          ref="menuitem"
        >
          <span class="menu-list__link-title">{{ about_title }}</span>
        </a>
      </li>
      {% if has_artists_link == false %}
        <li
          role="presentation"
          class="menu-list__list-item"
          on:focus="/activate"
          on:blur="/deactivate"
          on:pointerenter="/activate"
          on:pointerleave="/deactivate"
        >
          <a
            href="{{ artists_url }}"
            data-skip-node-update="true"
            class="menu-list__link{% if request.path == artists_path or request.path == artists_url %} menu-list__link--active{% endif %}"
            {% if request.path == artists_path or request.path == artists_url %}
              aria-current="page"
            {% endif %}
            ref="menuitem"
          >
            <span class="menu-list__link-title">{{ artists_title }}</span>
          </a>
        </li>
      {% endif %}
    {% elsif is_about_link and has_artists_link == false %}
      <li
        role="presentation"
        class="menu-list__list-item"
        on:focus="/activate"
        on:blur="/deactivate"
        on:pointerenter="/activate"
        on:pointerleave="/deactivate"
      >
        <a
          href="{{ artists_url }}"
          data-skip-node-update="true"
          class="menu-list__link{% if request.path == artists_path or request.path == artists_url %} menu-list__link--active{% endif %}"
          {% if request.path == artists_path or request.path == artists_url %}
            aria-current="page"
          {% endif %}
          ref="menuitem"
        >
          <span class="menu-list__link-title">{{ artists_title }}</span>
        </a>
      </li>
    {% endif %}
  {% endfor %}
  <li
    class="menu-list__list-item"
    role="presentation"
    slot="more"
    on:focus="/activate"
    on:blur="/deactivate"
    on:pointerenter="/activate"
    on:pointerleave="/deactivate"
  >
    <button role="menuitem" class="button menu-list__link button-unstyled">
      <span class="menu-list__link-title">{{ 'actions.more' | t }}</span>
    </button>
  </li>
{% endcapture %}

<nav header-menu>
  <div
    class="menu-list"
    style="{% render 'menu-font-styles', settings: block_settings %}"
  >
    {% assign class = 'overflow-menu' | append: color_scheme_classes %}
    {% render 'overflow-list', class: class, ref: 'overflowMenu', children: children, minimum-items: 2, defer: true %}
  </div>
</nav>
