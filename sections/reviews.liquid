<div class="reviews section section--page-width">
  <div class=reviews__inner>
    <div class="col-left">
      <h2 class="reviews__title">
        {{ section.settings.main-text }}
      </h2>
      <!--
        <a href="{{ section.settings.button_link }}" class="reviews__button button">
          {{ section.settings.button_text }}
        </a>
      -->
    </div>
    <div class="col-right">
      <div class="reviews__wrapper">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.reviews{
  margin: 160px 0 100px;
  text-align: center;

  .reviews__title{
    margin: 20px 0;
    color: var(--brown);
    font-size: 36px;
  }

  .reviews__button{
    margin: 0 auto;
  }

  .reviews__wrapper{
    display: grid;
    grid-template-columns: 300px 300px 300px 300px 300px 300px;
    gap: 10px;
    position: relative;
    overflow: hidden;
    margin: 40px 0 0;

    &::before, &::after{
      position: absolute;
      left: 0;
      width: 80px;
      height: 100%;
      content: "";
      background: linear-gradient(90deg, #fffaf1, #fffaf100);
      z-index: 5;
      display: block;
    }

    &::after{
      left: auto;
      right: 0;
      background: linear-gradient(270deg, #fffaf1, #fffaf100);
    }

    product-card-link{
      background-color: var(--beige);
      border-radius: 20px;
      padding: 30px;

      .rating{
        background: var(--brown);
        padding: 5px 8px;
        margin-bottom: 10px;

        .stars{
          height: 9px;
        }
      }

      rte-formatter{
        font-size: 14px;
        color: var(--brown);

        h3{
          font-size: 18px !important;
          font-weight: 700;
        }
      }
    }
  }
}

@media(min-width: 750px){
  .reviews{
    .reviews__title{
      font-size: 96px;
      max-width: 800px;
      margin: 0 auto 40px;
    }

    .reviews__wrapper{
      margin-top: 60px;
    }
  }
}

@media(min-width: 1200px){
  .reviews{
    text-align: left;
    margin: 300px 0 140px;

    .reviews__inner{
      display: flex;

      .col-left{
        width: 50%;
      }

      .col-right{
        width: 50%;
      }
    }

    .reviews__title{
      margin: 100px 0 40px;
    }

    .reviews__button{
      margin: 20px 0;
    }

    .reviews__wrapper{
      margin-top: 0;
      grid-template-columns: 50% 50%;
      height: 800px;
      position: relative;

      &::before{
        top: 0;
        width: 100%;
        height: 100px;
        background: linear-gradient(180deg, #fffaf1, #fffaf100);
      }

      &::after{
        bottom: 0;
        width: 100%;
        height: 100px;
        background: linear-gradient(0deg, #fffaf1, #fffaf100);
      }
    }
  }
}
{% endstylesheet %}

{% javascript %}
if (document.querySelector(".reviews__wrapper") != null) {
  if (window.innerWidth < 1200) {
    gsap.to(".reviews__wrapper > product-card-link:nth-of-type(1), .reviews__wrapper > product-card-link:nth-of-type(2), .reviews__wrapper > product-card-link:nth-of-type(3), .reviews__wrapper > product-card-link:nth-of-type(4), .reviews__wrapper > product-card-link:nth-of-type(5), .reviews__wrapper > product-card-link:nth-of-type(6)", {
      scrollTrigger: {
          trigger:".reviews__wrapper",
          scrub: true,
          start: "top bottom",
          end: "bottom top"
      },
      ease: Power0.easeNone,
      x: "-400px"
    });

    gsap.from(".reviews__wrapper > product-card-link:nth-of-type(7), .reviews__wrapper > product-card-link:nth-of-type(8), .reviews__wrapper > product-card-link:nth-of-type(9), .reviews__wrapper > product-card-link:nth-of-type(10), .reviews__wrapper > product-card-link:nth-of-type(11), .reviews__wrapper > product-card-link:nth-of-type(12)", {
      scrollTrigger: {
          trigger:".reviews__wrapper",
          scrub: true,
          start: "top bottom",
          end: "bottom top"
      },
      ease: Power0.easeNone,
      x: "-400px"
    });
  } else {
    gsap.to(".reviews__wrapper > product-card-link:nth-of-type(even)", {
      scrollTrigger: {
          trigger:".reviews__wrapper",
          scrub: true,
          start: "top bottom",
          end: "bottom top"
      },
      ease: Power0.easeNone,
      y: "-400px"
    });

    gsap.from(".reviews__wrapper > product-card-link:nth-of-type(odd)", {
      scrollTrigger: {
          trigger:".reviews__wrapper",
          scrub: true,
          start: "top bottom",
          end: "bottom top"
      },
      ease: Power0.easeNone,
      y: "-400px"
    });
  }
}
{% endjavascript %}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "text",
      "id": "main-text",
      "label": "Main Text",
      "default": "What do our customers say about us?"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "All reviews"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "product-card"
    }
  ]
}
{% endschema %}
