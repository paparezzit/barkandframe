{{ 'collection-artist.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign artist = collection.metafields.custom.artist.value
  assign nav_links = linklists[section.settings.collection_nav].links

  assign col_text  = collection.metafields.custom.collection_text.value
  assign col_claim = collection.metafields.custom.collection_claim.value
  if col_text == blank
    assign col_text = section.settings.collection_text
  endif
  if col_claim == blank
    assign col_claim = section.settings.collection_claim
  endif
  assign col_desc_title = section.settings.collection_desc_title | default: 'About the collection'
-%}

<div class="artist-collection">

  {%- if nav_links.size > 0 -%}
    <nav class="artist-collection__nav section section--page-width">
      {%- for link in nav_links -%}
        <a
          href="{{ link.url }}"
          class="artist-collection__nav-link{% if link.active %} is-active{% endif %}"
          {% if link.active %}aria-current="page"{% endif %}
        >
          {{- link.title -}}
        </a>
      {%- endfor -%}
    </nav>
  {%- endif -%}

  <div class="artist-collection__wrapper">
    <div class="artist-collection__hero">
      <h1 class="artist-collection__title">{{ collection.title }}</h1>
      {%- if artist and artist.signature.value != blank -%}
        <div class="artist-collection__signature">
          <span class="artist-collection__by">by</span>
          <img
            src="{{ artist.signature.value | image_url: width: 400 }}"
            alt=""
            width="400"
            height="100"
            loading="eager"
          >
        </div>
      {%- endif -%}
    </div>

    <div class="artist-collection__hero-outline" aria-hidden="true">
      <div class="artist-collection__title">{{ collection.title }}</div>
      {%- if artist and artist.signature.value != blank -%}
        <div class="artist-collection__signature">
          <span class="artist-collection__by">by</span>
          <img
            src="{{ artist.signature.value | image_url: width: 400 }}"
            alt=""
            width="400"
            height="100"
            loading="lazy"
          >
        </div>
      {%- endif -%}
    </div>

    <div class="artist-collection__info section section--page-width">

      <div class="artist-collection__artist-bio">
        {%- if artist -%}
          {%- if artist.photo.value != blank -%}
            <div class="artist-collection__artist-photo">
              <img
                src="{{ artist.photo.value | image_url: width: 600 }}"
                alt="{{ artist.name.value }}"
                width="600"
                height="750"
                loading="lazy"
              >
            </div>
          {%- endif -%}
          <div class="artist-collection__artist-text">
            {%- if artist.name.value != blank -%}
              <h2 class="artist-collection__artist-name">{{ artist.name.value }}</h2>
            {%- endif -%}
            {%- if artist['about-long'].value != blank -%}
              <div class="rte artist-collection__artist-about">{{ artist['about-long'].value | newline_to_br }}</div>
            {%- endif -%}
            {%- if artist.signature.value != blank -%}
              <div class="artist-collection__artist-signature">
                <img
                  src="{{ artist.signature.value | image_url: width: 240 }}"
                  alt=""
                  width="240"
                  height="60"
                  loading="lazy"
                >
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="artist-collection__collection-desc">
        {%- if col_text != blank -%}
          <div class="artist-collection__desc-text rte">{{ col_text | newline_to_br }}</div>
        {%- endif -%}
      </div>

    </div>

    <div class="artist-collection__products">
      {%- liquid
        assign floating_image_count = 0
        assign rendered_floating_cards = 0
      -%}

      {%- for block in section.blocks -%}
        {%- liquid
          assign target_collection = block.settings.collection_handle | strip
          assign render_block = false

          if block.type == 'floating_image' and block.settings.image != blank
            if target_collection == blank or target_collection == collection.handle
              assign render_block = true
            endif
          endif
        -%}

        {%- if render_block -%}
          {%- liquid
            assign pattern_index = floating_image_count | modulo: 5
            assign floating_image_count = floating_image_count | plus: 1
            assign rendered_floating_cards = rendered_floating_cards | plus: 1
            assign parallax_amount = '0vh'
            if pattern_index == 1
              assign parallax_amount = '-20vh'
            elsif pattern_index == 2
              assign parallax_amount = '-10vh'
            elsif pattern_index == 4
              assign parallax_amount = '-20vh'
            endif

            assign display_image = block.settings.image
            assign display_image_alt = display_image.alt | default: block.settings.title
            assign display_image_width = display_image.width
            assign display_image_height = display_image.height
          -%}

          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="artist-collection__product-card" data-parallax="{{ parallax_amount }}" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="artist-collection__product-card" data-parallax="{{ parallax_amount }}" {{ block.shopify_attributes }}>
          {%- endif -%}
            <div class="artist-collection__product-image">
              <img
                src="{{ display_image | image_url: width: 900 }}"
                alt="{{ display_image_alt }}"
                width="{{ display_image_width }}"
                height="{{ display_image_height }}"
                loading="lazy"
              >
            </div>
            {%- if block.settings.title != blank -%}
              <span class="artist-collection__product-name">{{ block.settings.title }}</span>
            {%- endif -%}
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if rendered_floating_cards == 0 -%}
      {%- for product in collection.products -%}
        {%- liquid
          assign pattern_index = forloop.index0 | modulo: 5
          assign parallax_amount = '0vh'
          if pattern_index == 1
            assign parallax_amount = '-20vh'
          elsif pattern_index == 2
            assign parallax_amount = '-10vh'
          elsif pattern_index == 4
            assign parallax_amount = '-20vh'
          endif

          assign collection_img = product.metafields.custom.collection_image.value
          if collection_img != blank
            assign display_image = collection_img
            assign display_image_alt = collection_img.alt | default: product.title
            assign display_image_width = collection_img.width
            assign display_image_height = collection_img.height
          elsif product.featured_image
            assign display_image = product.featured_image
            assign display_image_alt = product.featured_image.alt | default: product.title
            assign display_image_width = product.featured_image.width
            assign display_image_height = product.featured_image.height
          endif
        -%}
        <a href="{{ product.url }}" class="artist-collection__product-card" data-parallax="{{ parallax_amount }}">
          <div class="artist-collection__product-image">
            {%- if display_image -%}
              <img
                src="{{ display_image | image_url: width: 600 }}"
                alt="{{ display_image_alt }}"
                width="{{ display_image_width }}"
                height="{{ display_image_height }}"
                loading="lazy"
              >
            {%- endif -%}
          </div>
          <span class="artist-collection__product-name">{{ product.title }}</span>
        </a>
      {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

</div>

<script>
  (() => {
    const updateArtistCollectionInfo = () => {
      document.querySelectorAll('.artist-collection').forEach((section) => {
        const title = section.querySelector('.artist-collection__hero .artist-collection__title');
        const info = section.querySelector('.artist-collection__info');
        const wrapper = section.querySelector('.artist-collection__wrapper') || section;
        if (!title || !info) return;

        const bodyStyles = getComputedStyle(document.body);
        const rootStyles = getComputedStyle(document.documentElement);
        const headerHeight =
          parseFloat(bodyStyles.getPropertyValue('--header-height')) ||
          parseFloat(rootStyles.getPropertyValue('--header-height')) ||
          0;
        const titleTop = title.getBoundingClientRect().top;
        const wrapperTop = wrapper.getBoundingClientRect().top;
        const infoCenter = ((headerHeight + titleTop) / 2) - wrapperTop;

        section.style.setProperty('--artist-info-center-y', `${infoCenter}px`);
      });
    };

    let frame;
    const scheduleArtistCollectionInfo = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(updateArtistCollectionInfo);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', scheduleArtistCollectionInfo, { once: true });
    } else {
      scheduleArtistCollectionInfo();
    }

    window.addEventListener('load', scheduleArtistCollectionInfo);
    window.addEventListener('resize', scheduleArtistCollectionInfo);
    document.addEventListener('shopify:section:load', scheduleArtistCollectionInfo);

    if (document.fonts) {
      document.fonts.ready.then(scheduleArtistCollectionInfo);
    }
  })();
</script>

{% schema %}
{
  "name": "Artist Collection",
  "settings": [
    {
      "type": "link_list",
      "id": "collection_nav",
      "label": "Collection navigation",
      "info": "Shared across all collections using this template"
    },
    {
      "type": "text",
      "id": "collection_desc_title",
      "label": "Description heading",
      "default": "About the collection"
    },
    {
      "type": "richtext",
      "id": "collection_text",
      "label": "Collection text"
    },
    {
      "type": "text",
      "id": "collection_claim",
      "label": "Collection claim"
    }
  ],
  "blocks": [
    {
      "type": "floating_image",
      "name": "Floating image",
      "settings": [
        {
          "type": "text",
          "id": "collection_handle",
          "label": "Collection handle"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Bubble text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Bubble link"
        }
      ]
    }
  ]
}
{% endschema %}
