{{ 'page-at-home.css' | asset_url | stylesheet_tag }}

<div class="at-home">
  <h1 class="visually-hidden">See it at home</h1>

  <div class="at-home__sticky-stage">
    <div class="at-home__hero-stack">
      <div class="at-home__hero">
        <div class="at-home__title-wrap" aria-hidden="true">
          <div class="at-home__title">
            <span>See it</span>
            <span>at home</span>
          </div>
        </div>
      </div>

      <div class="at-home__outline-overlay" aria-hidden="true">
        <div class="at-home__title-wrap">
          <div class="at-home__title">
            <span>See it</span>
            <span>at home</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="at-home__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          <button
            class="at-home__item"
            data-src="{{ block.settings.image | image_url: width: 2000 }}"
            data-alt="{{ block.settings.image.alt | default: '' | escape }}"
            {{ block.shopify_attributes }}
          >
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.image.alt | default: '' }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.button_text != blank -%}
    <div class="at-home__cta">
      <a href="{{ section.settings.button_url }}" class="button">{{ section.settings.button_text }}</a>
    </div>
  {%- endif -%}

</div>

<div class="at-home-lightbox" id="at-home-lightbox" aria-hidden="true">
  <div class="at-home-lightbox__backdrop"></div>
  <button class="at-home-lightbox__close" aria-label="Close">
    {{- 'icon-close.svg' | inline_asset_content -}}
  </button>
  <button class="at-home-lightbox__arrow at-home-lightbox__arrow--prev" aria-label="Previous">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="butt" stroke-linejoin="miter">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>
  <button class="at-home-lightbox__arrow at-home-lightbox__arrow--next" aria-label="Next">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="butt" stroke-linejoin="miter">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>
  <div class="at-home-lightbox__stage">
    <img class="at-home-lightbox__img" src="" alt="" width="1600" height="1200" loading="eager">
  </div>
</div>

{% javascript %}
(function () {
  var lightbox = document.getElementById('at-home-lightbox');
  if (!lightbox) return;
  var img = lightbox.querySelector('.at-home-lightbox__img');
  var backdrop = lightbox.querySelector('.at-home-lightbox__backdrop');
  var closeBtn = lightbox.querySelector('.at-home-lightbox__close');
  var prevBtn = lightbox.querySelector('.at-home-lightbox__arrow--prev');
  var nextBtn = lightbox.querySelector('.at-home-lightbox__arrow--next');

  var items = [];
  var currentIndex = 0;

  function buildItems() {
    items = Array.from(document.querySelectorAll('.at-home__item')).map(function (btn) {
      return { src: btn.dataset.src, alt: btn.dataset.alt };
    });
  }

  function show(index) {
    currentIndex = (index + items.length) % items.length;
    img.src = items[currentIndex].src;
    img.alt = items[currentIndex].alt;
    prevBtn.style.display = items.length > 1 ? '' : 'none';
    nextBtn.style.display = items.length > 1 ? '' : 'none';
  }

  function open(index) {
    buildItems();
    show(index);
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setTimeout(function () { img.src = ''; }, 300);
  }

  var grid = document.querySelector('.at-home__grid');
  var canHover = window.matchMedia('(hover: hover)').matches;

  document.querySelectorAll('.at-home__item').forEach(function (btn, i) {
    btn.addEventListener('click', function () { open(i); });

    if (canHover && grid) {
      btn.addEventListener('mouseenter', function () {
        grid.classList.add('has-hover');
        btn.classList.add('is-hovered');
      });
      btn.addEventListener('mouseleave', function () {
        grid.classList.remove('has-hover');
        btn.classList.remove('is-hovered');
      });
    }
  });

  prevBtn.addEventListener('click', function () { show(currentIndex - 1); });
  nextBtn.addEventListener('click', function () { show(currentIndex + 1); });
  backdrop.addEventListener('click', close);
  closeBtn.addEventListener('click', close);
  document.addEventListener('keydown', function (e) {
    if (!lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(currentIndex - 1);
    if (e.key === 'ArrowRight') show(currentIndex + 1);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "See it at home",
  "settings": [
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "See it at home"
    }
  ]
}
{% endschema %}
