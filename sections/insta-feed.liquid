<div class="insta-feed">
  <div class="section section--page-width">
    <div class="insta-feed__inner">
      <h2 class="insta-feed__title">
        Follow Us
      </h2>
      <a href="https://instagram.com/bark_and_frame" class="button insta-feed__button">@bark_and_frame</a>
    </div>
  </div>
  {% content_for 'blocks' %}
</div>



{% javascript %}

{% endjavascript %}

{% stylesheet %}
.insta-feed{
  margin: 120px 0;

  .insta-feed__inner{
    text-align: center;
  }

  .insta-feed__title{
    margin-bottom: 20px;
    font-size: 36px;
    color: var(--brown);
  }

  .insta-feed__button{
    margin: 0 auto 40px;
    background-color: transparent;
    color: var(--brown);
    border: 1px solid var(--brown);
    padding: 10px 20px;

    &:hover{
      background-color: var(--purple);
    }
  }

  marquee-component{
    --marquee-gap: 1px !important;

    .image-block{
      width: 160px;
      height: 200px;
      border: 1px solid transparent;
      border-radius: 20px;
      padding: 5px;
      transition: border .3s;
      position: relative;

      img{
        width: 100%;
        height: 100%;
        border-radius: 15px;
      }

      /*&::after{
        content: "";
        display: block;
        width: calc(100% - 10px);
        height: calc(100% - 10px);
        background-color: var(--brown);
        position: absolute;
        border-radius: 15px;
        opacity: 0;
        transition: opacity .3s;
      }*/

      &:hover{
        border-color: var(--brown);

        /*&::after{
          opacity: .81;
        }*/
      }
    }
  }
}

@media(min-width: 750px){
  .insta-feed{
    margin: 200px 0;

    .insta-feed__title{
      font-size: 96px;
    }

    marquee-component{
      --marquee-gap: 10px !important;

      .image-block{
        width: 240px;
        height: 300px;
      }
    }
  }
}

@media(min-width: 1200px){
  .insta-feed{
    margin: 300px 0 240px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Insta Feed",
  "class": "container-background-image",
  "blocks": [
    {
      "type": "_marquee"
    }
  ],
  "presets": [
    {
      "name": "Insta Feed",
      "category": "t:categories.storytelling",
    }
  ]
}
{% endschema %}