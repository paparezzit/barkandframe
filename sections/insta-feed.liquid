<div class="insta-feed">
  <div class="section section--page-width">
    <div class="insta-feed__inner">
      <h2 class="insta-feed__title">
        Follow Us
      </h2>
      <a href="https://instagram.com/bark_and_frame" class="button insta-feed__button" target="_blank" rel="noopener noreferrer">@bark_and_frame</a>
    </div>
  </div>
  {% content_for 'blocks' %}
</div>



{% javascript %}
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll(".insta-feed marquee-component").forEach(marquee => {
    const wrapper = marquee.querySelector(".marquee__wrapper");
    if (!wrapper) return;

    let pointerId = null;
    let startX = 0;
    let startY = 0;
    let startTranslateX = 0;
    let isDragging = false;
    let suppressClick = false;

    function currentTranslateX() {
      const transform = window.getComputedStyle(wrapper).transform;
      if (!transform || transform === "none") return 0;

      try {
        return new DOMMatrixReadOnly(transform).m41 || 0;
      } catch (error) {
        return 0;
      }
    }

    function finishSwipe(event) {
      if (event && pointerId !== event.pointerId) return;
      if (pointerId !== null) marquee.releasePointerCapture?.(pointerId);
      pointerId = null;
      isDragging = false;
      marquee.removeAttribute("data-swiping");
      wrapper.style.transform = "";
      wrapper.style.animationPlayState = "";
    }

    marquee.addEventListener("pointerdown", event => {
      if (event.pointerType === "mouse") return;
      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      startTranslateX = currentTranslateX();
      isDragging = false;
      marquee.setPointerCapture?.(event.pointerId);
      marquee.setAttribute("data-swiping", "true");
      wrapper.style.animationPlayState = "paused";
    });

    marquee.addEventListener("pointermove", event => {
      if (pointerId !== event.pointerId) return;

      const deltaX = event.clientX - startX;
      const deltaY = event.clientY - startY;

      if (!isDragging && Math.abs(deltaY) > Math.abs(deltaX) && Math.abs(deltaY) > 8) {
        finishSwipe(event);
        return;
      }

      if (Math.abs(deltaX) < 8) return;

      isDragging = true;
      suppressClick = true;
      wrapper.style.transform = `translate3d(${startTranslateX + deltaX}px, 0, 0)`;
      event.preventDefault();
    }, { passive: false });

    marquee.addEventListener("pointerup", finishSwipe);
    marquee.addEventListener("pointercancel", finishSwipe);

    marquee.addEventListener("click", event => {
      if (!suppressClick) return;
      event.preventDefault();
      event.stopPropagation();
      suppressClick = false;
    }, true);
  });
});

{% endjavascript %}

{% stylesheet %}
.insta-feed{
  margin: 120px 0;

  .insta-feed__inner{
    text-align: center;
  }

  .insta-feed__title{
    margin-bottom: 20px;
    font-size: 36px;
    color: var(--brown);
  }

  .insta-feed__button{
    margin: 0 auto 40px;
    background-color: transparent;
    color: var(--brown);
    border: 1px solid var(--brown);
    padding: 10px 20px;

    &:hover{
      background-color: var(--purple);
    }
  }

  marquee-component{
    --marquee-gap: 1px !important;
    cursor: grab;
    touch-action: pan-y;

    &[data-swiping='true']{
      cursor: grabbing;

      .marquee__wrapper{
        animation-play-state: paused !important;
      }
    }

    .image-block{
      width: 160px;
      height: 200px;
      border: 1px solid transparent;
      border-radius: 20px;
      padding: 5px;
      transition: border .3s;
      position: relative;

      img{
        width: 100%;
        height: 100%;
        border-radius: 15px;
      }

      /*&::after{
        content: "";
        display: block;
        width: calc(100% - 10px);
        height: calc(100% - 10px);
        background-color: var(--brown);
        position: absolute;
        border-radius: 15px;
        opacity: 0;
        transition: opacity .3s;
      }*/

      &:hover{
        border-color: var(--brown);

        /*&::after{
          opacity: .81;
        }*/
      }
    }
  }
}

@media(min-width: 750px){
  .insta-feed{
    margin: 200px 0;

    .insta-feed__title{
      font-size: 96px;
    }

    marquee-component{
      --marquee-gap: 10px !important;

      .image-block{
        width: 240px;
        height: 300px;
      }
    }
  }
}

@media(min-width: 1200px){
  .insta-feed{
    margin: 300px 0 240px;
  }
}
{% endstylesheet %}

