<div class="prod-accordion-section section section--page-width">
  <div class="prod-accordion-section__inner">

    {%- if product.description != blank -%}
      <div class="prod-accordion-section__description rte">
        {{ product.description }}
      </div>
    {%- endif -%}

    {%- assign product_the_fabric = product.metafields.custom.the_fabric -%}
    {%- assign product_the_fit = product.metafields.custom.the_fit -%}
    {%- assign product_size_guide = product.metafields.custom.size_guide -%}
    {%- assign product_made = product.metafields.custom.made -%}
    {%- assign product_care = product.metafields.custom.care -%}
    {%- assign product_handle_downcase = product.handle | downcase -%}
    {%- assign product_type_downcase = product.type | downcase -%}
    {%- assign product_title_downcase = product.title | downcase -%}
    {%- assign is_crewneck_product = false -%}
    {%- if product_type_downcase contains 'crewneck'
      or product_type_downcase contains 'crew neck'
      or product_title_downcase contains 'crewneck'
      or product_title_downcase contains 'crew neck'
    -%}
      {%- assign is_crewneck_product = true -%}
    {%- endif -%}
    {%- assign is_tshirt_product = false -%}
    {%- if product_type_downcase contains 't-shirt'
      or product_type_downcase contains 't shirt'
      or product_title_downcase contains 't-shirt'
      or product_title_downcase contains 't shirt'
    -%}
      {%- assign is_tshirt_product = true -%}
    {%- endif -%}
    {%- assign is_cap_product = false -%}
    {%- if product_type_downcase == 'cap' or product_title_downcase contains ' cap' or product_title_downcase contains '| cap' -%}
      {%- assign is_cap_product = true -%}
    {%- endif -%}
    {%- assign is_charity_cap_product = false -%}
    {%- if is_cap_product -%}
      {%- if product_handle_downcase contains 'give-love' or product_handle_downcase contains 'charity' or product_title_downcase contains 'charity' -%}
        {%- assign is_charity_cap_product = true -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign product_detail_icon_keys = '' -%}
    {%- assign product_detail_icons_metafield = product.metafields.custom.detail_icons -%}
    {%- if product_detail_icons_metafield != blank -%}
      {%- assign product_detail_icons_text = product_detail_icons_metafield.value | join: '||' | downcase -%}
      {%- if product_detail_icons_text contains '10 eur to charity' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: '10 Eur to Charity||' -%}
      {%- endif -%}
      {%- if product_detail_icons_text contains 'natural' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: 'Natural||' -%}
      {%- endif -%}
      {%- if product_detail_icons_text contains '100% organic' or product_detail_icons_text contains '100 organic' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: '100% Organic||' -%}
      {%- endif -%}
      {%- if product_detail_icons_text contains 'human friendly' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: 'Human Friendly||' -%}
      {%- endif -%}
      {%- if product_detail_icons_text contains 'quality product' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: 'Quality Product||' -%}
      {%- endif -%}
    {%- endif -%}
    {%- if product_detail_icon_keys == '' -%}
      {%- if is_charity_cap_product -%}
        {%- assign product_detail_icon_keys = '10 Eur to Charity||100% Organic||Human Friendly||' -%}
      {%- elsif is_crewneck_product -%}
        {%- assign product_detail_icon_keys = 'Natural||Human Friendly||Quality Product||' -%}
      {%- elsif is_tshirt_product or is_cap_product -%}
        {%- assign product_detail_icon_keys = '100% Organic||Human Friendly||Quality Product||' -%}
      {%- endif -%}
    {%- endif -%}

    {%- if product_detail_icon_keys != blank -%}
      <ul class="prod-detail-icons" role="list" aria-label="Product highlights">
        {%- assign product_detail_icon_labels = product_detail_icon_keys | split: '||' -%}
        {%- for product_detail_icon in product_detail_icon_labels -%}
          {%- assign product_detail_icon_label = product_detail_icon | strip -%}
          {%- if product_detail_icon_label != blank -%}
            {%- liquid
              assign product_detail_icon_handle = product_detail_icon_label | handleize
              assign product_detail_icon_asset = ''
              assign product_detail_icon_display = product_detail_icon_label

              case product_detail_icon_handle
                when '100-organic'
                  assign product_detail_icon_asset = 'product-icon-100-organic.svg'
                  assign product_detail_icon_display = '100%<br>Organic'
                when 'natural'
                  assign product_detail_icon_asset = 'product-icon-natural.svg'
                  assign product_detail_icon_display = 'Natural'
                when 'quality-product'
                  assign product_detail_icon_asset = 'product-icon-quality-product.svg'
                  assign product_detail_icon_display = 'Quality Product'
                when 'human-friendly'
                  assign product_detail_icon_asset = 'product-icon-human-friendly.svg'
                  assign product_detail_icon_display = 'Human Friendly'
                when '10-eur-to-charity'
                  assign product_detail_icon_asset = 'product-icon-10-eur-to-charity.svg'
                  assign product_detail_icon_display = '10 Eur to Charity'
              endcase
            -%}
            {%- if product_detail_icon_asset != blank -%}
              <li class="prod-detail-icons__item">
                <img
                  class="prod-detail-icons__icon"
                  src="{{ product_detail_icon_asset | asset_url }}"
                  alt=""
                  width="100"
                  height="100"
                  loading="lazy"
                >
                <span class="prod-detail-icons__label">{{ product_detail_icon_display }}</span>
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="prod-accordion-section__accordions" id="prod-accordions">
      {%- assign opened_product_accordion = false -%}

      {%- if product_the_fabric != blank -%}
        <accordion-custom>
          <details class="details prod-accordion" open>
            {%- assign opened_product_accordion = true -%}
            <summary class="prod-accordion__summary">
              <span>The fabric</span>
              <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
            </summary>
            <div class="details-content prod-accordion__body">
              {{ product_the_fabric | metafield_tag }}
            </div>
          </details>
        </accordion-custom>
      {%- endif -%}

      {%- if product_the_fit != blank -%}
        <accordion-custom>
          <details class="details prod-accordion"{% unless opened_product_accordion %} open{% assign opened_product_accordion = true %}{% endunless %}>
            <summary class="prod-accordion__summary">
              <span>The fit</span>
              <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
            </summary>
            <div class="details-content prod-accordion__body">
              {{ product_the_fit | metafield_tag }}
            </div>
          </details>
        </accordion-custom>
      {%- endif -%}

      {%- if product_size_guide != blank -%}
        <accordion-custom>
          <details class="details prod-accordion"{% unless opened_product_accordion %} open{% assign opened_product_accordion = true %}{% endunless %}>
            <summary class="prod-accordion__summary">
              <span>Size guide</span>
              <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
            </summary>
            <div class="details-content prod-accordion__body">
              {%- if is_crewneck_product -%}
                <p class="baf-size-guide__intro">Body length × Chest width.</p>
                <div class="baf-size-guide" aria-label="Crewneck size guide">
                  <h3 class="baf-size-guide__title">Crewneck</h3>
                  <table class="baf-size-guide__table">
                    <thead>
                      <tr>
                        <th scope="col"><span class="baf-size-guide__badge baf-size-guide__badge--size">SIZE</span></th>
                        <th scope="col"><span class="baf-size-guide__badge">CM</span></th>
                        <th scope="col"><span class="baf-size-guide__badge">IN</span></th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <th scope="row">S</th>
                        <td>68.5 × 84 to 91</td>
                        <td>27.0 × 33.1 to 35.8</td>
                      </tr>
                      <tr>
                        <th scope="row">M</th>
                        <td>71 × 94 to 101</td>
                        <td>28.0 × 37.0 to 39.8</td>
                      </tr>
                      <tr>
                        <th scope="row">L</th>
                        <td>73.5 × 104 to 109</td>
                        <td>29.0 × 40.9 to 42.9</td>
                      </tr>
                      <tr>
                        <th scope="row">XL</th>
                        <td>76 × 112 to 117</td>
                        <td>30.0 × 44.1 to 46.1</td>
                      </tr>
                      <tr>
                        <th scope="row">XXL</th>
                        <td>78.5 × 119 to 124</td>
                        <td>31.0 × 46.9 to 48.8</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              {%- elsif is_tshirt_product -%}
                <p class="baf-size-guide__intro">Body length × Chest width.</p>
                <div class="baf-size-guide" aria-label="T-Shirt size guide">
                  <h3 class="baf-size-guide__title">T-Shirt</h3>
                  <table class="baf-size-guide__table">
                    <thead>
                      <tr>
                        <th scope="col"><span class="baf-size-guide__badge baf-size-guide__badge--size">SIZE</span></th>
                        <th scope="col"><span class="baf-size-guide__badge">CM</span></th>
                        <th scope="col"><span class="baf-size-guide__badge">IN</span></th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <th scope="row">S</th>
                        <td>71 × 110</td>
                        <td>28.0 × 43.3</td>
                      </tr>
                      <tr>
                        <th scope="row">M</th>
                        <td>75 × 116</td>
                        <td>29.5 × 45.7</td>
                      </tr>
                      <tr>
                        <th scope="row">L</th>
                        <td>77 × 122</td>
                        <td>30.3 × 48.0</td>
                      </tr>
                      <tr>
                        <th scope="row">XL</th>
                        <td>79 × 128</td>
                        <td>31.1 × 50.4</td>
                      </tr>
                      <tr>
                        <th scope="row">XXL</th>
                        <td>81 × 134</td>
                        <td>31.9 × 52.8</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              {%- elsif is_cap_product -%}
                <div class="baf-size-guide" aria-label="Cap size guide">
                  <h3 class="baf-size-guide__title">Cap</h3>
                  <table class="baf-size-guide__table baf-size-guide__table--single">
                    <thead>
                      <tr>
                        <th scope="col"><span class="baf-size-guide__badge baf-size-guide__badge--size">SIZE</span></th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>One size · adjustable</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              {%- else -%}
                {{ product_size_guide | metafield_tag }}
              {%- endif -%}
            </div>
          </details>
        </accordion-custom>
      {%- endif -%}

      {%- if product_made != blank -%}
        <accordion-custom>
          <details class="details prod-accordion"{% unless opened_product_accordion %} open{% assign opened_product_accordion = true %}{% endunless %}>
            <summary class="prod-accordion__summary">
              <span>Made</span>
              <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
            </summary>
            <div class="details-content prod-accordion__body">
              {{ product_made | metafield_tag }}
            </div>
          </details>
        </accordion-custom>
      {%- endif -%}

      {%- if product_care != blank -%}
        <accordion-custom>
          <details class="details prod-accordion"{% unless opened_product_accordion %} open{% assign opened_product_accordion = true %}{% endunless %}>
            <summary class="prod-accordion__summary">
              <span>Care</span>
              <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
            </summary>
            <div class="details-content prod-accordion__body">
              {{ product_care | metafield_tag }}
            </div>
          </details>
        </accordion-custom>
      {%- endif -%}

    </div>

  </div>
</div>

{% stylesheet %}
main.content-for-layout .prod-accordion-section.section {
  --site-content-margin: var(--page-margin);
}

.prod-accordion-section {
  padding: 60px 0 80px;
}

.prod-accordion-section__inner {
  max-width: 520px;
}

.prod-accordion-section__description {
  font-size: 14px;
  line-height: 1.6;
  color: var(--brown);
  margin-bottom: 40px;
}

.prod-detail-icons {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 28px 50px;
  margin: 0 0 54px;
  padding: 0;
  color: var(--brown);
  list-style: none;
}

.prod-detail-icons__item {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 108px;
}

.prod-detail-icons__icon {
  display: block;
  width: 36px;
  height: 36px;
  flex: 0 0 36px;
  object-fit: contain;
}

.prod-detail-icons__label {
  display: block;
  max-width: 82px;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.15;
}

.prod-accordion__summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  font-size: 14px;
  font-weight: 700;
  color: var(--brown);
  cursor: pointer;
  list-style: none;
  border-bottom: 2px solid var(--beige);
}

.prod-accordion__summary::-webkit-details-marker {
  display: none;
}

.prod-accordion__summary .svg-wrapper {
  width: 22px;
  height: 22px;
  background-color: var(--beige);
  border-radius: 50%;
  flex-shrink: 0;
}

.prod-accordion__summary .svg-wrapper svg {
  width: 12px;
  height: 12px;
}

.prod-accordion .svg-wrapper.icon-plus {
  transition: transform 0.2s ease;
}

.prod-accordion[open] .svg-wrapper.icon-plus {
  transform: rotate(45deg);
}

.prod-accordion__body {
  padding: 20px 0 40px;
  font-size: 14px;
  line-height: 1.6;
  color: var(--brown);
}

.prod-accordion__body p {
  margin: 0 0 1em;
}

.prod-accordion__body img {
  margin: 2em 0;
  vertical-align: top;
  max-width: 100%;
}

.baf-size-guide {
  margin: 20px 0;
  padding: 40px 20px;
  box-sizing: border-box;
  color: var(--brown);
  background: var(--cream);
  border-radius: var(--baf-radius-md);
}

.baf-size-guide__intro {
  margin: 0 0 18px;
  color: var(--brown);
  font-size: 14px;
  font-style: normal;
  font-weight: 400;
  line-height: 1.5;
}

.baf-size-guide__title {
  margin: 0 0 10px !important;
  font-family: "display", serif;
  font-size: 21px;
  font-weight: 400;
  line-height: 1;
  text-align: center;
  text-transform: none;
}

.baf-size-guide__table {
  display: grid;
  grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1fr);
  width: 100%;
}

.baf-size-guide__table thead,
.baf-size-guide__table tbody,
.baf-size-guide__table tr {
  display: contents;
}

.baf-size-guide__table--single {
  grid-template-columns: 1fr;
}

.baf-size-guide__table th,
.baf-size-guide__table td {
  padding: 0;
  text-align: left;
  vertical-align: middle;
}

.baf-size-guide__table thead th {
  display: flex;
  align-items: center;
}

.baf-size-guide__table thead th:not(:first-child) {
  justify-content: center;
}

.baf-size-guide__table tbody th,
.baf-size-guide__table tbody td {
  padding: 14px 0;
}

.baf-size-guide__table tbody th {
  display: flex;
  flex-direction: column;
  gap: 3px;
  justify-content: center;
  padding-right: 8px;
  font-size: 14px;
  font-weight: 500;
  line-height: 1.2;
}

.baf-size-guide__table tbody td {
  display: flex;
  justify-content: center;
  align-items: center;
  border-left: 1px solid var(--brown);
  padding-inline: 16px;
  text-align: center;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.baf-size-guide__table tbody td:last-child {
  border-right: 1px solid var(--brown);
}

.baf-size-guide__table.baf-size-guide__table--single tbody td {
  justify-content: flex-start;
  border-left: 0;
  border-right: 0;
  padding-inline: 0;
  text-align: left;
  font-weight: 500;
}

.baf-size-guide__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  margin: 20px 0;
  padding: 2px 8px;
  border-radius: 999px;
  color: var(--cream);
  background: var(--green);
  font-size: 10px;
  font-weight: 500;
  line-height: 1;
}

.baf-size-guide__badge--size {
  background: var(--brown);
}

.baf-size-guide__table thead th:not(:first-child) .baf-size-guide__badge {
  margin-inline: 0;
}

@media screen and (max-width: 749px) {
  .prod-detail-icons {
    gap: 24px 34px;
    margin-bottom: 44px;
  }

  .prod-detail-icons__item {
    min-width: 100px;
  }

  .prod-detail-icons__icon {
    width: 34px;
    height: 34px;
    flex-basis: 34px;
  }

  .prod-detail-icons__label {
    max-width: 76px;
  }

  .baf-size-guide {
    padding: 40px 20px;
    border-radius: var(--baf-radius-md);
  }

  .baf-size-guide__table {
    grid-template-columns: 44px minmax(0, 1fr) minmax(0, 1fr);
  }

  .baf-size-guide__table tbody td {
    padding-inline: 10px;
  }
}

@media screen and (min-width: 750px) {
  .baf-size-guide {
    padding: 40px;
  }
}

@media (min-width: 750px) {
  .prod-accordion-section {
    padding: 80px 0 100px;
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  var accordions = document.querySelectorAll('#prod-accordions .prod-accordion');
  accordions.forEach(function (details) {
    details.addEventListener('toggle', function () {
      if (details.open) {
        accordions.forEach(function (other) {
          if (other !== details && other.open) other.open = false;
        });
      }
    });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Description + accordion",
  "presets": [
    {
      "name": "Description + accordion"
    }
  ]
}
{% endschema %}
