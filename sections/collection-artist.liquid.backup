{%- liquid
  assign artist = shop.metaobjects['artist'][section.settings.artist_handle]
  assign nav_links = linklists[section.settings.collection_nav].links
-%}

<div class="artist-collection">

  {%- if nav_links.size > 0 -%}
    <nav class="artist-collection__nav section section--page-width">
      {%- for link in nav_links -%}
        <a
          href="{{ link.url }}"
          class="artist-collection__nav-link{% if link.active %} is-active{% endif %}"
          {% if link.active %}aria-current="page"{% endif %}
        >
          {{- link.title -}}
        </a>
      {%- endfor -%}
    </nav>
  {%- endif -%}

  <div class="artist-collection__hero">
    <h1 class="artist-collection__title">{{ collection.title }}</h1>
    {%- if artist and artist.signature.value != blank -%}
      <div class="artist-collection__signature">
        <img
          src="{{ artist.signature.value | image_url: width: 400 }}"
          alt=""
          width="400"
          height="100"
          loading="eager"
        >
      </div>
    {%- endif -%}
  </div>

  <div class="artist-collection__products section section--page-width">
    {%- for product in collection.products -%}
      <a href="{{ product.url }}" class="artist-collection__product-card">
        <div class="artist-collection__product-image">
          {%- if product.featured_image -%}
            <img
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.featured_image.alt | default: product.title }}"
              width="600"
              height="720"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <span class="artist-collection__product-name">{{ product.title }}</span>
      </a>
    {%- endfor -%}
  </div>

  <div class="artist-collection__info section section--page-width">

    <div class="artist-collection__artist-bio">
      {%- if artist -%}
        {%- if artist.photo.value != blank -%}
          <div class="artist-collection__artist-photo">
            <img
              src="{{ artist.photo.value | image_url: width: 600 }}"
              alt="{{ artist.name.value }}"
              width="600"
              height="750"
              loading="lazy"
            >
          </div>
        {%- endif -%}
        <div class="artist-collection__artist-text">
          {%- if artist.name.value != blank -%}
            <p class="artist-collection__artist-name">{{ artist.name.value }}</p>
          {%- endif -%}
          {%- if artist['about-long'].value != blank -%}
            <div class="rte artist-collection__artist-about">{{ artist['about-long'].value | newline_to_br }}</div>
          {%- endif -%}
          {%- if artist.signature.value != blank -%}
            <div class="artist-collection__artist-signature">
              <img
                src="{{ artist.signature.value | image_url: width: 240 }}"
                alt=""
                width="240"
                height="60"
                loading="lazy"
              >
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="artist-collection__collection-desc">
      {%- if section.settings.collection_title != blank -%}
        <h2 class="artist-collection__desc-title">{{ section.settings.collection_title }}</h2>
      {%- endif -%}
      {%- if section.settings.collection_text != blank -%}
        <div class="artist-collection__desc-text rte">{{ section.settings.collection_text }}</div>
      {%- endif -%}
      {%- if section.settings.collection_claim != blank -%}
        <p class="artist-collection__desc-claim">{{ section.settings.collection_claim }}</p>
      {%- endif -%}
    </div>

  </div>

</div>

{% stylesheet %}
  .artist-collection__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    padding-top: 40px;
    padding-bottom: 0;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .artist-collection__nav-link {
    display: inline-block;
    font-family: "display", serif;
    font-size: 21px;
    color: var(--brown);
    text-decoration: none;
    opacity: 0.35;
    padding: 6px 16px;
    transition: opacity .2s;
    white-space: nowrap;

    &:hover {
      opacity: 0.7;
    }

    &.is-active {
      opacity: 1;
    }
  }

  .artist-collection__hero {
    padding: 60px var(--page-margin) 50px;
    text-align: center;
  }

  .artist-collection__title {
    font-family: "display", serif;
    font-size: clamp(48px, 8vw, 96px);
    line-height: 1;
    color: var(--brown);
    font-weight: 400;
    margin: 0 0 28px;
  }

  .artist-collection__signature {
    display: flex;
    justify-content: center;

    img {
      width: auto;
      height: 56px;
      object-fit: contain;
    }
  }

  .artist-collection__products {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .artist-collection__product-card {
    display: block;
    text-decoration: none;
    color: var(--brown);
  }

  .artist-collection__product-image {
    aspect-ratio: 5/6;
    overflow: hidden;
    border-radius: 10px;
    background: var(--cream);
    margin-bottom: 12px;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
      transition: transform .4s ease;
    }
  }

  .artist-collection__product-card:hover .artist-collection__product-image img {
    transform: scale(1.04);
  }

  .artist-collection__product-name {
    font-family: "display", serif;
    font-size: 18px;
    line-height: 1.3;
    color: var(--brown);
  }

  .artist-collection__info {
    display: flex;
    flex-direction: column;
    gap: 60px;
    padding-top: 60px;
    padding-bottom: 100px;
    border-top: 1px solid var(--brown);
  }

  .artist-collection__artist-bio {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .artist-collection__artist-photo {
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;

    img {
      width: 100%;
      display: block;
      object-fit: cover;
    }
  }

  .artist-collection__artist-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .artist-collection__artist-name {
    font-family: "display", serif;
    font-size: 24px;
    color: var(--brown);
    margin: 0;
    font-weight: 400;
  }

  .artist-collection__artist-about {
    font-size: 15px;
    line-height: 1.7;
    color: var(--brown);
    margin: 0;
  }

  .artist-collection__artist-signature img {
    height: 44px;
    width: auto;
    display: block;
  }

  .artist-collection__collection-desc {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .artist-collection__desc-title {
    font-family: "display", serif;
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 400;
    color: var(--brown);
    margin: 0;
    line-height: 1.1;
  }

  .artist-collection__desc-text {
    font-size: 15px;
    line-height: 1.7;
    color: var(--brown);
    margin: 0;
  }

  .artist-collection__desc-claim {
    font-family: "display", serif;
    font-size: clamp(20px, 3vw, 30px);
    font-style: italic;
    color: var(--brown);
    margin: 0;
    line-height: 1.3;
  }

  @media screen and (min-width: 750px) {
    .artist-collection__hero {
      padding-top: 100px;
    }

    .artist-collection__products {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .artist-collection__info {
      flex-direction: row;
      gap: 60px;
      align-items: start;
    }

    .artist-collection__artist-bio {
      flex: 1;
      flex-direction: row;
      align-items: start;
    }

    .artist-collection__artist-photo {
      width: 200px;
    }

    .artist-collection__collection-desc {
      flex: 1;
    }
  }

  @media screen and (min-width: 1200px) {
    .artist-collection__hero {
      padding-top: 160px;
    }

    .artist-collection__products {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }

    .artist-collection__info {
      gap: 100px;
      padding-top: 80px;
      padding-bottom: 140px;
    }

    .artist-collection__artist-photo {
      width: 260px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Artist Collection",
  "settings": [
    {
      "type": "link_list",
      "id": "collection_nav",
      "label": "Navigace kolekcí",
      "info": "Vyberte menu s odkazy na jednotlivé kolekce umělce"
    },
    {
      "type": "text",
      "id": "artist_handle",
      "label": "Handle umělce",
      "info": "Najdete ho v Shopify Admin → Content → Metaobjects → Artist → upravit záznam → v URL je poslední část (např. 'jan-novak')"
    },
    {
      "type": "header",
      "content": "Popis kolekce (pravý sloupec)"
    },
    {
      "type": "text",
      "id": "collection_title",
      "label": "Nadpis"
    },
    {
      "type": "richtext",
      "id": "collection_text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "collection_claim",
      "label": "Claim"
    }
  ]
}
{% endschema %}
