{%- liquid
  assign wearable_art_count = 0
-%}

<link rel="stylesheet" href="{{ 'baf-section-wearable-art-products.css' | asset_url }}" media="print, (min-width: 990px)" onload="this.onload=null;this.media='all'">
<noscript>{{ 'baf-section-wearable-art-products.css' | asset_url | stylesheet_tag }}</noscript>

{%- capture wearable_art_cards -%}
  {%- for product in section.settings.products limit: 10 -%}
    {%- if product != blank -%}
      {%- assign wearable_art_count = wearable_art_count | plus: 1 -%}
      <li
        class="shop-products__rail-item"
        data-product-id="{{ product.id }}"
        data-product-handle="{{ product.handle }}"
        {% if product.handle == 'bloom-t-shirt' %}
          data-product-url-override="/products/bloom-t-shirt?variant=54206718247258"
        {% endif %}
      >
        {%- # theme-check-disable UniqueStaticBlockId -%}
        {%- content_for 'block', type: '_product-card', id: 'product-card', closest.product: product -%}
        {%- # theme-check-enable UniqueStaticBlockId -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if wearable_art_count == 0 -%}
  {%- capture wearable_art_cards -%}
    {%- assign default_wearable_art_handles = 'give-love-cap,sunday-ride-t-shirt,more-dog-is-more-dog-cap,powered-by-dogs-t-shirt,chill-vibes-crewneck,bloom-t-shirt' | split: ',' -%}
    {%- for handle in default_wearable_art_handles -%}
      {%- assign product = all_products[handle] -%}
      {%- if product != blank -%}
        {%- assign wearable_art_count = wearable_art_count | plus: 1 -%}
        <li
          class="shop-products__rail-item"
          data-product-id="{{ product.id }}"
          data-product-handle="{{ product.handle }}"
          {% if product.handle == 'bloom-t-shirt' %}
            data-product-url-override="/products/bloom-t-shirt?variant=54206718247258"
          {% endif %}
        >
          {%- # theme-check-disable UniqueStaticBlockId -%}
          {%- content_for 'block', type: '_product-card', id: 'product-card', closest.product: product -%}
          {%- # theme-check-enable UniqueStaticBlockId -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

{%- if wearable_art_cards != blank -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>

  <section
    class="wearable-art-products section color-{{ section.settings.color_scheme }}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    {{ section.shopify_attributes }}
  >
    <div class="wearable-art-products__inner">
      <section id="wearable-art-products-bestseller" class="wearable-art-products__bestseller wearable-art-products__anchor">
        <h2 class="wearable-art-products__section-title wearable-art-products__section-title--center">
          {{ section.settings.title }}
        </h2>

        <div class="wearable-art-products__bestseller-carousel" data-wearable-art-carousel>
          <div class="shop-products__rail" data-wearable-art-rail>
            <ul
              class="shop-products__rail-track"
              role="list"
              data-wearable-art-card-count="{{ wearable_art_count }}"
              data-wearable-art-set-count="1"
              data-wearable-art-clone-set-count="9"
            >
              {{ wearable_art_cards }}
            </ul>
          </div>
          <slideshow-arrows class="wearable-art-products__bestseller-arrows product-gallery__arrows" position="center">
            <button
              class="wearable-art-products__bestseller-arrow slideshow-control slideshow-control--previous button button-unstyled button-unstyled--transparent"
              type="button"
              aria-label="Previous product"
              data-wearable-art-prev
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="butt" stroke-linejoin="miter">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </button>
            <button
              class="wearable-art-products__bestseller-arrow slideshow-control slideshow-control--next button button-unstyled button-unstyled--transparent"
              type="button"
              aria-label="Next product"
              data-wearable-art-next
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="butt" stroke-linejoin="miter">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </button>
          </slideshow-arrows>
        </div>
      </section>
    </div>
  </section>
{%- endif -%}

<script>
  (() => {
    const carousels = document.querySelectorAll('[data-wearable-art-carousel]');

    const initCarousel = (carousel) => {
      if (carousel.dataset.wearableArtReady === 'true') return;
      carousel.dataset.wearableArtReady = 'true';

      const rail = carousel.querySelector('[data-wearable-art-rail]');
      if (!rail) return;

      const track = rail.querySelector('.shop-products__rail-track');
      const prev = carousel.querySelector('[data-wearable-art-prev]');
      const next = carousel.querySelector('[data-wearable-art-next]');
      if (!track || !prev || !next) return;

      let loopPoint = 0;
      let normalizeTimer = null;
      let refreshFrame = null;
      let lastMeasuredWidth = Math.round(rail.clientWidth || window.innerWidth);
      const cardCount = Number.parseInt(track.dataset.wearableArtCardCount || '0', 10);
      let setCount = Number.parseInt(track.dataset.wearableArtSetCount || '1', 10);
      const cloneSetCount = Number.parseInt(track.dataset.wearableArtCloneSetCount || '9', 10);

      if (cardCount > 0 && cloneSetCount > setCount && track.dataset.wearableArtCloned !== 'true') {
        const sourceItems = Array.from(track.children).slice(0, cardCount);
        const fragment = document.createDocumentFragment();

        for (let setIndex = setCount; setIndex < cloneSetCount; setIndex += 1) {
          sourceItems.forEach((item) => {
            const clone = item.cloneNode(true);
            fragment.appendChild(clone);
          });
        }

        track.appendChild(fragment);
        setCount = cloneSetCount;
        track.dataset.wearableArtSetCount = String(setCount);
        track.dataset.wearableArtCloned = 'true';
      }

      const middleSetIndex = Math.floor(setCount / 2);

      carousel.querySelectorAll('[data-product-url-override]').forEach((item) => {
        const overrideUrl = item.dataset.productUrlOverride;
        if (!overrideUrl) return;

        item.querySelectorAll('a[href]').forEach((link) => {
          link.setAttribute('href', overrideUrl);
        });
      });

      const measureLoopPoint = () => {
        const firstItem = track.children[0];
        const nextSetFirstItem = cardCount > 0 ? track.children[cardCount] : null;
        loopPoint = firstItem && nextSetFirstItem
          ? nextSetFirstItem.offsetLeft - firstItem.offsetLeft
          : 0;
      };

      const jumpWithoutAnimation = (left) => {
        rail.style.scrollBehavior = 'auto';
        rail.scrollLeft = Math.round(left);
        rail.offsetHeight;
        rail.style.scrollBehavior = '';
      };

      const normalizePosition = () => {
        if (loopPoint <= 0) return;

        const middleStart = loopPoint * middleSetIndex;
        const min = loopPoint;
        const max = loopPoint * (setCount - 2);
        const current = rail.scrollLeft;

        if (current < min) {
          jumpWithoutAnimation(current + middleStart);
        } else if (current > max) {
          jumpWithoutAnimation(current - middleStart);
        }
      };

      const refreshRail = () => {
        measureLoopPoint();
        lastMeasuredWidth = Math.round(rail.clientWidth || window.innerWidth);

        if (loopPoint <= 0) return;

        const middleStart = loopPoint * middleSetIndex;
        if (!rail.dataset.infiniteRailReady) {
          jumpWithoutAnimation(middleStart);
          rail.dataset.infiniteRailReady = 'true';
        } else {
          normalizePosition();
        }
      };

      const queueRefreshRail = () => {
        if (refreshFrame) return;
        refreshFrame = window.requestAnimationFrame(() => {
          refreshFrame = null;
          refreshRail();
        });
      };

      const handleResize = () => {
        const currentWidth = Math.round(rail.clientWidth || window.innerWidth);
        if (Math.abs(currentWidth - lastMeasuredWidth) < 2) return;
        lastMeasuredWidth = currentWidth;
        queueRefreshRail();
      };

      const getStep = () => {
        const items = track.querySelectorAll('.shop-products__rail-item');
        if (items.length > 1) {
          return Math.abs(items[1].offsetLeft - items[0].offsetLeft);
        }

        const item = items[0];
        const gap = parseFloat(getComputedStyle(track).gap) || 0;
        return item ? item.getBoundingClientRect().width + gap : rail.clientWidth;
      };

      const scrollByDirection = (direction) => {
        refreshRail();
        const step = getStep();
        if (step <= 0) return;

        normalizePosition();
        const target = rail.scrollLeft + (step * direction);
        rail.scrollTo({ left: target, behavior: 'smooth' });
      };

      prev.addEventListener('click', () => {
        scrollByDirection(-1);
      });

      next.addEventListener('click', () => {
        scrollByDirection(1);
      });

      rail.addEventListener('scroll', () => {
        clearTimeout(normalizeTimer);
        normalizeTimer = window.setTimeout(normalizePosition, 180);
      }, { passive: true });

      rail.addEventListener('scrollend', normalizePosition, { passive: true });

      track.querySelectorAll('img').forEach((image) => {
        image.setAttribute('loading', 'lazy');
        image.setAttribute('decoding', 'async');
        image.draggable = false;
      });

      track.querySelectorAll('img').forEach((image) => {
        if (!image.complete) image.addEventListener('load', queueRefreshRail, { once: true });
      });

      window.addEventListener('resize', handleResize, { passive: true });
      refreshRail();
      window.setTimeout(refreshRail, 400);

      document.addEventListener('shopify:section:unload', () => {
        if (refreshFrame) window.cancelAnimationFrame(refreshFrame);
        clearTimeout(normalizeTimer);
        window.removeEventListener('resize', handleResize);
      }, { once: true });
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.unobserve(entry.target);
          initCarousel(entry.target);
        });
      }, { rootMargin: '900px 0px' });

      carousels.forEach((carousel) => observer.observe(carousel));
    } else {
      carousels.forEach(initCarousel);
    }
  })();
</script>

{% schema %}
{
  "name": "Wearable art products",
  "enabled_on": {
    "templates": ["index"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Wearable art designed by artists"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 10
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Wearable art products"
    }
  ]
}
{% endschema %}
