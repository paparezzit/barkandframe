{%- liquid
  assign cap_cards = ''
  assign tshirt_cards = ''
  assign crewneck_cards = ''
  assign cap_count = 0
  assign tshirt_count = 0
  assign crewneck_count = 0
  assign bestseller_count = 0
-%}

{%- paginate collection.products by 50 -%}
  {%- for product in collection.products -%}
    {%- liquid
      assign product_type = product.type | downcase
      assign product_title = product.title | downcase
      assign is_cap = false
      assign is_tshirt = false
      assign is_crewneck = false

      if product_type == 'cap' or product_title contains '| cap' or product_title contains ' cap'
        assign is_cap = true
      elsif product_type contains 't-shirt' or product_type contains 't shirt' or product_title contains '| t-shirt' or product_title contains '| t shirt'
        assign is_tshirt = true
      elsif product_type contains 'crewneck' or product_type contains 'crew neck' or product_title contains '| crewneck' or product_title contains '| crew neck'
        assign is_crewneck = true
      endif
    -%}

    {%- capture card_markup -%}
      <li class="shop-products__grid-item" data-product-id="{{ product.id }}">
        {%- # theme-check-disable UniqueStaticBlockId -%}
        {%- content_for 'block', type: '_product-card', id: 'product-card', closest.product: product -%}
        {%- # theme-check-enable UniqueStaticBlockId -%}
      </li>
    {%- endcapture -%}

    {%- if is_cap -%}
      {%- assign cap_cards = cap_cards | append: card_markup -%}
      {%- assign cap_count = cap_count | plus: 1 -%}
    {%- elsif is_tshirt -%}
      {%- assign tshirt_cards = tshirt_cards | append: card_markup -%}
      {%- assign tshirt_count = tshirt_count | plus: 1 -%}
    {%- elsif is_crewneck -%}
      {%- assign crewneck_cards = crewneck_cards | append: card_markup -%}
      {%- assign crewneck_count = crewneck_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endpaginate -%}

{%- capture bestseller_cards -%}
  {%- for product in section.settings.bestseller_products limit: 10 -%}
    {%- if product != blank -%}
      {%- assign bestseller_count = bestseller_count | plus: 1 -%}
      <li
        class="shop-products__rail-item"
        data-product-id="{{ product.id }}"
        data-product-handle="{{ product.handle }}"
        {% if product.handle == 'bloom-t-shirt' %}
          data-product-url-override="/products/bloom-t-shirt?variant=54206718247258"
        {% endif %}
      >
        {%- # theme-check-disable UniqueStaticBlockId -%}
        {%- content_for 'block', type: '_product-card', id: 'product-card', closest.product: product -%}
        {%- # theme-check-enable UniqueStaticBlockId -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if bestseller_count == 0 -%}
  {%- capture bestseller_cards -%}
    {%- assign default_bestseller_handles = 'give-love-cap,sunday-ride-t-shirt,more-dog-is-more-dog-cap,powered-by-dogs-t-shirt,chill-vibes-crewneck,bloom-t-shirt' | split: ',' -%}
    {%- for handle in default_bestseller_handles -%}
      {%- assign product = all_products[handle] -%}
      {%- if product != blank -%}
        {%- assign bestseller_count = bestseller_count | plus: 1 -%}
        <li
          class="shop-products__rail-item"
          data-product-id="{{ product.id }}"
          data-product-handle="{{ product.handle }}"
          {% if product.handle == 'bloom-t-shirt' %}
            data-product-url-override="/products/bloom-t-shirt?variant=54206718247258"
          {% endif %}
        >
          {%- # theme-check-disable UniqueStaticBlockId -%}
          {%- content_for 'block', type: '_product-card', id: 'product-card', closest.product: product -%}
          {%- # theme-check-enable UniqueStaticBlockId -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<section
  class="shop-products section color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <nav class="shop-products__nav section section--page-width" aria-label="Shop products sections" data-baf-scroll-subnav>
    <a class="shop-products__nav-link is-active" href="#shop-products-custom">{{ section.settings.custom_portrait_title }}</a>
    {%- if bestseller_cards != blank -%}<a class="shop-products__nav-link" href="#shop-products-bestseller">{{ section.settings.bestseller_title }}</a>{%- endif -%}
    {%- if cap_count > 0 -%}<a class="shop-products__nav-link" href="#shop-products-cap">{{ section.settings.cap_title }}</a>{%- endif -%}
    {%- if tshirt_count > 0 -%}<a class="shop-products__nav-link" href="#shop-products-tshirt">{{ section.settings.tshirt_title }}</a>{%- endif -%}
    {%- if crewneck_count > 0 -%}<a class="shop-products__nav-link" href="#shop-products-crewneck">{{ section.settings.crewneck_title }}</a>{%- endif -%}
  </nav>

  <div class="shop-products__inner">
    <section id="shop-products-custom" class="shop-products__custom shop-products__anchor">
      <h1 class="shop-products__hero-title">{{ section.settings.custom_portrait_title }}</h1>

      <div class="shop-products__portrait-grid">
        {%- render 'shop-products-portrait-tile',
          image: section.settings.portrait_1_image,
          style_label: section.settings.portrait_1_style_label,
          style_id: section.settings.portrait_1_style_id,
          product: section.settings.portrait_1_product,
          product_label: section.settings.portrait_1_product_label,
          product_handle_override: section.settings.portrait_1_product_handle_override,
          preset_product_category: 'canvas',
          preset_size: '20″×28″',
          preset_framing: 'framed',
          preset_color: 'brown',
          button_label: section.settings.portrait_1_button_label,
          click_id: 'baf-click-collection-portrait-01',
          fallback_image: 'make-portrait/overview01.png'
        -%}

        {%- render 'shop-products-portrait-tile',
          image: section.settings.portrait_2_image,
          style_label: section.settings.portrait_2_style_label,
          style_id: section.settings.portrait_2_style_id,
          product: section.settings.portrait_2_product,
          product_label: section.settings.portrait_2_product_label,
          product_handle_override: section.settings.portrait_2_product_handle_override,
          preset_product_category: 'canvas',
          preset_size: '20″×28″',
          preset_framing: 'framed',
          preset_color: 'brown',
          button_label: section.settings.portrait_2_button_label,
          click_id: 'baf-click-collection-portrait-02',
          fallback_image: 'make-portrait/overview02.png'
        -%}

        {%- render 'shop-products-portrait-tile',
          image: section.settings.portrait_3_image,
          style_label: section.settings.portrait_3_style_label,
          style_id: section.settings.portrait_3_style_id,
          product: section.settings.portrait_3_product,
          product_label: section.settings.portrait_3_product_label,
          product_handle_override: section.settings.portrait_3_product_handle_override,
          preset_product_category: 'paper',
          preset_size: '50×70 cm',
          preset_border: 'no-border',
          preset_framing: 'framed',
          preset_color: 'oak',
          button_label: section.settings.portrait_3_button_label,
          click_id: 'baf-click-collection-portrait-03',
          fallback_image: 'make-portrait/bark-and-frame-configurator-hero-jack-russell-with-his-portrait-gentleman-old-master-style-living-room.jpg'
        -%}
      </div>
      <div class="shop-products__portrait-scrollbar" aria-hidden="true">
        <span class="shop-products__portrait-scrollbar-thumb"></span>
      </div>
    </section>

    {%- if bestseller_cards != blank -%}
      <section id="shop-products-bestseller" class="shop-products__bestseller shop-products__anchor">
        <h2 class="shop-products__section-title shop-products__section-title--center">
          {{ section.settings.bestseller_title }}
        </h2>

        <div class="shop-products__bestseller-carousel" data-shop-bestseller-carousel>
          <div class="shop-products__rail" data-shop-bestseller-rail>
            <ul
              class="shop-products__rail-track"
              role="list"
              data-shop-bestseller-card-count="{{ bestseller_count }}"
              data-shop-bestseller-set-count="9"
            >
              {%- for i in (1..9) -%}
                {{ bestseller_cards }}
              {%- endfor -%}
            </ul>
          </div>
          <slideshow-arrows class="shop-products__bestseller-arrows product-gallery__arrows" position="center">
            <button
              class="shop-products__bestseller-arrow slideshow-control slideshow-control--previous button button-unstyled button-unstyled--transparent"
              type="button"
              aria-label="Previous product"
              data-shop-bestseller-prev
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="butt" stroke-linejoin="miter">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </button>
            <button
              class="shop-products__bestseller-arrow slideshow-control slideshow-control--next button button-unstyled button-unstyled--transparent"
              type="button"
              aria-label="Next product"
              data-shop-bestseller-next
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="butt" stroke-linejoin="miter">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </button>
          </slideshow-arrows>
        </div>
      </section>
    {%- endif -%}

    {%- if cap_cards != blank -%}
      <section id="shop-products-cap" class="shop-products__product-section shop-products__anchor">
        <h2 class="shop-products__section-title">{{ section.settings.cap_title }}</h2>
        <ul class="shop-products__product-grid" role="list">{{ cap_cards }}</ul>
      </section>
    {%- endif -%}

    {%- if tshirt_cards != blank -%}
      <section id="shop-products-tshirt" class="shop-products__product-section shop-products__anchor">
        <h2 class="shop-products__section-title">{{ section.settings.tshirt_title }}</h2>
        <ul class="shop-products__product-grid" role="list">{{ tshirt_cards }}</ul>
      </section>
    {%- endif -%}

    {%- if crewneck_cards != blank -%}
      <section id="shop-products-crewneck" class="shop-products__product-section shop-products__anchor">
        <h2 class="shop-products__section-title">{{ section.settings.crewneck_title }}</h2>
        <ul class="shop-products__product-grid" role="list">{{ crewneck_cards }}</ul>
      </section>
    {%- endif -%}

    <div class="shop-products__end-spacer" aria-hidden="true"></div>
  </div>
</section>

{%- if section.settings.sticky_button_enabled and section.settings.sticky_button_link != blank -%}
  <a href="{{ section.settings.sticky_button_link }}" class="collection-sticky-btn button">
    {{- section.settings.sticky_button_text | default: 'Shop now' -}}
  </a>
{%- endif -%}

{{ 'shop-bestsellers-collection.css' | asset_url | stylesheet_tag }}

<script>
  (() => {
    const portraitGrid = document.querySelector('.shop-products__portrait-grid');
    const portraitScrollbar = document.querySelector('.shop-products__portrait-scrollbar');
    const portraitScrollbarThumb = portraitScrollbar?.querySelector('.shop-products__portrait-scrollbar-thumb');
    const bestsellerCarousels = document.querySelectorAll('[data-shop-bestseller-carousel]');
    const stickyButton = document.querySelector('.collection-sticky-btn');
    const navLinks = Array.from(document.querySelectorAll('.shop-products__nav-link[href^="#shop-products-"]'));
    const navSections = navLinks
      .map((link) => ({
        link,
        section: document.querySelector(link.getAttribute('href')),
      }))
      .filter((item) => item.section);
    let isPortraitScrollbarDragging = false;

    const updatePortraitScrollbar = () => {
      if (!portraitGrid || !portraitScrollbar || !portraitScrollbarThumb) return;

      const maxScroll = portraitGrid.scrollWidth - portraitGrid.clientWidth;

      if (maxScroll <= 0) {
        portraitScrollbar.hidden = true;
        portraitScrollbarThumb.style.width = '100%';
        portraitScrollbarThumb.style.transform = 'translateX(0)';
        return;
      }

      portraitScrollbar.hidden = false;

      const trackWidth = portraitScrollbar.clientWidth;
      const thumbWidth = Math.max((portraitGrid.clientWidth / portraitGrid.scrollWidth) * trackWidth, 34);
      const left = ((trackWidth - thumbWidth) * portraitGrid.scrollLeft) / maxScroll;

      portraitScrollbarThumb.style.width = `${thumbWidth}px`;
      portraitScrollbarThumb.style.transform = `translateX(${left}px)`;
    };

    const scrollPortraitGridFromScrollbar = (clientX) => {
      if (!portraitGrid || !portraitScrollbar || !portraitScrollbarThumb) return;

      const maxScroll = portraitGrid.scrollWidth - portraitGrid.clientWidth;
      if (maxScroll <= 0) return;

      const rect = portraitScrollbar.getBoundingClientRect();
      const thumbWidth = portraitScrollbarThumb.offsetWidth || 34;
      const usableWidth = Math.max(rect.width - thumbWidth, 1);
      const progress = Math.min(Math.max((clientX - rect.left - thumbWidth / 2) / usableWidth, 0), 1);

      portraitGrid.scrollLeft = progress * maxScroll;
      updatePortraitScrollbar();
    };

    const refreshPortraitScrollbar = () => {
      updatePortraitScrollbar();
      window.requestAnimationFrame(() => {
        updatePortraitScrollbar();
        window.requestAnimationFrame(updatePortraitScrollbar);
      });
    };

    portraitGrid?.addEventListener('scroll', updatePortraitScrollbar, { passive: true });
    portraitScrollbar?.addEventListener('pointerdown', (event) => {
      isPortraitScrollbarDragging = true;
      portraitScrollbar.setPointerCapture?.(event.pointerId);
      scrollPortraitGridFromScrollbar(event.clientX);
      event.preventDefault();
    });
    document.addEventListener('pointermove', (event) => {
      if (!isPortraitScrollbarDragging) return;
      scrollPortraitGridFromScrollbar(event.clientX);
      event.preventDefault();
    });
    document.addEventListener('pointerup', () => {
      isPortraitScrollbarDragging = false;
    });
    document.addEventListener('pointercancel', () => {
      isPortraitScrollbarDragging = false;
    });
    window.addEventListener('resize', refreshPortraitScrollbar);
    window.addEventListener('load', refreshPortraitScrollbar);
    refreshPortraitScrollbar();

    bestsellerCarousels.forEach((carousel) => {
      const rail = carousel.querySelector('[data-shop-bestseller-rail]');
      const track = carousel.querySelector('.shop-products__rail-track');
      const prev = carousel.querySelector('[data-shop-bestseller-prev]');
      const next = carousel.querySelector('[data-shop-bestseller-next]');
      if (!rail || !track || !prev || !next) return;

      let loopPoint = 0;
      let normalizeTimer = null;
      let refreshFrame = null;
      let lastMeasuredWidth = Math.round(rail.clientWidth || window.innerWidth);
      const cardCount = Number.parseInt(track.dataset.shopBestsellerCardCount || '0', 10);
      const setCount = Number.parseInt(track.dataset.shopBestsellerSetCount || '9', 10);
      const middleSetIndex = Math.floor(setCount / 2);

      carousel.querySelectorAll('[data-product-url-override]').forEach((item) => {
        const overrideUrl = item.dataset.productUrlOverride;
        if (!overrideUrl) return;

        item.querySelectorAll('a[href]').forEach((link) => {
          link.setAttribute('href', overrideUrl);
        });
      });

      track.querySelectorAll('img').forEach((image) => {
        image.setAttribute('loading', 'eager');
        image.setAttribute('decoding', 'async');
        image.draggable = false;
      });

      const measureLoopPoint = () => {
        const firstItem = track.children[0];
        const nextSetFirstItem = cardCount > 0 ? track.children[cardCount] : null;
        loopPoint = firstItem && nextSetFirstItem
          ? nextSetFirstItem.offsetLeft - firstItem.offsetLeft
          : 0;
      };

      const jumpWithoutAnimation = (left) => {
        rail.style.scrollBehavior = 'auto';
        rail.scrollLeft = Math.round(left);
        rail.offsetHeight;
        rail.style.scrollBehavior = '';
      };

      const normalizePosition = () => {
        if (loopPoint <= 0) return;

        const middleStart = loopPoint * middleSetIndex;
        const min = loopPoint;
        const max = loopPoint * (setCount - 2);
        const current = rail.scrollLeft;

        if (current < min) {
          jumpWithoutAnimation(current + middleStart);
        } else if (current > max) {
          jumpWithoutAnimation(current - middleStart);
        }
      };

      const refreshRail = () => {
        measureLoopPoint();
        lastMeasuredWidth = Math.round(rail.clientWidth || window.innerWidth);

        if (loopPoint <= 0) return;

        const middleStart = loopPoint * middleSetIndex;
        if (!rail.dataset.infiniteRailReady) {
          jumpWithoutAnimation(middleStart);
          rail.dataset.infiniteRailReady = 'true';
        } else {
          normalizePosition();
        }
      };

      const queueRefreshRail = () => {
        if (refreshFrame) return;
        refreshFrame = window.requestAnimationFrame(() => {
          refreshFrame = null;
          refreshRail();
        });
      };

      const handleResize = () => {
        const currentWidth = Math.round(rail.clientWidth || window.innerWidth);
        if (Math.abs(currentWidth - lastMeasuredWidth) < 2) return;
        lastMeasuredWidth = currentWidth;
        queueRefreshRail();
      };

      const getStep = () => {
        const items = track.querySelectorAll('.shop-products__rail-item');
        if (items.length > 1) {
          return Math.abs(items[1].offsetLeft - items[0].offsetLeft);
        }

        const item = items[0];
        const gap = parseFloat(getComputedStyle(track).gap) || 0;
        return item ? item.getBoundingClientRect().width + gap : rail.clientWidth;
      };

      const scrollByDirection = (direction) => {
        refreshRail();
        const step = getStep();
        if (step <= 0) return;

        normalizePosition();
        const target = rail.scrollLeft + (step * direction);
        rail.scrollTo({ left: target, behavior: 'smooth' });
      };

      prev.addEventListener('click', () => {
        scrollByDirection(-1);
      });

      next.addEventListener('click', () => {
        scrollByDirection(1);
      });

      rail.addEventListener('scroll', () => {
        clearTimeout(normalizeTimer);
        normalizeTimer = window.setTimeout(normalizePosition, 180);
      }, { passive: true });

      rail.addEventListener('scrollend', normalizePosition, { passive: true });

      track.querySelectorAll('img').forEach((image) => {
        if (!image.complete) image.addEventListener('load', queueRefreshRail, { once: true });
      });

      window.addEventListener('resize', handleResize, { passive: true });
      refreshRail();
      window.setTimeout(refreshRail, 400);

      document.addEventListener('shopify:section:unload', () => {
        if (refreshFrame) window.cancelAnimationFrame(refreshFrame);
        clearTimeout(normalizeTimer);
        window.removeEventListener('resize', handleResize);
      }, { once: true });
    });

    if (navSections.length) {
      let navTicking = false;

      const getNavOffset = () => {
        const headerHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 0;
        const nav = document.querySelector('.shop-products__nav');
        const navHeight = nav ? nav.offsetHeight : 0;
        return headerHeight + navHeight + 12;
      };

      const updateActiveNav = () => {
        const probeY = window.scrollY + getNavOffset() + 12;
        let activeItem = navSections[0];

        navSections.forEach((item) => {
          const sectionTop = item.section.getBoundingClientRect().top + window.scrollY;
          if (sectionTop <= probeY) activeItem = item;
        });

        navLinks.forEach((link) => {
          link.classList.toggle('is-active', link === activeItem.link);
        });

        navTicking = false;
      };

      const onNavScroll = () => {
        if (navTicking) return;
        navTicking = true;
        window.requestAnimationFrame(updateActiveNav);
      };

      updateActiveNav();
      navSections.forEach((item) => {
        item.link.addEventListener('click', (event) => {
          event.preventDefault();
          const sectionTop = item.section.getBoundingClientRect().top + window.scrollY;

          window.scrollTo({
            top: Math.max(sectionTop - getNavOffset(), 0),
            behavior: 'smooth',
          });

          navLinks.forEach((link) => {
            link.classList.toggle('is-active', link === item.link);
          });

          window.history.replaceState(null, '', item.link.getAttribute('href'));
        });
      });
      window.addEventListener('scroll', onNavScroll, { passive: true });
      window.addEventListener('resize', onNavScroll);
      document.addEventListener('shopify:section:unload', () => {
        window.removeEventListener('scroll', onNavScroll);
        window.removeEventListener('resize', onNavScroll);
      }, { once: true });
    }

    if (!stickyButton) return;

    let lastScrollY = window.scrollY;
    let ticking = false;
    const scrollThreshold = 8;

    const updateStickyButton = () => {
      const currentScrollY = Math.max(window.scrollY, 0);
      const delta = currentScrollY - lastScrollY;

      if (currentScrollY <= scrollThreshold || delta < -scrollThreshold) {
        stickyButton.classList.remove('is-hidden-on-scroll');
      } else if (delta > scrollThreshold) {
        stickyButton.classList.add('is-hidden-on-scroll');
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateStickyButton);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('shopify:section:unload', () => {
      window.removeEventListener('scroll', onScroll);
    }, { once: true });
  })();
</script>

