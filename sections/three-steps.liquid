<div class="three-steps section section--page-width">
  <div class=three-steps__inner>
    <div class="three-steps__wrapper" data-three-steps-pin>
      <div class="three-steps__pin">
        <h2 class="three-steps__title">
          {{ section.settings.main-text }}
        </h2>
        <div class="three-steps__content">
          <div class="three-steps__step">
            <div class="three-steps__step__content">
              <h3 class="three-steps__step__title">
                Choose your style
              </h3>
              <p class="three-steps__step__text">
                Pick the one that feels like them
              </p>
            </div>
            <div class="three-steps__step__image">
              <img src="{{ 'illustrations/01.svg' | asset_url }}" alt="" width="400" height="400">
            </div>
          </div>

          <div class="three-steps__step">
            <div class="three-steps__step__content">
              <h3 class="three-steps__step__title">
                Pick product & details
              </h3>
              <p class="three-steps__step__text">
                Choose how it looks and feels
              </p>
            </div>
            <div class="three-steps__step__image">
              <img src="{{ 'illustrations/02.svg' | asset_url }}" alt="" width="400" height="400">
            </div>
          </div>

          <div class="three-steps__step">
            <div class="three-steps__step__content">
              <h3 class="three-steps__step__title">
                Upload your photo
              </h3>
              <p class="three-steps__step__text">
                Any phone photo will do
              </p>
            </div>
            <div class="three-steps__step__image">
              <img src="{{ 'illustrations/03.svg' | asset_url }}" alt="" width="400" height="400">
            </div>
          </div>
        </div>
      </div>
    </div>

    {% if section.settings.button_text != blank %}
      <div class="three-steps__button">
        <a href="{{ section.settings.button_link }}" class="button">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
    
  </div>
</div>

{% javascript %}
  (function () {
    if (window.BAFThreeStepsPinReady) return;
    window.BAFThreeStepsPinReady = true;

    var media = window.matchMedia('(max-width: 749px)');
    var frame = null;

    function clamp(value, min, max) {
      return Math.min(Math.max(value, min), max);
    }

    function clearStepStyles(scene) {
      scene.querySelectorAll('.three-steps__step').forEach(function (step) {
        step.style.opacity = '';
        step.style.transform = '';
        step.style.pointerEvents = '';
      });
    }

    function updatePinnedSteps() {
      frame = null;

      document.querySelectorAll('[data-three-steps-pin]').forEach(function (scene) {
        var steps = Array.from(scene.querySelectorAll('.three-steps__step'));
        if (!media.matches || steps.length < 2) {
          clearStepStyles(scene);
          return;
        }

        var viewportHeight = window.innerHeight || document.documentElement.clientHeight || 1;
        var scrollDistance = Math.max(scene.offsetHeight - viewportHeight, 1);
        var progress = clamp((scene.getBoundingClientRect().top * -1) / scrollDistance, 0, 1);
        var stepProgress = progress * (steps.length - 1);

        steps.forEach(function (step, index) {
          var opacity = clamp(1 - Math.abs(stepProgress - index), 0, 1);
          step.style.opacity = opacity.toFixed(3);
          step.style.transform = 'translate3d(0, ' + ((1 - opacity) * 18).toFixed(1) + 'px, 0)';
          step.style.pointerEvents = opacity > 0.5 ? 'auto' : 'none';
        });
      });
    }

    function queuePinnedStepsUpdate() {
      if (frame !== null) return;
      frame = window.requestAnimationFrame(updatePinnedSteps);
    }

    function initPinnedSteps() {
      updatePinnedSteps();
      window.addEventListener('scroll', queuePinnedStepsUpdate, { passive: true });
      window.addEventListener('resize', queuePinnedStepsUpdate, { passive: true });
      window.addEventListener('orientationchange', queuePinnedStepsUpdate, { passive: true });
      media.addEventListener?.('change', queuePinnedStepsUpdate);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPinnedSteps, { once: true });
    } else {
      initPinnedSteps();
    }
  })();
{% endjavascript %}

{% stylesheet %}
.three-steps{
  .three-steps__inner{
    padding: 80px 20px 0px;
  }

  .three-steps__title{
    text-align: center;
    margin-bottom: 0;
    font-size: 36px;
  }

  .three-steps__step{
    margin: 40px 0 80px;

    .three-steps__step__content{
      position: relative;
      text-align: center;
      color: var(--brown);
      max-width: 260px;
      margin: 0 auto;

      .three-steps__step__title{
        font-family: var(--baf-text-family);
        font-size: var(--baf-text-medium-size);
        font-weight: var(--baf-text-weight);
        line-height: normal;
        color: var(--beige);
        background-color: var(--green);
        width: fit-content;
        margin: 0 auto;
        padding: 4px 12px;
        border-radius: 1000px;
      }
      .three-steps__step__text{
        font-family: "display", "Times New Roman", serif !important;
        font-weight: normal !important;
        font-size: var(--baf-display-medium-size);
        line-height: 1em;
        margin: 30px 0 0;
      }
    }

    .three-steps__step__image{
      img{
        width: 140px;
        margin: 20px auto;
      }
    }
  }

  .three-steps__button{
    text-align: center;

    .button{
      display: inline-block;
    }
  }

  @media(max-width: 749px){
    .three-steps__inner{
      padding: 0 20px 0;
    }

    .three-steps__wrapper{
      min-height: calc(300svh - var(--header-height, 0px));
      position: relative;
    }

    .three-steps__pin{
      position: sticky;
      top: var(--header-height, 0px);
      min-height: calc(100svh - var(--header-height, 0px));
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 44px 0;
      box-sizing: border-box;
    }

    .three-steps__title{
      margin: 0 0 36px;
      line-height: 1;
    }

    .three-steps__content{
      display: grid;
      grid-template: "step" 1fr / 1fr;
      align-items: center;
      min-height: 360px;
    }

    .three-steps__step{
      grid-area: step;
      margin: 0;
      opacity: 0;
      pointer-events: none;
      will-change: opacity, transform;
    }

    .three-steps__step:first-child{
      opacity: 1;
      pointer-events: auto;
    }

    .three-steps__button{
      margin-top: 10px;
    }
  }

  @media(min-width: 750px){

    .three-steps__inner{
      padding: 120px 0 40px;
    }

    .three-steps__content{
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      max-width: 1100px;
      margin: 0 auto;
    }

    .three-steps__step__image{
      img{
        width: 160px;
      }
    }

    .three-steps__title{
      font-size: 96px;
      line-height: 90px;
    }

    .three-steps__step{
      margin: 80px 0 60px;
      width: 220px;

      .three-steps__step__content{
        max-width: none;

        .three-steps__step__text{
          margin: 50px 0 30px;
          font-size: 36px;
        }
      }
    }
  }

  @media(min-width: 1200px){
    

    .three-steps__step{
      width: 260px;

      .three-steps__step__image{
      img{
        width: 250px;
        height: 260px;
      }
    }
    }
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Three Steps",
  "settings": [
    {
      "type": "text",
      "id": "main-text",
      "label": "Main Text",
      "default": "It only takes three steps"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Start your portrait"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
