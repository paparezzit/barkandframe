<div class="three-steps section section--page-width">
  <div class=three-steps__inner>
    <div class="three-steps__wrapper">
      <div class="three-steps__pin">
        <h2 class="three-steps__title">
          {{ section.settings.main-text }}
        </h2>
        {% if section.settings.button_text != blank %}
          <div class="three-steps__button three-steps__button--sticky">
            <a href="{{ section.settings.button_link }}" class="button">
              {{ section.settings.button_text }}
            </a>
          </div>
        {% endif %}
        <div class="three-steps__content">
          <div class="three-steps__step">
            <div class="three-steps__step__content">
              <h3 class="three-steps__step__title">
                Choose your style
              </h3>
              <p class="three-steps__step__text">
                Pick the one that feels like them
              </p>
            </div>
            <div class="three-steps__step__image">
              <img src="{{ 'illustrations/01.svg' | asset_url }}" alt="" width="400" height="400">
            </div>
          </div>

          <div class="three-steps__step">
            <div class="three-steps__step__content">
              <h3 class="three-steps__step__title">
                Pick product & details
              </h3>
              <p class="three-steps__step__text">
                Choose how it looks and feels
              </p>
            </div>
            <div class="three-steps__step__image">
              <img src="{{ 'illustrations/02.svg' | asset_url }}" alt="" width="400" height="400">
            </div>
          </div>

          <div class="three-steps__step">
            <div class="three-steps__step__content">
              <h3 class="three-steps__step__title">
                Upload your photo
              </h3>
              <p class="three-steps__step__text">
                Any phone photo will do
              </p>
            </div>
            <div class="three-steps__step__image">
              <img src="{{ 'illustrations/03.svg' | asset_url }}" alt="" width="400" height="400">
            </div>
          </div>
        </div>
      </div>
    </div>

    {% if section.settings.button_text != blank %}
      <div class="three-steps__button three-steps__button--end">
        <a href="{{ section.settings.button_link }}" class="button">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
    
  </div>
</div>

{% stylesheet %}
.three-steps{
  .three-steps__inner{
    padding: 80px 20px 0px;
  }

  .three-steps__title{
    text-align: center;
    margin-bottom: 0;
    font-size: 36px;
  }

  .three-steps__step{
    margin: 40px 0 80px;

    .three-steps__step__content{
      position: relative;
      text-align: center;
      color: var(--brown);
      max-width: 260px;
      margin: 0 auto;

      .three-steps__step__title{
        font-family: var(--baf-text-family);
        font-size: var(--baf-text-medium-size);
        font-weight: var(--baf-text-weight);
        line-height: normal;
        color: var(--beige);
        background-color: var(--green);
        width: fit-content;
        margin: 0 auto;
        padding: 4px 12px;
        border-radius: 1000px;
      }
      .three-steps__step__text{
        font-family: "display", "Times New Roman", serif !important;
        font-weight: normal !important;
        font-size: var(--baf-display-medium-size);
        line-height: 1em;
        margin: 30px 0 0;
      }
    }

    .three-steps__step__image{
      img{
        width: 140px;
        margin: 20px auto;
      }
    }
  }

  .three-steps__button{
    text-align: center;

    .button{
      display: inline-block;
    }
  }

  .three-steps__button--sticky{
    display: none;
  }

  @media(max-width: 749px){
    .three-steps__inner{
      padding: 0 20px 20px;
    }

    .three-steps__wrapper{
      position: relative;
      padding-top: 48px;
    }

    .three-steps__pin{
      position: static;
      min-height: 0;
      padding: 0;
    }

    .three-steps__title{
      position: sticky;
      top: calc(var(--header-height, 0px) + 24px);
      z-index: 5;
      margin: 0 0 30px;
      line-height: 1;
    }

    .three-steps__content{
      display: block;
      min-height: 0;
    }

    .three-steps__step{
      position: sticky;
      top: calc(var(--header-height, 0px) + 26svh);
      z-index: 1;
      min-height: 330px;
      margin: 0 0 70svh;
      padding: 24px 0 16px;
      background: var(--beige);
      opacity: 1;
      pointer-events: auto;
    }

    .three-steps__step:nth-child(2){
      z-index: 2;
    }

    .three-steps__step:nth-child(3){
      z-index: 3;
      margin-bottom: 18px;
    }

    .three-steps__button--sticky{
      display: block;
      position: sticky;
      top: calc(100svh - 92px);
      z-index: 8;
      margin: 0 0 22px;
    }

    .three-steps__button--end{
      display: none;
    }
  }

  @media(min-width: 750px){

    .three-steps__inner{
      padding: 120px 0 40px;
    }

    .three-steps__content{
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      max-width: 1100px;
      margin: 0 auto;
    }

    .three-steps__step__image{
      img{
        width: 160px;
      }
    }

    .three-steps__title{
      font-size: 96px;
      line-height: 90px;
    }

    .three-steps__step{
      margin: 80px 0 60px;
      width: 220px;

      .three-steps__step__content{
        max-width: none;

        .three-steps__step__text{
          margin: 50px 0 30px;
          font-size: 36px;
        }
      }
    }
  }

  @media(min-width: 1200px){
    

    .three-steps__step{
      width: 260px;

      .three-steps__step__image{
      img{
        width: 250px;
        height: 260px;
      }
    }
    }
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Three Steps",
  "settings": [
    {
      "type": "text",
      "id": "main-text",
      "label": "Main Text",
      "default": "It only takes three steps"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Start your portrait"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
