<link rel="stylesheet" href="{{ 'baf-section-three-steps.css' | asset_url }}" media="print, (min-width: 990px)" onload="this.onload=null;this.media='all'">
<noscript>{{ 'baf-section-three-steps.css' | asset_url | stylesheet_tag }}</noscript>

<section class="three-steps section section--page-width" aria-labelledby="three-steps-title-{{ section.id }}">
  <div class="three-steps__inner">
    <div class="three-steps__panel">
      <h2 id="three-steps-title-{{ section.id }}" class="three-steps__title">
        <span class="three-steps__title-line">How Your Portrait</span><br>
        <span class="three-steps__title-line">Comes to Life</span>
      </h2>

      <div class="three-steps__list" aria-label="How your portrait comes to life">
        <div class="three-steps__item">
          <span class="three-steps__icon" aria-hidden="true">
            <img src="{{ 'baf-three-steps-artist.svg' | asset_url }}" alt="" width="216" height="216" loading="lazy" decoding="async">
          </span>
          <p class="three-steps__text">Each style is designed by an award-winning artist.</p>
        </div>

        <div class="three-steps__item">
          <span class="three-steps__icon" aria-hidden="true">
            <img src="{{ 'baf-three-steps-iphone-config.svg' | asset_url }}" alt="" width="216" height="216" loading="lazy" decoding="async">
          </span>
          <p class="three-steps__text">Choose your style and finishing details, then upload your dog’s photo.</p>
        </div>

        <div class="three-steps__item">
          <span class="three-steps__icon" aria-hidden="true">
            <img src="{{ 'baf-three-steps-custom-portrait.svg' | asset_url }}" alt="" width="216" height="216" loading="lazy" decoding="async">
          </span>
          <p class="three-steps__text">Our team carefully ensures that every detail feels true to your dog, creating a beautifully finished portrait that captures their unique character.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portrait process",
  "settings": [
    {
      "type": "text",
      "id": "main-text",
      "label": "Main Text",
      "default": "How Your Portrait Comes to Life"
    }
  ]
}
{% endschema %}
