{% assign slide_speed = section.settings.autoplay_speed | default: 4 %}
{% assign has_video = false %}
{% for block in section.blocks %}
  {% if block.settings.video != blank or block.settings.video_url != blank %}
    {% assign has_video = true %}
    {% break %}
  {% endif %}
{% endfor %}
<style>
  :root {
    --slideshow-duration: {{ slide_speed }}s;
  }
</style>

<div class="section section--custom-slideshow">
  <div 
    class="custom-slideshow"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.autoplay_speed }}"
  >
    <div class="slideshow__track">
      {% for block in section.blocks %}
        {% assign portrait_image_position = block.settings.portrait_image_position | default: 'center center' %}
        {% assign portrait_image_position_key = portrait_image_position | split: ' ' | first %}
        <div
          class="slide {% if forloop.first %}is-active{% endif %}"
          data-portrait-image-position="{{ portrait_image_position_key }}"
          style="--slide-image-position-portrait: {{ portrait_image_position }};"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.video != blank %}
            <div class="slide-image">
              <video
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                class="slide-video"
              >
                {% for source in block.settings.video.sources %}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {% endfor %}
              </video>
            </div>
          {% elsif block.settings.video_url != blank %}
            <div class="slide-image">
              <video
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                class="slide-video"
              >
                <source src="{{ block.settings.video_url }}" type="video/mp4">
              </video>
            </div>
          {% elsif block.settings.image %}
            <div class="slide-image">
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                alt=""
                loading="lazy"
                width="1200" height="800">
            </div>
          {% endif %}

          <div class="slide-content">
            <h2 class="slide__title">
              {{ block.settings.title | newline_to_br }}
            </h2>
            <p class="slide__text">
              {{ block.settings.text }}
            </p>
            {% if block.settings.button_link %}
              <a href="{{ block.settings.button_link }}" class="slide__button button">
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>

        </div>
      {% endfor %}
    </div>

    <div class="slideshow__dots">
      {% for block in section.blocks %}
        <button class="dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}"></button>
      {% endfor %}
    </div>

    {% if has_video %}
      <button class="slideshow__sound-toggle" type="button" aria-label="Turn sound on" aria-pressed="false" data-sound-toggle>
        <img class="sound-icon sound-icon--off" src="{{ 'icon-volume-off.svg' | asset_url }}" alt="" width="24" height="24" loading="lazy">
        <img class="sound-icon sound-icon--on" src="{{ 'icon-volume-up.svg' | asset_url }}" alt="" width="24" height="24" loading="lazy">
      </button>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .section--custom-slideshow{
    display: block;
  }

  .custom-slideshow {
    position: relative; 
    margin-bottom: 80px;
  }

  .custom-slideshow.is-autoplay-paused .slideshow__dots .dot.is-active::after {
    animation-play-state: paused;
  }

  .slideshow__track{
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1/1;
    position: relative;
    border-radius: 0 0 80px 80px;
    touch-action: pan-y;
  }

  .custom-slideshow .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.7s ease;
    display: grid;
  }

  .custom-slideshow .slide.is-active {
    opacity: 1;
    z-index: 2;
  }

  .custom-slideshow .slide-image {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .custom-slideshow .slide::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 42.857%;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.27) 0%, rgb(0 0 0 / 0) 100%);
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 1;
  }

  .custom-slideshow .slide-image img,
  .custom-slideshow .slide-image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right;
  }

  .custom-slideshow .slide-content {
    position: relative;
    z-index: 2;
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 14px;
    width: min( var(--page-width) - var(--page-margin) * 2, calc(100% - var(--page-margin) * 2) );
    margin: 0 auto;
    padding: 60px 0;

    .slide__title{
      max-width: 250px;
      color: var(--beige);
      margin: 0;
    }

    .slide__text{
      font-weight: 700;
      max-width: 240px;
      color: var(--beige);
      margin: 0;
    }

    .slide__button{
      margin-top: 0;
    }
  }

  .custom-slideshow .slide__button:not(:hover) {
    --button-color: var(--brown);
    --button-background-color: var(--beige);
    --button-border-color: var(--beige);
  }

  .slideshow__dots {
    display: flex;
    gap: 10px;
    z-index: 5;
    margin: -30px auto 0;
    width: 240px;
    position: relative;
  }

  .slideshow__dots .dot {
    background-color: transparent;
    width: 100%;
    height: 20px;
    border-radius: 0;
    border: 0;
    padding: 0;
    position: relative;
    flex: 1;
    cursor: pointer;

    &::before{
      height: 4px;
      width: 100%;
      position: absolute;
      top: 8px;
      left: 0;
      background-color: var(--brown);
      content: "";
    }

    &.is-active{
      &::after{
        height: 4px;
        width: 100%;
        position: absolute;
        top: 8px;
        left: 0;
        background-color: var(--beige);
        content: "";
        animation-name: change-width;
        display: block;
        animation-timing-function: linear;
        animation-duration: var(--slideshow-duration);
      }
    }
  }

  .slideshow__sound-toggle {
    position: absolute;
    right: var(--page-margin);
    bottom: 24px;
    z-index: 6;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: var(--beige);
    color: var(--brown);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  .slideshow__sound-toggle.is-visible {
    display: flex;
  }

  .slideshow__sound-toggle .sound-icon {
    width: 24px;
    height: 24px;
    display: block;
  }

  .slideshow__sound-toggle .sound-icon--on {
    display: none;
  }

  .slideshow__sound-toggle.is-sound-on .sound-icon--off {
    display: none;
  }

  .slideshow__sound-toggle.is-sound-on .sound-icon--on {
    display: block;
  }

  @media(min-width: 750px){
    .custom-slideshow {
      margin-bottom: 120px;
      
      .slideshow__track{
        aspect-ratio: 3/2;
      }

      .slide-content{
        gap: 18px;
        padding: 80px 0;

        .slide__title{
          max-width: 300px;
          font-size: 36px;
        }

        .slide__text{
          font-size: 18px;
          max-width: 270px;
        }
      }

      .slideshow__dots{
        width: 500px;
      }
    }
  }

  @media(min-width: 1200px){
    .custom-slideshow {
      .slideshow__track{
        aspect-ratio: 13/7;
        max-height: calc(95dvh - var(--header-height));
      }

      .slide-image img,
      .slide-image video{
        object-position: center;
      }

      .slide-content{
        gap: 22px;
        padding: 120px 0;

        .slide__title{
          max-width: 500px;
          font-size: 54px;
        }

        .slide__text{
          max-width: 320px;
        }
      }
    }
  }

  @media (orientation: portrait) {
    .custom-slideshow {
      margin-bottom: 90px;

      .slideshow__track {
        aspect-ratio: auto;
        min-height: calc(94svh - var(--header-height));
        max-height: none;
      }

      .slide-image img,
      .slide-image video {
        object-position: var(--slide-image-position-portrait, center center);
      }

      .slide[data-portrait-image-position='left'] .slide-image img,
      .slide[data-portrait-image-position='left'] .slide-image video {
        object-position: left center;
      }

      .slide[data-portrait-image-position='center'] .slide-image img,
      .slide[data-portrait-image-position='center'] .slide-image video {
        object-position: center center;
      }

      .slide[data-portrait-image-position='right'] .slide-image img,
      .slide[data-portrait-image-position='right'] .slide-image video {
        object-position: right center;
      }

      .slide-content {
        width: auto;
        margin-inline: max(var(--util-page-margin-offset), 24px);
        justify-content: center;
        align-items: flex-start;
        gap: 14px;
        padding: 80px 0;

        .slide__title {
          max-width: 340px;
          margin: 0;
          font-size: 40px;
          line-height: 0.95;
        }

        .slide__text {
          max-width: 310px;
          margin: 0;
          font-size: 16px;
        }

        .slide__button {
          margin-top: 0;
        }
      }
    }
  }

  @media (min-width: 750px) and (orientation: portrait) {
    .custom-slideshow {
      margin-bottom: 120px;

      .slideshow__track {
        min-height: calc(95svh - var(--header-height));
      }

      .slide-content {
        padding: 110px 0;

        .slide__title {
          max-width: 520px;
          font-size: 54px;
        }

        .slide__text {
          max-width: 360px;
          font-size: 19px;
        }
      }
    }
  }

  @media (min-width: 1200px) and (orientation: portrait) {
    .custom-slideshow {
      .slideshow__track {
        min-height: calc(96svh - var(--header-height));
      }

      .slide-content {
        padding: 140px 0;

        .slide__title {
          max-width: 650px;
          font-size: 64px;
        }

        .slide__text {
          max-width: 420px;
          font-size: 22px;
        }
      }
    }
  }

  @media (orientation: portrait) {
    .custom-slideshow .slide .slide-image img,
    .custom-slideshow .slide .slide-image video {
      object-position: var(--slide-image-position-portrait, center center) !important;
    }
  }
{% endstylesheet %}

{% javascript %}
document.addEventListener("DOMContentLoaded", () => {
  const slideshow = document.querySelector(".custom-slideshow");
  if (!slideshow) return;

  const slides = slideshow.querySelectorAll(".slide");
  const dots = slideshow.querySelectorAll(".dot");
  const soundToggle = slideshow.querySelector("[data-sound-toggle]");
  const swipeSurface = slideshow.querySelector(".slideshow__track");
  
  let index = 0;
  let soundOn = false;
  let swipePointerId = null;
  let swipeStartX = 0;
  let swipeStartY = 0;
  let swipeMoved = false;

  const autoplay = slideshow.dataset.autoplay === "true";
  const speed = (parseFloat(slideshow.dataset.speed) || 4) * 1000;

  let slideTimer;
  let resumeTimeout;
  let slideStartedAt = 0;
  let remainingSlideTime = speed;
  let autoplayPaused = false;

  function scheduleNextSlide(duration = speed) {
    if (!autoplay) return;
    clearTimeout(slideTimer);
    remainingSlideTime = duration;
    slideStartedAt = Date.now();
    slideTimer = setTimeout(nextSlide, duration);
  }

  function restartAutoplayTimer() {
    if (!autoplay) return;
    autoplayPaused = false;
    slideshow.classList.remove("is-autoplay-paused");
    scheduleNextSlide(speed);
  }

  function showSlide(i, resetAutoplay = true) {
    slides.forEach((slide, idx) => {
      const active = idx === i;
      slide.classList.toggle("is-active", active);
      const video = slide.querySelector("video");
      if (video) {
        video.muted = !soundOn;
        if (active) { video.currentTime = 0; video.play().catch(() => {}); }
        else video.pause();
      }
    });

    dots.forEach((dot, idx) => {
      dot.classList.toggle("is-active", idx === i);
    });

    if (soundToggle) {
      const activeVideo = slides[i] && slides[i].querySelector("video");
      soundToggle.classList.toggle("is-visible", Boolean(activeVideo));
    }

    if (resetAutoplay) restartAutoplayTimer();
  }

  function nextSlide() {
    index = (index + 1) % slides.length;
    showSlide(index);
  }

  function previousSlide() {
    index = (index - 1 + slides.length) % slides.length;
    showSlide(index);
  }

  function pauseAutoplayTemporarily() {
    if (!autoplay) return;
    clearTimeout(resumeTimeout);

    if (!autoplayPaused) {
      const elapsed = Date.now() - slideStartedAt;
      remainingSlideTime = Math.max(0, remainingSlideTime - elapsed);
      clearTimeout(slideTimer);
      autoplayPaused = true;
      slideshow.classList.add("is-autoplay-paused");
    }

    resumeTimeout = setTimeout(() => {
      autoplayPaused = false;
      slideshow.classList.remove("is-autoplay-paused");
      scheduleNextSlide(remainingSlideTime);
    }, 15000);
  }

  dots.forEach(dot => {
    dot.addEventListener("click", () => {

      index = parseInt(dot.dataset.index);
      showSlide(index);
    });
  });

  slideshow.addEventListener("click", pauseAutoplayTemporarily);

  if (swipeSurface) {
    swipeSurface.addEventListener("pointerdown", event => {
      if (event.pointerType === "mouse") return;
      swipePointerId = event.pointerId;
      swipeStartX = event.clientX;
      swipeStartY = event.clientY;
      swipeMoved = false;
      swipeSurface.setPointerCapture?.(event.pointerId);
    });

    swipeSurface.addEventListener("pointerup", event => {
      if (swipePointerId !== event.pointerId) return;
      const deltaX = event.clientX - swipeStartX;
      const deltaY = event.clientY - swipeStartY;
      swipePointerId = null;

      if (Math.abs(deltaX) < 45 || Math.abs(deltaX) < Math.abs(deltaY)) return;

      swipeMoved = true;
      if (deltaX < 0) nextSlide();
      else previousSlide();
      pauseAutoplayTemporarily();
    });

    swipeSurface.addEventListener("pointercancel", () => {
      swipePointerId = null;
    });

    swipeSurface.addEventListener("click", event => {
      if (!swipeMoved) return;
      event.preventDefault();
      event.stopPropagation();
      swipeMoved = false;
    }, true);
  }

  if (soundToggle) {
    soundToggle.addEventListener("click", () => {
      soundOn = !soundOn;
      soundToggle.classList.toggle("is-sound-on", soundOn);
      soundToggle.setAttribute("aria-pressed", soundOn ? "true" : "false");
      soundToggle.setAttribute("aria-label", soundOn ? "Turn sound off" : "Turn sound on");
      slides.forEach(slide => {
        const video = slide.querySelector("video");
        if (video) video.muted = !soundOn;
      });
    });
  }

  showSlide(index);
});
{% endjavascript %}

{% schema %}
{
  "name": "Fade Slideshow",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": true,
      "label": "Autoplay"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 0.5,
      "default": 4,
      "label": "Speed"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (fallback if no video)"
        },
        {
          "type": "select",
          "id": "portrait_image_position",
          "label": "Portrait image position",
          "options": [
            {
              "value": "left center",
              "label": "Left"
            },
            {
              "value": "center center",
              "label": "Center"
            },
            {
              "value": "78% center",
              "label": "Right"
            }
          ],
          "default": "center center"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fade Slideshow"
    }
  ]
}
{% endschema %}
