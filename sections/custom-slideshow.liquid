{% assign slide_speed = section.settings.autoplay_speed | default: 4 %}
{% assign has_multiple_slides = false %}
{% if section.blocks.size > 1 %}
  {% assign has_multiple_slides = true %}
{% endif %}
{% assign has_video = false %}
{% for block in section.blocks %}
  {% if block.settings.video != blank or block.settings.video_url != blank or block.settings.portrait_video_url != blank or block.settings.portrait_video_mobile_url != blank %}
    {% assign has_video = true %}
    {% break %}
  {% endif %}
{% endfor %}
<style>
  :root {
    --slideshow-duration: {{ slide_speed }}s;
  }

  @media (orientation: portrait) {
    .custom-slideshow .slideshow__track {
      height: 79.71svh;
      min-height: 79.71svh;
      max-height: none;
    }

    .custom-slideshow .slide-content {
      padding-top: 26px !important;
    }
  }

  @media (min-width: 750px) and (orientation: portrait) {
    .custom-slideshow .slideshow__track {
      height: 79.71svh;
      min-height: 79.71svh;
    }

    .custom-slideshow .slide-content {
      padding-top: 28px !important;
    }

    .custom-slideshow .slide-content .slide__title {
      font-size: var(--baf-display-large-size) !important;
    }
  }

  @media (min-width: 1200px) and (orientation: portrait) {
    .custom-slideshow .slideshow__track {
      height: 79.71svh;
      min-height: 79.71svh;
    }

    .custom-slideshow .slide-content {
      padding-top: 32px !important;
    }

    .custom-slideshow .slide-content .slide__title {
      font-size: var(--baf-display-large-size) !important;
    }
  }

  @media (min-width: 1200px) and (orientation: landscape) {
    .custom-slideshow .slideshow__track {
      height: min(53.846vw, calc(100dvh - var(--header-height) - 116px)) !important;
      max-height: calc(100dvh - var(--header-height) - 116px) !important;
    }
  }
</style>

<div class="section section--custom-slideshow">
  {% assign first_slide = section.blocks | first %}
  {% if first_slide.settings.title != blank %}
    <h1 class="visually-hidden">{{ first_slide.settings.title | newline_to_br }}</h1>
  {% endif %}
  <div 
    class="custom-slideshow"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.autoplay_speed }}"
  >
      <div class="slideshow__track">
      {% assign portrait_slide_button_count = 0 %}
      {% for block in section.blocks %}
        {% assign slide_image_asset = block.settings.image_asset | strip %}
        {% assign slide_mobile_image_asset = block.settings.mobile_image_asset | strip %}
        {% if forloop.first and slide_image_asset == blank %}
          {% assign slide_image_asset = 'hero banner desktop.jpg' %}
        {% endif %}
        {% if forloop.first and slide_mobile_image_asset == blank %}
          {% assign slide_mobile_image_asset = 'hero banner mobil.jpg' %}
        {% endif %}
        {% assign slide_image_webp_asset = '' %}
        {% assign slide_mobile_image_webp_asset = '' %}
        {% if slide_image_asset == 'hero banner desktop.jpg' %}
          {% assign slide_image_webp_asset = 'hero-banner-desktop-2215.webp' %}
        {% endif %}
        {% if slide_mobile_image_asset == 'hero banner mobil.jpg' %}
          {% assign slide_mobile_image_webp_asset = 'hero-banner-mobile-989.webp' %}
        {% endif %}
        {% assign portrait_image_position = block.settings.portrait_image_position | default: 'center center' %}
        {% assign portrait_image_position_key = portrait_image_position | split: ' ' | first %}
        {% assign has_landscape_video = false %}
        {% assign has_portrait_video = false %}
        {% if block.settings.video != blank or block.settings.video_url != blank %}
          {% assign has_landscape_video = true %}
        {% endif %}
        {% if block.settings.portrait_video_url != blank or block.settings.portrait_video_mobile_url != blank %}
          {% assign has_portrait_video = true %}
        {% endif %}
        <div
          class="slide {% if forloop.first %}slide--first is-active{% endif %}"
          data-portrait-image-position="{{ portrait_image_position_key }}"
          style="--slide-image-position-portrait: {{ portrait_image_position }};"
          {{ block.shopify_attributes }}
        >

          {% if has_landscape_video or has_portrait_video %}
            {% if block.settings.button_link != blank %}
              <a
                class="slide-image slide-image--link"
                href="{{ block.settings.button_link }}"
                aria-label="{{ block.settings.button_text | default: block.settings.title | strip_newlines | escape }}"
              >
            {% else %}
              <div class="slide-image">
            {% endif %}
              {% if has_landscape_video %}
                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="auto"
                  class="slide-video slide-video--landscape{% unless has_portrait_video %} slide-video--all{% endunless %}"
                >
                  {% if block.settings.video != blank %}
                    {% for source in block.settings.video.sources %}
                      <source
                        src="{{ source.url }}"
                        type="{{ source.mime_type }}"
                        {% if has_portrait_video %}media="(orientation: landscape)"{% endif %}
                      >
                    {% endfor %}
                  {% else %}
                    <source
                      src="{{ block.settings.video_url }}"
                      type="video/mp4"
                      {% if has_portrait_video %}media="(orientation: landscape)"{% endif %}
                    >
                  {% endif %}
                </video>
              {% endif %}
              {% if has_portrait_video %}
                {% assign portrait_desktop_media = '' %}
                {% if has_landscape_video %}
                  {% assign portrait_desktop_media = '(orientation: portrait)' %}
                  {% if block.settings.portrait_video_mobile_url != blank %}
                    {% assign portrait_desktop_media = '(min-width: 750px) and (orientation: portrait)' %}
                  {% endif %}
                {% endif %}
                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="auto"
                  class="slide-video slide-video--portrait{% unless has_landscape_video %} slide-video--all{% endunless %}"
                >
                  {% if block.settings.portrait_video_mobile_url != blank %}
                    <source
                      src="{{ block.settings.portrait_video_mobile_url }}"
                      type="video/mp4"
                      media="(max-width: 749px)"
                    >
                  {% endif %}
                  {% if block.settings.portrait_video_url != blank %}
                    <source
                      src="{{ block.settings.portrait_video_url }}"
                      type="video/mp4"
                      {% if portrait_desktop_media != blank %}media="{{ portrait_desktop_media }}"{% endif %}
                    >
                  {% endif %}
                  </video>
              {% endif %}
            {% if block.settings.button_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% elsif block.settings.image != blank or slide_image_asset != blank %}
            {% if block.settings.button_link != blank %}
              <a
                class="slide-image slide-image--link"
                href="{{ block.settings.button_link }}"
                aria-label="{{ block.settings.button_text | default: block.settings.title | strip_newlines | escape }}"
              >
            {% else %}
              <div class="slide-image">
            {% endif %}
              <picture>
                {% if slide_mobile_image_webp_asset != blank %}
                  <source
                    type="image/webp"
                    media="(max-width: 749px)"
                    sizes="100vw"
                    srcset="{{ 'hero-banner-mobile-640.webp' | asset_url }} 640w"
                  >
                {% endif %}
                {% if slide_mobile_image_asset != blank %}
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ slide_mobile_image_asset | asset_url }}"
                  >
                {% elsif block.settings.mobile_image != blank %}
                  {% render 'mobile-image-source', image: block.settings.mobile_image %}
                {% else %}
                  {% render 'mobile-image-source', image: block.settings.image %}
                {% endif %}
                {% if slide_image_webp_asset != blank %}
                  <source
                    type="image/webp"
                    sizes="100vw"
                    srcset="{{ 'hero-banner-desktop-1600.webp' | asset_url }} 1600w, {{ slide_image_webp_asset | asset_url }} 2215w"
                  >
                {% endif %}
                {% if slide_image_asset != blank %}
                  <img
                    src="{{ slide_image_asset | asset_url }}"
                    alt=""
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                    width="1200"
                    height="800">
                {% else %}
                  <img
                    src="{{ block.settings.image | image_url: width: 2000 }}"
                    alt=""
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                    width="1200"
                    height="800">
                {% endif %}
              </picture>
            {% if block.settings.button_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% endif %}

          <div class="slide-content">
            <div class="slide-content__inner">
              <h2 class="slide__title">
                {{ block.settings.title | newline_to_br }}
              </h2>
              <p class="slide__text">
                {{ block.settings.text }}
              </p>
              {% if block.settings.button_link %}
                {%- liquid
                  assign slide_button_id = ''
                  if block.settings.button_link contains 'pages/portrait'
                    assign portrait_slide_button_count = portrait_slide_button_count | plus: 1
                    assign slide_button_id = 'baf-click-home-portrait-0' | append: portrait_slide_button_count
                  endif
                -%}
                <a
                  {% if slide_button_id != blank %}id="{{ slide_button_id }}"{% endif %}
                  href="{{ block.settings.button_link }}"
                  class="slide__button button"
                >
                  {{ block.settings.button_text }}
                </a>
              {% endif %}
            </div>
          </div>

        </div>
      {% endfor %}
    </div>

    {% if has_multiple_slides %}
      <div class="slideshow__dots">
        {% for block in section.blocks %}
          <button class="dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}"></button>
        {% endfor %}
      </div>
    {% endif %}

    {% if has_video %}
      <button class="slideshow__sound-toggle" type="button" aria-label="Turn sound on" aria-pressed="false" data-sound-toggle>
        <img class="sound-icon sound-icon--off" src="{{ 'icon-volume-off.svg' | asset_url }}" alt="" width="24" height="24" loading="lazy">
        <img class="sound-icon sound-icon--on" src="{{ 'icon-volume-up.svg' | asset_url }}" alt="" width="24" height="24" loading="lazy">
      </button>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .section--custom-slideshow{
    display: block;
  }

  .custom-slideshow {
    position: relative; 
    margin-bottom: 80px;
  }

  .custom-slideshow.is-autoplay-paused .slideshow__dots .dot.is-active::after {
    animation-play-state: paused;
  }

  .slideshow__track{
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1/1;
    position: relative;
    border-radius: 0 0 80px 80px;
    touch-action: pan-y;
  }

  .custom-slideshow .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.7s ease;
    display: grid;
  }

  .custom-slideshow .slide.is-active {
    opacity: 1;
    z-index: 2;
  }

  .custom-slideshow .slide-image {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .custom-slideshow .slide-image--link {
    display: block;
    cursor: pointer;
  }

  .custom-slideshow .slide::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 42.857%;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.27) 0%, rgb(0 0 0 / 0) 100%);
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 1;
  }

  .custom-slideshow .slide-image picture,
  .custom-slideshow .slide-image img,
  .custom-slideshow .slide-image video {
    width: 100%;
    height: 100%;
  }

  .custom-slideshow .slide-image img,
  .custom-slideshow .slide-image video {
    object-fit: cover;
    object-position: center;
  }

  .custom-slideshow .slide-video--portrait {
    display: none;
  }

  .custom-slideshow .slide-content {
    position: relative;
    z-index: 2;
    display: flex;
    pointer-events: none;
    height: 100%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 14px;
    width: min( var(--page-width) - var(--page-margin) * 2, calc(100% - var(--page-margin) * 2) );
    margin: 0 auto;
    padding: 60px 0;

    .slide-content__inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: inherit;
    }

    .slide__title{
      max-width: 250px;
      color: var(--beige);
      margin: 0;
      font-family: var(--baf-display-family);
      font-weight: var(--baf-display-weight);
      font-size: var(--baf-display-large-size);
      line-height: 0.95;
      letter-spacing: 0;
      text-transform: none;
    }

    .slide__text{
      font-weight: 700;
      max-width: 240px;
      color: var(--beige);
      margin: 0;
    }

    .slide__button{
      margin-top: 0;
      pointer-events: auto;
    }
  }

  .custom-slideshow .slide--first .slide-content__inner {
    align-items: center;
    text-align: center;
  }

  .custom-slideshow .slide__button:not(:hover) {
    --button-color: var(--brown);
    --button-background-color: var(--beige);
    --button-border-color: var(--beige);
  }

  @media(max-width: 749px){
    .custom-slideshow .slide::after {
      width: 71.428%;
    }
  }

  .slideshow__dots {
    display: flex;
    gap: 10px;
    z-index: 5;
    margin: -30px auto 0;
    width: 240px;
    position: relative;
  }

  .slideshow__dots .dot {
    background-color: transparent;
    width: 100%;
    height: 20px;
    border-radius: 0;
    border: 0;
    padding: 0;
    position: relative;
    flex: 1;
    cursor: pointer;

    &::before{
      height: 4px;
      width: 100%;
      position: absolute;
      top: 8px;
      left: 0;
      background-color: var(--brown);
      content: "";
    }

    &.is-active{
      &::after{
        height: 4px;
        width: 100%;
        position: absolute;
        top: 8px;
        left: 0;
        background-color: var(--beige);
        content: "";
        animation-name: change-width;
        display: block;
        animation-timing-function: linear;
        animation-duration: var(--slideshow-duration);
      }
    }
  }

  .slideshow__sound-toggle {
    position: absolute;
    right: var(--page-margin);
    bottom: 24px;
    z-index: 6;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: var(--beige);
    color: var(--brown);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  .slideshow__sound-toggle.is-visible {
    display: flex;
  }

  .slideshow__sound-toggle .sound-icon {
    width: 24px;
    height: 24px;
    display: block;
  }

  .slideshow__sound-toggle .sound-icon--on {
    display: none;
  }

  .slideshow__sound-toggle.is-sound-on .sound-icon--off {
    display: none;
  }

  .slideshow__sound-toggle.is-sound-on .sound-icon--on {
    display: block;
  }

  @media(min-width: 750px){
    .custom-slideshow {
      margin-bottom: 120px;
      
      .slideshow__track{
        aspect-ratio: 3/2;
      }

      .slide-content{
        gap: 18px;
        padding: 80px 0;

        .slide__title{
          max-width: 300px;
          font-size: var(--baf-display-large-size);
        }

        .slide__text{
          font-size: var(--baf-text-large-size);
          max-width: 270px;
        }
      }

      .slideshow__dots{
        width: 500px;
      }
    }
  }

  @media(min-width: 1200px){
    .custom-slideshow {
      .slideshow__track{
        aspect-ratio: 13/7;
        height: min(53.846vw, calc(100dvh - var(--header-height) - 116px));
        max-height: calc(100dvh - var(--header-height) - 116px);
      }

      .slide-image img,
      .slide-image video{
        object-position: center;
      }

      .slide-content{
        gap: 22px;
        padding: 120px 0;

        .slide__title{
          max-width: 500px;
          font-size: var(--baf-display-large-size);
        }

        .slide__text{
          max-width: 320px;
        }
      }
    }
  }

  @media (orientation: portrait) {
    .custom-slideshow {
      margin-bottom: 90px;

      .slideshow__track {
        aspect-ratio: auto;
        min-height: 79.71svh;
        max-height: none;
      }

      .slide-image img,
      .slide-image video {
        object-position: var(--slide-image-position-portrait, center center);
      }

      .slide[data-portrait-image-position='left'] .slide-image img,
      .slide[data-portrait-image-position='left'] .slide-image video {
        object-position: left center;
      }

      .slide[data-portrait-image-position='center'] .slide-image img,
      .slide[data-portrait-image-position='center'] .slide-image video {
        object-position: center center;
      }

      .slide[data-portrait-image-position='right'] .slide-image img,
      .slide[data-portrait-image-position='right'] .slide-image video {
        object-position: right center;
      }

      .slide-content {
        width: auto;
        margin-inline: max(var(--util-page-margin-offset), 24px);
        justify-content: flex-start;
        align-items: center;
        gap: 14px;
        padding: 26px 0 80px;

        .slide-content__inner {
          align-items: center;
          text-align: center;
        }

        .slide__title {
          max-width: 340px;
          margin: 0;
          font-size: var(--baf-display-large-size);
          line-height: 0.95;
        }

        .slide__text {
          max-width: 310px;
          margin: 0;
          font-size: var(--baf-text-medium-size);
        }

        .slide__button {
          margin-top: 0;
        }
      }
    }
  }

  @media (min-width: 750px) and (orientation: portrait) {
    .custom-slideshow {
      margin-bottom: 120px;

      .slideshow__track {
        min-height: 79.71svh;
      }

      .slide-content {
        padding: 28px 0 110px;

        .slide__title {
          max-width: 520px;
          font-size: var(--baf-display-large-size);
        }

        .slide__text {
          max-width: 360px;
          font-size: var(--baf-text-large-size);
        }
      }
    }
  }

  @media (min-width: 1200px) and (orientation: portrait) {
    .custom-slideshow {
      .slideshow__track {
        min-height: 79.71svh;
      }

      .slide-content {
        padding: 32px 0 140px;

        .slide__title {
          max-width: 650px;
          font-size: var(--baf-display-large-size);
        }

        .slide__text {
          max-width: 420px;
          font-size: var(--baf-text-large-size);
        }
      }
    }
  }

  @media (orientation: portrait) {
    .custom-slideshow .slide-video--landscape:not(.slide-video--all) {
      display: none;
    }

    .custom-slideshow .slide-video--portrait {
      display: block;
    }

    .custom-slideshow .slide .slide-image img,
    .custom-slideshow .slide .slide-image video {
      object-position: var(--slide-image-position-portrait, center center) !important;
    }
  }
{% endstylesheet %}

<script type="module">
document.addEventListener("DOMContentLoaded", () => {
  const slideshow = document.querySelector(".custom-slideshow");
  if (!slideshow) return;

  const slides = slideshow.querySelectorAll(".slide");
  if (!slides.length) return;

  const dots = slideshow.querySelectorAll(".dot");
  const soundToggle = slideshow.querySelector("[data-sound-toggle]");
  const swipeSurface = slideshow.querySelector(".slideshow__track");
  const hasMultipleSlides = slides.length > 1;
  
  let index = 0;
  let soundOn = false;
  let swipePointerId = null;
  let swipeStartX = 0;
  let swipeStartY = 0;
  let swipeMoved = false;

  const autoplay = hasMultipleSlides && slideshow.dataset.autoplay === "true";
  const deferAutoplay = autoplay && window.matchMedia("(max-width: 749px), (hover: none), (pointer: coarse)").matches;
  const speed = (parseFloat(slideshow.dataset.speed) || 4) * 1000;

  let slideTimer;
  let resumeTimeout;
  let slideStartedAt = 0;
  let remainingSlideTime = speed;
  let autoplayPaused = false;
  const portraitMedia = window.matchMedia("(orientation: portrait)");

  function videoMatchesViewport(video) {
    const hasPortraitAlternative = Boolean(video.closest(".slide")?.querySelector(".slide-video--portrait"));
    if (video.classList.contains("slide-video--portrait")) return portraitMedia.matches;
    if (video.classList.contains("slide-video--landscape") && hasPortraitAlternative) return !portraitMedia.matches;
    return true;
  }

  function scheduleNextSlide(duration = speed) {
    if (!autoplay) return;
    clearTimeout(slideTimer);
    remainingSlideTime = duration;
    slideStartedAt = Date.now();
    slideTimer = setTimeout(nextSlide, duration);
  }

  function restartAutoplayTimer() {
    if (!autoplay) return;
    autoplayPaused = false;
    slideshow.classList.remove("is-autoplay-paused");
    scheduleNextSlide(speed);
  }

  function showSlide(i, resetAutoplay = true) {
    slides.forEach((slide, idx) => {
      const active = idx === i;
      slide.classList.toggle("is-active", active);
      const videos = slide.querySelectorAll("video");
      videos.forEach(video => {
        video.muted = !soundOn;
        if (active && videoMatchesViewport(video)) { video.currentTime = 0; video.play().catch(() => {}); }
        else video.pause();
      });
    });

    dots.forEach((dot, idx) => {
      dot.classList.toggle("is-active", idx === i);
    });

    if (soundToggle) {
      const activeVideo = slides[i] && slides[i].querySelector("video");
      soundToggle.classList.toggle("is-visible", Boolean(activeVideo));
    }

    if (resetAutoplay) restartAutoplayTimer();
  }

  function nextSlide() {
    index = (index + 1) % slides.length;
    showSlide(index);
  }

  function previousSlide() {
    index = (index - 1 + slides.length) % slides.length;
    showSlide(index);
  }

  function pauseAutoplayTemporarily() {
    if (!autoplay) return;
    clearTimeout(resumeTimeout);

    if (!autoplayPaused) {
      const elapsed = Date.now() - slideStartedAt;
      remainingSlideTime = Math.max(0, remainingSlideTime - elapsed);
      clearTimeout(slideTimer);
      autoplayPaused = true;
      slideshow.classList.add("is-autoplay-paused");
    }

    resumeTimeout = setTimeout(() => {
      autoplayPaused = false;
      slideshow.classList.remove("is-autoplay-paused");
      scheduleNextSlide(remainingSlideTime);
    }, 2000);
  }

  dots.forEach(dot => {
    dot.addEventListener("click", () => {

      index = parseInt(dot.dataset.index);
      showSlide(index);
    });
  });

  if (hasMultipleSlides) {
    slideshow.addEventListener("click", pauseAutoplayTemporarily);
  }

  if (hasMultipleSlides && swipeSurface) {
    swipeSurface.addEventListener("pointerdown", event => {
      if (event.pointerType === "mouse") return;
      swipePointerId = event.pointerId;
      swipeStartX = event.clientX;
      swipeStartY = event.clientY;
      swipeMoved = false;
      swipeSurface.setPointerCapture?.(event.pointerId);
    });

    swipeSurface.addEventListener("pointerup", event => {
      if (swipePointerId !== event.pointerId) return;
      const deltaX = event.clientX - swipeStartX;
      const deltaY = event.clientY - swipeStartY;
      swipePointerId = null;

      if (Math.abs(deltaX) < 45 || Math.abs(deltaX) < Math.abs(deltaY)) return;

      swipeMoved = true;
      if (deltaX < 0) nextSlide();
      else previousSlide();
      pauseAutoplayTemporarily();
    });

    swipeSurface.addEventListener("pointercancel", () => {
      swipePointerId = null;
    });

    swipeSurface.addEventListener("click", event => {
      if (!swipeMoved) return;
      event.preventDefault();
      event.stopPropagation();
      swipeMoved = false;
    }, true);
  }

  if (soundToggle) {
    soundToggle.addEventListener("click", () => {
      soundOn = !soundOn;
      soundToggle.classList.toggle("is-sound-on", soundOn);
      soundToggle.setAttribute("aria-pressed", soundOn ? "true" : "false");
      soundToggle.setAttribute("aria-label", soundOn ? "Turn sound off" : "Turn sound on");
      slides.forEach(slide => {
        slide.querySelectorAll("video").forEach(video => {
          video.muted = !soundOn;
        });
      });
    });
  }

  portraitMedia.addEventListener?.("change", () => showSlide(index, false));

  if (deferAutoplay) {
    let deferredAutoplayStarted = false;
    const startDeferredAutoplay = () => {
      if (deferredAutoplayStarted) return;
      deferredAutoplayStarted = true;
      slideshow.classList.remove("is-autoplay-paused");
      restartAutoplayTimer();
    };

    slideshow.classList.add("is-autoplay-paused");
    ["pointerdown", "touchstart", "keydown", "wheel"].forEach(eventName => {
      window.addEventListener(eventName, startDeferredAutoplay, { once: true, passive: true });
    });
    window.addEventListener("load", () => {
      window.setTimeout(startDeferredAutoplay, 20000);
    }, { once: true });
    showSlide(index, false);
  } else {
    showSlide(index);
  }
});
</script>

