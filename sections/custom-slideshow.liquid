{% assign slide_speed = section.settings.autoplay_speed | default: 4 %}
<style>
  :root {
    --slideshow-duration: {{ slide_speed }}s;
  }
</style>

<div class="section section--custom-slideshow">
  <div 
    class="custom-slideshow"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.autoplay_speed }}"
  >
    <div class="slideshow__track">
      {% for block in section.blocks %}
        <div class="slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>

          {% if block.settings.video != blank %}
            <div class="slide-image">
              <video
                autoplay
                muted
                loop
                playsinline
                class="slide-video"
              >
                {% for source in block.settings.video.sources %}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {% endfor %}
              </video>
            </div>
          {% elsif block.settings.image %}
            <div class="slide-image">
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                alt=""
                loading="lazy"
                width="1200" height="800">
            </div>
          {% endif %}

          <div class="slide-content">
            <h2 class="slide__title">
              {{ block.settings.title }}
            </h2>
            <p class="slide__text">
              {{ block.settings.text }}
            </p>
            {% if block.settings.button_link %}
              <a href="{{ block.settings.button_link }}" class="slide__button button">
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>

        </div>
      {% endfor %}
    </div>

    <div class="slideshow__dots">
      {% for block in section.blocks %}
        <button class="dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}"></button>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .section--custom-slideshow{
    display: block;
  }

  .custom-slideshow {
    position: relative; 
    margin-bottom: 80px;
  }

  .slideshow__track{
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1/1;
    position: relative;
    border-radius: 0 0 80px 80px;
  }

  .custom-slideshow .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.7s ease;
    display: grid;
  }

  .custom-slideshow .slide.is-active {
    opacity: 1;
    z-index: 2;
  }

  .custom-slideshow .slide-image {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .custom-slideshow .slide-image img,
  .custom-slideshow .slide-image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right;
  }

  .custom-slideshow .slide-content {
    position: relative;
    z-index: 2;
    display: flex;
    height: 100%;
    flex-direction: column;
    width: min( var(--page-width) - var(--page-margin) * 2, calc(100% - var(--page-margin) * 2) );
    margin: 0 auto;
    padding: 60px 0;

    .slide__title{
      max-width: 250px;
    }

    .slide__text{
      font-weight: 700;
      max-width: 240px;
      color: var(--brown);
    }

    .slide__button{
      margin-top: 10px;
    }
  }

  .slideshow__dots {
    display: flex;
    gap: 10px;
    z-index: 5;
    margin: -30px auto 0;
    width: 240px;
    position: relative;
  }

  .slideshow__dots .dot {
    background-color: transparent;
    width: 100%;
    height: 20px;
    border-radius: 0;
    border: 0;
    padding: 0;
    position: relative;
    flex: 1;
    cursor: pointer;

    &::before{
      height: 4px;
      width: 100%;
      position: absolute;
      top: 8px;
      left: 0;
      background-color: var(--brown);
      content: "";
    }

    &.is-active{
      &::after{
        height: 4px;
        width: 100%;
        position: absolute;
        top: 8px;
        left: 0;
        background-color: var(--beige);
        content: "";
        animation-name: change-width;
        display: block;
        animation-timing-function: linear;
        animation-duration: var(--slideshow-duration);
      }
    }
  }

  @media(min-width: 750px){
    .custom-slideshow {
      margin-bottom: 120px;
      
      .slideshow__track{
        aspect-ratio: 3/2;
      }

      .slide-content{
        padding: 80px 0 120px;
        .slide__title{
          max-width: 300px;
          font-size: 36px;
        }

        .slide__text{
          font-size: 18px;
          max-width: 270px;
        }
      }

      .slideshow__dots{
        width: 500px;
      }
    }
  }

  @media(min-width: 1200px){
    .custom-slideshow {
      .slideshow__track{
        aspect-ratio: 13/7;
        max-height: calc(95dvh - var(--header-height));
      }

      .slide-image img,
      .slide-image video{
        object-position: center;
      }

      .slide-content{
        padding: 120px 0 250px;

        .slide__title{
          max-width: 500px;
          font-size: 54px;
          margin-bottom: auto;
        }

        .slide__text{
          max-width: 320px;
        }
      }
    }
  }
{% endstylesheet %}

{% javascript %}
document.addEventListener("DOMContentLoaded", () => {
  const slideshow = document.querySelector(".custom-slideshow");
  if (!slideshow) return;

  const slides = slideshow.querySelectorAll(".slide");
  const dots = slideshow.querySelectorAll(".dot");
  
  let index = 0;

  const autoplay = slideshow.dataset.autoplay === "true";
  const speed = (parseInt(slideshow.dataset.speed) || 4) * 1000;

  let interval;
  if (autoplay) {
    interval = setInterval(nextSlide, speed);
  }

  function showSlide(i) {
    slides.forEach((slide, idx) => {
      const active = idx === i;
      slide.classList.toggle("is-active", active);
      const video = slide.querySelector("video");
      if (video) {
        if (active) { video.currentTime = 0; video.play(); }
        else video.pause();
      }
    });

    dots.forEach((dot, idx) => {
      dot.classList.toggle("is-active", idx === i);
    });
  }

  function nextSlide() {
    index = (index + 1) % slides.length;
    showSlide(index);
  }

  dots.forEach(dot => {
    dot.addEventListener("click", () => {

      index = parseInt(dot.dataset.index);
      showSlide(index);

      if (autoplay) {
        clearInterval(interval);
        interval = setInterval(nextSlide, speed);
      }
    });
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Fade Slideshow",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": true,
      "label": "Autoplay"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Speed"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (fallback if no video)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fade Slideshow"
    }
  ]
}
{% endschema %}