{%- liquid
  assign cap_cards = ''
  assign tshirt_cards = ''
  assign crewneck_cards = ''
  assign cap_count = 0
  assign tshirt_count = 0
  assign crewneck_count = 0
  assign bestseller_count = 0
-%}

{%- paginate collection.products by 50 -%}
  {%- for product in collection.products -%}
    {%- liquid
      assign product_type = product.type | downcase
      assign product_title = product.title | downcase
      assign is_cap = false
      assign is_tshirt = false
      assign is_crewneck = false

      if product_type == 'cap' or product_title contains '| cap' or product_title contains ' cap'
        assign is_cap = true
      elsif product_type contains 't-shirt' or product_type contains 't shirt' or product_title contains '| t-shirt' or product_title contains '| t shirt'
        assign is_tshirt = true
      elsif product_type contains 'crewneck' or product_type contains 'crew neck' or product_title contains '| crewneck' or product_title contains '| crew neck'
        assign is_crewneck = true
      endif
    -%}

    {%- capture card_markup -%}
      <li class="shop-products__grid-item" data-product-id="{{ product.id }}">
        {%- # theme-check-disable UniqueStaticBlockId -%}
        {%- content_for 'block', type: '_product-card', id: 'product-card', closest.product: product -%}
        {%- # theme-check-enable UniqueStaticBlockId -%}
      </li>
    {%- endcapture -%}

    {%- if is_cap -%}
      {%- assign cap_cards = cap_cards | append: card_markup -%}
      {%- assign cap_count = cap_count | plus: 1 -%}
    {%- elsif is_tshirt -%}
      {%- assign tshirt_cards = tshirt_cards | append: card_markup -%}
      {%- assign tshirt_count = tshirt_count | plus: 1 -%}
    {%- elsif is_crewneck -%}
      {%- assign crewneck_cards = crewneck_cards | append: card_markup -%}
      {%- assign crewneck_count = crewneck_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endpaginate -%}

{%- capture bestseller_cards -%}
  {%- for product in section.settings.bestseller_products limit: 10 -%}
    {%- if product != blank -%}
      {%- assign bestseller_count = bestseller_count | plus: 1 -%}
      <li class="shop-products__rail-item" data-product-id="{{ product.id }}">
        {%- # theme-check-disable UniqueStaticBlockId -%}
        {%- content_for 'block', type: '_product-card', id: 'product-card', closest.product: product -%}
        {%- # theme-check-enable UniqueStaticBlockId -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if bestseller_count == 0 -%}
  {%- capture bestseller_cards -%}
    {%- assign default_bestseller_handles = 'give-love-cap,powered-by-dogs-t-shirt,powered-by-dogs-cap,bloom-crewneck,no-fart-no-love-t-shirt' | split: ',' -%}
    {%- for handle in default_bestseller_handles -%}
      {%- assign product = all_products[handle] -%}
      {%- if product != blank -%}
        {%- assign bestseller_count = bestseller_count | plus: 1 -%}
        <li class="shop-products__rail-item" data-product-id="{{ product.id }}">
          {%- # theme-check-disable UniqueStaticBlockId -%}
          {%- content_for 'block', type: '_product-card', id: 'product-card', closest.product: product -%}
          {%- # theme-check-enable UniqueStaticBlockId -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<section
  class="shop-products section color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <nav class="shop-products__nav section section--page-width" aria-label="Shop products sections" data-baf-scroll-subnav>
    <a class="shop-products__nav-link is-active" href="#shop-products-custom">{{ section.settings.custom_portrait_title }}</a>
    {%- if bestseller_cards != blank -%}<a class="shop-products__nav-link" href="#shop-products-bestseller">{{ section.settings.bestseller_title }}</a>{%- endif -%}
    {%- if cap_count > 0 -%}<a class="shop-products__nav-link" href="#shop-products-cap">{{ section.settings.cap_title }}</a>{%- endif -%}
    {%- if tshirt_count > 0 -%}<a class="shop-products__nav-link" href="#shop-products-tshirt">{{ section.settings.tshirt_title }}</a>{%- endif -%}
    {%- if crewneck_count > 0 -%}<a class="shop-products__nav-link" href="#shop-products-crewneck">{{ section.settings.crewneck_title }}</a>{%- endif -%}
  </nav>

  <div class="shop-products__inner">
    <section id="shop-products-custom" class="shop-products__custom shop-products__anchor">
      <h1 class="shop-products__hero-title">{{ section.settings.custom_portrait_title }}</h1>

      <div class="shop-products__portrait-grid">
        {%- render 'shop-products-portrait-tile',
          image: section.settings.portrait_1_image,
          style_label: section.settings.portrait_1_style_label,
          style_id: section.settings.portrait_1_style_id,
          product: section.settings.portrait_1_product,
          product_label: section.settings.portrait_1_product_label,
          product_handle_override: section.settings.portrait_1_product_handle_override,
          preset_product_category: 'canvas',
          preset_framing: 'unframed',
          preset_size: '20″×28″',
          button_label: section.settings.portrait_1_button_label,
          fallback_image: 'make-portrait/overview01.png'
        -%}

        {%- render 'shop-products-portrait-tile',
          image: section.settings.portrait_2_image,
          style_label: section.settings.portrait_2_style_label,
          style_id: section.settings.portrait_2_style_id,
          product: section.settings.portrait_2_product,
          product_label: section.settings.portrait_2_product_label,
          product_handle_override: section.settings.portrait_2_product_handle_override,
          preset_product_category: 'canvas',
          preset_size: '20″×28″',
          preset_framing: 'framed',
          preset_color: 'brown',
          button_label: section.settings.portrait_2_button_label,
          fallback_image: 'make-portrait/overview02.png'
        -%}

        {%- render 'shop-products-portrait-tile',
          image: section.settings.portrait_3_image,
          style_label: section.settings.portrait_3_style_label,
          style_id: section.settings.portrait_3_style_id,
          product: section.settings.portrait_3_product,
          product_label: section.settings.portrait_3_product_label,
          product_handle_override: section.settings.portrait_3_product_handle_override,
          preset_product_category: 'paper',
          preset_size: '50×70 cm',
          preset_border: 'no-border',
          preset_framing: 'framed',
          preset_color: 'oak',
          button_label: section.settings.portrait_3_button_label,
          fallback_image: 'make-portrait/bark-and-frame-configurator-hero-jack-russell-with-his-portrait-gentleman-old-master-style-living-room.jpg'
        -%}
      </div>
    </section>

    {%- if bestseller_cards != blank -%}
      <section id="shop-products-bestseller" class="shop-products__bestseller shop-products__anchor">
        <h2 class="shop-products__section-title shop-products__section-title--center">
          {{ section.settings.bestseller_title }}
        </h2>

        <div class="shop-products__rail" data-shop-products-rail>
          <ul class="shop-products__rail-track" role="list">
            {%- for i in (1..8) -%}
              {{ bestseller_cards }}
            {%- endfor -%}
          </ul>
        </div>
      </section>
    {%- endif -%}

    {%- if cap_cards != blank -%}
      <section id="shop-products-cap" class="shop-products__product-section shop-products__anchor">
        <h2 class="shop-products__section-title">{{ section.settings.cap_title }}</h2>
        <ul class="shop-products__product-grid" role="list">{{ cap_cards }}</ul>
      </section>
    {%- endif -%}

    {%- if tshirt_cards != blank -%}
      <section id="shop-products-tshirt" class="shop-products__product-section shop-products__anchor">
        <h2 class="shop-products__section-title">{{ section.settings.tshirt_title }}</h2>
        <ul class="shop-products__product-grid" role="list">{{ tshirt_cards }}</ul>
      </section>
    {%- endif -%}

    {%- if crewneck_cards != blank -%}
      <section id="shop-products-crewneck" class="shop-products__product-section shop-products__anchor">
        <h2 class="shop-products__section-title">{{ section.settings.crewneck_title }}</h2>
        <ul class="shop-products__product-grid" role="list">{{ crewneck_cards }}</ul>
      </section>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.sticky_button_enabled and section.settings.sticky_button_link != blank -%}
  <a href="{{ section.settings.sticky_button_link }}" class="collection-sticky-btn button">
    {{- section.settings.sticky_button_text | default: 'Shop Now' -}}
  </a>
{%- endif -%}

{% stylesheet %}
  .shop-products {
    --shop-products-grid-gap: 20px;
    --shop-products-card-width: calc((min(var(--page-content-width), calc(100vw - (var(--site-content-margin) * 2))) - (var(--shop-products-grid-gap) * 3)) / 4);
    padding-block: var(--padding-block-start) 120px;
    background: var(--beige);
  }

  .shop-products__inner {
    width: 100%;
    margin-inline: auto;
  }

  .shop-products__anchor {
    scroll-margin-top: 120px;
  }

  .shop-products__nav {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-start;
    gap: 0;
    box-sizing: border-box;
    position: sticky;
    top: var(--header-height, 0);
    z-index: 7;
    width: 100vw;
    margin-inline: calc((100% - 100vw) / 2);
    padding: 10px 0 0;
    background: var(--beige);
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    transition: opacity 0.16s ease, transform 0.16s ease;
    will-change: transform;
  }

  .shop-products__nav.is-hidden-on-scroll {
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(-100% - 1px));
  }

  .shop-products__nav::before,
  .shop-products__nav::after {
    content: "";
    flex: 1 0 var(--page-margin);
  }

  .shop-products__nav::-webkit-scrollbar {
    display: none;
  }

  .shop-products__nav-link {
    display: inline-block;
    flex: 0 0 auto;
    padding: 10px;
    color: var(--brown);
    font-family: "display", serif;
    font-size: 21px;
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
    opacity: 0.35;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .shop-products__nav-link:hover,
  .shop-products__nav-link.is-active {
    opacity: 1;
  }

  .shop-products__custom {
    padding-top: 103px;
  }

  .shop-products__hero-title {
    margin: 0;
    color: var(--brown);
    font-family: "display", serif;
    font-size: var(--baf-display-large-size);
    font-weight: 400;
    line-height: 1;
    text-align: center;
    text-transform: none;
  }

  .shop-products__portrait-grid {
    --portrait-grid-gap: 20px;
    --portrait-card-width: calc((100% - (var(--portrait-grid-gap) * 3)) / 4);
    display: flex;
    justify-content: center;
    gap: var(--portrait-grid-gap);
    box-sizing: border-box;
    width: 100%;
    margin-top: calc(126px - var(--hover-lift-amount));
    margin-inline: 0;
    padding-block-start: var(--hover-lift-amount);
    overflow-x: auto;
    scroll-padding-inline: 0;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .shop-products__portrait-grid::-webkit-scrollbar {
    display: none;
  }

  .shop-products__portrait-card {
    position: relative;
    display: grid;
    flex: 0 0 var(--portrait-card-width);
    gap: 20px;
    isolation: isolate;
    scroll-snap-align: start;
    transition: transform var(--hover-transition-duration) var(--hover-transition-timing);
  }

  .shop-products__portrait-media {
    display: block;
    aspect-ratio: 302 / 383;
    overflow: hidden;
    border-radius: 40px;
    background: #f4efe5;
  }

  .shop-products__portrait-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-products__portrait-badges {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    pointer-events: none;
  }

  .shop-products__portrait-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 15px;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .shop-products__portrait-badge--style {
    background: #dbdbff;
    color: var(--brown);
  }

  .shop-products__portrait-badge--product {
    background: var(--green);
    color: var(--beige);
  }

  .shop-products__portrait-button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 51px;
    padding: 14px 24px;
    border-radius: 999px;
    background: var(--brown);
    color: var(--beige);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: background-color .2s, color .2s;
  }

  .shop-products__portrait-card:is(:hover, :focus-within) .shop-products__portrait-button {
    background-color: var(--purple);
    color: var(--brown);
  }

  .shop-products__bestseller {
    position: relative;
    isolation: isolate;
    margin: clamp(133px, 21.33vw, 325px) auto 0;
    padding: 76px 0 92px;
    overflow: visible;
    border-radius: 360px;
    background: transparent;
  }

  .shop-products__bestseller::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: #f4efe5;
  }

  .shop-products__section-title {
    margin: 0 0 48px;
    color: var(--brown);
    font-family: "display", serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1;
    text-transform: none;
  }

  .shop-products__section-title--center {
    text-align: center;
  }

  .shop-products__rail {
    width: 100vw;
    margin-block-start: calc(-1 * var(--hover-lift-amount));
    margin-inline: calc((100% - 100vw) / 2);
    padding-block-start: var(--hover-lift-amount);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .shop-products__rail::-webkit-scrollbar {
    display: none;
  }

  .shop-products__rail-track {
    display: flex;
    gap: var(--shop-products-grid-gap);
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shop-products__rail-item {
    flex: 0 0 var(--shop-products-card-width);
    width: var(--shop-products-card-width);
    min-width: 0;
    max-width: var(--shop-products-card-width);
    transition: transform var(--hover-transition-duration) var(--hover-transition-timing);
  }

  .shop-products__product-section {
    margin-top: 224px;
  }

  .shop-products__product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 64px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shop-products__grid-item {
    min-width: 0;
    transition: transform var(--hover-transition-duration) var(--hover-transition-timing);
  }

  @media (any-pointer: fine) and (prefers-reduced-motion: no-preference) {
    .shop-products__portrait-card:hover,
    .shop-products__rail-item:hover,
    .shop-products__grid-item:hover {
      transform: translateY(calc(-1 * var(--hover-lift-amount)));
    }
  }

  .collection-sticky-btn {
    position: sticky;
    bottom: 20px;
    left: 50%;
    z-index: 100;
    margin-bottom: 60px;
    transform: translateX(-50%);
    white-space: nowrap;
    background-color: var(--beige);
    border: 1px solid var(--brown);
    color: var(--brown);
  }

  .collection-sticky-btn.is-hidden-on-scroll {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .shop-products__portrait-grid {
      --portrait-card-width: calc((100% - (var(--portrait-grid-gap) * 2)) / 3);
    }

    .shop-products {
      --shop-products-card-width: calc((min(var(--page-content-width), calc(100vw - (var(--site-content-margin) * 2))) - (var(--shop-products-grid-gap) * 2)) / 3);
    }

    .shop-products__product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .shop-products__custom {
      padding-top: 68px;
    }

    .shop-products {
      --shop-products-grid-gap: 12px;
      --shop-products-card-width: calc((min(var(--page-content-width), calc(100vw - (var(--site-content-margin) * 2))) - var(--shop-products-grid-gap)) / 2);
    }

    .shop-products__hero-title {
      margin: 0;
      font-size: var(--baf-display-large-size);
    }

    .shop-products__portrait-grid {
      --portrait-grid-gap: 12px;
      --portrait-card-width: calc((100% - var(--portrait-grid-gap)) / 2);
      justify-content: flex-start;
      margin-top: calc(83px - var(--hover-lift-amount));
    }

    .shop-products__bestseller {
      margin-top: 112px;
      padding: 52px 0 64px;
      border-radius: 80px;
    }

    .shop-products__section-title {
      margin-bottom: 28px;
      font-size: var(--baf-display-large-size);
    }

    .shop-products__rail-track {
      gap: var(--shop-products-grid-gap);
    }

    .shop-products__product-section {
      margin-top: 152px;
    }

    .shop-products__product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 42px var(--shop-products-grid-gap);
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const rails = document.querySelectorAll('[data-shop-products-rail]');
    const stickyButton = document.querySelector('.collection-sticky-btn');
    const navLinks = Array.from(document.querySelectorAll('.shop-products__nav-link[href^="#shop-products-"]'));
    const navSections = navLinks
      .map((link) => ({
        link,
        section: document.querySelector(link.getAttribute('href')),
      }))
      .filter((item) => item.section);

    rails.forEach((rail) => {
      const track = rail.querySelector('.shop-products__rail-track');
      if (!track) return;

      let frame = null;
      let paused = false;
      const speed = 0.45;

      const getLoopPoint = () => track.scrollWidth / 2;

      const normalizeScroll = () => {
        const loopPoint = getLoopPoint();
        if (loopPoint <= 0) return;
        if (rail.scrollLeft >= loopPoint) rail.scrollLeft -= loopPoint;
        if (rail.scrollLeft < 0) rail.scrollLeft += loopPoint;
      };

      const tick = () => {
        if (!paused) {
          rail.scrollLeft += speed;
          normalizeScroll();
        }
        frame = window.requestAnimationFrame(tick);
      };

      const pauseRail = () => {
        paused = true;
      };

      const resumeRail = () => {
        paused = false;
      };

      rail.addEventListener('mouseenter', pauseRail);
      rail.addEventListener('pointerenter', pauseRail);
      rail.addEventListener('mouseleave', resumeRail);
      rail.addEventListener('pointerleave', resumeRail);

      frame = window.requestAnimationFrame(tick);

      document.addEventListener('shopify:section:unload', () => {
        if (frame) window.cancelAnimationFrame(frame);
      }, { once: true });
    });

    if (navSections.length) {
      let navTicking = false;

      const getNavOffset = () => {
        const headerHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 0;
        const nav = document.querySelector('.shop-products__nav');
        const navHeight = nav ? nav.offsetHeight : 0;
        return headerHeight + navHeight + 12;
      };

      const updateActiveNav = () => {
        const probeY = window.scrollY + getNavOffset() + 12;
        let activeItem = navSections[0];

        navSections.forEach((item) => {
          const sectionTop = item.section.getBoundingClientRect().top + window.scrollY;
          if (sectionTop <= probeY) activeItem = item;
        });

        navLinks.forEach((link) => {
          link.classList.toggle('is-active', link === activeItem.link);
        });

        navTicking = false;
      };

      const onNavScroll = () => {
        if (navTicking) return;
        navTicking = true;
        window.requestAnimationFrame(updateActiveNav);
      };

      updateActiveNav();
      navSections.forEach((item) => {
        item.link.addEventListener('click', (event) => {
          event.preventDefault();
          const sectionTop = item.section.getBoundingClientRect().top + window.scrollY;

          window.scrollTo({
            top: Math.max(sectionTop - getNavOffset(), 0),
            behavior: 'smooth',
          });

          navLinks.forEach((link) => {
            link.classList.toggle('is-active', link === item.link);
          });

          window.history.replaceState(null, '', item.link.getAttribute('href'));
        });
      });
      window.addEventListener('scroll', onNavScroll, { passive: true });
      window.addEventListener('resize', onNavScroll);
      document.addEventListener('shopify:section:unload', () => {
        window.removeEventListener('scroll', onNavScroll);
        window.removeEventListener('resize', onNavScroll);
      }, { once: true });
    }

    if (!stickyButton) return;

    let lastScrollY = window.scrollY;
    let ticking = false;
    const scrollThreshold = 8;

    const updateStickyButton = () => {
      const currentScrollY = Math.max(window.scrollY, 0);
      const delta = currentScrollY - lastScrollY;

      if (currentScrollY <= scrollThreshold || delta < -scrollThreshold) {
        stickyButton.classList.remove('is-hidden-on-scroll');
      } else if (delta > scrollThreshold) {
        stickyButton.classList.add('is-hidden-on-scroll');
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateStickyButton);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('shopify:section:unload', () => {
      window.removeEventListener('scroll', onScroll);
    }, { once: true });
  })();
</script>

