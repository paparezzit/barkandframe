{% schema %}
{
  "name": "Shop products layout",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "custom_portrait_title",
      "label": "Custom portrait title",
      "default": "Custom Portrait"
    },
    {
      "type": "header",
      "content": "Custom portrait 1"
    },
    {
      "type": "image_picker",
      "id": "portrait_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "portrait_1_style_label",
      "label": "Style bubble",
      "default": "The Gentleman"
    },
    {
      "type": "text",
      "id": "portrait_1_style_id",
