<div class="artist-intro">
  <div class="artist-intro__wrapper">
    {%- if section.settings.title != blank -%}
      {%- assign title_parts = section.settings.title | split: '. ' -%}
      <h2 class="artist-intro__title">
        {%- if title_parts.size > 1 -%}
          {{- title_parts.first -}}.<span class="artist-intro__title-space"> </span><br class="artist-intro__title-break">
          {%- for title_part in title_parts -%}
            {%- unless forloop.first -%}
              {{- title_part -}}{%- unless forloop.last -%}. {% endunless -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {{- section.settings.title -}}
        {%- endif -%}
      </h2>
    {%- endif -%}
    <div class="artist-intro__inner">

      <div class="artist-intro__image">
        {%- if section.settings.image != blank -%}
          {{- section.settings.image | image_url: width: 900 | image_tag:
            loading: 'lazy',
            widths: '450, 600, 900',
            class: 'artist-intro__img'
          -}}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'artist-intro__img artist-intro__placeholder' }}
        {%- endif -%}
      </div>

      <div class="artist-intro__content">
        {%- if section.settings.text != blank -%}
          <div class="artist-intro__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button artist-intro__btn">
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% stylesheet %}
  .artist-intro {
    padding: 0 var(--page-margin);
    margin: 60px auto;
    max-width: calc(var(--narrow-page-width) + 2 * var(--page-margin));
  }

  .artist-intro__wrapper {
    background: var(--cream);
    border-radius: 1000px;
    max-width: 360px;
    margin: 0 auto;
    padding: 120px 0 40px;
  }

  .artist-intro__inner {
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .artist-intro__image {
    overflow: hidden;
    padding: 0 30px;
    mix-blend-mode: darken;
  }

  .artist-intro__img {
    width: 100%;
    display: block;
    max-width: 340px;
    margin: auto;
  }

  .artist-intro__content {
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 30px;
    text-align: center;
  }

  .artist-intro__title {
    font-family: "display", serif;
    font-size: clamp(36px, 4.5vw, 54px);
    color: var(--brown);
    font-weight: 400;
    margin: 0 0 40px;
    text-align: center;
  }

  .artist-intro__title-break {
    display: none;
  }

  .artist-intro__title-space {
    display: inline;
  }

  .artist-intro__text {
    color: var(--brown);
    font-family: var(--baf-text-bold-family);
    font-size: var(--baf-text-bold-large-size);
    font-weight: var(--baf-text-bold-weight);
    line-height: 1.3;
    max-width: 360px;
    margin: 0;
  }

  .artist-intro__btn {
    margin: 0 auto;
    align-self: flex-start;
  }

  @media screen and (min-width: 750px) {
    .artist-intro__wrapper{
      max-width: none;
      padding: 70px 80px;
    }

    .artist-intro__title{
      max-width: 540px;
      margin: 0 auto 30px;
    }

    .artist-intro__inner {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .artist-intro__image{
      display: flex;
      padding: 20px;
    }

    .artist-intro__content{
      padding: 0;
      text-align: left;
      gap: 40px;
    }

    .artist-intro__btn{
      margin: 0;
    }
    
  }

  @media screen and (min-width: 1200px) {
    .artist-intro__wrapper{
      padding: 70px 200px;
    }

    .artist-intro__title{
      max-width: 660px;
    }
  }

  @media screen and (max-width: 749px) {
    .artist-intro__title-space {
      display: none;
    }

    .artist-intro__title-break {
      display: initial;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Artist Intro",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Obrázek (vlevo)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Nadpis",
      "default": "Real artists.\nReal signatures."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every signature style at Bark & Frame is designed by one of our artists.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Text tlačítka",
      "default": "Meet our artists"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link tlačítka"
    }
  ],
  "presets": [
    {
      "name": "Artist Intro"
    }
  ]
}
{% endschema %}
