
{%- liquid
  assign portrait_styles = shop.metaobjects.portrait_style.values | sort: 'order'
  assign default_cta_style = blank
  assign use_scroll_layout = false
  assign is_artist_page = false

  if template.name == 'page' and template.suffix == 'artist'
    assign is_artist_page = true
  endif

  if request.page_type == 'product' or is_artist_page
    assign use_scroll_layout = true
  endif

  for style in portrait_styles
    assign style_id = style.style_id.value | strip
    assign style_name = style.name.value | strip
    if style_id == 'the_gentleman' or style_name == 'The Gentleman'
      assign default_cta_style = style
      break
    endif
  endfor
-%}

<section class="more-from section section--page-width{% if use_scroll_layout %} more-from--scroll{% endif %}">
  <h2 class="more-from__title">{{ section.settings.title }}</h2>

  <div class="more-from__grid">

    <a href="{{ section.settings.cta_link }}" class="more-from__cta">
      {%- assign has_cta_style_images = false -%}
      <div class="more-from__cta-img" data-more-from-style-cycler>
        {%- if default_cta_style != blank -%}
          {%- assign default_style_image = default_cta_style.visualizator.value | default: default_cta_style.visualizer_image.value | default: default_cta_style.preview_image.value -%}
          {%- if default_style_image != blank -%}
            {%- assign has_cta_style_images = true -%}
            <img
              class="more-from__cta-style-img is-active"
              src="{{ default_style_image | image_url: width: 640 }}"
              srcset="{{ default_style_image | image_url: width: 320 }} 320w, {{ default_style_image | image_url: width: 480 }} 480w, {{ default_style_image | image_url: width: 640 }} 640w"
              sizes="(max-width: 749px) 48vw, 25vw"
              alt="{{ default_cta_style.name.value | default: section.settings.cta_label | escape }}"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="{{ default_style_image.width }}"
              height="{{ default_style_image.height }}"
            >
          {%- endif -%}
        {%- endif -%}

        {%- for style in portrait_styles -%}
          {%- assign style_id = style.style_id.value | strip -%}
          {%- assign style_name = style.name.value | strip -%}
          {%- unless style_id == 'the_gentleman' or style_name == 'The Gentleman' -%}
            {%- assign style_image = style.visualizator.value | default: style.visualizer_image.value | default: style.preview_image.value -%}
            {%- if style_image != blank -%}
              {%- assign has_cta_style_images = true -%}
              <img
                class="more-from__cta-style-img"
                src="{{ style_image | image_url: width: 640 }}"
                srcset="{{ style_image | image_url: width: 320 }} 320w, {{ style_image | image_url: width: 480 }} 480w, {{ style_image | image_url: width: 640 }} 640w"
                sizes="(max-width: 749px) 48vw, 25vw"
                alt="{{ style.name.value | default: section.settings.cta_label | escape }}"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="{{ style_image.width }}"
                height="{{ style_image.height }}"
              >
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}

        {%- if has_cta_style_images == false and section.settings.cta_image != blank -%}
          <img
            class="more-from__cta-style-img is-active"
            src="{{ section.settings.cta_image | image_url: width: 640 }}"
            srcset="{{ section.settings.cta_image | image_url: width: 320 }} 320w, {{ section.settings.cta_image | image_url: width: 480 }} 480w, {{ section.settings.cta_image | image_url: width: 640 }} 640w"
            sizes="(max-width: 749px) 48vw, 25vw"
            alt="{{ section.settings.cta_label | escape }}"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="{{ section.settings.cta_image.width }}"
            height="{{ section.settings.cta_image.height }}"
          >
        {%- endif -%}
      </div>
      <div class="more-from__cta-body">
        <span class="more-from__cta-label">{{ section.settings.cta_label }}</span>
      </div>
    </a>

    {%- liquid
      assign more_from_handles = 'bloom-crewneck,you-can-pet-the-dog-cap,powered-by-dogs-t-shirt' | split: ','
    -%}

    {%- for product_handle in more_from_handles -%}
      {%- assign product = all_products[product_handle] -%}
      {%- if product != blank -%}
        <div class="more-from__product-card">
          {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
        </div>
      {%- endif -%}
    {%- endfor -%}

  </div>

  {%- if use_scroll_layout -%}
    <div class="more-from__scrollbar" aria-hidden="true">
      <span class="more-from__scrollbar-thumb"></span>
    </div>
  {%- endif -%}

  <div class="more-from__end-spacer" aria-hidden="true"></div>
</section>

{{ 'more-from-barkandframe.css' | asset_url | stylesheet_tag }}

<script>
  (() => {
    if (window.__bafMoreFromStyleCyclerBound) return;
    window.__bafMoreFromStyleCyclerBound = true;

    const moreFromScroll = document.querySelector('.more-from--scroll');
    const moreFromGrid = moreFromScroll?.querySelector('.more-from__grid');
    const moreFromScrollbar = moreFromScroll?.querySelector('.more-from__scrollbar');
    const moreFromScrollbarThumb = moreFromScrollbar?.querySelector('.more-from__scrollbar-thumb');
    const timers = new WeakMap();
    const desktopQuery = window.matchMedia('(min-width: 1200px)');
    const motionQuery = window.matchMedia('(prefers-reduced-motion: no-preference)');
    let isMoreFromScrollbarDragging = false;

    const updateMoreFromScrollbar = () => {
      if (!moreFromGrid || !moreFromScrollbar || !moreFromScrollbarThumb) return;

      const maxScroll = moreFromGrid.scrollWidth - moreFromGrid.clientWidth;

      if (maxScroll <= 0) {
        moreFromScrollbar.hidden = true;
        moreFromScrollbarThumb.style.width = '100%';
        moreFromScrollbarThumb.style.transform = 'translateX(0)';
        return;
      }

      moreFromScrollbar.hidden = false;

      const trackWidth = moreFromScrollbar.clientWidth;
      const thumbWidth = Math.max((moreFromGrid.clientWidth / moreFromGrid.scrollWidth) * trackWidth, 34);
      const left = ((trackWidth - thumbWidth) * moreFromGrid.scrollLeft) / maxScroll;

      moreFromScrollbarThumb.style.width = `${thumbWidth}px`;
      moreFromScrollbarThumb.style.transform = `translateX(${left}px)`;
    };

    const scrollMoreFromFromScrollbar = (clientX) => {
      if (!moreFromGrid || !moreFromScrollbar || !moreFromScrollbarThumb) return;

      const maxScroll = moreFromGrid.scrollWidth - moreFromGrid.clientWidth;
      if (maxScroll <= 0) return;

      const rect = moreFromScrollbar.getBoundingClientRect();
      const thumbWidth = moreFromScrollbarThumb.offsetWidth || 34;
      const usableWidth = Math.max(rect.width - thumbWidth, 1);
      const progress = Math.min(Math.max((clientX - rect.left - thumbWidth / 2) / usableWidth, 0), 1);

      moreFromGrid.scrollLeft = progress * maxScroll;
      updateMoreFromScrollbar();
    };

    const refreshMoreFromScrollbar = () => {
      updateMoreFromScrollbar();
      window.requestAnimationFrame(() => {
        updateMoreFromScrollbar();
        window.requestAnimationFrame(updateMoreFromScrollbar);
      });
    };

    moreFromGrid?.addEventListener('scroll', updateMoreFromScrollbar, { passive: true });
    moreFromScrollbar?.addEventListener('pointerdown', (event) => {
      isMoreFromScrollbarDragging = true;
      moreFromScrollbar.setPointerCapture?.(event.pointerId);
      scrollMoreFromFromScrollbar(event.clientX);
      event.preventDefault();
    });
    document.addEventListener('pointermove', (event) => {
      if (!isMoreFromScrollbarDragging) return;
      scrollMoreFromFromScrollbar(event.clientX);
      event.preventDefault();
    });
    document.addEventListener('pointerup', () => {
      isMoreFromScrollbarDragging = false;
    });
    document.addEventListener('pointercancel', () => {
      isMoreFromScrollbarDragging = false;
    });
    moreFromGrid?.querySelectorAll('img').forEach((image) => {
      if (!image.complete) image.addEventListener('load', refreshMoreFromScrollbar, { once: true });
    });
    window.addEventListener('resize', refreshMoreFromScrollbar);
    window.addEventListener('load', refreshMoreFromScrollbar);
    refreshMoreFromScrollbar();

    const setActiveImage = (holder, index) => {
      const images = holder.querySelectorAll('.more-from__cta-style-img');
      if (!images.length) return;
      images.forEach((image, imageIndex) => image.classList.toggle('is-active', imageIndex === index));
      holder.dataset.activeStyleIndex = String(index);
    };

    const startCycler = (holder, resetFirst = false) => {
      if (timers.has(holder)) return;

      const images = holder.querySelectorAll('.more-from__cta-style-img');
      if (images.length < 2) return;

      let index = resetFirst ? 0 : Number(holder.dataset.activeStyleIndex || 0);
      const cycle = () => {
        index = (index + 1) % images.length;
        setActiveImage(holder, index);
      };

      cycle();
      timers.set(holder, window.setInterval(cycle, 700));
    };

    const resetCycler = (holder) => {
      const timer = timers.get(holder);
      if (timer) window.clearInterval(timer);
      timers.delete(holder);
      setActiveImage(holder, 0);
    };

    const syncAutoCyclers = () => {
      const shouldAutoCycle = !desktopQuery.matches && motionQuery.matches;
      document.querySelectorAll('[data-more-from-style-cycler]').forEach((holder) => {
        if (shouldAutoCycle) {
          startCycler(holder, true);
        } else {
          resetCycler(holder);
        }
      });
    };

    document.addEventListener('pointerenter', (event) => {
      const holder = event.target.closest('[data-more-from-style-cycler]');
      if (!holder || !desktopQuery.matches || !motionQuery.matches || event.pointerType !== 'mouse') return;
      startCycler(holder, true);
    }, true);

    document.addEventListener('pointerleave', (event) => {
      const holder = event.target.closest('[data-more-from-style-cycler]');
      if (!holder || !desktopQuery.matches || event.pointerType !== 'mouse') return;
      resetCycler(holder);
    }, true);

    desktopQuery.addEventListener('change', syncAutoCyclers);
    motionQuery.addEventListener('change', syncAutoCyclers);
    syncAutoCyclers();
  })();
</script>

{% schema %}
{
  "name": "More from Bark & Frame",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "More from Bark & Frame"
    },
    {
      "type": "header",
      "content": "CTA card"
    },
    {
      "type": "image_picker",
      "id": "cta_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Label",
      "default": "Make a portrait"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "More from Bark & Frame"
    }
  ]
}
{% endschema %}
