{% liquid
  assign products_collection = collections[section.settings.products_collection]
  assign _portrait_styles = shop.metaobjects.portrait_style.values | sort: 'order'
  assign _first_portrait_style = _portrait_styles | first
%}

{%- comment -%} Embedded style data for JS {%- endcomment -%}
<script>
  window.MakePortraitStyles = [
    {%- for style in _portrait_styles -%}
      {%- assign artist = style.artist.value -%}
      {
        "id": {{ style.style_id.value | json }},
        "name": {{ style.name.value | default: '' | json }},
        "imageUrl": "{{ style.preview_image.value | image_url: width: 900 }}",
        "visualizerImageUrl": "{% if style.visualizator.value %}{{ style.visualizator.value | image_url: width: 900 }}{% elsif style.visualizer_image.value %}{{ style.visualizer_image.value | image_url: width: 900 }}{% endif %}",
        "artistName": {%- if artist != blank -%}{{ artist.name.value | default: '' | json }}{%- else -%}""{%- endif -%},
        "artistPhotoUrl": "{%- if artist != blank -%}{{ artist.photo.value | image_url: width: 200 }}{%- endif -%}",
        "artistId": {%- if artist != blank -%}{{ artist.system.handle | json }}{%- else -%}null{%- endif -%},
        "description": {{ style.description.value | default: '' | json }},
        "tag": {{ style.tags.value | first | downcase | strip | default: '' | json }},
        "order": {{ style.order.value | default: 999 }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ].filter(s => s.name).sort((a, b) => a.order - b.order);

  window.MakePortraitOverviewImages = {
    {%- for block in section.blocks -%}
      {%- if block.type == 'overview_style' and block.settings.style_id != blank -%}
        {{ block.settings.style_id | strip | json }}: {
          photo: {
            src: {%- if block.settings.photo_image != blank -%}{{ block.settings.photo_image | image_url: width: 520 | json }}{%- else -%}null{%- endif -%},
            alt: {{ block.settings.photo_image.alt | default: block.settings.style_name | default: '' | json }}
          },
          artist: {
            src: {%- if block.settings.artist_image != blank -%}{{ block.settings.artist_image | image_url: width: 520 | json }}{%- else -%}null{%- endif -%},
            alt: {{ block.settings.artist_image.alt | default: block.settings.style_name | default: '' | json }}
          },
          wall: {
            src: {%- if block.settings.wall_image != blank -%}{{ block.settings.wall_image | image_url: width: 1040 | json }}{%- else -%}null{%- endif -%},
            alt: {{ block.settings.wall_image.alt | default: block.settings.style_name | default: '' | json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  };

  window.MakePortraitMoneyFormat = {{ shop.money_format | json }};
  window.MakePortraitCloudinary = {
    cloudName: {{ section.settings.cloudinary_cloud_name | default: '' | json }},
    uploadPreset: {{ section.settings.cloudinary_upload_preset | default: '' | json }}
  };

  {%- assign _donation_block = section.blocks | where: "type", "donation" | first -%}
  window.MakePortraitDonationTitle = {{ _donation_block.settings.title | default: 'Donation' | json }};

  window.MakePortraitProducts = [
    {%- if products_collection != blank -%}
      {%- for product in products_collection.products -%}
        {
          "id": {{ product.id }},
          "title": {{ product.title | json }},
          "handle": {{ product.handle | json }},
          "featuredImage": "{{ product.featured_image | image_url: width: 600 }}",
          "price": {{ product.price_min }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  ];

  window.MakePortraitCanvasHandles = {
    unframed: {{ section.settings.canvas_unframed_handle | default: '' | json }},
    framed:   {{ section.settings.canvas_framed_handle   | default: '' | json }}
  };
  window.MakePortraitFramedPosterHandle = {{ section.settings.framed_poster_handle | default: '' | json }};
  {%- comment -%} Category preview variant IDs -- canvas: largest Premium Walnut variant; paper: last variant {%- endcomment -%}
  window.MakePortraitCategoryPreviewVariants = {
    {%- assign _cpv_cf = all_products[section.settings.canvas_framed_handle] -%}
    {%- assign _cpv_fp = all_products[section.settings.framed_poster_handle] -%}
    {%- if _cpv_cf != blank -%}
      {%- assign _cpv_cv = null -%}
      {%- for _v in _cpv_cf.variants -%}
        {%- assign _v_options_str = _v.options | join: ' ' | downcase -%}
        {%- if _v_options_str contains 'brown' -%}
          {%- assign _cpv_cv = _v -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if _cpv_cv == null -%}{%- assign _cpv_cv = _cpv_cf.variants | last -%}{%- endif -%}
      "canvas": {{ _cpv_cv.id }},
    {%- endif -%}
    {%- if _cpv_fp != blank -%}
      {%- assign _cpv_pv = _cpv_fp.variants | last -%}
      "paper": {{ _cpv_pv.id }}
    {%- endif -%}
  };
  {%- comment -%} Map of variantId -> { styleId: { default: url, white_border: url } } from metafield custom.style_previews {%- endcomment -%}
  window.MakePortraitStylePreviews = {
    {%- assign _sp_handles = '' -%}
    {%- if section.settings.canvas_unframed_handle != blank -%}{%- assign _sp_handles = _sp_handles | append: section.settings.canvas_unframed_handle | append: ',' -%}{%- endif -%}
    {%- if section.settings.canvas_framed_handle   != blank -%}{%- assign _sp_handles = _sp_handles | append: section.settings.canvas_framed_handle   | append: ',' -%}{%- endif -%}
    {%- if section.settings.framed_poster_handle   != blank -%}{%- assign _sp_handles = _sp_handles | append: section.settings.framed_poster_handle   | append: ',' -%}{%- endif -%}
    {%- assign _sp_handle_list = _sp_handles | split: ',' -%}
    {%- for _sp_h in _sp_handle_list -%}
      {%- unless _sp_h == blank -%}
        {%- assign _sp_p = all_products[_sp_h] -%}
        {%- for _sp_v in _sp_p.variants -%}
          {%- assign _sp_mf = _sp_v.metafields.custom.style_previews -%}
          {%- if _sp_mf != blank -%}
            {{ _sp_v.id }}: {{ _sp_mf.value | json }},
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- if products_collection != blank -%}
      {%- for _sp_cp in products_collection.products -%}
        {%- for _sp_cv in _sp_cp.variants -%}
          {%- assign _sp_cmf = _sp_cv.metafields.custom.style_previews -%}
          {%- if _sp_cmf != blank -%}
            {{ _sp_cv.id }}: {{ _sp_cmf.value | json }},
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}
  };
  window.MakePortraitAvailability = {
    {%- assign _av_handles = '' -%}
    {%- if section.settings.canvas_unframed_handle != blank -%}{%- assign _av_handles = _av_handles | append: section.settings.canvas_unframed_handle | append: ',' -%}{%- endif -%}
    {%- if section.settings.canvas_framed_handle   != blank -%}{%- assign _av_handles = _av_handles | append: section.settings.canvas_framed_handle   | append: ',' -%}{%- endif -%}
    {%- if section.settings.framed_poster_handle   != blank -%}{%- assign _av_handles = _av_handles | append: section.settings.framed_poster_handle   | append: ',' -%}{%- endif -%}
    {%- assign _av_handle_list = _av_handles | split: ',' -%}
    {%- for _av_h in _av_handle_list -%}
      {%- unless _av_h == blank -%}
        {%- assign _av_p = all_products[_av_h] -%}
        {%- for _av_v in _av_p.variants -%}
          {{ _av_v.id }}: {{ _av_v.metafields.custom.availability_status.value | default: 'in_stock' | json }},
        {%- endfor -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- if products_collection != blank -%}
      {%- for _av_cp in products_collection.products -%}
        {%- for _av_cv in _av_cp.variants -%}
          {{ _av_cv.id }}: {{ _av_cv.metafields.custom.availability_status.value | default: 'in_stock' | json }},
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}
  };
  window.MakePortraitExtraPetUSD    = {{ section.settings.extra_pet_price   | default: 9 }};
  window.MakePortraitPetNameUSD     = {{ section.settings.pet_name_price    | default: 5 }};

  {%- comment -%} Map of variantId -> "WxH" minimum resolution string from metafield custom.min_resolution {%- endcomment -%}
  window.MakePortraitMinResolutions = {
    {%- assign _mp_res_handles = '' -%}
    {%- if section.settings.canvas_unframed_handle != blank -%}{%- assign _mp_res_handles = _mp_res_handles | append: section.settings.canvas_unframed_handle | append: ',' -%}{%- endif -%}
    {%- if section.settings.canvas_framed_handle   != blank -%}{%- assign _mp_res_handles = _mp_res_handles | append: section.settings.canvas_framed_handle   | append: ',' -%}{%- endif -%}
    {%- assign _mp_res_list = _mp_res_handles | split: ',' -%}
    {%- for _mp_rh in _mp_res_list -%}
      {%- unless _mp_rh == blank -%}
        {%- assign _mp_rp = all_products[_mp_rh] -%}
        {%- for _mp_rv in _mp_rp.variants -%}
          {%- assign _mp_rmf = _mp_rv.metafields.custom.min_resolution -%}
          {%- if _mp_rmf != blank -%}
            {{ _mp_rv.id }}: {{ _mp_rmf.value | json }},
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- if products_collection != blank -%}
      {%- for _mp_rp2 in products_collection.products -%}
        {%- for _mp_rv2 in _mp_rp2.variants -%}
          {%- assign _mp_rmf2 = _mp_rv2.metafields.custom.min_resolution -%}
          {%- if _mp_rmf2 != blank -%}
            {{ _mp_rv2.id }}: {{ _mp_rmf2.value | json }},
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}
  };
  {%- comment -%} Map of variantId -> printful_variant_id parsed from SKU (format: PREFIX_PRINTFULID) {%- endcomment -%}
  window.MakePortraitPrintfulVariants = {
    {%- assign _mp_pv_handles = '' -%}
    {%- if section.settings.canvas_unframed_handle != blank -%}{%- assign _mp_pv_handles = _mp_pv_handles | append: section.settings.canvas_unframed_handle | append: ',' -%}{%- endif -%}
    {%- if section.settings.canvas_framed_handle   != blank -%}{%- assign _mp_pv_handles = _mp_pv_handles | append: section.settings.canvas_framed_handle   | append: ',' -%}{%- endif -%}
    {%- if section.settings.framed_poster_handle   != blank -%}{%- assign _mp_pv_handles = _mp_pv_handles | append: section.settings.framed_poster_handle   | append: ',' -%}{%- endif -%}
    {%- assign _mp_pv_list = _mp_pv_handles | split: ',' -%}
    {%- for _mp_pvh in _mp_pv_list -%}
      {%- unless _mp_pvh == blank -%}
        {%- assign _mp_pvp = all_products[_mp_pvh] -%}
        {%- for _mp_pvv in _mp_pvp.variants -%}
          {%- assign _mp_pvid = _mp_pvv.sku | split: '_' | last | plus: 0 -%}
          {%- if _mp_pvid != 0 -%}
            {{ _mp_pvv.id }}: {{ _mp_pvid }},
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- if products_collection != blank -%}
      {%- for _mp_pvp2 in products_collection.products -%}
        {%- for _mp_pvv2 in _mp_pvp2.variants -%}
          {%- assign _mp_pvid2 = _mp_pvv2.sku | split: '_' | last | plus: 0 -%}
          {%- if _mp_pvid2 != 0 -%}
            {{ _mp_pvv2.id }}: {{ _mp_pvid2 }},
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}
  };

  {%- assign _prints_block = section.blocks | where: "type", "prints" | first -%}
  window.MakePortraitPrintsBaseEUR  = {{ _prints_block.settings.base_price  | default: 30 }};
  window.MakePortraitPrintsExtraEUR = {{ _prints_block.settings.extra_price | default: 20 }};
  {%- comment -%} Map of "{opt-slug}-{value-slug}" -> asset_url for option images in step 3 {%- endcomment -%}
  {%- assign _mp_img_handles = '' -%}
  {%- if section.settings.canvas_unframed_handle != blank -%}{%- assign _mp_img_handles = _mp_img_handles | append: section.settings.canvas_unframed_handle | append: ',' -%}{%- endif -%}
  {%- if section.settings.canvas_framed_handle   != blank -%}{%- assign _mp_img_handles = _mp_img_handles | append: section.settings.canvas_framed_handle   | append: ',' -%}{%- endif -%}
  {%- if section.settings.framed_poster_handle   != blank -%}{%- assign _mp_img_handles = _mp_img_handles | append: section.settings.framed_poster_handle   | append: ',' -%}{%- endif -%}
  window.MakePortraitOptionImages = {
    "frame-unframed": {{ 'make-portrait/frame-unframed.png' | asset_url | json }},
    "frame-framed":   {{ 'make-portrait/frame-framed.png'   | asset_url | json }},
    "border-no-border":          {{ 'make-portrait/border-no-border.png'          | asset_url | json }},
    "border-white-border":       {{ 'make-portrait/border-white-border.png'       | asset_url | json }},
    "background-classic":        {{ 'make-portrait/background-classic.png'        | asset_url | json }},
    "background-clear":          {{ 'make-portrait/background-clear.png'          | asset_url | json }},
    "background-royal-pattern":  {{ 'make-portrait/background-royal-pattern.png'  | asset_url | json }},
    "background-midnight":       {{ 'make-portrait/background-midnight.png'       | asset_url | json }},
    "number-of-pets-1":          {{ 'make-portrait/number-of-pets-1.png'          | asset_url | json }},
    "number-of-pets-2":          {{ 'make-portrait/number-of-pets-2.png'          | asset_url | json }},
    "number-of-pets-3":          {{ 'make-portrait/number-of-pets-3.png'          | asset_url | json }},
    "number-of-pets-4":          {{ 'make-portrait/number-of-pets-4.png'          | asset_url | json }},
    {%- assign _mp_img_list = _mp_img_handles | split: ',' -%}
    {%- for _mp_ih in _mp_img_list -%}
      {%- unless _mp_ih == blank -%}
        {%- assign _mp_ip = all_products[_mp_ih] -%}
        {%- for _mp_io in _mp_ip.options_with_values -%}
          {%- assign _mp_ios = _mp_io.name | downcase | replace: ' ', '-' -%}
          {%- for _mp_iv in _mp_io.values -%}
            {%- assign _mp_ivs = _mp_iv | downcase | replace: '×', 'x' | replace: '″', '' | replace: '"', '' | replace: "'", '' | replace: ' ', '-' -%}
            {%- assign _mp_ikey = _mp_ios | append: '-' | append: _mp_ivs -%}
            {{ _mp_ikey | json }}: {{ 'make-portrait/' | append: _mp_ikey | append: '.png' | asset_url | json }},
          {%- endfor -%}
        {%- endfor -%}
      {%- endunless -%}
    {%- endfor -%}
  };
</script>

<div class="make-portrait section section--page-width" id="make-portrait-section">
  <h1 class="visually-hidden">Create your portrait</h1>
  <div class="make-portrait__layout">

    {%- comment -%}--------------------------------------------------------------------------------
      LEFT PANEL - Preview only
    --------------------------------------------------------------------------------{%- endcomment -%}
    <div class="make-portrait__left">

      <div class="make-portrait__preview-wrap">
        <img
          class="make-portrait__preview-img make-portrait__preview-img--square"
          id="mp-preview-img"
          width="900"
          height="1125"
          alt=""
          style="opacity: 0;"
        >

        <div class="make-portrait__preview-style-name" id="mp-preview-style-name"></div>

        {%- comment -%} Artist badge - visible on step 1 {%- endcomment -%}
        <div
          class="make-portrait_artist-badge"
          id="mp-artist-badge"
          role="button"
          tabindex="0"
          aria-controls="tab-artist"
          aria-label="Open artist details"
        >
          <img class="artist-badge__photo" id="mp-artist-photo" src="" alt="" width="32" height="32">
          <div class="artist-badge__text">
            <span class="artist-badge__label">Designed by</span>
            <span class="artist-badge__name" id="mp-artist-name"></span>
          </div>
        </div>

        {%- comment -%} Product label - visible on step 2+ {%- endcomment -%}
        <div class="make-portrait__product-label" id="mp-product-label" hidden></div>

      </div>

    </div>

    {%- comment -%}--------------------------------------------------------------------------------
      RIGHT PANEL - Configurator (sticky)
    --------------------------------------------------------------------------------{%- endcomment -%}
    <div class="make-portrait__right">

      {%- comment -%} Step indicator {%- endcomment -%}
      <nav class="make-portrait__step-indicator" aria-label="Progress">
        <button class="step-indicator__btn active" data-step="1" aria-label="Step 1: Style">Style</button>
        <span class="step-indicator__arrow" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1"/></svg></span>
        <button class="step-indicator__btn" data-step="2" aria-label="Step 2: Format">Format</button>
        <span class="step-indicator__arrow" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1"/></svg></span>
        <button class="step-indicator__btn" data-step="3" aria-label="Step 3: Details">Details</button>
        <span class="step-indicator__arrow" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1"/></svg></span>
        <button class="step-indicator__btn" data-step="4" aria-label="Step 4: Order">Order</button>
      </nav>

      {%- comment -%}------ STEP 1: Choose Style ------{%- endcomment -%}
      <div class="make-portrait__step" data-step="1">
        <h2 class="make-portrait__step-title">Pick a style<br>for your dog</h2>

        <div class="style-picker" id="mp-style-picker" role="listbox" aria-label="Portrait styles">
          {%- for style in _portrait_styles -%}
            {%- assign _style_id = style.style_id.value | strip -%}
            {%- assign _style_tag = style.tags.value | first | downcase | strip | replace: ' ', '-' -%}
            {%- assign _btn_img = style.image_button.value | default: style.preview_image.value -%}
            {%- if _style_id == 'atelier_sketch' or style.name.value == 'Atelier Sketch' -%}
              {%- for block in section.blocks -%}
                {%- assign _block_style_id = block.settings.style_id | strip -%}
                {%- if block.type == 'overview_style' and block.settings.artist_image != blank -%}
                  {%- if _block_style_id == _style_id or block.settings.style_name == style.name.value -%}
                    {%- assign _btn_img = block.settings.artist_image -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            <button
              class="style-picker__item{% if forloop.first %} selected{% endif %}{% if _style_tag != blank %} style--{{ _style_tag }}{% endif %}"
              type="button"
              data-style-id="{{ style.style_id.value }}"
              role="option"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              title="{{ style.name.value }}"
            >
              {%- if _btn_img -%}
                <div class="style-picker__item__img">
                  <img src="{{ _btn_img | image_url: width: 120 }}" width="120" height="160" alt="{{ style.name.value }}" loading="lazy">
                  {%- if _style_tag != blank -%}
                    <span class="style-picker__tag">{{ _style_tag | replace: '-', ' ' | capitalize | replace: 'Sold out', 'Soon' }}</span>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="style-picker__placeholder"></div>
              {%- endif -%}

              <span class="style-picker__name">{{ style.name.value }}</span>
            </button>
          {%- endfor -%}
        </div>

        <div class="make-portrait__style-info" id="mp-style-info">
          <h3 class="make-portrait__style-name" id="mp-style-name-display"></h3>
          <div class="make-portrait__style-description" id="mp-style-description"></div>
        </div>

      </div>

      {%- comment -%}------ STEP 2: Choose Product ------{%- endcomment -%}
      <div class="make-portrait__step" data-step="2" hidden>
        <h2 class="make-portrait__step-title">Pick a format</h2>

        <div class="product-picker" id="mp-product-picker" role="listbox" aria-label="Product types">
          {%- if products_collection != blank -%}

            {%- comment -%} === Prints on Canvas + Paper (side by side, each with own label) === {%- endcomment -%}
            <div class="product-picker__print-group">
              {%- assign _cu = all_products[section.settings.canvas_unframed_handle] -%}
              {%- assign _cf = all_products[section.settings.canvas_framed_handle] -%}
              {%- assign _canvas_img = section.settings.canvas_picker_image | default: _cu.featured_image | default: _cf.featured_image -%}
              {%- assign _canvas_min_price = _cu.price_min -%}
              {%- if _cf != blank and _cf.price_min < _canvas_min_price -%}
                {%- assign _canvas_min_price = _cf.price_min -%}
              {%- endif -%}
              <button
                class="product-picker__item product-picker__item--category"
                data-category="canvas"
                data-min-price="{{ _canvas_min_price }}"
                role="option"
                aria-selected="false"
              >
                {%- if _canvas_img -%}
                  <img src="{{ _canvas_img | image_url: width: 200 }}" width="200" height="200" alt="Print on Canvas" loading="lazy">
                {%- else -%}
                  <div class="product-picker__placeholder"></div>
                {%- endif -%}
                <span class="product-picker__name">Canvas</span>
                <span class="product-picker__sub">from {{ _canvas_min_price | money }}</span>
              </button>
            </div>

            {%- comment -%} === Framed Poster (direct product) === {%- endcomment -%}
            {%- assign _fp = all_products[section.settings.framed_poster_handle] -%}
            {%- if _fp != blank -%}
            {%- assign _fp_img = section.settings.poster_picker_image | default: _fp.featured_image -%}
            <div class="product-picker__print-group">
              <button
                class="product-picker__item product-picker__item--category"
                data-product-handle="{{ _fp.handle }}"
                data-product-id="{{ _fp.id }}"
                role="option"
                aria-selected="false"
              >
                {%- if _fp_img -%}
                  <img src="{{ _fp_img | image_url: width: 200 }}" width="200" height="200" alt="{{ _fp.title }}" loading="lazy">
                {%- else -%}
                  <div class="product-picker__placeholder"></div>
                {%- endif -%}
                <span class="product-picker__name">{{ _fp.title }}</span>
                <span class="product-picker__sub">from {{ _fp.price_min | money }}</span>
              </button>
            </div>
            {%- endif -%}

            {%- comment -%} === Other items === {%- endcomment -%}
            {%- assign _group_started = false -%}
            {%- for product in products_collection.products -%}
              {%- assign _type = product.type | downcase -%}
              {%- assign _is_reserved_handle = false -%}
              {%- if product.handle == section.settings.canvas_unframed_handle or product.handle == section.settings.canvas_framed_handle or product.handle == section.settings.framed_poster_handle -%}
                {%- assign _is_reserved_handle = true -%}
              {%- endif -%}
              {%- unless _type contains 'canvas' or _type contains 'paper' or _is_reserved_handle -%}
                {%- unless _group_started -%}
                  <span class="product-picker__category-label">Your portrait. Beyond the wall.</span>
                  {%- assign _group_started = true -%}
                {%- endunless -%}
                <button
                  class="product-picker__item"
                  data-product-handle="{{ product.handle }}"
                  data-product-id="{{ product.id }}"
                  role="option"
                  aria-selected="false"
                >
                  {%- if product.featured_image -%}
                    <img src="{{ product.featured_image | image_url: width: 200 }}" width="200" height="200" alt="{{ product.title }}" loading="lazy">
                  {%- else -%}
                    <div class="product-picker__placeholder"></div>
                  {%- endif -%}
                  <span class="product-picker__name">{{ product.title }}</span>
                  <span class="product-picker__sub">from {{ product.price_min | money }}</span>
                </button>
              {%- endunless -%}
            {%- endfor -%}

          {%- else -%}
            <p class="make-portrait__empty-note">No products assigned. Set a collection in theme settings.</p>
          {%- endif -%}
        </div>

      </div>

      {%- comment -%}------ STEP 3: Choose Options ------{%- endcomment -%}
      <div class="make-portrait__step" data-step="3" hidden>
        <h2 class="make-portrait__step-title">Now the details</h2>

        <div id="mp-options-container">
          {%- comment -%} Populated dynamically by JS after product is fetched {%- endcomment -%}
          <p class="make-portrait__loading" id="mp-options-loading">Loading options…</p>
        </div>

        <div class="make-portrait__option-group" id="mp-border-group">
          <span class="make-portrait__option-label">Border</span>
          <div class="option-btn-grid" id="mp-border-grid" data-option-name="border">
            <button class="option-btn selected" data-border="no-border" data-value="no-border" type="button">No Border</button>
            <button class="option-btn" data-border="white-border" data-value="white-border" type="button">White Border</button>
          </div>
        </div>

        {%- comment -%}
        <div class="make-portrait__option-group">
          <span class="make-portrait__option-label">Background</span>
          <div class="option-btn-grid" id="mp-background-grid" data-option-name="background">
            <button class="option-btn option-btn--small selected" data-background="classic" data-value="classic" type="button">Classic</button>
            <button class="option-btn option-btn--small" data-background="clear" data-value="clear" type="button">Clear</button>
            <button class="option-btn option-btn--small" data-background="royal-pattern" data-value="royal-pattern" type="button">Royal Pattern</button>
            <button class="option-btn option-btn--small" data-background="midnight" data-value="midnight" type="button">Midnight</button>
          </div>
        </div>

        <div class="make-portrait__option-group">
          <span class="make-portrait__option-label">Number of dogs</span>
          <div class="option-btn-grid" id="mp-pets-grid" data-option-name="number-of-pets">
            <button class="option-btn option-btn--small selected" data-pet-count="1" data-value="1" type="button">1 pet</button>
            <button class="option-btn option-btn--small" data-pet-count="2" data-value="2" data-extra-usd="{{ section.settings.extra_pet_price | default: 9 | times: 1 }}" type="button">2 pets</button>
            <button class="option-btn option-btn--small" data-pet-count="3" data-value="3" data-extra-usd="{{ section.settings.extra_pet_price | default: 9 | times: 2 }}" type="button">3 pets</button>
            <button class="option-btn option-btn--small" data-pet-count="4" data-value="4" data-extra-usd="{{ section.settings.extra_pet_price | default: 9 | times: 3 }}" type="button">4 pets</button>
          </div>
        </div>
        {%- endcomment -%}

        <div id="mp-options-container-2"></div>

        <div class="make-portrait__option-group" id="mp-pet-name-group">
          <div class="make-portrait__option-label-row">
            <label class="make-portrait__option-label" for="mp-pet-name">Dog’s name</label>
            {%- capture pet_name_tooltip -%}<p>The image shown in the configurator is a preview template only. After you enter your pet’s name, it will be carefully integrated into your final custom portrait design.</p>{%- endcapture -%}
            {%- render 'info-tooltip', tooltip_content: pet_name_tooltip -%}
          </div>
          <input
            class="make-portrait__text-input"
            type="text"
            id="mp-pet-name"
            placeholder="Alister"
            maxlength="40"
          >
          <div class="make-portrait__pet-name-fee" id="mp-pet-name-fee" hidden>
            <span>Add name</span>
            <span id="mp-pet-name-fee-amount"></span>
          </div>
        </div>

      </div>

      {%- comment -%}------ STEP 4: Upload Photo ------{%- endcomment -%}
      <div class="make-portrait__step" data-step="4" hidden>
        <h2 class="make-portrait__step-title">Upload your dog’s photo</h2>

        <div class="photo-upload" id="mp-upload-area">
          <div class="photo-upload__zone" id="mp-upload-zone" role="button" tabindex="0" aria-label="Upload photo – click or drag and drop">
            <p class="photo-upload__instruction">Drop your photo here</p>
            <p class="photo-upload__sub">JPG / PNG / HEIC – Max 10 MB</p>
            <label class="button button--secondary photo-upload__browse" for="mp-file-input">Browse files</label>
            <input
              type="file"
              id="mp-file-input"
              accept=".jpg,.jpeg,.png,.heic,.heif,image/jpeg,image/png,image/heic,image/heif"
              class="photo-upload__input"
              aria-label="Upload pet photo"
            >
          </div>
          <div class="photo-upload__previews" id="mp-photo-previews" aria-live="polite"></div>
          <div id="mp-resolution-alert" class="photo-upload__resolution-alert" hidden>
            <span class="photo-upload__resolution-alert__icon">⚠</span>
            <p id="mp-resolution-alert-text" class="photo-upload__resolution-alert__text"></p>
          </div>
          <p id="mp-upload-counter" class="photo-upload__counter" hidden></p>
          <p id="mp-upload-error" class="make-portrait__error" hidden></p>
        </div>

        <div class="mp-image-guidelines">
          <h2 class="title">
            Photo guidelines
          </h2>
          <div class="description">
            Not sure which photo to pick? No worries. Here’s what makes a good one.
          </div>
          <div class="content">
            <div class="column column--good">
              <h3 class="title">
                Good
              </h3>
              <img class="image" src="{{ 'bark-and-frame-photo-upload-example-good-jack-russell-sitting-eye-level-soft-light-clean.jpg' | asset_url }}" alt="Good photo example" loading="lazy">
              <ul>
                <li>Dog facing the camera at eye level</li>
                <li>Good lighting</li>
                <li>Whole body and paws visible</li>
                <li>Ideally sitting up</li>
              </ul>
            </div>

            <div class="column column--bad">
              <h3 class="title">
                Bad
              </h3>
              <img class="image" src="{{ 'bark-and-frame-photo-upload-example-skip-jack-russell-cafe-rotated-busy-background.jpg' | asset_url }}" alt="Good photo example" loading="lazy">
              <ul>
                <li>Angled face, not at eye level</li>
                <li>Poor lighting, heavy shadows</li>
                <li>Too many objects in the background</li>
              </ul>
            </div>

            <div class="column column--bad">
              <h3 class="title">
                Bad
              </h3>
              <img class="image" src="{{ 'bark-and-frame-photo-upload-example-skip-jack-russell-profile-harsh-shadow-not-eye-level.jpg' | asset_url }}" alt="Good photo example" loading="lazy">
              <ul>
                <li>Head and neck not fully visible</li>
                <li>Pet lying down</li>
              </ul>
            </div>
          </div>
        </div>

        {%- assign has_addons = false -%}
        {%- assign has_donation = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'addon' or block.type == 'prints' -%}{%- assign has_addons = true -%}{%- endif -%}
          {%- if block.type == 'donation' -%}{%- assign has_donation = true -%}{%- endif -%}
        {%- endfor -%}

        {%- if has_addons -%}
          <div class="make-portrait__addons">
            <h3 class="make-portrait__addons-title">Customize your order</h3>
            {%- for block in section.blocks -%}
              {%- if block.type == 'addon' -%}
                <label class="addon-item" {{ block.shopify_attributes }}>
                  <input
                    type="checkbox"
                    class="addon-item__check"
                    data-addon-price="{{ block.settings.price | default: 0 }}"
                    data-addon-eur="{{ block.settings.price | default: 0 }}"
                    data-addon-name="{{ block.settings.name | escape }}"
                    aria-label="{{ block.settings.name }}"
                  >
                  <div class="addon-item__body">
                    <div class="addon-item__left">
                      <span class="addon-item__name">{{ block.settings.name }}</span>
                      <span class="addon-item__price"></span>
                    </div>
                    {%- if block.settings.description != blank -%}
                      <div class="addon-item__description">{{ block.settings.description }}</div>
                    {%- endif -%}
                  </div>
                </label>
              {%- elsif block.type == 'prints' -%}
                <div class="addon-item addon-item--prints" {{ block.shopify_attributes }}>
                  <label class="addon-item__header">
                    <input
                      type="checkbox"
                      class="addon-item__check addon-item__check--prints"
                      id="mp-prints-check"
                      aria-label="Add copies"
                    >
                    <div class="addon-item__body">
                      <div class="addon-item__left">
                        <span class="addon-item__name">Add copies</span>
                        <span class="addon-item__price" id="mp-prints-price"></span>
                      </div>
                      {%- if block.settings.description != blank -%}
                        <div class="addon-item__description">{{ block.settings.description }}</div>
                      {%- endif -%}
                    </div>
                  </label>
                  <div class="make-portrait__prints-options" id="mp-prints-options" hidden>
                    <div class="option-btn-grid" id="mp-prints-grid">
                      <button class="option-btn option-btn--small selected" data-prints="1" type="button"></button>
                      <button class="option-btn option-btn--small" data-prints="2" type="button"></button>
                      <button class="option-btn option-btn--small" data-prints="3" type="button"></button>
                      <button class="option-btn option-btn--small" data-prints="4" type="button"></button>
                      <label class="option-btn option-btn--small make-portrait__prints-custom">
                        <input
                          type="number"
                          class="make-portrait__prints-custom-input"
                          min="1"
                          step="1"
                          placeholder="5pcs"
                          aria-label="Custom number of prints"
                        >
                        <span class="make-portrait__prints-custom-price">
                          
                        </span>
                      </label>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if has_donation -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'donation' -%}
              <div class="donation-card" {{ block.shopify_attributes }}>
                <h3 class="make-portrait__addons-title">{{ block.settings.title | default: 'DogsTrust' }}</h3>
                <div class="donation-card__inner">
                  {%- if block.settings.image -%}
                    <img
                      class="donation-card__image"
                      src="{{ block.settings.image | image_url: width: 300 }}"
                      width="150" height="150"
                      alt=""
                      loading="lazy"
                    >
                  {%- endif -%}
                  <div class="donation-card__content">
                    {%- if block.settings.heading != blank -%}
                      <h4 class="donation-card__heading">{{ block.settings.heading }}</h4>
                    {%- endif -%}
                    {%- if block.settings.description != blank -%}
                      <p class="donation-card__description">{{ block.settings.description }}</p>
                    {%- endif -%}
                    <div class="option-btn-grid donation-card__amounts">
                      {%- assign amounts = block.settings.amounts | default: '' | split: ',' -%}
                      {%- for amount in amounts -%}
                        {%- assign clean = amount | strip | times: 1 -%}
                        {%- if clean > 0 -%}
                          <button
                            class="option-btn"
                            data-donation="{{ clean | times: 100 }}"
                            data-donation-eur="{{ clean | times: 100 }}"
                            type="button"
                          ></button>
                        {%- endif -%}
                      {%- endfor -%}
                      <label class="option-btn donation-card__custom">
                        <input
                          type="number"
                          class="donation-card__custom-input"
                          min="1"
                          step="1"
                          placeholder="Custom"
                          aria-label="Custom donation amount"
                        >
                      </label>
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}


        <p id="mp-cart-error" class="make-portrait__error" hidden></p>
      </div>

      <div class="make-portrait__resume-backdrop" id="mp-resume-backdrop" hidden></div>
      <div class="make-portrait__resume-banner" id="mp-resume-banner" hidden>
        <p class="make-portrait__resume-banner__text">You have an unfinished portrait. Continue where you left off?</p>
        <div class="make-portrait__resume-banner__actions">
          <button class="button button--secondary" id="mp-resume-yes" type="button">Resume</button>
          <button class="button button--ghost" id="mp-resume-no" type="button">Start fresh</button>
        </div>
      </div>

      <div class="make-portrait__resume-backdrop" id="mp-upload-required-backdrop" hidden></div>
      <div class="make-portrait__resume-banner" id="mp-upload-required-banner" hidden>
        <p class="make-portrait__resume-banner__text">Please upload a photo of your pet before ordering.</p>
        <div class="make-portrait__resume-banner__actions">
          <button class="button button--secondary" id="mp-upload-required-ok" type="button">Upload photo</button>
        </div>
      </div>

      <div class="make-portrait__resume-backdrop" id="mp-oos-backdrop" hidden></div>
      <div class="make-portrait__resume-banner" id="mp-oos-banner" hidden>
        <p class="make-portrait__resume-banner__text">This product is currently out of stock. We&#x2019;re not accepting new orders at this time.</p>
        <div class="make-portrait__resume-banner__actions">
          <button class="button button--secondary" id="mp-oos-ok" type="button">OK</button>
        </div>
      </div>

      <div class="make-portrait__resume-backdrop" id="mp-quality-backdrop" hidden></div>
      <div class="make-portrait__resume-banner" id="mp-quality-banner" hidden>
        <p class="make-portrait__resume-banner__text">Your photo resolution may be too low for the best print quality.</p>
        <p id="mp-quality-banner-detail" class="make-portrait__resume-banner__detail"></p>
        <div class="make-portrait__resume-banner__actions">
          <button class="button button--secondary" id="mp-quality-yes" type="button">I agree to use photo with low resolution</button>
          <button class="button button--ghost" id="mp-quality-no" type="button">Remove photo</button>
        </div>
      </div>

      <div class="make-portrait__action-bar" id="mp-action-bar">
        <div class="make-portrait__subtotal" id="mp-subtotal-panel">
          <span class="subtotal__label__title">Subtotal</span>
          <div id="mp-order-summary" class="order-summary"></div>
          <div class="subtotal__row subtotal__row--total">
            <span class="subtotal__label__note">Free shipping over $100</span>
            <span class="subtotal__price">
              <span id="mp-subtotal-prefix">from </span><span class="subtotal__price__amount" id="mp-subtotal-price">—</span>
            </span>
          </div>
        </div>
      </div>
      <button class="button make-portrait__cta" id="mp-cta-step1">Continue to format</button>
      <button class="button make-portrait__cta" id="mp-cta-step2" disabled hidden>Continue to details</button>
      <button class="button make-portrait__cta make-portrait__cta--secondary" id="mp-back-step1" hidden>Change a style</button>
      <button class="button make-portrait__cta" id="mp-cta-step3" hidden>Last step</button>
      <button class="button make-portrait__cta make-portrait__cta--secondary" id="mp-back-step2" hidden>Change a format</button>
      <button class="button make-portrait__cta" id="mp-cta-order" hidden>Order portrait</button>
      <button class="button make-portrait__cta make-portrait__cta--secondary" id="mp-back-step3" hidden>Change details</button>

      <p class="make-portrait__availability" id="mp-availability">
        <span class="make-portrait__availability__indicator"></span>
        <span id="mp-availability-label">Our artists are available</span>
      </p>
      
      <p class="make-portrait__delivery-note">
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path d="M2.72222 9.45312C2.35926 9.08854 2.17778 8.64583 2.17778 8.125H0.622222L0.902222 6.875H2.66C2.8363 6.67708 3.0437 6.52344 3.28222 6.41406C3.52074 6.30469 3.77481 6.25 4.04444 6.25C4.31407 6.25 4.56815 6.30469 4.80667 6.41406C5.04519 6.52344 5.25259 6.67708 5.42889 6.875H8.02667L9.33333 1.25H2.52L2.58222 0.984375C2.64444 0.692708 2.78704 0.455729 3.01 0.273438C3.23296 0.0911458 3.49481 0 3.79556 0H10.8889L10.3133 2.5H12.1333L14 5L13.3778 8.125H12.1333C12.1333 8.64583 11.9519 9.08854 11.5889 9.45312C11.2259 9.81771 10.7852 10 10.2667 10C9.74815 10 9.30741 9.81771 8.94444 9.45312C8.58148 9.08854 8.4 8.64583 8.4 8.125H5.91111C5.91111 8.64583 5.72963 9.08854 5.36667 9.45312C5.0037 9.81771 4.56296 10 4.04444 10C3.52593 10 3.08519 9.81771 2.72222 9.45312ZM9.59778 5.625H12.6L12.6622 5.29688L11.5111 3.75H10.0333L9.59778 5.625ZM9.30222 1.35938L9.33333 1.25L8.02667 6.875L8.05778 6.76562L8.58667 4.48438L9.30222 1.35938ZM0 5.82812L0.311111 4.57812H3.73333L3.42222 5.82812H0ZM1.24444 3.54688L1.55556 2.29688H5.6L5.28889 3.54688H1.24444ZM4.04444 8.75C4.22074 8.75 4.36852 8.6901 4.48778 8.57031C4.60704 8.45052 4.66667 8.30208 4.66667 8.125C4.66667 7.94792 4.60704 7.79948 4.48778 7.67969C4.36852 7.5599 4.22074 7.5 4.04444 7.5C3.86815 7.5 3.72037 7.5599 3.60111 7.67969C3.48185 7.79948 3.42222 7.94792 3.42222 8.125C3.42222 8.30208 3.48185 8.45052 3.60111 8.57031C3.72037 8.6901 3.86815 8.75 4.04444 8.75ZM10.2667 8.75C10.443 8.75 10.5907 8.6901 10.71 8.57031C10.8293 8.45052 10.8889 8.30208 10.8889 8.125C10.8889 7.94792 10.8293 7.79948 10.71 7.67969C10.5907 7.5599 10.443 7.5 10.2667 7.5C10.0904 7.5 9.94259 7.5599 9.82333 7.67969C9.70407 7.79948 9.64444 7.94792 9.64444 8.125C9.64444 8.30208 9.70407 8.45052 9.82333 8.57031C9.94259 8.6901 10.0904 8.75 10.2667 8.75Z" fill="currentColor"/></svg>
        <span class="mp-delivery__label">Estimated delivery to</span>
        <span id="mp-delivery"></span>
      </p>

      

    </div>{%- comment -%} end .make-portrait__right {%- endcomment -%}

    

    {%- comment -%} Tabs - third grid child, spans below preview on desktop {%- endcomment -%}
    <div class="make-portrait__tabs">
      <nav class="make-portrait__tab-nav" role="tablist">
        <button class="tab-nav__btn active" data-tab="overview" role="tab" aria-selected="true">Overview</button>
        <button class="tab-nav__btn" data-tab="artist" role="tab" aria-selected="false">Artist</button>
        <button class="tab-nav__btn" data-tab="product" role="tab" aria-selected="false">Product</button>
        {%- comment -%}<button class="tab-nav__btn" data-tab="limited" role="tab" aria-selected="false">Limited</button>{%- endcomment -%}
      </nav>
      <div class="make-portrait__tab-panels">

        <div class="tab-panel" id="tab-overview" data-tab="overview" role="tabpanel">
          <div class="tab-overview">
            <h2 class="tab-overview__heading">It’s that simple</h2>
            <img src="{{ 'make-portrait/overview01.png' | asset_url }}" alt="Size" loading="lazy">
            <p>
              A portrait of your dog isn’t just wall art. It’s a way to give shape to a relationship made of small, everyday moments. Designed by our small studio of award-winning artists in their signature style. Their character. Their posture. The details only you would notice.
            </p>
            <div class="tab-overview__composite" id="mp-overview-media">
              <figure class="tab-overview__image-card tab-overview__image-card--photo">
                <img id="mp-overview-photo" src="" alt="" width="263" height="350" loading="lazy">
                <figcaption class="tab-overview__photo-label tab-overview__photo-label--photo">Your photo</figcaption>
              </figure>
              <figure class="tab-overview__image-card tab-overview__image-card--artist">
                <img id="mp-overview-artist" src="" alt="" width="200" height="243" loading="lazy">
                <figcaption class="tab-overview__photo-label tab-overview__photo-label--artist">Designed by artists</figcaption>
              </figure>
              <figure class="tab-overview__image-card tab-overview__image-card--wall">
                <img id="mp-overview-wall" src="" alt="" width="709" height="478" loading="lazy">
                <figcaption class="tab-overview__photo-label tab-overview__photo-label--wall">On your wall</figcaption>
              </figure>
            </div>
          </div>
        </div>

        <div class="tab-panel" id="tab-artist" data-tab="artist" role="tabpanel" hidden>
          {%- for style in _portrait_styles -%}
            {%- assign a = style.artist.value -%}
            {%- if a != blank -%}
              <div class="tab-artist-panel" data-style-id="{{ style.style_id.value }}" hidden>

                {%- render 'artist-card', artist: a, about_long_only: true, heading_tag: 'h3' -%}

                {%- if style.story.value != blank -%}
                  <div class="artist-bio">{{ style.story.value | metafield_tag }}</div>
                {%- endif -%}

                {%- if a.description_image.value != blank -%}
                  <div class="description-image">
                    <img src="{{ a.description_image.value | image_url: width: 800 }}" alt="{{ a.name.value }}" loading="lazy">
                  </div>
                {%- endif -%}

                {%- if a.hero.value != blank -%}
                  <p class="artist-hero">{{ a.hero.value }}</p>
                {%- endif -%}

              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="tab-panel" id="tab-product" data-tab="product" role="tabpanel" hidden>
          <div class="tab-product" id="tab-product-accordions">
            <accordion-custom>
              <details class="details tab-accordion" open>
                <summary class="tab-accordion__summary">
                  <span>Size</span>
                  <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                </summary>
                <div class="details-content tab-accordion__body">
                  <p>Every portrait comes in multiple sizes, so it can live in your home the way you want it to.</p>

                  <div class="accordion-card">
                    <h4 class="accordion-card__title">Canvas</h4>
                    <div class="size-table">
                      <div class="size-table__header">
                        <span class="size-table__badge size-table__badge--dark">SIZE</span>
                        <span class="size-table__badge size-table__badge--green">UNFRAMED</span>
                        <span class="size-table__badge size-table__badge--green">FRAMED</span>
                      </div>
                      <div class="size-table__row">
                        <div class="size-table__label"><strong>Small</strong><span>For a desk or hallway</span></div>
                        <div class="size-table__dim"><strong>20 × 25 cm</strong><span>7.9 × 9.8 in</span></div>
                        <div class="size-table__dim"><strong>23 × 28 cm</strong><span>9.1 × 11.0 in</span></div>
                      </div>
                      <div class="size-table__row">
                        <div class="size-table__label"><strong>Medium</strong><span>For the wall you pass every morning</span></div>
                        <div class="size-table__dim"><strong>30 × 40 cm</strong><span>11.8 × 15.7 in</span></div>
                        <div class="size-table__dim"><strong>33 × 43 cm</strong><span>13.0 × 16.9 in</span></div>
                      </div>
                      <div class="size-table__row">
                        <div class="size-table__label"><strong>Large</strong><span>Statement piece</span></div>
                        <div class="size-table__dim"><strong>51 × 71 cm</strong><span>20.1 × 28.0 in</span></div>
                        <div class="size-table__dim"><strong>54 × 74 cm</strong><span>21.3 × 29.1 in</span></div>
                      </div>
                    </div>
                  </div>

                  <div class="accordion-card">
                    <h4 class="accordion-card__title">Paper</h4>
                    <div class="size-table size-table--2col">
                      <div class="size-table__header">
                        <span class="size-table__badge size-table__badge--dark">SIZE</span>
                        <span class="size-table__badge size-table__badge--green">FRAMED</span>
                      </div>
                      <div class="size-table__row">
                        <div class="size-table__label"><strong>Small</strong><span>For a desk or hallway</span></div>
                        <div class="size-table__dim"><strong>24 × 33 cm</strong><span>9.4 × 13.0 in</span></div>
                      </div>
                      <div class="size-table__row">
                        <div class="size-table__label"><strong>Medium</strong><span>For the wall you pass every morning</span></div>
                        <div class="size-table__dim"><strong>33 × 43 cm</strong><span>13.0 × 16.9 in</span></div>
                      </div>
                      <div class="size-table__row">
                        <div class="size-table__label"><strong>Large</strong><span>Statement piece</span></div>
                        <div class="size-table__dim"><strong>54 × 74 cm</strong><span>21.3 × 29.1 in</span></div>
                      </div>
                    </div>
                  </div>
                </div>
              </details>
            </accordion-custom>
            <accordion-custom>
              <details class="details tab-accordion">
                <summary class="tab-accordion__summary">
                  <span>Materials</span>
                  <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                </summary>
                <div class="details-content tab-accordion__body">
                  <p>
                    Printed on gallery-quality paper with a clean, precise finish that captures fine detail and tonal depth of colors while maintaining clarity.
                  </p>
                  <div class="tab-accordion__image-grid">
                    <img src="{{ 'make-portrait/bark-and-frame-configurator-paper-portrait-work-in-progress-jack-russell-gentleman-style-watercolour.jpg' | asset_url }}" alt="Paper portrait work in progress" loading="lazy">
                    <img src="{{ 'make-portrait/bark-and-frame-configurator-paper-material-close-up-texture-matte-gallery-quality.jpg' | asset_url }}" alt="Paper material close-up texture" loading="lazy">
                  </div>
                  <p>
                    Canvas introduces a structured surface with visible texture that interacts with light, adding depth and reducing glare. The result feels more physical and holds its presence as an object.
                  </p>
                  <div class="tab-accordion__image-grid">
                    <img src="{{ 'make-portrait/bark-and-frame-configurator-canvas-portrait-work-in-progress-jack-russell-gentleman-style-oil-painting.jpg' | asset_url }}" alt="Canvas portrait work in progress" loading="lazy">
                    <img src="{{ 'make-portrait/bark-and-frame-configurator-canvas-material-close-up-texture-natural-cotton-weave.jpg' | asset_url }}" alt="Canvas material close-up texture" loading="lazy">
                  </div>
                  <p>
                    The same material standards are applied across all formats, ensuring consistency in detail, color, and durability.
                  </p>
                </div>
              </details>
            </accordion-custom>
            <accordion-custom>
              <details class="details tab-accordion">
                <summary class="tab-accordion__summary">
                  <span>Framing</span>
                  <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                </summary>
                <div class="details-content tab-accordion__body">
                  <p>Frames are solid, minimal, and made to support the artwork without competing with it. Four options across two collections, all in real wood.</p>

                  <div class="accordion-card">
                    <h4 class="accordion-card__title">Standard frames</h4>
                    <p class="accordion-card__desc">Black or white. Ayous wood for paper portraits, pine for canvas. The wall stays calm, the artwork takes the lead.</p>
                    <div class="accordion-card__grid">
                      <div class="accordion-card__item">
                        <img src="{{ 'make-portrait/bark-and-frame-canvas-black-frame-corner-detail-real-wood-artist-signature.jpg' | asset_url }}" alt="Black frame" loading="lazy">
                        <h5 class="accordion-card__item-name">Black</h5>
                        <p class="accordion-card__item-desc">Defined edge, modern feel.</p>
                      </div>
                      <div class="accordion-card__item">
                        <img src="{{ 'make-portrait/bark-and-frame-canvas-white-frame-corner-detail-real-wood-artist-signature.jpg' | asset_url }}" alt="White frame" loading="lazy">
                        <h5 class="accordion-card__item-name">White</h5>
                        <p class="accordion-card__item-desc">Soft, minimal, blends in.</p>
                      </div>
                    </div>
                  </div>

                  <div class="accordion-card">
                    <h4 class="accordion-card__title">Premium woods</h4>
                    <p class="accordion-card__desc">Oak for paper portraits, walnut for canvas. Both have a visible natural grain that gives the piece real surface presence and a quiet weight on the wall.</p>
                    <div class="accordion-card__grid">
                      <div class="accordion-card__item">
                        <img src="{{ 'make-portrait/bark-and-frame-canvas-oak-frame-corner-detail-real-wood-artist-signature.jpg' | asset_url }}" alt="Premium Oak frame" loading="lazy">
                        <h5 class="accordion-card__item-name">Premium Oak</h5>
                        <p class="accordion-card__item-desc">Light, warm, natural grain.<br>For paper portraits.</p>
                      </div>
                      <div class="accordion-card__item">
                        <img src="{{ 'make-portrait/bark-and-frame-canvas-walnut-frame-corner-detail-real-wood-artist-signature.jpg' | asset_url }}" alt="Walnut frame" loading="lazy">
                        <h5 class="accordion-card__item-name">Premium Walnut</h5>
                        <p class="accordion-card__item-desc">Deep, rich, more weight.<br>For canvas portraits.</p>
                      </div>
                    </div>
                  </div>

                  <p>Crafted with precise joints for stability, made to hold its form over time. Each frame arrives fully assembled and ready to hang.</p>
                </div>
              </details>
            </accordion-custom>
            <accordion-custom>
              <details class="details tab-accordion">
                <summary class="tab-accordion__summary">
                  <span>Finish</span>
                  <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                </summary>
                <div class="details-content tab-accordion__body">
                  <p>
                    Each portrait arrives complete. Hanging hardware ready. Nothing to adjust, nothing left to do. Just hang it on the wall. Acrylite front protector on paper formats.
                  </p>
                  <img class="tab-accordion__finish-image" src="{{ 'make-portrait/bark-and-frame-configurator-hero-jack-russell-with-his-portrait-gentleman-old-master-style-living-room.jpg' | asset_url }}" alt="Finished portrait in a living room" loading="lazy">
                  <p class="tab-accordion__claim">Made to hold its place.</p>
                </div>
              </details>
            </accordion-custom>
          </div>
        </div>

        {%- comment -%}
        <div class="tab-panel" id="tab-limited" data-tab="limited" role="tabpanel" hidden>
          <div class="tab-limited">
            <p>Some styles are created for a limited time. Once they are gone, they do not return. Each limited release captures a specific moment. A collaboration, an idea, or a direction explored only once.</p>
            <h2 class="tab-limited__heading">Available briefly. Gone permanently.</h2>
          </div>
        </div>
        {%- endcomment -%}

      </div>

      {%- if section.settings.show_reviews -%}
        <div class="mp-reviews">
          <h2 class="reviews__heading">What dog people say</h2>
          <div class="reviews__outer">
            <div class="reviews__grid">
              {%- for r in shop.metaobjects['review'].values limit: 9 -%}
                <div class="review-card">
                  {%- if r.photo.value != blank -%}
                    <div class="review-card__img">
                      <img
                        src="{{ r.photo.value | image_url: width: 600 }}"
                        alt="{{ r.heading.value | escape }}"
                        loading="lazy"
                        width="600"
                        height="400"
                      >
                    </div>
                  {%- endif -%}
                  {%- if r.heading.value != blank -%}
                    <h3 class="review-card__heading">{{ r.heading.value }}</h3>
                  {%- endif -%}
                  {%- if r.body.value != blank -%}
                    <p class="review-card__body">{{ r.body.value | newline_to_br }}</p>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
            <div class="reviews__fade" aria-hidden="true"></div>
          </div>
          <!--
            <div class="reviews__cta">
              <a href="/pages/reviews" class="button">All reviews</a>
            </div>
          -->
        </div>
      {%- endif -%}

    </div>

  </div>{%- comment -%} end .make-portrait__layout {%- endcomment -%}
</div>

{% style %}
  #make-portrait-section {
    --icon-cross-url: url({{ 'icon-cross--red.svg' | asset_url }});
    --icon-checkmark-url: url({{ 'icon-checkmark--green.svg' | asset_url }});
  }
{% endstyle %}

{% stylesheet %}

.make-portrait {
  padding: 40px 0 100px;
  font-family: var(--font-body--family);
  color: var(--brown);
}

/* ------ Layout ------ */
.make-portrait__layout {
  display: flex;
  flex-direction: column;
  gap: 40px;
}

/* ------ Left Panel ------ */
.make-portrait__left {
  display: flex;
  flex-direction: column;
  gap: 24px;
  scroll-margin-top: 20px;
}

.make-portrait__preview-wrap {
  position: relative;
  aspect-ratio: 1/1;
  border-radius: 40px;
  overflow: hidden;
  background: var(--cream);
}

.make-portrait__preview-img--square {
  height: 94%;
  width: 94%;
  aspect-ratio: 1/1;
  margin: 3% auto;
  object-fit: cover;
  object-position: center;
  transition: opacity 0.4s ease;
  box-shadow: none;
}

/* Artist badge */
.make-portrait_artist-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  background: var(--purple);
  padding: 15px;
  text-align: center;
  transition: opacity 0.3s;
  width: 120px;
  cursor: pointer;
}

.make-portrait_artist-badge[hidden] {
  display: none;
}

.make-portrait_artist-badge:focus-visible {
  outline: 2px solid var(--green);
  outline-offset: 3px;
}

.artist-badge__photo {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
}

.artist-badge__text {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.artist-badge__label {
  font-size: 7px;
  line-height: 1.2;
}

.artist-badge__name {
  font-size: 7px;
}

/* Product / size labels */
.make-portrait__product-label,
.make-portrait__size-label {
  position: absolute;
  top: 16px;
  left: 16px;
  background: rgba(244, 239, 229, 0.92);
  backdrop-filter: blur(4px);
  border-radius: 20px;
  padding: 6px 14px;
  font-size: var(--font-h6--size);
  font-weight: 600;
  color: var(--brown, #5a4035);
}


.make-portrait__size-label {
  top: auto;
  bottom: 16px;
  left: auto;
  right: 16px;
  font-size: 11px;
}

/* ------ Tabs ------ */
.make-portrait__tabs {
  width: 100%;
}

.make-portrait__tab-nav {
  display: flex;
  justify-content: space-between;
  max-width: 360px;
  margin: 0 auto 1em;
}

.tab-nav__btn {
  background: none;
  border: none;
  padding: 12px 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--brown);
  cursor: pointer;
  position: relative;
  transition: opacity 0.2s;
  opacity: .45;
}

.tab-nav__btn.active {
  opacity: 1;
}

.tab-nav__btn.active::after {
  transform: scaleX(1);
}

.make-portrait__tab-panels {
  padding: 20px 0;
  max-width: 520px;
  margin: 0 auto;
}

.tab-panel {
  font-size: 14px;
  line-height: 1.2;
  color: var(--brown);
}

.tab-panel[hidden] {
  display: none;
}

/* ------ Tab: Overview ------ */
.tab-overview > img {
  display: block;
  height: auto;
  margin-bottom: 60px;
  max-width: 100%;
}

.tab-overview__heading {
  font-family: var(--font-heading--family);
  font-size: var(--font-size--2xl);
  text-align: center;
  margin: 0 0 20px;
}

.tab-overview__steps {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-bottom: 28px;
}

.tab-overview__step {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
}

.tab-overview__step-pill {
  display: inline-block;
  background: var(--green);
  color: var(--cream);
  font-size: var(--font-size--2xs);
  padding: 3px 10px;
  border-radius: 20px;
  font-weight: 600;
}

.tab-overview__step-title {
  font-family: var(--font-heading--family);
  font-size: var(--font-size--lg);
  margin: 0;
}

.tab-overview__step-img {
  width: 100%;
  max-width: 180px;
  margin-top: 6px;
}

.tab-overview__body {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 28px;
  font-size: var(--font-size--sm);
  line-height: 1.6;
}

.tab-overview__body p { margin: 0; }

.tab-overview__composite {
  aspect-ratio: 1036 / 1020;
  margin-top: 60px;
  position: relative;
  width: 100%;
}

.tab-overview__image-card {
  margin: 0;
  position: absolute;
}

.tab-overview__image-card img {
  display: block;
  height: auto;
  width: 100%;
}

.tab-overview__image-card--photo {
  left: 0;
  top: 15.1%;
  width: 25.29%;
}

.tab-overview__image-card--photo img {
  border-radius: 12% / 9%;
}

.tab-overview__image-card--artist {
  left: 45.95%;
  top: 9.8%;
  width: 19.11%;
}

.tab-overview__image-card--artist img {
  border-radius: 11% / 9%;
}

.tab-overview__image-card--wall {
  border-radius: 30px;
  left: 31.66%;
  overflow: visible;
  top: 53.14%;
  width: 68.34%;
}

.tab-overview__image-card--wall img {
  border-radius: 30px;
  clip-path: inset(0 round 30px);
  -webkit-mask-image: -webkit-radial-gradient(white, black);
}

.tab-overview__photo-label {
  position: absolute;
  background: var(--green);
  color: var(--cream);
  font-size: var(--font-size--2xs);
  padding: 3px 10px;
  border-radius: 20px;
  font-weight: 600;
  transform: translate3d(0, var(--overview-label-parallax, 0px), 0);
  transition: transform 120ms linear;
  white-space: nowrap;
  will-change: transform;
}

.tab-overview__photo-label--photo {
  left: 100%;
  margin-left: 20px;
  top: 45%;
}

.tab-overview__photo-label--artist {
  left: 100%;
  margin-left: 20px;
  top: 39%;
}

.tab-overview__photo-label--wall {
  margin-right: 20px;
  right: 100%;
  top: 47%;
}

@media (max-width: 749px) {
  .tab-overview__photo-label--wall {
    margin-right: 12px;
  }
}

/* ------ Tab: Product ------ */
#tab-product-accordions,
#tab-product-accordions .tab-accordion {
  overflow-anchor: none;
}

.tab-accordion__summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  font-size: 14px;
  font-weight: 700;
  color: var(--brown);
  cursor: pointer;
  list-style: none;
  border-bottom: 2px solid var(--cream);

  &:hover{
    color: var(--brown);
  }

  .svg-wrapper{
    width: 22px;
    height: 22px;
    background-color: var(--cream);
    border-radius: 50%;

    svg{
      width: 12px;
      height: 12px;
    }
  }
}

.tab-accordion__summary::-webkit-details-marker { display: none; }

.tab-accordion__claim {
  font-family: "display", serif;
  font-size: 21px;
  font-weight: 400;
  line-height: 1.2;
  margin: 60px 0 0 !important;
}

.accordion-card {
  background-color: var(--cream);
  border-radius: 40px;
  padding: 40px 20px;
  margin: 20px 0;
}

.accordion-card__title {
  font-family: "display", serif;
  font-size: 21px;
  font-weight: 400;
  text-align: center;
  margin: 0 0 10px !important;
  text-transform: none;
}

.accordion-card__desc {
  font-size: 14px;
  line-height: 1.25;
  margin: 0 0 20px;
}

.accordion-card__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.accordion-card__item img {
  width: 100%;
  object-fit: cover;
  border-radius: 30px;
  display: block;
}

.accordion-card__item-name {
  font-family: "display", serif;
  font-size: 18px;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 0;
  text-transform: none;
  color: inherit;
  margin: 10px 0 5px !important;
  padding: 0 10px;
}

.accordion-card__item-desc {
  font-size: 10px;
  line-height: 1.4;
  margin: 0 !important;
  padding: 0 10px;
}

.tab-accordion__image-grid {
  display: grid;
  gap: 20px;
  grid-template-columns: 1fr 1fr;
  margin: 2em 0;
}

.tab-accordion__image-grid img {
  border-radius: 30px;
  display: block;
  margin: 0;
  width: 100%;
}

.size-table {
  display: grid;
  grid-template-columns: 120px 1fr 1fr;
  gap: 0;
}

.size-table--2col {
  grid-template-columns: 120px 1fr;
}

.size-table__header {
  display: contents;
}

.size-table__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 500;
  border-radius: 999px;
  padding: 2px 8px;
  width: fit-content;
  margin: 20px 0;
}

.size-table__badge--dark {
  background-color: var(--brown);
  color: var(--cream);
}

.size-table__badge--green {
  background-color: var(--green);
  color: var(--cream);
  margin: 20px auto;
}

.size-table__row {
  display: contents;
}

.size-table__row > * {
  padding: 14px 0;
}

.size-table__label {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding-right: 10px;
  justify-content: center;

  strong {
    font-size: 14px;
    font-weight: 500;
  }

  span {
    font-size: 10px;
    line-height: 1.2;
  }
}

.size-table__dim {
  display: flex;
  flex-direction: column;
  gap: 3px;
  border-left: 1px solid var(--brown);
  padding: 0 10px;
  text-align: center;
  justify-content: center;

  strong {
    font-size: 14px;
    font-weight: 700;
    margin-top: 10px;
  }

  span {
    font-size: 14px;
    font-weight: 700;
    opacity: .5;
    margin-bottom: 10px;
  }
}

.size-table__dim:last-child {
  border-right: 1px solid var(--brown);
}

.tab-accordion .svg-wrapper.icon-plus {
  transition: transform 0.2s ease;
}

.tab-accordion[open] .svg-wrapper.icon-plus {
  transform: rotate(45deg);
}

.tab-accordion[open] > summary .icon-plus .vertical {
  opacity: 1;
  transform: none;
}

.tab-accordion[open] > summary .icon-plus .horizontal {
  transform: none;
}

.tab-accordion__body {
  padding: 10px 0 60px;
  font-size: 14px;
  line-height: 1.2;
}

.tab-accordion__body p {
  margin: 2em 0 2em;
}

.tab-accordion__body img {
  margin: 2em 0 2em;
  vertical-align: top;
}

.tab-accordion__body .tab-accordion__finish-image {
  border-radius: 40px;
  display: block;
  margin: 2em auto;
  width: 78%;
}

/* ------ Tab: Limited ------ */
.tab-limited {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.tab-limited p {
  margin: 0;
  font-size: var(--font-size--sm);
  line-height: 1.6;
}

.tab-limited__heading {
  font-family: var(--font-heading--family);
  font-size: 21px;
  margin: 0;
}

/* ------ Right Panel ------ */
.make-portrait__right {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* Step indicator */
.make-portrait__step-indicator {
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 28px;
}

.step-indicator__btn {
  padding: 4px 0;
  background: transparent;
  border: none;
  color: var(--brown);
  opacity: .27;
  font-size: 10px;
  font-weight: 500;
  cursor: default;
  white-space: nowrap;
  transition: color 0.2s;
  flex-shrink: 0;
  font-family: var(--font-body--family);
}

.step-indicator__btn.active {
  opacity: 1;
  font-weight: 700;
}

.step-indicator__btn.completed {
  opacity: 1;
  cursor: pointer;
}

.step-indicator__arrow {
  margin: 0 10px;
  opacity: .54;

  svg{
    stroke: var(--brown);
  }
}

/* ------ Step common ------ */
.make-portrait__step-title {
  font-size: 36px;
  line-height: 1.2;
  color: var(--brown, #5a4035);
  margin: .5em 0 1em !important;
  font-family: var(--font-heading--family, "display", serif);
}


/* ------ Style picker ------ */
.style-picker {
  display: flex;
  flex-wrap: wrap;
  max-width: 340px;
  gap: 15px;
  margin-bottom: 20px;
}

.style-picker__item {
  background: none;
  overflow: hidden;
  cursor: pointer;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  position: relative;
  border: 0;
}

.style-picker__item__img{
  position: relative;
}

.style-picker__item img,
.style-picker__placeholder {
  width: 64px;
  aspect-ratio: 1/1;
  object-fit: cover;
  display: block;
  border-radius: 11px;
  transition: border-color 0.2s;
  border: 2px solid transparent;
}

.style-picker__name {
  font-size: 10px;
  color: var(--brown);
  padding: 8px 2px;
  font-weight: 700;
  line-height: 1;
  display: inline-block;
  max-width: 64px;
  opacity: .45;
  box-sizing: border-box;
  padding-left: 4px;
  padding-right: 0;
}

.style-picker__tag {
  position: absolute;
  bottom: 2px;
  left: 2px;
  font-size: 10px;
  text-transform: uppercase;
  border-radius: 1000px;
  padding: 2px 6px;
  pointer-events: none;
  background: var(--cream);
  color: var(--brown);
  white-space: nowrap;
}

.style--new .style-picker__tag { background: var(--green); color: var(--beige); }
.style--limited .style-picker__tag { background: var(--purple); color: var(--brown); }
.style--sold-out .style-picker__tag {
  background: var(--brown);
  color: var(--beige);
  bottom: calc(50% - 8px);
  left: calc(50% - 20px);
}
.style--sold-out{
}

.style--sold-out img,
.style--sold-out .style-picker__placeholder { opacity: 0.45; }

.style--sold-out .style-picker__name{
  opacity: 0.36;
}

.style-picker__item.selected img,
.style-picker__item.selected .style-picker__placeholder {
  border-color: var(--green);
}

.style-picker__item.selected .style-picker__name{
  opacity: 1;
}

/* Style info */
.make-portrait__style-info {
  margin: 3em 0;
  color: var(--brown);
}

.make-portrait__style-name {
  font-family: var(--font-paragraph--family);
  font-size: var(--font-paragraph--size);
  font-weight: 700;
  line-height: var(--font-paragraph--line-height);
  letter-spacing: 0;
  text-transform: none;
  color: var(--brown);
  margin: 0 0 .8em;
}

.make-portrait__preview-style-name {
  font-size: 18px;
  font-weight: 700;
  text-align: center;
  color: var(--brown);
  position: absolute;
  bottom: calc(7.5% - 10px);
  width: 100%;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.make-portrait__upload-info-title {
  display: block;
  font-weight: 700;
}

.make-portrait__upload-info-text {
  line-height: 1.2;
  margin: 4px 16px 0;
  font-weight: 500;
  font-size: 10px;
  max-width: 300px;
}

.preview-size-cm {
  font-size: 18px;
  font-weight: 700;
  margin-bottom: -.5em;
}

.preview-size-inch {
  font-size: 18px;
  font-weight: 700;
  opacity: 0.45;
  margin-bottom: -.5em;
}

.make-portrait__style-description {
  line-height: 1.2;
  color: var(--brown);
}

/* ------ Product picker ------ */
.product-picker {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-bottom: 20px;
}

.product-picker__print-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.product-picker__print-group .product-picker__item {
  width: 100%;
}

.product-picker__category-label {
  grid-column: 1 / -1;
  font-size: 14px;
  color: var(--brown);
  margin: 6em 0 0.5em;
}

.product-picker__item {
  background: transparent;
  border: 2px solid var(--cream);
  border-radius: 20px;
  padding: 15px 20px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: start;
  gap: 4px;
  text-align: left;
  transition: border-color 0.2s, background 0.2s;
  font-family: var(--font-body--family);

  &.product-picker__item--category{
    border-color: transparent;
    background-color: var(--cream);
  }
}

.product-picker__item img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: contain;
}

.product-picker__placeholder {
  width: 100%;
  aspect-ratio: 1;
  background: var(--beige);
  border-radius: 8px;
}

.make-portrait__cta--secondary {
  background: color-mix(in srgb, var(--purple) 45%, transparent);
  color: var(--brown);
  margin-top: 10px;
  font-size: 10px;
  width: 50% !important;
  padding: 8px 16px;
  display: inline-flex;
  align-items: center;
  gap: 6px;

  &::before {
    content: '';
    display: block;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    background-color: currentColor;
    -webkit-mask-image: url("data:image/svg+xml,%3Csvg width='12' height='12' viewBox='0 0 12 12' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M10 6H2M6 2l-4 4 4 4' stroke='black' stroke-width='1.5'/%3E%3C/svg%3E");
    mask-image: url("data:image/svg+xml,%3Csvg width='12' height='12' viewBox='0 0 12 12' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M10 6H2M6 2l-4 4 4 4' stroke='black' stroke-width='1.5'/%3E%3C/svg%3E");
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  &:hover{
    background-color: color-mix(in srgb, var(--brown) 100%, transparent);
    color: var(--beige);
  }
}

.make-portrait__error-note {
  font-size: var(--font-h6--size);
  color: #c0392b;
  padding: 8px 0;
}

.product-picker__name {
  font-size: 14px;
  font-weight: 700;
  color: var(--brown);
  line-height: 1;
  margin-top: 10px;
}

.product-picker__sub, .product-picker__price{
  font-size: 10px;
  color: var(--brown);
  line-height: 1;
  text-transform: uppercase;
}

.product-picker__item:hover, .product-picker__item.selected {
  border-color: var(--green);
}

/* ------ Options ------ */
.make-portrait__option-group {
  margin-bottom: 40px;
}

.make-portrait__option-label {
  font-size: 14px;
  color: var(--brown);
  margin: 0 0 10px;
  display: block;
}

.make-portrait__option-label-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 0 0 10px;

  .make-portrait__option-label {
    margin: 0;
  }
}

.make-portrait__optional {
  font-weight: 400;
  opacity: 0.6;
}

.option-btn-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  align-items: start;
}

.option-btn {
  font-size: 10px;
  color: var(--brown);
  cursor: pointer;
  border: none;
  background-color: transparent;
  text-align: left;
  padding: 0;
  width: 128px;
  font-family: var(--font-body--family);
}

.option-btn .option-btn__img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: contain;
  display: block;
  flex-shrink: 0;
  border: 2px solid transparent;
  transition: border .2s;
  border-radius: 10px;
  background-color: var(--cream);
}

.option-btn .option-btn__label {
  text-align: left;
  font-weight: 700;
  margin: 1em 0 0;
  display: block;
  opacity: .45;
  transition: opacity .2s;
  box-sizing: border-box;
  padding-left: 0;
  overflow: visible;
}

.option-btn .option-btn__color-delta {
  display: block;
  font-size: 10px;
  font-weight: 400;
  transition: opacity .2s;
  box-sizing: border-box;
  padding-left: 0;
}

.option-btn:hover, .option-btn.selected {
  .option-btn__img{
    border-color: var(--green);
  }

  .option-btn__label{
    opacity: 1;
  }
}

.option-btn--size {
  background-color: var(--cream);
  border-radius: 10px;
  border: 2px solid transparent;
  transition: border .2s;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  overflow: hidden;
  min-width: 80px;
  margin-bottom: 20px;

  &.selected, &:hover {
    border-color: var(--green);
  }

  .option-btn__img {
    border: 0;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }

  .option-btn__label {
    padding: 5px 15px 10px;
    opacity: 1;
    margin: 0;
    font-size: 10px;;
  }

  .option-btn__size-cm {
    display: block;
  }

  .option-btn__size-inch {
    opacity: .45;
    display: block;
  }

  .option-btn__size-price {
    margin-top: 10px;
    display: block;
    font-weight: 500;
  }
}

.option-btn__extra-price {
  display: block;
  font-size: 10px;
}

.option-btn--small{
  width: 64px;
}

.make-portrait .style-picker__name {
  display: inline-block;
  position: static;
  left: auto;
  transform: none;
  box-sizing: border-box;
  padding-left: 4px;
  padding-right: 0;
}

.make-portrait .make-portrait__step[data-step="3"] .option-btn-grid[data-option-name="frame"] .option-btn__label,
.make-portrait .make-portrait__step[data-step="3"] .option-btn-grid[data-option-name="border"] .option-btn__label,
.make-portrait .make-portrait__step[data-step="3"] .option-btn-grid[data-option-name="color"] .option-btn__label,
.make-portrait .make-portrait__step[data-step="3"] .option-btn-grid[data-option-name="color"] .option-btn__color-delta {
  display: block;
  position: static;
  left: auto;
  transform: none;
  box-sizing: border-box;
  padding-left: 4px;
  width: 100%;
  max-width: 100%;
  overflow: visible;
  line-height: 1.1;
}

.make-portrait .make-portrait__step[data-step="3"] .option-btn-grid[data-option-name="frame"] .option-btn__label,
.make-portrait .make-portrait__step[data-step="3"] .option-btn-grid[data-option-name="border"] .option-btn__label,
.make-portrait .make-portrait__step[data-step="3"] .option-btn-grid[data-option-name="color"] .option-btn__label {
  margin-top: 8px;
}

.make-portrait .make-portrait__step[data-step="3"] .option-btn-grid[data-option-name="color"] .option-btn__label,
.make-portrait .make-portrait__step[data-step="3"] .option-btn-grid[data-option-name="color"] .option-btn__color-delta {
  width: 64px;
}

/* Text input */
.make-portrait__text-input {
  width: 100%;
  border: 2px solid transparent;
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 36px;
  color: var(--brown);
  background: #fff;
  outline: none;
  transition: border-color 0.2s;
  display: block;
  background: var(--cream);
  font-family: "display", serif;

  &:hover, &:focus{
    border-color: var(--green);
    background: var(--cream);
  }

  &::placeholder{
    color: var(--brown);
    opacity: .36;
  }
}

.make-portrait__text-input:focus {
  border-color: var(--green);
}

.make-portrait__pet-name-fee {
  display: flex;
  flex-direction: column;
  margin-top: 10px;
  font-size: 10px;
  color: var(--brown);
  
  span{
    font-weight: 700;

    &#mp-pet-name-fee-amount{
      font-weight: 500;
    }
  }
}

.make-portrait__pet-name-fee[hidden] {
  display: none;
}

/* Loading state */
.make-portrait__loading {
  color: rgba(90, 64, 53, 0.5);
  font-size: var(--font-h6--size);
  padding: 16px 0;
}

/* ------ Photo upload ------ */
.photo-upload {
  margin-bottom: 16px;
}

.photo-upload__zone {
  position: relative;
  vertical-align: top;
  padding: 60px 20px 50px;
  text-align: center;
  cursor: pointer;

  &::after{
    border-radius: 20px;
    border: 2px dashed var(--brown);
    display: block;
    content: "";
    width: 100%;
    height: 100%;
    inset: 0;
    position: absolute;
    transition: opacity 0.2s, background 0.2s;
    opacity: .63;
    background: transparent;
  }
}

.photo-upload__zone:hover,
.photo-upload__zone.drag-over {
  &::after{
    opacity: 1;
    background: var(--cream);
  }
}

.photo-upload__instruction {
  font-size: 14px;
  color: var(--brown);
  position: relative;
  z-index: 1;
  margin: 0;
}

.photo-upload__sub {
  font-size: 10px;
  color: var(--brown);
  margin: 2px 0 25px;
  position: relative;
  z-index: 1;
  opacity: .45;
}

.photo-upload__input {
  display: none;
}

.photo-upload__browse {
  cursor: pointer;
  display: inline-block;
  position: relative;
  z-index: 1;
  color: var(--brown);
  background: transparent;
  border: 1px solid var(--brown);
}

.photo-upload__previews {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;

  .photo-preview{
    margin-top: 15px;
  }
}


.photo-upload__resolution-alert {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  margin-top: 10px;
  padding: 12px 14px;
  background: rgba(180, 120, 0, 0.08);
  border: 1px solid rgba(180, 120, 0, 0.25);
  border-radius: 8px;
}

.photo-upload__resolution-alert[hidden] {
  display: none;
}

.photo-upload__resolution-alert__icon {
  font-size: 16px;
  line-height: 1.4;
  flex-shrink: 0;
  color: #b47800;
}

.photo-upload__resolution-alert__text {
  font-size: var(--font-size--sm, 13px);
  color: var(--brown);
  margin: 0;
  line-height: 1.5;
}

.photo-upload__counter {
  text-align: right;
  font-size: var(--font-size--sm, 13px);
  color: var(--brown);
  margin-top: 6px;
  margin-bottom: 0;
}

.photo-preview {
  position: relative;
  width: 72px;
  height: 72px;
  border-radius: 10px;
  overflow: hidden;
  border: 1.5px solid rgba(90, 64, 53, 0.2);
}

.photo-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-preview__file-fallback {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  background: rgba(244, 239, 229, 0.9);
  color: var(--brown, #5a4035);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.photo-preview__spinner {
  position: absolute;
  inset: 0;
  background: rgba(244, 239, 229, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-preview__spinner::after {
  content: '';
  width: 20px;
  height: 20px;
  border: 2px solid rgba(90, 64, 53, 0.3);
  border-top-color: var(--brown, #5a4035);
  border-radius: 50%;
  animation: mp-spin 0.7s linear infinite;
}

.photo-preview__spinner--error::after {
  content: '!';
  border: none;
  width: auto;
  height: auto;
  animation: none;
  font-size: 18px;
  font-weight: 700;
  color: #c0392b;
}

.photo-preview--error {
  outline: 2px solid var(--color-error);
  border-radius: 8px;
  opacity: 0.6;
}

@keyframes mp-spin {
  to { transform: rotate(360deg); }
}

.photo-preview__remove {
  position: absolute;
  top: 3px;
  right: 3px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: rgba(90, 64, 53, 0.8);
  color: #fff;
  border: none;
  cursor: pointer;
  font-size: 11px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mp-image-guidelines{
  margin: 60px 0;
  background-color: var(--cream);
  padding: 20px;
  border-radius: 20px;

  .title{
    font-size: 14px;
    font-family: var(--font-body--family) !important;
  }

  .description{
    font-size: 10px;
  }

  .content{
    margin: 40px 0 0;
    display: flex;
    gap: 15px;

    .column{
      flex: 1;

      .title{
        text-align: center;
        font-family: "display" !important;
        font-size: 18px;
        margin-bottom: 8px;
      }

      .image{
        aspect-ratio: 1 / 1.08;
        vertical-align: top;
        object-fit: cover;
        border-radius: 20px;
      }

      ul{
        list-style: none;
        padding-left: 0;
        margin: 12px 0 0;

        li{
          font-size: 10px;
          color: color-mix(in srgb, var(--brown) 63%, transparent);
          padding-left: 1.4em;
          position: relative;
          margin-bottom: 8px;
          line-height: 1.2;

          &::before{
            content: "";
            position: absolute;
            left: 0;
            top: 0.3em;
            width: 1em;
            height: .7em;
            background: var(--icon-cross-url) center / contain no-repeat;
          }
        }
      }

      &.column--good{
        ul li::before{
          background-image: var(--icon-checkmark-url);
        }
      }
    }
  }
}

/* ------ Add prints ------ */
.addon-item--prints {
  display: flex;
  flex-direction: column;
  position: relative;
}

.addon-item--prints .addon-item__header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  cursor: pointer;
  width: 100%;
}

.make-portrait__prints-options {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 15px 20px;
  background-color: var(--cream);
  border-radius: 10px;
  display: flex;
  align-items: center;

  .option-btn{
    text-align: center;
    width: auto;

    .option-btn__count{
      padding: 4px 10px;
      background-color: var(--beige);
      display: inline-block;
      font-size: 14px;
      font-family: "display", serif;
      border-radius: 5px;
      margin-bottom: 5px;
      height: 25px;
      transition: background .2s, color .2s;
    }

    &.selected{
      .option-btn__count{
        background-color: var(--brown);
        color: var(--beige);
      }
    }
  }

  .make-portrait__prints-custom{
    display: block;
    
    .make-portrait__prints-custom-input{
      width: 45px;
      display: block;
      background-color: var(--beige);
      border-radius: 5px;
      font-size: 14px;
      font-family: "display", serif;
      height: 25px;
      padding: 0;
      margin-bottom: 5px;
    }

    .make-portrait__prints-custom-price{
      font-size: 10px;
      opacity: .45;
    }

    &.selected{
      .make-portrait__prints-custom-price{
        opacity: 1;
      }
    }
  }
}

.make-portrait__prints-options[hidden] {
  display: none;
}

.make-portrait__prints-custom {
  cursor: text;
  flex-direction: column;
  gap: 2px;
}

.make-portrait__prints-custom-input {
  width: 100%;
  background: transparent;
  border: none;
  outline: none;
  color: inherit;
  font: inherit;
  font-size: inherit;
  text-align: center;
  -moz-appearance: textfield;
  cursor: text;
  min-width: 0;
}

.make-portrait__prints-custom-input::-webkit-outer-spin-button,
.make-portrait__prints-custom-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
}

.make-portrait__prints-custom-input::placeholder {
  color: inherit;
  opacity: 0.5;
}

.make-portrait__prints-custom-price {
  font-size: var(--font-size--xs);
  opacity: 0.7;
}

/* ------ Add-ons ------ */
.make-portrait__addons {
  margin-bottom: 60px;
}

.make-portrait__addons-title {
  font-size: 14px;
  font-weight: 500;
  color: var(--brown);
  margin: 0 0 1em;
}

.addon-item {
  padding: 15px 20px;
  border-radius: 10px;
  margin-bottom: 10px;
  cursor: pointer;
  border: 2px solid transparent;
  transition: border-color 0.2s, background 0.2s;
  background: var(--cream);
  display: block;
}

.addon-item__check {
  display: none;
}

.addon-item__body {
  display: flex;
  align-items: center;
  gap: 20px;
  width: 100%;
}

.addon-item__left {
  display: flex;
  flex-direction: column;
  min-width: 120px;
  flex: 1;
}

.addon-item__name {
  font-family: "display", "Times New Roman", serif;
  font-size: 21px;
  opacity: .36;
  transition: opacity 0.2s;
  line-height: 1;
}

.addon-item__price {
  font-size: 10px;
}

.addon-item__description {
  font-size: 10px;
  line-height: 1.2;
  flex: 1;
  opacity: .63;
}

.addon-item:hover, .addon-item:has(.addon-item__check:checked){
  border-color: var(--green);

  .addon-item__name, .addon-item__description{
    opacity: 1;
  }
}

/* ------ Donation card ------ */
.donation-card__inner {
  display: flex;
  gap: 0;
  background: var(--purple);
  border-radius: 10px;
  align-items: stretch;
  overflow: hidden;
}

.donation-card__image {
  width: 30%;
  object-fit: cover;
  object-position: center right;
}

.donation-card__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 20px;
}

.donation-card__heading {
  font-family: "display", serif;
  font-size: 21px;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 0;
  text-transform: none;
  color: inherit;
  margin: 0;
}

.donation-card__description {
  font-size: 10px;
  line-height: 1.2;
  margin: 0;
  opacity: .63;
}

.donation-card__amounts{
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px;
  margin-top: 5px;
}

.donation-card__amounts .option-btn {
  background: var(--beige);
  border: 2px solid transparent;
  color: var(--brown);
  border-radius: 10px;
  font-family: "display", serif;
  font-size: 14px;
  padding: 5px 8px;
  width: auto;
  text-align: center;
  transition: border .2s;
  white-space: nowrap;
}

.donation-card__amounts .option-btn:hover, .donation-card__amounts .option-btn.selected{
  border-color: var(--green);
}

.donation-card__amounts .donation-card__custom {
  cursor: text;
  padding: 0 5px;
  height: 100%;
}

.donation-card__custom-input, .donation-card__custom-input:hover {
  width: 100%;
  background: transparent;
  border: none;
  outline: none;
  color: inherit;
  font: inherit;
  font-size: inherit;
  text-align: center;
  -moz-appearance: textfield;
  cursor: text;
  min-width: 0;
  padding: 0;
  height: 100%;
}

.donation-card__custom-input::-webkit-outer-spin-button,
.donation-card__custom-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
}

.donation-card__custom-input::placeholder {
  color: inherit;
  opacity: 0.5;
}

/* ------ Subtotal ------ */
.make-portrait__subtotal {
  margin: 0 0 20px;
  background-color: var(--cream);
  border-radius: 10px;
  padding: 15px 20px;
  color: var(--brown);
}

.subtotal__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 10px;
}

.subtotal__label{
  display: flex;
  flex-direction: column;
}

.subtotal__label__title{
  font-size: 14px;
}

.subtotal__label__note{
  margin: auto 0 5px;
}

#mp-subtotal-prefix {
  vertical-align: middle;
}

.subtotal__price__amount{
  font-family: "display", "Times New Roman", serif !important;
  font-size: 36px;
  line-height: 1em;
  display: inline-block;
}

.make-portrait__availability{
  font-size: 10px;
  display: flex;
  gap: 9px;
  align-items: center;
  margin: 30px 0 7px;
}

.make-portrait__availability__indicator{
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: #2DCA7C;
  display: inline-block;
}

.make-portrait__availability--out_of_stock .make-portrait__availability__indicator {
  background-color: #E53935;
}

.make-portrait__availability--low_stock .make-portrait__availability__indicator {
  background-color: #F4A435;
}

.make-portrait__delivery-note {
  display: flex;
  align-items: center;
  font-size: 10px;
  margin: 0;
  gap: 2px;
}

.mp-delivery__label{
  margin-left: 3px;
}

#mp-delivery{
  font-weight: 700;
}

.make-portrait__subtotal--summary {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.order-summary{
  margin-bottom: 15px;
}

.order-summary__line {
  font-size: 10px;
  margin: 0;
  line-height: 1.5;
}

.order-summary__line--donation{
  margin-top: 1em;
}

.order-summary__line strong {
  font-weight: 700;
}

.order-summary__section {
  margin-top: 1em;
  font-size: 10px;
}

.order-summary__section-label {
  margin: 0;
}

.order-summary__section-value {
  font-weight: 700;
  margin: 0;
}

/* ------ CTA button ------ */
.make-portrait__cta {
  width: 100%;
}

.make-portrait__cta:disabled {
  background: #9D9895 !important;
  border-color: #9D9895 !important;
  opacity: 1 !important;
  cursor: not-allowed;
}

.make-portrait__cta--upload-required {
  opacity: 0.72;
  position: relative;
}
.make-portrait__cta--upload-required::after {
  content: '';
  position: absolute;
  inset: 0;
  cursor: not-allowed;
  border-radius: inherit;
}

.make-portrait__error {
  color: #c0392b;
  font-size: var(--font-h6--size);
  margin: 8px 0 0;
  padding: 10px;
  background: rgba(192, 57, 43, 0.08);
  border-radius: 8px;
}

.make-portrait__empty-note {
  font-size: var(--font-h6--size);
  color: rgba(90, 64, 53, 0.5);
  padding: 16px 0;
}

.tab-artist-panel {
  flex-direction: column;
  gap: 2rem;
}

.tab-artist-panel:not([hidden]) {
  display: flex;
}


.artist-bio {
  font-size: 14px;
  color: var(--brown);
  line-height: 1.3;
  margin: 1em 0;
}

.artist-bio p { margin: 0 0 1em; }
.artist-bio p:last-child { margin-bottom: 0; }

.artist-portrait img {
  width: 100%;
  border-radius: 1rem;
  display: block;
}

.artist-hero {
  font-family: "display";
  font-size: 21px;
  margin: 0;
}

/* ------ Reviews grid ------ */
.mp-reviews{
  text-align: left;
  border-top: 2px solid var(--cream);
  padding: 100px 0 0;
  margin: 120px 0 0;
}

.reviews__heading {
  font-family: var(--font-heading--family);
  font-size: 36px;
  margin: 0 0 1em;
}

.reviews__cta {
  display: flex;
  justify-content: center;
  margin-top: 20px;
}

.reviews__outer {
  position: relative;
  max-height: 900px;
  overflow: hidden;
}

.reviews__grid {
  columns: 2;
  column-gap: 20px;
}

.reviews__fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 220px;
  background: linear-gradient(to bottom, transparent, var(--beige));
  pointer-events: none;
}

.review-card {
  background: var(--cream);
  border-radius: 20px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 15px;
  break-inside: avoid;
  margin-bottom: 20px;
}

.review-card__img {
  border-radius: 10px;
  overflow: hidden;
}

.review-card__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.review-card:hover .review-card__img img {
  transform: scale(1.04);
}

.review-card__heading {
  font-size: 18px;
  font-weight: 700;
  margin: 1em 0 .3em;
}

.review-card__body {
  font-size: 14px;
  margin: 0;
}

.make-portrait__resume-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 900;
}

.make-portrait__resume-backdrop[hidden] { display: none; }

.make-portrait__resume-banner {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 901;
  background: var(--brown);
  color: var(--cream);
  border-radius: 16px;
  padding: 32px 28px;
  width: min(420px, calc(100vw - 32px));
  max-height: calc(100dvh - 32px);
  overflow: auto;
  display: flex;
  flex-direction: column;
  gap: 20px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.32);
}

.make-portrait__resume-banner__text {
  font-size: var(--font-size--md);
  font-weight: 600;
  margin: 0;
  line-height: 1.4;
}

.make-portrait__resume-banner__actions {
  display: flex;
  gap: 10px;
}

.make-portrait__resume-banner .button--secondary {
  background: var(--cream);
  color: var(--brown);
  border-color: var(--cream);

  &:hover{
    background: var(--purple);
  }
}

.make-portrait__resume-banner .button--ghost {
  color: var(--beige);
  border: 1px solid var(--beige);

  &:hover{
    color: var(--brown);
  }
}

.make-portrait__resume-banner__detail {
  font-size: var(--font-size--sm);
  margin: 0;
  opacity: 0.75;
  line-height: 1.4;
}

.make-portrait__resume-banner[hidden] { display: none; }

@media (max-width: 480px) {
  .make-portrait__resume-banner {
    padding: 24px 20px;
  }

  .make-portrait__resume-banner__actions {
    flex-direction: column;
  }

  .make-portrait__resume-banner__actions .button {
    width: 100%;
  }
}

@media (min-width: 800px) {
  .make-portrait__layout {
    display: grid;
    grid-template-columns: 3fr 2fr;
    grid-template-areas:
      "left  right"
      "tabs  right"
      ".  right";
    gap: 40px;
    align-items: start;
  }

  .make-portrait__left  { grid-area: left; }
  .make-portrait__right { grid-area: right; position: sticky; top: 94px; padding-bottom: 40px;}
  .make-portrait__tabs  { grid-area: tabs; align-self: start; }

  .make-portrait__action-bar {
    position: sticky;
    bottom: 0px;
    z-index: 10;
    background: var(--beige);
    border-radius: 10px 10px 0 0;
    margin-top: 20px;
  }
}

@media (min-width: 750px) {
  .accordion-card{
    padding: 40px;
  }
}

@media (min-width: 1200px) {
  .make-portrait__layout{
    grid-template-columns: 3fr 420px;
    gap: 120px;
  }

  .make-portrait_artist-badge{
    padding: 40px;
    gap: 20px;
    width: 180px;

    .artist-badge__photo{
      width: 60px;
      height: 60px;
    }

    .artist-badge__text{
      .artist-badge__label, .artist-badge__name{
        font-size: 10px;
      }
    }
  }

  .donation-card__amounts{
    display: flex;
    flex-wrap: nowrap;
  }

  .reviews__grid {
    columns: 3;
  }
}

{% endstylesheet %}

{% # theme-check-disable StaticStylesheetAndJavascriptTags %}
{% javascript %}

(function () {

  /* --------------------------------------------------------------------------------
     State
  -------------------------------------------------------------------------------- */
  var state = {
    step: 1,
    styleId: null,
    style: null,
    productCategory: null,   // 'canvas' | null
    categoryMinPrice: 0,     // in local currency cents
    canvasFrameChoice: null, // 'unframed' | 'framed'
    productHandle: null,
    product: null,
    variantId: null,
    variant: null,
    selectedOptions: {},
    petCount: 1,
    petName: '',
    border: 'no-border',
    background: 'classic',
    addonTotal: 0,   // in cents
    donation: 0,     // in cents
    prints: 0,       // number of copies (0 = none)
    files: [],
    photoUrls: [],
    pendingUploads: 0,
    fileDimensions: new Map(),
    previewImageUrl: null
  };

  var STYLES = window.MakePortraitStyles || [];
  var FRAMED_POSTER_HANDLE = window.MakePortraitFramedPosterHandle || '';
  var COLOR_DISPLAY_NAMES = { 'oak': 'Premium Oak', 'brown': 'Premium Walnut' };
  var PRODUCTS = window.MakePortraitProducts || [];
  var CANVAS_HANDLES = window.MakePortraitCanvasHandles || {};
  var EXTRA_PET_USD    = window.MakePortraitExtraPetUSD    || 9;
  var PET_NAME_USD     = window.MakePortraitPetNameUSD     || 5;
  var PRINTS_BASE_EUR  = window.MakePortraitPrintsBaseEUR  || 30;
  var PRINTS_EXTRA_EUR = window.MakePortraitPrintsExtraEUR || 20;
  var FX_RATE          = 1;
  var EXTRA_PET_PRICE  = EXTRA_PET_USD * 100;
  var PET_NAME_PRICE   = PET_NAME_USD  * 100;
  var PRINTS_BASE_PRICE  = PRINTS_BASE_EUR  * 100;
  var PRINTS_EXTRA_PRICE = PRINTS_EXTRA_EUR * 100;

  /* --------------------------------------------------------------------------------
     Utilities
  -------------------------------------------------------------------------------- */
  function formatMoney(cents) {
    var format = window.MakePortraitMoneyFormat || '${{amount}}';
    var amount = Math.round(cents) / 100;
    var intAmount = Math.round(amount);
    return format
      .replace('{{amount}}', intAmount)
      .replace('{{amount_no_decimals}}', intAmount)
      .replace('{{amount_with_comma_separator}}', intAmount)
      .replace('{{amount_no_decimals_with_comma_separator}}', intAmount);
  }

  function getDeliveryDate() {
    var d = new Date();
    d.setDate(d.getDate() + 7);
    var dd = String(d.getDate()).padStart(2, '0');
    var mm = String(d.getMonth() + 1).padStart(2, '0');
    var yyyy = d.getFullYear();
    return dd + '/' + mm + '/' + yyyy;
  }

  function $(selector) {
    return document.getElementById(selector);
  }

  var overviewCompositeBase = { width: 1036, height: 1020 };
  var overviewCompositeBoxes = {
    photo: { x: 0, y: 154, width: 262 },
    artist: { x: 476, y: 100, width: 198 },
    wall: { x: 328, y: 542, width: 708 }
  };

  function layoutOverviewComposite() {
    var media = $('mp-overview-media');
    if (!media) return;

    var scale = media.clientWidth / overviewCompositeBase.width;
    if (!scale) return;

    var maxBottom = overviewCompositeBase.height * scale;
    Object.keys(overviewCompositeBoxes).forEach(function (slot) {
      var box = overviewCompositeBoxes[slot];
      var img = $('mp-overview-' + slot);
      var card = img && img.closest('.tab-overview__image-card');
      if (!card || card.hidden) return;

      card.style.left = (box.x * scale) + 'px';
      card.style.top = (box.y * scale) + 'px';
      card.style.width = (box.width * scale) + 'px';

      var bottom = (box.y * scale) + card.getBoundingClientRect().height;
      if (bottom > maxBottom) maxBottom = bottom;
    });

    media.style.height = Math.ceil(maxBottom) + 'px';
  }

  function setOverviewImage(slot, data) {
    var img = $('mp-overview-' + slot);
    if (!img) return;
    var card = img.closest('.tab-overview__image-card');
    if (!data || !data.src) {
      img.removeAttribute('src');
      img.alt = '';
      if (card) card.hidden = true;
      return;
    }
    img.onload = layoutOverviewComposite;
    img.src = data.src;
    img.alt = data.alt || '';
    if (card) card.hidden = false;
    window.requestAnimationFrame(layoutOverviewComposite);
  }

  function updateOverviewImages() {
    var overviewMap = window.MakePortraitOverviewImages || {};
    var bucket = overviewMap[state.styleId] || null;
    setOverviewImage('photo', bucket && bucket.photo);
    setOverviewImage('artist', bucket && bucket.artist);
    setOverviewImage('wall', bucket && bucket.wall);
    window.requestAnimationFrame(layoutOverviewComposite);
  }

  function initOverviewLabelParallax() {
    var media = $('mp-overview-media');
    if (!media || !window.matchMedia || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var labels = [
      { el: media.querySelector('.tab-overview__photo-label--photo'), strength: 0.026 },
      { el: media.querySelector('.tab-overview__photo-label--artist'), strength: 0.034 },
      { el: media.querySelector('.tab-overview__photo-label--wall'), strength: 0.022 }
    ].filter(function (item) {
      return item.el;
    });
    var ticking = false;

    function clamp(value, min, max) {
      return Math.min(max, Math.max(min, value));
    }

    function update() {
      ticking = false;
      var rect = media.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;

      var mediaCenter = rect.top + rect.height / 2;
      var viewportCenter = window.innerHeight / 2;
      var distanceFromCenter = viewportCenter - mediaCenter;

      labels.forEach(function (item) {
        var offset = clamp(distanceFromCenter * item.strength, -12, 12);
        item.el.style.setProperty('--overview-label-parallax', offset.toFixed(2) + 'px');
      });
    }

    function requestUpdate() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    }

    update();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  }

  /* --------------------------------------------------------------------------------
     Delivery dates
  -------------------------------------------------------------------------------- */
  function updateDeliveryDates() {
    var date = getDeliveryDate();
    ['mp-delivery'].forEach(function (id) {
      var el = $(id);
      if (el) el.textContent = date;
    });
  }

  /* --------------------------------------------------------------------------------
     Subtotal
  -------------------------------------------------------------------------------- */
  function getBasePrice() {
    if (state.variant && state.variant.price) {
      return state.variant.price; // already in cents
    }
    if (state.product && state.product.variants && state.product.variants.length) {
      return state.product.variants[0].price;
    }
    if (state.categoryMinPrice) {
      return state.categoryMinPrice; // already in local currency cents from Shopify
    }
    var prices = window.MakePortraitProducts.map(function(p) { return p.price; });
    if (prices.length) return Math.min.apply(null, prices);
    return 0;
  }

  function getPetExtra() {
    var extraPets = Math.max(0, state.petCount - 1);
    return extraPets * EXTRA_PET_PRICE + (state.petName ? PET_NAME_PRICE : 0);
  }

  function getPrintsPrice() {
    if (!state.prints || state.prints < 1) return 0;
    return PRINTS_BASE_PRICE + (state.prints - 1) * PRINTS_EXTRA_PRICE;
  }

  function getShopCurrencyRate() {
    var rate = parseFloat((Shopify.currency && Shopify.currency.rate) || FX_RATE || 1);
    return isFinite(rate) && rate > 0 ? rate : 1;
  }

  function getCustomTotalPrice() {
    return getBasePrice() + getPetExtra() + state.addonTotal + state.donation + getPrintsPrice();
  }

  function toShopCurrencyCents(presentmentCents) {
    return Math.round(presentmentCents / getShopCurrencyRate());
  }

  function updatePetNameVisibility() {
    var group = $('mp-pet-name-group');
    if (!group) return;
    var isDream = state.style && state.style.name && state.style.name.toLowerCase() === 'dream';
    var isWhiteBorder = state.border === 'white-border';
    var isPaper = state.productHandle === (window.MakePortraitFramedPosterHandle || '');
    var canvasHandles = window.MakePortraitCanvasHandles || {};
    var isCanvas = state.productHandle === canvasHandles.unframed || state.productHandle === canvasHandles.framed;
    group.hidden = isDream && (isCanvas || (!isWhiteBorder && isPaper));
  }

  function updateSubtotals() {
    var total = getCustomTotalPrice();
    var formatted = total > 0 ? formatMoney(total) : '\u2014';
    var priceEl = $('mp-subtotal-price');
    if (priceEl) priceEl.textContent = formatted;
    var prefix = $('mp-subtotal-prefix');
    if (prefix) prefix.hidden = !!state.variant && state.step >= 3;
    updatePetNameVisibility();
    buildSummary();
    saveDraft();
  }

  /* --------------------------------------------------------------------------------
     Step navigation
  -------------------------------------------------------------------------------- */
  function syncPreviewNameForStep() {
    var previewName = $('mp-preview-style-name');
    if (!previewName) return;

    previewName.innerHTML = '';

    if (state.step === 4) return;

    if (state.step >= 3) {
      var sizeValue = getSelectedSizeValue();
      var dims = sizeValue ? getSizeDimensions(sizeValue) : null;
      if (dims) {
        previewName.innerHTML =
          '<span class="preview-size-cm">' + dims.cm + '</span>' +
          '<span class="preview-size-inch">' + dims.inches + '</span>';
        return;
      }
    }

    if (state.step === 2 && (state.productCategory || state.productHandle || state.product)) {
      previewName.textContent = getProductSummaryLabel();
      return;
    }

    if (state.step === 1) {
      previewName.textContent = state.style ? (state.style.name || '') : '';
    }
  }

  function goToStep(step) {
    document.querySelectorAll('.make-portrait__step').forEach(function (el) {
      el.hidden = parseInt(el.dataset.step, 10) !== step;
    });

    document.querySelectorAll('.step-indicator__btn').forEach(function (btn) {
      var s = parseInt(btn.dataset.step, 10);
      btn.classList.toggle('active', s === step);
      btn.classList.toggle('completed', s < step);
    });

    state.step = step;
    updateSubtotals();

    // Show/hide artist badge and product label
    var artistBadge = $('mp-artist-badge');
    var productLabel = $('mp-product-label');
    if (artistBadge) artistBadge.hidden = step !== 1;
    if (productLabel) productLabel.hidden = true;

    // Step 4: dim preview image; restore when leaving
    var previewImg = $('mp-preview-img');
    if (previewImg) previewImg.style.opacity = step === 4 ? '0.27' : '1';

    if (step === 4) updateOrderButton();

    syncPreviewNameForStep();
    updatePreviewImage({ skipScroll: true });

    // Show only the CTA for the active step
    var ctaMap = { 1: 'mp-cta-step1', 2: 'mp-cta-step2', 3: 'mp-cta-step3', 4: 'mp-cta-order' };
    Object.keys(ctaMap).forEach(function (s) {
      var el = $(ctaMap[s]);
      if (el) el.hidden = parseInt(s) !== step;
    });
    var backBtn = $('mp-back-step1');
    if (backBtn) backBtn.hidden = step !== 2;
    var backBtn2 = $('mp-back-step2');
    if (backBtn2) backBtn2.hidden = step !== 3;
    var backBtn3 = $('mp-back-step3');
    if (backBtn3) backBtn3.hidden = step !== 4;

  }

  function goToStepFromControl(step) {
    goToStep(step);
    jumpToConfiguratorStart();
  }

  function getConfiguratorStartTop() {
    var section = $('make-portrait-section');
    return section ? Math.max(0, Math.round(section.getBoundingClientRect().top + window.pageYOffset - 20)) : 0;
  }

  function cancelConfiguratorScrolls() {
    if (productAccordionScrollFrame) {
      window.cancelAnimationFrame(productAccordionScrollFrame);
      productAccordionScrollFrame = null;
    }
    if (configuratorScrollTimer) {
      window.clearTimeout(configuratorScrollTimer);
      configuratorScrollTimer = null;
    }
    if (configuratorScrollFrame) {
      window.cancelAnimationFrame(configuratorScrollFrame);
      configuratorScrollFrame = null;
    }
    if (configuratorScrollRestoreTimer) {
      window.clearTimeout(configuratorScrollRestoreTimer);
      configuratorScrollRestoreTimer = null;
    }
    configuratorScrollToken += 1;
  }

  function forceWindowScrollTop(targetTop) {
    targetTop = Math.max(0, Math.round(targetTop));
    var root = document.documentElement;
    var body = document.body;
    var scroller = document.scrollingElement || root;
    var currentTop = window.pageYOffset || (scroller && scroller.scrollTop) || 0;
    var lenis = window.BarkFrameLenis || window.lenis || null;

    if (!configuratorScrollBehaviorState) {
      configuratorScrollBehaviorState = {
        root: root ? root.style.scrollBehavior : '',
        body: body ? body.style.scrollBehavior : ''
      };
    }

    if (root) root.style.scrollBehavior = 'auto';
    if (body) body.style.scrollBehavior = 'auto';
    if (lenis && typeof lenis.stop === 'function') lenis.stop();
    if (lenis && typeof lenis.scrollTo === 'function') {
      try { lenis.scrollTo(targetTop, { immediate: true, force: true }); } catch (e) {}
    }

    window.scrollTo({ top: currentTop, left: 0, behavior: 'auto' });
    if (scroller) scroller.scrollTop = currentTop;
    if (root) root.scrollTop = currentTop;
    if (body) body.scrollTop = currentTop;

    window.scrollTo({ top: targetTop, left: 0, behavior: 'auto' });
    if (scroller) scroller.scrollTop = targetTop;
    if (root) root.scrollTop = targetTop;
    if (body) body.scrollTop = targetTop;
  }

  function restoreConfiguratorScrollBehavior(token) {
    if (token !== configuratorScrollToken || !configuratorScrollBehaviorState) return;
    var root = document.documentElement;
    var body = document.body;
    if (root) root.style.scrollBehavior = configuratorScrollBehaviorState.root;
    if (body) body.style.scrollBehavior = configuratorScrollBehaviorState.body;
    var lenis = window.BarkFrameLenis || window.lenis || null;
    if (lenis && typeof lenis.start === 'function') lenis.start();
    configuratorScrollBehaviorState = null;
    configuratorScrollRestoreTimer = null;
  }

  function applyConfiguratorStartScroll(token) {
    if (typeof token === 'number' && token !== configuratorScrollToken) return;
    var stickyPanel = document.querySelector('.make-portrait__right');
    if (stickyPanel) stickyPanel.style.top = window.innerWidth >= 800 ? '94px' : '';
    lockProductAccordionScrollAnchoring();
    forceWindowScrollTop(getConfiguratorStartTop());
    if (configuratorScrollRestoreTimer) window.clearTimeout(configuratorScrollRestoreTimer);
    configuratorScrollRestoreTimer = window.setTimeout(function () {
      restoreConfiguratorScrollBehavior(configuratorScrollToken);
    }, 350);
  }

  function jumpToConfiguratorStart() {
    cancelConfiguratorScrolls();
    applyConfiguratorStartScroll();
  }

  function scheduleConfiguratorStartScroll() {
    cancelConfiguratorScrolls();
    var token = configuratorScrollToken;
    var guardUntil = Date.now() + 700;

    function guardConfiguratorStartScroll() {
      if (token !== configuratorScrollToken) return;
      applyConfiguratorStartScroll(token);
      if (Date.now() < guardUntil) {
        configuratorScrollFrame = window.requestAnimationFrame(guardConfiguratorStartScroll);
      } else {
        configuratorScrollFrame = null;
      }
    }

    configuratorScrollTimer = window.setTimeout(function () {
      configuratorScrollTimer = null;
      if (token !== configuratorScrollToken) return;
      guardConfiguratorStartScroll();
    }, 0);
  }

  function scrollToPreview() {
    return;
  }

  var productAccordionScrollFrame = null;
  var configuratorScrollTimer = null;
  var configuratorScrollFrame = null;
  var configuratorScrollRestoreTimer = null;
  var configuratorScrollToken = 0;
  var configuratorScrollBehaviorState = null;
  var productAccordionAnchorTimer = null;
  var productAccordionAnchorState = null;

  function lockProductAccordionScrollAnchoring() {
    if (!productAccordionAnchorState) {
      productAccordionAnchorState = {
        html: document.documentElement.style.overflowAnchor,
        body: document.body ? document.body.style.overflowAnchor : ''
      };
    }

    document.documentElement.style.overflowAnchor = 'none';
    if (document.body) document.body.style.overflowAnchor = 'none';

    if (productAccordionAnchorTimer) {
      window.clearTimeout(productAccordionAnchorTimer);
    }

    productAccordionAnchorTimer = window.setTimeout(function () {
      if (!productAccordionAnchorState) return;
      document.documentElement.style.overflowAnchor = productAccordionAnchorState.html;
      if (document.body) document.body.style.overflowAnchor = productAccordionAnchorState.body;
      productAccordionAnchorState = null;
      productAccordionAnchorTimer = null;
    }, 900);
  }

  function getProductAccordionScrollOffset() {
    var headerHeight = 0;
    var bodyStyles = window.getComputedStyle(document.body);
    var cssHeaderHeight = parseFloat(bodyStyles.getPropertyValue('--header-height')) || 0;
    var header = document.querySelector('#header-component');

    if (header) {
      var headerRect = header.getBoundingClientRect();
      headerHeight = Math.max(headerHeight, headerRect.height || 0);
    }

    headerHeight = Math.max(headerHeight, cssHeaderHeight);

    return Math.round(headerHeight + 16);
  }

  function animateProductAccordionScroll(targetTop, onComplete) {
    targetTop = Math.max(0, Math.round(targetTop));
    lockProductAccordionScrollAnchoring();

    if (productAccordionScrollFrame) {
      window.cancelAnimationFrame(productAccordionScrollFrame);
      productAccordionScrollFrame = null;
    }

    var startTop = window.pageYOffset || document.documentElement.scrollTop || 0;
    var distance = targetTop - startTop;
    if (Math.abs(distance) < 1) {
      window.scrollTo(0, targetTop);
      return;
    }

    var duration = Math.min(650, Math.max(260, Math.abs(distance) * 0.3));
    var startTime = null;

    function easeOutCubic(progress) {
      return 1 - Math.pow(1 - progress, 3);
    }

    function step(timestamp) {
      if (startTime === null) startTime = timestamp;

      var progress = Math.min(1, (timestamp - startTime) / duration);
      window.scrollTo(0, startTop + distance * easeOutCubic(progress));

      if (progress < 1) {
        productAccordionScrollFrame = window.requestAnimationFrame(step);
      } else {
        window.scrollTo(0, targetTop);
        productAccordionScrollFrame = null;
        if (typeof onComplete === 'function') onComplete();
      }
    }

    productAccordionScrollFrame = window.requestAnimationFrame(step);
  }

  function scrollProductAccordionIntoView(details) {
    return;

    var summary = details.querySelector('.tab-accordion__summary') || details;

    function getTargetTop() {
      return summary.getBoundingClientRect().top + window.pageYOffset - getProductAccordionScrollOffset();
    }

    lockProductAccordionScrollAnchoring();
    window.requestAnimationFrame(function () {
      window.requestAnimationFrame(function () {
        animateProductAccordionScroll(getTargetTop(), function () {
          window.requestAnimationFrame(function () {
            var correctedTop = Math.max(0, Math.round(getTargetTop()));
            var currentTop = window.pageYOffset || document.documentElement.scrollTop || 0;
            if (Math.abs(correctedTop - currentTop) > 2) {
              window.scrollTo(0, correctedTop);
            }
          });
        });
      });
    });
  }

  function scrollToPreviewAnchor() {
    return;
  }

  var MP_AVAILABILITY_LABELS = {
    in_stock:    'Our artists are available',
    out_of_stock: 'Our artists are not available',
    low_stock:   'Our artists are almost fully occupied'
  };

  function updateAvailability() {
    var el = $('mp-availability');
    if (!el) return;
    var avMap = window.MakePortraitAvailability || {};
    var status = (state.variantId && avMap[state.variantId]) || 'in_stock';
    el.className = 'make-portrait__availability make-portrait__availability--' + status;
    var labelEl = $('mp-availability-label');
    if (labelEl) labelEl.textContent = MP_AVAILABILITY_LABELS[status] || MP_AVAILABILITY_LABELS.in_stock;
    var isOos = (status === 'out_of_stock');
    var step3btn = $('mp-cta-step3');
    var orderBtn = $('mp-cta-order');
    if (step3btn) step3btn.classList.toggle('make-portrait__cta--upload-required', isOos);
    if (orderBtn) orderBtn.classList.toggle('make-portrait__cta--upload-required', isOos);
  }

  function setConfiguratorPreviewImage(orderPreviewUrl, options) {
    var visualPreviewUrl = options && options.visualPreviewUrl ? options.visualPreviewUrl : orderPreviewUrl;
    if (!visualPreviewUrl) return;

    var persistOrderPreview = !options || options.persistOrderPreview !== false;
    if (persistOrderPreview && orderPreviewUrl) state.previewImageUrl = orderPreviewUrl;

    var img = $('mp-preview-img');
    if (!img) return;
    img.style.opacity = '0';
    img.onload = function () { img.style.opacity = '1'; };
    img.src = visualPreviewUrl;
    if (img.complete) img.style.opacity = '1';
  }

  function updatePreviewImage(options) {
    var spMap = window.MakePortraitStylePreviews || {};
    var variant = state.variant;
    var hasProductConfiguration = !!(state.variant || state.product || state.productHandle || state.productCategory);
    var useStyleFallback = state.step <= 1 && !hasProductConfiguration;
    var defaultVariantId = !variant && (window.MakePortraitCategoryPreviewVariants || {})['canvas'];
    var variantPreviews = variant ? (spMap[variant.id] || {}) : (defaultVariantId ? (spMap[defaultVariantId] || {}) : {});
    var styleBucket = variantPreviews[state.styleId] || {};
    var effectivePetName = getEffectivePetName();
    var hasName = !!(effectivePetName && effectivePetName.trim());
    var borderBase = getEffectiveBorder() === 'white-border' ? 'white_border' : 'default';
    var borderKey = hasName ? borderBase + '_name' : borderBase;
    var visualizerKey = borderKey + '_visualizer';
    var visualizerBaseKey = borderBase + '_visualizer';
    var url = styleBucket[borderKey]
              || styleBucket[borderBase]
              || styleBucket['default']
              || (variant && variant.featured_image && variant.featured_image.src ? variant.featured_image.src : null)
              || (useStyleFallback && state.style && state.style.imageUrl ? state.style.imageUrl : null);
    var visualUrl = styleBucket[visualizerKey]
              || styleBucket[visualizerBaseKey]
              || styleBucket['visualizer']
              || (useStyleFallback && state.style && state.style.visualizerImageUrl ? state.style.visualizerImageUrl : null)
              || url;
    setConfiguratorPreviewImage(url, { visualPreviewUrl: visualUrl });
    if (state.initialized && !(options && options.skipScroll)) scrollToPreview();
  }

  /* --------------------------------------------------------------------------------
     Step 1 - Style
  -------------------------------------------------------------------------------- */
  function selectStyle(styleId) {
    state.styleId = styleId;
    state.style = STYLES.filter(function (s) { return s.id === styleId; })[0] || null;

    document.querySelectorAll('.style-picker__item').forEach(function (btn) {
      var selected = btn.dataset.styleId === styleId;
      btn.classList.toggle('selected', selected);
      btn.setAttribute('aria-selected', selected ? 'true' : 'false');
    });

    if (!state.style) return;

    updatePreviewImage();
    updateOverviewImages();

    // Artist badge
    var artistName = $('mp-artist-name');
    if (artistName) artistName.textContent = state.style.artistName || '';
    var artistPhoto = $('mp-artist-photo');
    if (artistPhoto) {
      artistPhoto.src = state.style.artistPhotoUrl || '';
      artistPhoto.alt = state.style.artistName || '';
      artistPhoto.hidden = !state.style.artistName;
    }
    var artistBadge = $('mp-artist-badge');
    if (artistBadge) {
      artistBadge.setAttribute('aria-label', state.style.artistName ? 'Open artist details for ' + state.style.artistName : 'Open artist details');
    }

    // Artist tab panel
    document.querySelectorAll('.tab-artist-panel').forEach(function (p) { p.hidden = true; });
    if (state.style.id) {
      var activeArtist = document.querySelector('.tab-artist-panel[data-style-id="' + state.style.id + '"]');
      if (activeArtist) activeArtist.hidden = false;
    }

    // Style info
    var nameDisplay = $('mp-style-name-display');
    if (nameDisplay) nameDisplay.textContent = state.style.name || '';

    var previewName = $('mp-preview-style-name');
    if (previewName) previewName.textContent = state.style.name || '';

    var desc = $('mp-style-description');
    if (desc) desc.innerHTML = state.style.description || '';

    var cta1 = $('mp-cta-step1');
    if (cta1) {
      var isSoldOut = state.style && (state.style.tag || '').replace(/ /g, '-') === 'sold-out';
      cta1.classList.toggle('make-portrait__cta--upload-required', isSoldOut);
    }

    updateSubtotals();
  }

  /* --------------------------------------------------------------------------------
     Step 2 - Product
  -------------------------------------------------------------------------------- */
  function selectProduct(handle) {
    state.productCategory = null;
    state.canvasFrameChoice = null;
    state.productHandle = handle;
    state.product = null;
    state.variantId = null;
    state.variant = null;

    document.querySelectorAll('.product-picker__item').forEach(function (btn) {
      var selected = btn.dataset.productHandle === handle;
      btn.classList.toggle('selected', selected);
      btn.setAttribute('aria-selected', selected ? 'true' : 'false');
    });

    // Update product label and preview name
    var productLabel = $('mp-product-label');
    var matchedProduct = PRODUCTS.filter(function (p) { return p.handle === handle; })[0];
    if (productLabel && matchedProduct) productLabel.textContent = matchedProduct.title;
    var previewName = $('mp-preview-style-name');
    if (previewName && matchedProduct) previewName.textContent = matchedProduct.title;

    // Fetch full product data for variants
    fetch('/products/' + handle + '.js')
      .then(function (r) { return r.json(); })
      .then(function (product) {
        state.product = product;

        // Update preview: find brown/oak variant (largest = last match)
        var spMap = window.MakePortraitStylePreviews || {};
        var _previewVariantId = null;
        if (product.variants && product.variants.length) {
          product.variants.forEach(function (v) {
            var opts = (v.options || []).join(' ').toLowerCase();
            if (opts.includes('brown') || opts.includes('oak')) {
              _previewVariantId = v.id;
            }
          });
        }
        if (_previewVariantId) {
          var _pvPreviews = spMap[_previewVariantId] || {};
          var _pvBucket   = _pvPreviews[state.styleId] || {};
          var _pvUrl      = _pvBucket['default'] || (state.style && state.style.imageUrl) || null;
          var _pvVisualUrl = _pvBucket['default_visualizer'] || _pvBucket['visualizer'] || _pvUrl;
          if (_pvUrl) {
            setConfiguratorPreviewImage(_pvUrl, { persistOrderPreview: false, visualPreviewUrl: _pvVisualUrl });
            scrollToPreview();
          }
        } else if (matchedProduct && matchedProduct.featuredImage) {
          setConfiguratorPreviewImage(matchedProduct.featuredImage, { persistOrderPreview: false });
          scrollToPreview();
        }
        if (product.variants && product.variants.length) {
          state.variantId = product.variants[0].id;
          state.variant = product.variants[0];
          updateAvailability();
        }
        var ctaStep2 = $('mp-cta-step2');
        if (ctaStep2) ctaStep2.disabled = false;

        if (_pendingRestore && _pendingRestore.productHandle === handle) {
          var r = _pendingRestore;
          _pendingRestore = null;
          if (r.selectedOptions) state.selectedOptions = r.selectedOptions;
          if (r.step >= 3) {
            buildOptionsUI(product);
            goToStep(3);
          } else {
            goToStep(r.step || 2);
          }
          applyRestoredStatics(r);
        } else if (_pendingUrlPreset && _pendingUrlPreset.productHandle === handle) {
          var preset = _pendingUrlPreset;
          _pendingUrlPreset = null;
          if (preset.productCategory) state.productCategory = preset.productCategory;
          if (preset.step >= 3) {
            buildOptionsUI(product, preset.optionValuesByName);
            goToStep(3);
          } else if (preset.step && preset.step > 1) {
            goToStep(preset.step);
          }
          applyUrlPresetStatics(preset);
          updateSubtotals();
        } else {
          updateSubtotals();
        }
      })
      .catch(function (err) {
        console.error('Failed to fetch product:', err);
      });

    updateSubtotals();
  }

  /* --------------------------------------------------------------------------------
     Step 2 - Canvas category selection
  -------------------------------------------------------------------------------- */
  function selectCategory(category) {
    state.productCategory = category;
    state.canvasFrameChoice = null;
    state.productHandle = null;
    state.product = null;
    state.variantId = null;
    state.variant = null;
    var btn = document.querySelector('.product-picker__item--category[data-category="' + category + '"]');
    state.categoryMinPrice = btn ? parseInt(btn.dataset.minPrice, 10) || 0 : 0;

    document.querySelectorAll('.product-picker__item, .product-picker__item--category').forEach(function (btn) {
      var selected = btn.dataset.category === category;
      btn.classList.toggle('selected', selected);
      btn.setAttribute('aria-selected', selected ? 'true' : 'false');
    });

    var categoryNames = { canvas: 'Canvas', paper: 'Fine Art Paper' };
    var previewName = $('mp-preview-style-name');
    if (previewName) previewName.textContent = categoryNames[category] || '';

    var ctaStep2 = $('mp-cta-step2');
    if (ctaStep2) ctaStep2.disabled = false;

    var _catPreviewId = (window.MakePortraitCategoryPreviewVariants || {})[category];
    if (_catPreviewId) {
      var _catPreviews = (window.MakePortraitStylePreviews || {})[_catPreviewId] || {};
      var _catBucket   = _catPreviews[state.styleId] || {};
      var _catUrl      = _catBucket['default'] || (state.style && state.style.imageUrl) || null;
      var _catVisualUrl = _catBucket['default_visualizer'] || _catBucket['visualizer'] || _catUrl;
      if (_catUrl) {
        setConfiguratorPreviewImage(_catUrl, { persistOrderPreview: false, visualPreviewUrl: _catVisualUrl });
        scrollToPreview();
      }
    }

    updateSubtotals();
  }

  /* --------------------------------------------------------------------------------
     Step 3 - Canvas frame toggle
  -------------------------------------------------------------------------------- */
  function resetOptionsLayout() {
    var c2 = $('mp-options-container-2');
    var borderGroup  = $('mp-border-group');
    var petNameGroup = $('mp-pet-name-group');
    if (c2) c2.innerHTML = '';
    if (borderGroup)  borderGroup.hidden  = false;
    if (petNameGroup) petNameGroup.hidden = false;
  }

  function buildCanvasFrameUI() { buildFrameUI(CANVAS_HANDLES); }

  /* --------------------------------------------------------------------------------
     Step 3 - Canvas frame toggle
  -------------------------------------------------------------------------------- */
  function buildFrameUI(handles, initialChoice, initialSelections) {
    var container = $('mp-options-container');
    var loading = $('mp-options-loading');
    if (!container) return;

    resetOptionsLayout();
    container.innerHTML = '<p class="make-portrait__loading">Loading\u2026</p>';
    if (loading) loading.remove();

    var borderGroup = $('mp-border-group');
    if (borderGroup) borderGroup.hidden = true;

    var frameChoice = initialChoice === 'unframed' ? 'unframed' : 'framed';
    state.canvasFrameChoice = frameChoice;
    state.product = null;
    state.variantId = null;
    state.variant = null;
    state.selectedOptions = {};

    var ctaStep3 = $('mp-cta-step3');
    if (ctaStep3) ctaStep3.disabled = true;

    selectFrameProduct(handles, frameChoice, initialSelections);
  }

  function selectFrameProduct(handles, choice, initialSelections) {
    state.canvasFrameChoice = choice;
    var handle = choice === 'framed' ? handles.framed : handles.unframed;
    var ctaStep3 = $('mp-cta-step3');
    if (ctaStep3) ctaStep3.disabled = true;

    // Preserve current option values keyed by option NAME so they survive
    // across products that may have different option orderings (e.g. position mismatch)
    var previousSelections = {};
    if (state.product) {
      normalizeOptions(state.product.options).forEach(function (opt) {
        var val = state.selectedOptions[opt.position];
        if (val !== undefined) previousSelections[opt.name.toLowerCase()] = val;
      });
    }
    if (initialSelections) {
      Object.keys(initialSelections).forEach(function (key) {
        previousSelections[key.toLowerCase()] = initialSelections[key];
      });
    }

    if (!handle) {
      var c = $('mp-options-container');
      if (c) c.innerHTML = '<p class="make-portrait__error-note">Product handle not configured.</p>';
      return;
    }

    fetch('/products/' + handle + '.js')
      .then(function (r) { return r.json(); })
      .then(function (product) {
        state.productHandle = handle;
        state.product = product;
        state.variantId = null;
        state.variant = null;
        state.selectedOptions = {};
        renderFrameUI(product, handles, choice, previousSelections);
        if (ctaStep3) ctaStep3.disabled = false;
        updateSubtotals();
      })
      .catch(function (err) {
        console.error('Failed to fetch product:', err);
        var c = $('mp-options-container');
        if (c) c.innerHTML = '<p class="make-portrait__error-note">Failed to load product.</p>';
      });
  }

  function renderFrameUI(product, handles, currentChoice, previousSelections) {
    var container = $('mp-options-container');
    if (!container) return;
    container.innerHTML = '';
    var container2 = $('mp-options-container-2');
    if (container2) container2.innerHTML = '';

    var opts = normalizeOptions(product.options);
    var sizeOpts  = opts.filter(function (o) { return o.name.toLowerCase() === 'size'; });
    var otherOpts = opts.filter(function (o) { return o.name.toLowerCase() !== 'size'; });

    // 1. Size first
    sizeOpts.forEach(function (opt) { appendOptionGroup(opt, product, container, previousSelections); });

    // 2. Frame toggle
    var group = document.createElement('div');
    group.className = 'make-portrait__option-group';
    var lbl = document.createElement('span');
    lbl.className = 'make-portrait__option-label';
    lbl.textContent = 'Framing';
    group.appendChild(lbl);
    var grid = document.createElement('div');
    grid.className = 'option-btn-grid';
    grid.dataset.optionName = 'frame';
    ['framed', 'unframed'].forEach(function (choice) {
      var label = choice === 'unframed' ? 'Unframed' : 'Framed';
      var btn = document.createElement('button');
      btn.className = 'option-btn' + (choice === currentChoice ? ' selected' : '');
      btn.type = 'button';
      var frameImgUrl = optionImageUrl('frame', choice);
      if (frameImgUrl) {
        applyImageToBtn(btn, frameImgUrl, label);
      } else {
        btn.textContent = label;
      }
      btn.addEventListener('click', function () {
        grid.querySelectorAll('.option-btn').forEach(function (b) { b.classList.remove('selected'); });
        btn.classList.add('selected');
        selectFrameProduct(handles, choice);
      });
      grid.appendChild(btn);
    });
    group.appendChild(grid);
    container.appendChild(group);

    // 3. Frame Color and other options go after Dogs Name
    var container2 = $('mp-options-container-2');
    otherOpts.forEach(function (opt) { appendOptionGroup(opt, product, container2 || container, previousSelections); });

    matchVariant(product);
  }

  function optionImageUrl(optName, value) {
    var map = window.MakePortraitOptionImages || {};
    function slug(s) {
      return String(s).toLowerCase()
        .replace(/\u00D7/g, 'x')
        .replace(/[\u2033"']/g, '')
        .replace(/ /g, '-');
    }
    var key = slug(optName) + '-' + slug(value);
    return map[key] || null;
  }

  function getSizeDimensions(value) {
    var s = String(value).replace(/\u00D7/g, 'x').replace(/[\u2033"']/g, '').trim();
    var isCm = /cm/i.test(s);
    var parts = s.split('x');
    if (parts.length !== 2) return null;
    var a = parseFloat(parts[0]);
    var b = parseFloat(parts[1]);
    if (isNaN(a) || isNaN(b)) return null;

    var key = Math.round(a) + 'x' + Math.round(b);
    var handle = state.productHandle || '';
    var canvasHandles = window.MakePortraitCanvasHandles || {};
    var sizeOverrides = null;

    if (!isCm && handle === canvasHandles.unframed) {
      sizeOverrides = {
        '8x10':  { cm: '20 \u00D7 25 cm', inches: '7.9 \u00D7 9.8 in' },
        '12x16': { cm: '30 \u00D7 40 cm', inches: '11.8 \u00D7 15.7 in' },
        '20x28': { cm: '51 \u00D7 71 cm', inches: '20.1 \u00D7 28.0 in' }
      };
    } else if (!isCm && handle === canvasHandles.framed) {
      sizeOverrides = {
        '8x10':  { cm: '23 \u00D7 28 cm', inches: '9.1 \u00D7 11.0 in' },
        '12x16': { cm: '33 \u00D7 43 cm', inches: '13.0 \u00D7 16.9 in' },
        '20x28': { cm: '54 \u00D7 74 cm', inches: '21.3 \u00D7 29.1 in' }
      };
    } else if (isCm && handle === FRAMED_POSTER_HANDLE) {
      sizeOverrides = {
        '21x30': { cm: '24 \u00D7 33 cm', inches: '9.4 \u00D7 13.0 in' },
        '30x40': { cm: '33 \u00D7 43 cm', inches: '13.0 \u00D7 16.9 in' },
        '50x70': { cm: '54 \u00D7 74 cm', inches: '21.3 \u00D7 29.1 in' }
      };
    }

    if (sizeOverrides && sizeOverrides[key]) {
      return sizeOverrides[key];
    }

    var inchStr, cmStr;
    if (isCm) {
      cmStr = Math.round(a) + '\u00D7' + Math.round(b) + ' cm';
      inchStr = Math.round(a / 2.54) + '\u00D7' + Math.round(b / 2.54) + '\u2033';
    } else {
      inchStr = Math.round(a) + '\u00D7' + Math.round(b) + '\u2033';
      cmStr = Math.round(a * 2.54) + '\u00D7' + Math.round(b * 2.54) + ' cm';
    }
    return { inches: inchStr, cm: cmStr };
  }

  function applyImageToBtn(btn, imgUrl, label) {
    btn.classList.add('option-btn--with-img');
    var img = document.createElement('img');
    img.className = 'option-btn__img';
    img.src = imgUrl;
    img.alt = label;
    img.onerror = function () {
      btn.classList.remove('option-btn--with-img');
      btn.innerHTML = '';
      btn.textContent = label;
    };
    var span = document.createElement('span');
    span.className = 'option-btn__label';
    span.textContent = label;
    btn.appendChild(img);
    btn.appendChild(span);
  }

  function initCustomOptionImages() {
    document.querySelectorAll('.option-btn-grid[data-option-name]').forEach(function (grid) {
      var optName = grid.dataset.optionName;
      grid.querySelectorAll('.option-btn[data-value]').forEach(function (btn) {
        var value = btn.dataset.value;
        var imgUrl = optionImageUrl(optName, value);
        var extraUsd = btn.dataset.extraUsd;
        var originalText = btn.textContent.trim();
        btn.textContent = '';
        if (imgUrl) {
          applyImageToBtn(btn, imgUrl, originalText);
        } else {
          var textSpan = document.createElement('span');
          textSpan.textContent = originalText;
          btn.appendChild(textSpan);
        }
        if (extraUsd) {
          var extraEl = document.createElement('span');
          extraEl.className = 'option-btn__extra-price';
          extraEl.textContent = '+' + formatMoney(Math.round(parseFloat(extraUsd) * EXTRA_PET_PRICE / EXTRA_PET_USD));
          btn.appendChild(extraEl);
        }
      });
    });
    // Update pet name fee display amount
    var feeAmount = $('mp-pet-name-fee-amount');
    if (feeAmount) feeAmount.textContent = '+ ' + formatMoney(PET_NAME_PRICE);
  }

  function initStep4Pricing(rate) {
    PRINTS_BASE_PRICE  = Math.round(PRINTS_BASE_EUR  * rate) * 100;
    PRINTS_EXTRA_PRICE = Math.round(PRINTS_EXTRA_EUR * rate) * 100;

    // Prints buttons
    for (var i = 1; i <= 4; i++) {
      var printsBtn = document.querySelector('.option-btn[data-prints="' + i + '"]');
      if (!printsBtn) continue;
      var price = PRINTS_BASE_PRICE + (i - 1) * PRINTS_EXTRA_PRICE;
      printsBtn.innerHTML = '';
      var countSpan = document.createElement('span');
      countSpan.textContent = i + ' pc' + (i > 1 ? 's' : '');
      countSpan.className = 'option-btn__count';
      var priceSpan = document.createElement('span');
      priceSpan.className = 'option-btn__extra-price';
      priceSpan.textContent = '+ ' + formatMoney(price);
      printsBtn.appendChild(countSpan);
      printsBtn.appendChild(priceSpan);
    }

    // Prints price label (shown in addon header when grid visible)
    var printsPriceEl = $('mp-prints-price');
    if (printsPriceEl) printsPriceEl.textContent = '+ ' + formatMoney(PRINTS_BASE_PRICE);
    var printCustomPriceDefault = document.querySelector('.make-portrait__prints-custom-price');
    if (printCustomPriceDefault) {
      var defaultPrice = PRINTS_BASE_PRICE + 4 * PRINTS_EXTRA_PRICE;
      printCustomPriceDefault.textContent = '+ ' + formatMoney(defaultPrice);
    }

    // Addon prices
    document.querySelectorAll('.addon-item__check[data-addon-eur]').forEach(function (check) {
      var converted = Math.round(parseFloat(check.dataset.addonEur || 0) * rate) * 100;
      check.dataset.addonPrice = converted / 100;
      var priceEl = check.closest('.addon-item').querySelector('.addon-item__price');
      if (priceEl) priceEl.textContent = '+ ' + formatMoney(converted);
    });
    // Donation button labels
    document.querySelectorAll('.donation-card__amounts .option-btn[data-donation-eur]').forEach(function (btn) {
      var eurUnits = parseInt(btn.dataset.donationEur || 0, 10) / 100;
      var converted = Math.round(eurUnits * rate) * 100;
      btn.dataset.donation = converted;
      btn.textContent = formatMoney(converted);
    });
  }

  function normalizeOptions(rawOptions) {
    return (rawOptions || []).map(function (opt, idx) {
      return {
        name:     typeof opt === 'object' ? (opt.name || '') : opt,
        position: typeof opt === 'object' ? ((opt.position || idx + 1) - 1) : idx
      };
    });
  }

  function normalizePresetOptionValue(value) {
    return String(value || '')
      .toLowerCase()
      .replace(/\u00D7/g, 'x')
      .replace(/[\u2033"']/g, '')
      .replace(/\s+/g, '')
      .replace(/-/g, '');
  }

  function matchPresetOptionValue(values, presetValue) {
    if (!presetValue) return null;
    if (values.indexOf(presetValue) !== -1) return presetValue;

    var normalizedPreset = normalizePresetOptionValue(presetValue);
    for (var i = 0; i < values.length; i++) {
      if (normalizePresetOptionValue(values[i]) === normalizedPreset) return values[i];
    }
    return null;
  }

  function appendOptionGroup(opt, product, container, previousSelections) {
    var group = document.createElement('div');
    group.className = 'make-portrait__option-group';
    var label = document.createElement('span');
    label.className = 'make-portrait__option-label';
    var optionLabelNames = { 'color': 'Frame Color' };
    label.textContent = optionLabelNames[opt.name.toLowerCase()] || opt.name;
    group.appendChild(label);
    var grid = document.createElement('div');
    grid.className = 'option-btn-grid';
    grid.dataset.optionName = opt.name.toLowerCase();

    var seen = {}, values = [];
    product.variants.forEach(function (v) {
      var val = v.options[opt.position];
      if (!seen[val]) { seen[val] = true; values.push(val); }
    });

    if (opt.name.toLowerCase() === 'color') {
      values.sort(function (a, b) {
        var order = function (v) {
          var l = v.toLowerCase();
          if (l.includes('black')) return 0;
          if (l.includes('white')) return 1;
          return 2;
        };
        return order(a) - order(b);
      });
    }

    var prevValue = previousSelections && previousSelections[opt.name.toLowerCase()];
    var matchedPrevValue = matchPresetOptionValue(values, prevValue);
    var hasPrev = matchedPrevValue !== null;

    values.forEach(function (value, vIdx) {
      var _defaultIdx = opt.name.toLowerCase() === 'size' ? Math.floor(values.length / 2) : 0;
      var isSelected = hasPrev ? (value === matchedPrevValue) : (vIdx === _defaultIdx);
      var btn = document.createElement('button');
      var optNameLower = opt.name.toLowerCase();
      btn.className = 'option-btn' +
        (optNameLower === 'size' ? ' option-btn--size' : '') +
        (optNameLower === 'color' ? ' option-btn--small' : '') +
        (isSelected ? ' selected' : '');
      btn.type = 'button';
      btn.dataset.optionIndex = opt.position;
      btn.dataset.value = value;
      var imgUrl = optionImageUrl(opt.name, value);
      if (opt.name.toLowerCase() === 'size') {
        // Size button: always show inch + cm + price stacked; image optional
        if (imgUrl) {
          var sImg = document.createElement('img');
          sImg.className = 'option-btn__img';
          sImg.src = imgUrl;
          sImg.alt = value;
          sImg.onerror = function () { sImg.remove(); };
          btn.appendChild(sImg);
        }
        var sLabel = document.createElement('span');
        sLabel.className = 'option-btn__label';
        var dims = getSizeDimensions(value);
        if (dims) {
          var sCm = document.createElement('span');
          sCm.className = 'option-btn__size-cm';
          sCm.textContent = dims.cm;
          sLabel.appendChild(sCm);
        }
        var sInch = document.createElement('span');
        sInch.className = 'option-btn__size-inch';
        sInch.textContent = dims ? dims.inches : value;
        sLabel.appendChild(sInch);
        var sizePrice = null;
        product.variants.forEach(function (v) {
          if (v.options[opt.position] === value && (sizePrice === null || v.price < sizePrice)) {
            sizePrice = v.price;
          }
        });
        if (sizePrice !== null) {
          var sPrice = document.createElement('span');
          sPrice.className = 'option-btn__size-price';
          sPrice.textContent = formatMoney(sizePrice);
          sLabel.appendChild(sPrice);
        }
        btn.appendChild(sLabel);
      } else if (opt.name.toLowerCase() === 'color') {
        var displayName = COLOR_DISPLAY_NAMES[value.toLowerCase()] || value;
        var globalMinPrice = Math.min.apply(null, product.variants.map(function (v) { return v.price; }));
        var colorMinPrice = null;
        product.variants.forEach(function (v) {
          if (v.options[opt.position] === value && (colorMinPrice === null || v.price < colorMinPrice)) colorMinPrice = v.price;
        });
        var delta = colorMinPrice !== null ? colorMinPrice - globalMinPrice : 0;
        if (imgUrl) {
          applyImageToBtn(btn, imgUrl, displayName);
        } else {
          var cLabel = document.createElement('span');
          cLabel.className = 'option-btn__label';
          cLabel.textContent = displayName;
          btn.appendChild(cLabel);
        }
        if (delta > 0) {
          var cDelta = document.createElement('span');
          cDelta.className = 'option-btn__color-delta';
          cDelta.textContent = '+ ' + formatMoney(delta);
          btn.appendChild(cDelta);
        }
      } else if (imgUrl) {
        applyImageToBtn(btn, imgUrl, value);
      } else {
        btn.textContent = value;
      }
      if (isSelected) state.selectedOptions[opt.position] = value;
      btn.addEventListener('click', function () {
        grid.querySelectorAll('.option-btn').forEach(function (b) { b.classList.remove('selected'); });
        btn.classList.add('selected');
        state.selectedOptions[opt.position] = value;
        matchVariant(product);
      });
      grid.appendChild(btn);
    });

    group.appendChild(grid);
    container.appendChild(group);
  }

  /* --------------------------------------------------------------------------------
     Step 3 - Options
  -------------------------------------------------------------------------------- */
  function buildOptionsUI(product, initialSelections) {
    var container = $('mp-options-container');
    var loading = $('mp-options-loading');
    if (!container || !product) return;

    container.innerHTML = '';
    if (loading) loading.remove();

    resetOptionsLayout();
    var prevSel = {};
    if (initialSelections) {
      Object.keys(initialSelections).forEach(function (key) {
        prevSel[key.toLowerCase()] = initialSelections[key];
      });
    }
    normalizeOptions(product.options || []).forEach(function (opt) {
      var val = state.selectedOptions[opt.position];
      if (val !== undefined) prevSel[opt.name.toLowerCase()] = val;
    });
    state.selectedOptions = {};

    if (FRAMED_POSTER_HANDLE && product.handle === FRAMED_POSTER_HANDLE) {
      buildPosterUI(product, container, prevSel);
    } else {
      var borderGroup  = $('mp-border-group');
      var petNameGroup = $('mp-pet-name-group');
      if (borderGroup)  borderGroup.hidden  = true;
      if (petNameGroup) petNameGroup.hidden = true;
      buildVariantOptions(product, container, prevSel);
    }
  }

  function buildPaperDetailsThenGoToStep3(resetPosition) {
    var handle = state.productHandle || FRAMED_POSTER_HANDLE;
    var ctaStep2 = $('mp-cta-step2');

    if (!handle) return;

    if (state.product && state.product.handle === handle) {
      buildOptionsUI(state.product);
      goToStep(3);
      syncPreviewNameForStep();
      if (resetPosition) jumpToConfiguratorStart();
      return;
    }

    if (ctaStep2) ctaStep2.disabled = true;
    fetch('/products/' + handle + '.js')
      .then(function (r) { return r.json(); })
      .then(function (product) {
        state.productCategory = 'paper';
        state.productHandle = handle;
        state.product = product;
        state.variantId = null;
        state.variant = null;
        state.selectedOptions = {};
        buildOptionsUI(product);
        goToStep(3);
        syncPreviewNameForStep();
        if (resetPosition) jumpToConfiguratorStart();
      })
      .catch(function (err) {
        console.error('Failed to fetch paper product:', err);
        var c = $('mp-options-container');
        if (c) c.innerHTML = '<p class="make-portrait__error-note">Failed to load product.</p>';
      })
      .finally(function () {
        if (ctaStep2) ctaStep2.disabled = false;
      });
  }

  function buildVariantOptions(product, container, previousSelections) {
    if (!product.options || product.options.length === 0) {
      if (product.variants && product.variants.length) {
        state.variantId = product.variants[0].id;
        state.variant = product.variants[0];
        updateAvailability();
      }
      return;
    }
    var opts = normalizeOptions(product.options);
    opts.sort(function (a, b) {
      return (a.name.toLowerCase() === 'size' ? 0 : 1) - (b.name.toLowerCase() === 'size' ? 0 : 1) || a.position - b.position;
    });
    opts.forEach(function (opt) { appendOptionGroup(opt, product, container, previousSelections); });
    matchVariant(product);
  }

  function buildPosterUI(product, container, previousSelections) {
    var container2 = $('mp-options-container-2');
    var opts = normalizeOptions(product.options);
    var sizeOpts  = opts.filter(function (o) { return o.name.toLowerCase() === 'size'; });
    var colorOpts = opts.filter(function (o) { return o.name.toLowerCase() === 'color'; });

    // 1. Size
    sizeOpts.forEach(function (opt) { appendOptionGroup(opt, product, container, previousSelections || {}); });

    // 2. Border (static built-in - shown via resetOptionsLayout)
    // 3. Framing - always "Framed", display only (no choice)
    var framingGroup = document.createElement('div');
    framingGroup.className = 'make-portrait__option-group';
    var framingLabel = document.createElement('span');
    framingLabel.className = 'make-portrait__option-label';
    framingLabel.textContent = 'Framing';
    framingGroup.appendChild(framingLabel);
    var framingGrid = document.createElement('div');
    framingGrid.className = 'option-btn-grid';
    framingGrid.dataset.optionName = 'frame';
    var framedBtn = document.createElement('button');
    framedBtn.className = 'option-btn selected';
    framedBtn.type = 'button';
    var frameImgUrl = optionImageUrl('frame', 'framed');
    if (frameImgUrl) {
      applyImageToBtn(framedBtn, frameImgUrl, 'Framed');
    } else {
      framedBtn.textContent = 'Framed';
    }
    framingGrid.appendChild(framedBtn);
    framingGroup.appendChild(framingGrid);
    var secondaryContainer = container2 || container;
    secondaryContainer.appendChild(framingGroup);

    // 4. Dogs Name (static built-in - shown via resetOptionsLayout)

    // 5. Frame Color in container-2
    colorOpts.forEach(function (opt) { appendOptionGroup(opt, product, secondaryContainer, previousSelections || {}); });

    matchVariant(product);
    var ctaStep3 = $('mp-cta-step3');
    if (ctaStep3) ctaStep3.disabled = false;
    updateSubtotals();
  }

  function matchVariant(product) {
    if (!product) return;
    var variant = null;
    for (var i = 0; i < product.variants.length; i++) {
      var v = product.variants[i];
      var match = true;
      for (var idx = 0; idx < v.options.length; idx++) {
        if (state.selectedOptions[idx] !== v.options[idx]) {
          match = false;
          break;
        }
      }
      if (match) { variant = v; break; }
    }

    if (variant) {
      state.variantId = variant.id;
      state.variant = variant;
      updateQualityIndicator();

      // Update preview with selected size (cm first, then inches)
      var previewName = $('mp-preview-style-name');
      if (previewName) {
        var sizeOpts = normalizeOptions(state.product ? state.product.options : [])
          .filter(function (o) { return o.name.toLowerCase() === 'size'; });
        var sizeValue = sizeOpts.length ? state.selectedOptions[sizeOpts[0].position] : null;
        var dims = sizeValue ? getSizeDimensions(sizeValue) : null;
        if (dims) {
          previewName.innerHTML =
            '<span class="preview-size-cm">' + dims.cm + '</span>' +
            '<span class="preview-size-inch">' + dims.inches + '</span>';
        } else {
          previewName.textContent = sizeValue || '';
        }
      }

      updatePreviewImage();
      updateAvailability();
      syncPreviewNameForStep();
    }

    updateSubtotals();
  }

  /* --------------------------------------------------------------------------------
     Order summary (step 4)
  -------------------------------------------------------------------------------- */
  function getSelectedLabel(gridId) {
    var btn = document.querySelector('#' + gridId + ' .option-btn.selected');
    return btn ? btn.textContent.trim() : '';
  }

  function isStaticOptionGroupEnabled(groupId) {
    var group = $(groupId);
    return !!group && !group.hidden;
  }

  function getEffectiveBorder() {
    return isStaticOptionGroupEnabled('mp-border-group') ? state.border : 'no-border';
  }

  function getSelectedBorderLabel() {
    return isStaticOptionGroupEnabled('mp-border-group') ? getSelectedLabel('mp-border-grid') : '';
  }

  function getEffectivePetName() {
    return isStaticOptionGroupEnabled('mp-pet-name-group') ? (state.petName || '') : '';
  }

  function getSelectedSizeValue() {
    if (!state.product) return null;
    var sizeOpts = normalizeOptions(state.product.options)
      .filter(function (o) { return o.name.toLowerCase() === 'size'; });
    return sizeOpts.length ? state.selectedOptions[sizeOpts[0].position] : null;
  }

  function getFramingLabel() {
    if (state.canvasFrameChoice) {
      return state.canvasFrameChoice === 'framed' ? 'Framed' : 'Unframed';
    }
    if (state.productHandle === FRAMED_POSTER_HANDLE) {
      return 'Framed';
    }
    return '';
  }

  function getProductSummaryLabel() {
    var canvasHandles = window.MakePortraitCanvasHandles || {};
    if (state.productCategory === 'canvas' || state.productHandle === canvasHandles.unframed || state.productHandle === canvasHandles.framed) {
      return 'Canvas';
    }
    var categoryNames = { canvas: 'Canvas', paper: 'Fine Art Paper' };
    if (state.productCategory) return categoryNames[state.productCategory] || state.productCategory;
    if (state.product) return state.product.title;
    return '';
  }

  function getConfigurationDetails(useHtml) {
    var details = [];
    var sizeValue = getSelectedSizeValue();

    if (sizeValue) {
      var dims = getSizeDimensions(sizeValue);
      details.push(dims
        ? (useHtml ? dims.cm + ' <span style="opacity:0.45">' + dims.inches + '</span>' : dims.cm + ' ' + dims.inches)
        : sizeValue);
    }

    var border = getSelectedBorderLabel();
    if (border) details.push(border);

    var framingLabel = getFramingLabel();
    if (framingLabel) details.push(framingLabel);

    if (state.variant && state.variant.options) {
      state.variant.options.forEach(function (o) {
        if (!o || o === 'Default Title') return;
        if (o === sizeValue) return;
        details.push(COLOR_DISPLAY_NAMES[o.toLowerCase()] || o);
      });
    }

    if (getEffectivePetName()) details.push(useHtml ? 'Add name' : 'Name: ' + getEffectivePetName());

    return details;
  }

  function buildSummary() {
    var container = $('mp-order-summary');
    if (!container) return;
    container.innerHTML = '';

    function addLine(label, value, elementClass) {
      var p = document.createElement('p');
      p.className = 'order-summary__line';
      if(elementClass){
        p.className += " "+elementClass;
      }
      p.innerHTML = label + ' \u2013 <strong>' + value + '</strong>';
      container.appendChild(p);
    }

    if (state.style) addLine('Style', state.style.name);

    var productSummaryLabel = getProductSummaryLabel();
    if (productSummaryLabel) addLine('Product', productSummaryLabel);

    if (state.step >= 3) {
      var details = getConfigurationDetails(true);
      if (details.length) addLine('Details', details.join(' | '));
    }

    var addonNames = [];
    document.querySelectorAll('.addon-item__check:checked').forEach(function (c) {
      if (c.dataset.addonName) addonNames.push(c.dataset.addonName);
    });
    var customizeItems = addonNames.slice();
    if (state.prints > 0) customizeItems.unshift('Add ' + state.prints + ' cop' + (state.prints === 1 ? 'y' : 'ies'));

    if (customizeItems.length) {
      var section = document.createElement('div');
      section.className = 'order-summary__section';
      var lbl = document.createElement('p');
      lbl.className = 'order-summary__section-label';
      lbl.textContent = 'Customize order';
      var val = document.createElement('p');
      val.className = 'order-summary__section-value';
      val.textContent = customizeItems.join(' | ');
      section.appendChild(lbl);
      section.appendChild(val);
      container.appendChild(section);
    }

    if (state.donation > 0) {
      addLine(window.MakePortraitDonationTitle || 'Donation', formatMoney(state.donation), "order-summary__line--donation");
    }
  }

  /* --------------------------------------------------------------------------------
     Option button groups (border, background, pet count)
  -------------------------------------------------------------------------------- */
  function initOptionGroup(gridId, stateKey) {
    var grid = $(gridId);
    if (!grid) return;
    grid.querySelectorAll('.option-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        grid.querySelectorAll('.option-btn').forEach(function (b) { b.classList.remove('selected'); });
        btn.classList.add('selected');
        var val = btn.dataset[stateKey];
        if (stateKey === 'petCount') {
          state.petCount = parseInt(val, 10);
          updateUploadCounter();
          updateOrderButton();
        } else {
          state[stateKey] = val;
        }
        updateSubtotals();
      });
    });
  }

  /* --------------------------------------------------------------------------------
     File upload
  -------------------------------------------------------------------------------- */
  function updateQualityIndicator() {
    var alertEl = $('mp-resolution-alert');
    var alertText = $('mp-resolution-alert-text');
    if (!alertEl) return;

    if (state.fileDimensions.size === 0) {
      alertEl.hidden = true;
      return;
    }

    var minResStr = window.MakePortraitMinResolutions && window.MakePortraitMinResolutions[state.variantId];
    if (!minResStr) {
      alertEl.hidden = true;
      return;
    }

    var parts = minResStr.split(/x/i);
    var minW = parseInt(parts[0], 10);
    var minH = parseInt(parts[1], 10);

    var allPass = true;
    state.fileDimensions.forEach(function (dims) {
      var pass = Math.max(dims.w, dims.h) >= Math.max(minW, minH) &&
                 Math.min(dims.w, dims.h) >= Math.min(minW, minH);
      if (!pass) allPass = false;
    });

    state.lowResPhoto = !allPass;
    alertEl.hidden = allPass;
    if (!allPass && alertText) {
      alertText.textContent = 'Uploaded photo resolution is too low. To achieve optimal print quality, use a photo with resolution at least ' + minW + ' \u00D7 ' + minH + ' px.';
    }
  }

  function updateUploadCounter() {
    var el = $('mp-upload-counter');
    if (!el) return;
    var required = state.petCount;
    if (state.files.length === 0 && state.pendingUploads === 0) {
      el.hidden = true;
      return;
    }
    el.hidden = false;
    el.textContent = state.photoUrls.length + ' / ' + required;
  }

  function updateOrderButton() {
    var btn = $('mp-cta-order');
    if (!btn) return;
    var required = state.petCount;
    var isReady = state.pendingUploads === 0
      && !(state.files.length > 0 && state.photoUrls.length === 0)
      && state.photoUrls.length >= required;

    btn.disabled = false;
    btn.classList.toggle('make-portrait__cta--upload-required', !isReady);

    if (state.pendingUploads > 0) {
      btn.textContent = 'Uploading photo\u2026';
    } else if (state.files.length > 0 && state.photoUrls.length === 0) {
      btn.textContent = 'Upload failed \u2014 retry photo';
    } else {
      btn.textContent = 'Order portrait';
    }
  }

  function uploadToCloudinary(file, previewEl, onSuccess) {
    var cfg = window.MakePortraitCloudinary;
    if (!cfg || !cfg.cloudName || !cfg.uploadPreset) {
      previewEl.classList.add('photo-preview--error');
      showUploadError('Photo upload is not configured. Please try again later.');
      updateOrderButton();
      return;
    }

    state.pendingUploads++;
    updateOrderButton();

    var spinner = document.createElement('div');
    spinner.className = 'photo-preview__spinner';
    previewEl.appendChild(spinner);

    var formData = new FormData();
    formData.append('file', file);
    formData.append('upload_preset', cfg.uploadPreset);

    fetch('https://api.cloudinary.com/v1_1/' + cfg.cloudName + '/image/upload', {
      method: 'POST',
      body: formData
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.secure_url) {
          if (previewEl.isConnected) {
            state.photoUrls.push(data.secure_url);
            previewEl.dataset.photoUrl = data.secure_url;
            if (typeof onSuccess === 'function') onSuccess(data);
          }
          spinner.remove();
        } else {
          spinner.classList.add('photo-preview__spinner--error');
          spinner.title = data.error ? data.error.message : 'Upload failed';
        }
      })
      .catch(function () {
        spinner.classList.add('photo-preview__spinner--error');
        spinner.title = 'Upload failed';
      })
      .finally(function () {
        state.pendingUploads = Math.max(0, state.pendingUploads - 1);
        updateUploadCounter();
        updateOrderButton();
      });
  }

  var ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/heic', 'image/heif'];
  var MAX_FILE_SIZE = 10 * 1024 * 1024; // 10 MB

  function getFileExtension(file) {
    var parts = String(file && file.name ? file.name : '').split('.');
    return parts.length > 1 ? parts.pop().toLowerCase() : '';
  }

  function isHeicFile(file) {
    var ext = getFileExtension(file);
    var type = String(file && file.type ? file.type : '').toLowerCase();
    return ext === 'heic' || ext === 'heif' ||
      type === 'image/heic' || type === 'image/heif' ||
      type === 'image/heic-sequence' || type === 'image/heif-sequence';
  }

  function isAllowedUploadFile(file) {
    var ext = getFileExtension(file);
    var type = String(file && file.type ? file.type : '').toLowerCase();
    return ALLOWED_TYPES.includes(type) ||
      ext === 'jpg' || ext === 'jpeg' || ext === 'png' ||
      ext === 'heic' || ext === 'heif';
  }

  function getCloudinaryPreviewUrl(url) {
    if (!url) return '';
    return String(url).replace('/upload/', '/upload/c_fill,h_180,w_180,q_auto,f_jpg/');
  }

  function setPreviewImage(preview, src) {
    if (!preview || !src) return;
    preview.querySelectorAll('img, .photo-preview__file-fallback').forEach(function (el) {
      el.remove();
    });
    var img = document.createElement('img');
    img.src = src;
    img.alt = 'Pet photo preview';
    var removeBtn = preview.querySelector('.photo-preview__remove');
    preview.insertBefore(img, removeBtn || preview.firstChild);
  }

  function getMinResolutionParts() {
    var minResStr = window.MakePortraitMinResolutions && window.MakePortraitMinResolutions[state.variantId];
    if (!minResStr) return null;

    var parts = minResStr.split(/x/i);
    var minW = parseInt(parts[0], 10);
    var minH = parseInt(parts[1], 10);
    if (!minW || !minH) return null;

    return { minResStr: minResStr, minW: minW, minH: minH };
  }

  function photoMeetsMinResolution(dims, minRes) {
    if (!dims || !minRes) return true;
    return Math.max(dims.w, dims.h) >= Math.max(minRes.minW, minRes.minH) &&
           Math.min(dims.w, dims.h) >= Math.min(minRes.minW, minRes.minH);
  }

  function formatPhotoResolution(dims) {
    if (!dims || !dims.w || !dims.h) return '';
    return Math.round(dims.w) + ' \u00D7 ' + Math.round(dims.h) + ' px';
  }

  function showUploadError(msg) {
    var el = $('mp-upload-error');
    if (!el) return;
    el.textContent = msg;
    el.hidden = false;
    setTimeout(function () { el.hidden = true; }, 5000);
  }

  function showUploadRequiredPopup() {
    var backdrop = $('mp-upload-required-backdrop');
    var banner   = $('mp-upload-required-banner');
    var okBtn    = $('mp-upload-required-ok');
    if (!banner) return;
    if (backdrop) backdrop.hidden = false;
    banner.hidden = false;
    function close() {
      if (backdrop) backdrop.hidden = true;
      banner.hidden = true;
      okBtn.removeEventListener('click', close);
      if (backdrop) backdrop.removeEventListener('click', close);
    }
    okBtn.addEventListener('click', close);
    if (backdrop) backdrop.addEventListener('click', close);
  }

  function showOutOfStockPopup() {
    var backdrop = $('mp-oos-backdrop');
    var banner   = $('mp-oos-banner');
    var okBtn    = $('mp-oos-ok');
    if (!banner) return;
    if (backdrop) backdrop.hidden = false;
    banner.hidden = false;
    function close() {
      if (backdrop) backdrop.hidden = true;
      banner.hidden = true;
      okBtn.removeEventListener('click', close);
      if (backdrop) backdrop.removeEventListener('click', close);
    }
    okBtn.addEventListener('click', close);
    if (backdrop) backdrop.addEventListener('click', close);
  }

  function showQualityPopup(minResStr, photoDims, onConfirm, onCancel) {
    var backdrop = $('mp-quality-backdrop');
    var banner   = $('mp-quality-banner');
    var detail   = $('mp-quality-banner-detail');
    var yesBtn   = $('mp-quality-yes');
    var noBtn    = $('mp-quality-no');
    if (!banner) { onConfirm(); return; }

    if (detail && minResStr) {
      var rp = minResStr.split(/x/i);
      var currentResolution = formatPhotoResolution(photoDims);
      detail.textContent = (currentResolution ? 'Your photo resolution is ' + currentResolution + '. ' : '') +
        'For best results, use a photo at least ' + rp[0] + ' \u00D7 ' + rp[1] + ' px.';
    }
    if (backdrop) backdrop.hidden = false;
    banner.hidden = false;

    function close() {
      if (backdrop) backdrop.hidden = true;
      banner.hidden = true;
      yesBtn.removeEventListener('click', handleYes);
      noBtn.removeEventListener('click', handleNo);
      if (backdrop) backdrop.removeEventListener('click', handleNo);
    }
    function handleYes() { close(); onConfirm(); }
    function handleNo()  { close(); onCancel();  }

    yesBtn.addEventListener('click', handleYes);
    noBtn.addEventListener('click', handleNo);
    if (backdrop) backdrop.addEventListener('click', handleNo);
  }

  function handleFiles(files) {
    var previews = $('mp-photo-previews');
    if (!previews) return;

    function removePreviewFile(file, preview) {
      var idx = state.files.indexOf(file);
      if (idx > -1) state.files.splice(idx, 1);
      if (preview.dataset.photoUrl) {
        var urlIdx = state.photoUrls.indexOf(preview.dataset.photoUrl);
        if (urlIdx > -1) state.photoUrls.splice(urlIdx, 1);
      }
      preview.remove();
      state.fileDimensions.delete(file);
      updateQualityIndicator();
      updateUploadCounter();
      updateOrderButton();
    }

    function createPreview(file, imageSrc, fallbackLabel) {
      var preview = document.createElement('div');
      preview.className = 'photo-preview';

      if (imageSrc) {
        var img = document.createElement('img');
        img.src = imageSrc;
        img.alt = 'Pet photo preview';
        preview.appendChild(img);
      } else {
        var fallback = document.createElement('span');
        fallback.className = 'photo-preview__file-fallback';
        fallback.textContent = fallbackLabel || 'FILE';
        preview.appendChild(fallback);
      }

      var removeBtn = document.createElement('button');
      removeBtn.className = 'photo-preview__remove';
      removeBtn.type = 'button';
      removeBtn.textContent = '\u00D7';
      removeBtn.setAttribute('aria-label', 'Remove photo');
      removeBtn.addEventListener('click', function () {
        removePreviewFile(file, preview);
      });
      preview.appendChild(removeBtn);

      return preview;
    }

    Array.from(files).forEach(function (file) {
      if (state.files.length >= state.petCount) {
        showUploadError('You can only upload ' + state.petCount + ' photo' + (state.petCount > 1 ? 's' : '') + ' for ' + state.petCount + ' pet' + (state.petCount > 1 ? 's' : '') + '.');
        return;
      }
      if (!isAllowedUploadFile(file)) {
        showUploadError('Unsupported file type: ' + file.name + '. Please use JPG, PNG or HEIC.');
        return;
      }
      if (file.size > MAX_FILE_SIZE) {
        showUploadError(file.name + ' is too large. Maximum file size is 10 MB.');
        return;
      }
      state.files.push(file);
      updateUploadCounter();

      if (isHeicFile(file)) {
        var heicPreview = createPreview(file, null, 'HEIC');
        previews.appendChild(heicPreview);
        uploadToCloudinary(file, heicPreview, function (data) {
          setPreviewImage(heicPreview, getCloudinaryPreviewUrl(data.secure_url));

          if (data.width && data.height) {
            var heicDims = { w: data.width, h: data.height };
            state.fileDimensions.set(file, heicDims);
            updateQualityIndicator();

            var minRes = getMinResolutionParts();
            if (minRes && !photoMeetsMinResolution(heicDims, minRes)) {
              showQualityPopup(
                minRes.minResStr,
                heicDims,
                function () { updateOrderButton(); },
                function () { removePreviewFile(file, heicPreview); }
              );
            }
          }
        });
        return;
      }

      var reader = new FileReader();
      reader.onload = function (e) {
        var preview = createPreview(file, e.target.result, null);
        previews.appendChild(preview);


        // Measure dimensions first; upload only after quality confirmation
        var dimImg = new Image();
        dimImg.onload = function () {
          var dims = { w: dimImg.naturalWidth, h: dimImg.naturalHeight };
          state.fileDimensions.set(file, dims);
          updateQualityIndicator();

          var minResStr = window.MakePortraitMinResolutions && window.MakePortraitMinResolutions[state.variantId];
          var qualityOk = true;
          if (minResStr) {
            var rp = minResStr.split(/x/i);
            var minW = parseInt(rp[0], 10);
            var minH = parseInt(rp[1], 10);
            qualityOk = Math.max(dims.w, dims.h) >= Math.max(minW, minH) &&
                        Math.min(dims.w, dims.h) >= Math.min(minW, minH);
          }

          if (qualityOk) {
            uploadToCloudinary(file, preview);
          } else {
            showQualityPopup(
              minResStr,
              dims,
              function () { uploadToCloudinary(file, preview); },
              function () {
                var idx = state.files.indexOf(file);
                if (idx > -1) state.files.splice(idx, 1);
                state.fileDimensions.delete(file);
                preview.remove();
                updateQualityIndicator();
                updateUploadCounter();
                updateOrderButton();
              }
            );
          }
        };
        dimImg.onerror = function () {
          preview.classList.add('photo-preview--error');
          showUploadError('Could not read this image. Please try another photo.');
          updateOrderButton();
        };
        dimImg.src = e.target.result;
      };
      reader.onerror = function () {
        showUploadError('Could not read this image. Please try another photo.');
        var idx = state.files.indexOf(file);
        if (idx > -1) state.files.splice(idx, 1);
        updateUploadCounter();
        updateOrderButton();
      };
      reader.readAsDataURL(file);
    });
  }

  /* --------------------------------------------------------------------------------
     Add to cart
  -------------------------------------------------------------------------------- */
  function addToCart() {
    if (!state.variantId) {
      showError('Please complete all options before ordering.');
      return;
    }

    var _avMap = window.MakePortraitAvailability || {};
    var _avStatus = (state.variantId && _avMap[state.variantId]) || 'in_stock';
    if (_avStatus === 'out_of_stock') { showOutOfStockPopup(); return; }

    if (state.photoUrls.length < state.petCount) {
      var uploadArea = $('mp-upload-area');
      if (uploadArea) uploadArea.scrollIntoView({ behavior: 'smooth', block: 'center' });
      showUploadRequiredPopup();
      return;
    }

    var btn = $('mp-cta-order');
    if (btn) { btn.disabled = true; btn.textContent = 'Adding to cart\u2026'; }
    hideError();

    var detailParts = getConfigurationDetails(false);
    var orderItemId = 'portrait-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10);
    var unitQuantity = state.prints > 0 ? state.prints + 1 : 1;

    var properties = {
      'Style': state.style ? state.style.name : '',
      'Product': getProductSummaryLabel(),
      'Details': detailParts.join(' | '),
      '_baf_order_type': 'portrait',
      '_baf_order_item_id': orderItemId,
      '_baf_order_unit_quantity': String(unitQuantity)
    };

    var checkedAddons = [];
    document.querySelectorAll('.addon-item__check:checked').forEach(function (c) {
      if (c.dataset.addonName) checkedAddons.push(c.dataset.addonName);
    });
    var customizeCart = checkedAddons.slice();
    if (state.prints > 0) customizeCart.unshift('Add ' + state.prints + ' cop' + (state.prints === 1 ? 'y' : 'ies'));
    if (customizeCart.length) properties['Customize order'] = customizeCart.join(' | ');

    var displayDonation = Math.round(state.donation);
    var shopDonation = toShopCurrencyCents(displayDonation);
    if (displayDonation > 0) {
      properties['_donation'] = String(displayDonation);
      properties['_donation_shop'] = String(shopDonation);
    }

    if (state.previewImageUrl) {
      properties['_preview_image'] = state.previewImageUrl;
    }

    var displayTotal = Math.round(getCustomTotalPrice());

    // Keep the legacy presentment price for deploy compatibility; the current
    // Cart Transform uses the shop-currency value and converts it at checkout.
    properties['_custom_price'] = String(displayTotal);
    properties['_custom_price_shop'] = String(toShopCurrencyCents(displayTotal));

    var newOrderItem = {
      line_item_id: "",
      order_item_id: orderItemId,
      style_id: state.styleId || null,
      printful_variant_id: (window.MakePortraitPrintfulVariants && state.variantId)
        ? (window.MakePortraitPrintfulVariants[state.variantId] || null)
        : null,
      pasparta: state.border === 'white-border',
      pet_name: state.petName || '',
      photos: state.photoUrls,
      portrait_font: null,
      quantity: unitQuantity,
      low_resolution: state.lowResPhoto || undefined,
      skip_the_queue: checkedAddons.includes('Skip the queue')
    };

    var doRedirect = function () {
      clearDraft();
      document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true, detail: { data: {} } }));
      var drawer = document.querySelector('cart-drawer-component');
      if (drawer && typeof drawer.open === 'function') {
        drawer.open();
      } else {
        window.location.href = '/cart';
      }
      if (btn) { btn.disabled = false; btn.textContent = 'Order portrait'; }
    };
    var doError = function (msg) {
      if (btn) { btn.disabled = false; btn.textContent = 'Order portrait'; }
      showError(msg || 'An error occurred. Please try again.');
    };

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: state.variantId, quantity: 1, properties: properties })
    })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
      .then(function (result) {
        if (!result.ok) { doError(result.data.description || result.data.message); return; }

        if (!window.BAFOrderSync || typeof window.BAFOrderSync.syncCartOrder !== 'function') {
          doError('Portrait added, but order data update failed.');
          return;
        }

        return window.BAFOrderSync.syncCartOrder({ additionalItems: [newOrderItem] })
          .then(doRedirect)
          .catch(function () { doError('Portrait added, but order data update failed.'); });
      })
      .catch(function () { doError(); });
  }

  function showError(msg) {
    var el = $('mp-cart-error');
    if (!el) return;
    el.textContent = msg;
    el.hidden = false;
  }

  function hideError() {
    var el = $('mp-cart-error');
    if (el) el.hidden = true;
  }

  /* --------------------------------------------------------------------------------
     Tabs (left panel)
  -------------------------------------------------------------------------------- */
  function switchTab(tabId) {
    document.querySelectorAll('.tab-nav__btn').forEach(function (b) {
      var active = b.dataset.tab === tabId;
      b.classList.toggle('active', active);
      b.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    document.querySelectorAll('.tab-panel').forEach(function (p) {
      p.hidden = p.dataset.tab !== tabId;
    });
  }

  function initTabs() {
    document.querySelectorAll('.tab-nav__btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        switchTab(btn.dataset.tab);
      });
    });

    var artistBadge = $('mp-artist-badge');
    if (artistBadge) {
      artistBadge.addEventListener('click', function () {
        switchTab('artist');
      });
      artistBadge.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        switchTab('artist');
      });
    }
  }

  /* --------------------------------------------------------------------------------
     Draft save / restore
  -------------------------------------------------------------------------------- */
  var DRAFT_KEY    = 'mp_draft';
  var DRAFT_EXPIRY = 30 * 24 * 60 * 60 * 1000;
  var _pendingRestore = null;
  var _pendingUrlPreset = null;

  function saveDraft() {
    if (!state.styleId) return;
    try {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({
        ts:                Date.now(),
        styleId:           state.styleId,
        productHandle:     state.productHandle,
        productCategory:   state.productCategory,
        canvasFrameChoice: state.canvasFrameChoice,
        selectedOptions:   state.selectedOptions,
        border:            state.border,
        petName:           state.petName,
        photoUrls:         state.photoUrls,
        step:              state.step
      }));
    } catch (e) {}
  }

  function loadDraft() {
    try {
      var raw = localStorage.getItem(DRAFT_KEY);
      if (!raw) return null;
      var d = JSON.parse(raw);
      if (!d || !d.styleId || Date.now() - d.ts > DRAFT_EXPIRY) {
        localStorage.removeItem(DRAFT_KEY);
        return null;
      }
      return d;
    } catch (e) { return null; }
  }

  function clearDraft() {
    try { localStorage.removeItem(DRAFT_KEY); } catch (e) {}
  }

  function applyRestoredStatics(saved) {
    if (saved.border) {
      var grid = $('mp-border-grid');
      if (grid) {
        grid.querySelectorAll('.option-btn').forEach(function (b) {
          b.classList.toggle('selected', b.dataset.border === saved.border);
        });
        state.border = saved.border;
      }
    }
    if (saved.petName) {
      var inp = $('mp-pet-name');
      if (inp) inp.value = saved.petName;
      state.petName = saved.petName;
    }
    if (saved.photoUrls && saved.photoUrls.length) {
      state.photoUrls = saved.photoUrls.slice();
      var previews = $('mp-photo-previews');
      var counter  = $('mp-upload-counter');
      if (previews) {
        previews.innerHTML = '';
        saved.photoUrls.forEach(function (url) {
          var wrap = document.createElement('div');
          wrap.className = 'photo-upload__preview';
          var img = document.createElement('img');
          img.src = url;
          img.className = 'photo-upload__thumb';
          wrap.appendChild(img);
          previews.appendChild(wrap);
        });
      }
      if (counter) {
        counter.textContent = saved.photoUrls.length + ' photo' + (saved.photoUrls.length !== 1 ? 's' : '') + ' uploaded';
        counter.hidden = false;
      }
    }
    updateSubtotals();
  }

  function restoreDraft(saved) {
    _pendingRestore = saved;
    if (saved.styleId) selectStyle(saved.styleId);
    if (saved.productHandle) {
      selectProduct(saved.productHandle);
    } else if (saved.productCategory === 'canvas') {
      selectCategory('canvas');
      _pendingRestore = null;
      goToStep(Math.min(saved.step || 2, 2));
      applyRestoredStatics(saved);
    } else {
      _pendingRestore = null;
      applyRestoredStatics(saved);
    }
  }

  function normalizeFramingParam(value) {
    var normalized = String(value || '').toLowerCase().replace(/[_\s]+/g, '-');
    if (normalized === 'unframed' || normalized === 'no-frame' || normalized === 'without-frame') return 'unframed';
    if (normalized === 'framed' || normalized === 'frame') return 'framed';
    return null;
  }

  function getUrlOptionValues(urlParams) {
    var values = {};
    ['size', 'color'].forEach(function (name) {
      var value = urlParams.get(name);
      if (value) values[name] = value;
    });
    return values;
  }

  function getUrlPreset(urlParams) {
    var step = parseInt(urlParams.get('step'), 10);
    return {
      step: step && step > 1 ? Math.min(step, 4) : null,
      productHandle: urlParams.get('product') || '',
      productCategory: String(urlParams.get('category') || '').toLowerCase(),
      canvasFrameChoice: normalizeFramingParam(urlParams.get('framing') || urlParams.get('frame')),
      optionValuesByName: getUrlOptionValues(urlParams),
      border: urlParams.get('border') || null
    };
  }

  function applyUrlPresetStatics(preset) {
    if (!preset || !preset.border) return;
    applyRestoredStatics({ border: preset.border });
  }

  function isCanvasUrlPreset(preset) {
    if (!preset) return false;
    return preset.productCategory === 'canvas'
      || preset.productHandle === CANVAS_HANDLES.unframed
      || preset.productHandle === CANVAS_HANDLES.framed;
  }

  function applyUrlPreset(urlParams) {
    var preset = getUrlPreset(urlParams);
    if (!preset.productHandle && !preset.productCategory && !preset.step) return;

    if (isCanvasUrlPreset(preset)) {
      var choice = preset.canvasFrameChoice
        || (preset.productHandle === CANVAS_HANDLES.unframed ? 'unframed' : 'framed');
      selectCategory('canvas');
      if (preset.step >= 3) {
        buildFrameUI(CANVAS_HANDLES, choice, preset.optionValuesByName);
        goToStep(3);
        applyUrlPresetStatics(preset);
      } else if (preset.step && preset.step > 1) {
        goToStep(preset.step);
        applyUrlPresetStatics(preset);
      }
      return;
    }

    if (preset.productCategory === 'paper') {
      if (FRAMED_POSTER_HANDLE) {
        preset.productHandle = FRAMED_POSTER_HANDLE;
        _pendingUrlPreset = preset;
        selectProduct(FRAMED_POSTER_HANDLE);
      } else if (preset.step && preset.step > 1) {
        goToStep(preset.step);
        applyUrlPresetStatics(preset);
      }
      return;
    }

    if (preset.productHandle) {
      var productBtn = document.querySelector('.product-picker__item[data-product-handle="' + preset.productHandle + '"]');
      if (productBtn) {
        _pendingUrlPreset = preset;
        selectProduct(preset.productHandle);
        if (preset.step && preset.step > 1 && preset.step < 3) {
          goToStep(preset.step);
          applyUrlPresetStatics(preset);
        }
        return;
      }
    }

    if (preset.step && preset.step > 1) {
      goToStep(preset.step);
      applyUrlPresetStatics(preset);
    }
  }

  /* --------------------------------------------------------------------------------
     Init
  -------------------------------------------------------------------------------- */
  function init() {
    // Move fixed popups to document.body so they escape any ancestor stacking context
    ['mp-resume-backdrop', 'mp-resume-banner',
     'mp-upload-required-backdrop', 'mp-upload-required-banner',
     'mp-oos-backdrop', 'mp-oos-banner',
     'mp-quality-backdrop', 'mp-quality-banner'
    ].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) document.body.appendChild(el);
    });

    updateDeliveryDates();
    initTabs();
    initSmartSticky();
    initOverviewLabelParallax();

    // Resume banner
    var urlParams = new URLSearchParams(window.location.search);
    var hasFreshStart = urlParams.get('style') || urlParams.get('product') || urlParams.get('category');
    var savedDraft = !hasFreshStart && loadDraft();
    if (savedDraft && (savedDraft.step || 1) <= 1) {
      clearDraft();
      savedDraft = null;
    }
    if (savedDraft) {
      var banner   = $('mp-resume-banner');
      var backdrop = $('mp-resume-backdrop');
      function closeBanner() {
        if (banner)   banner.hidden   = true;
        if (backdrop) backdrop.hidden = true;
      }
      if (banner)   banner.hidden   = false;
      if (backdrop) backdrop.hidden = false;
      var resumeYes = $('mp-resume-yes');
      var resumeNo  = $('mp-resume-no');
      if (resumeYes) resumeYes.addEventListener('click', function () {
        closeBanner();
        restoreDraft(savedDraft);
      });
      if (resumeNo) resumeNo.addEventListener('click', function () {
        closeBanner();
        clearDraft();
      });
      if (backdrop) backdrop.addEventListener('click', function () {
        closeBanner();
        clearDraft();
      });
    }

    // Auto-select style from URL param or fall back to first
    if (STYLES.length > 0) {
      var urlStyle = urlParams.get('style');
      var preselect = urlStyle && STYLES.find(function (s) { return s.id === urlStyle; });
      selectStyle(preselect ? preselect.id : STYLES[0].id);
    }

    // Pre-select product/category and jump from URL params after building any needed UI
    applyUrlPreset(urlParams);

    // Style picker
    var stylePicker = $('mp-style-picker');
    if (stylePicker) {
      stylePicker.addEventListener('click', function (event) {
        var btn = event.target.closest('.style-picker__item');
        if (!btn || !stylePicker.contains(btn)) return;

        event.preventDefault();
        event.stopPropagation();
        lockProductAccordionScrollAnchoring();
        selectStyle(btn.dataset.styleId);
        switchTab('overview');
        if (event.detail > 0 && typeof btn.blur === 'function') btn.blur();
        scrollToPreviewAnchor();
      }, true);
    }

    // Product picker
    document.querySelectorAll('.product-picker__item').forEach(function (btn) {
      if (btn.dataset.category) {
        btn.addEventListener('click', function () {
          selectCategory(btn.dataset.category);
        });
      } else {
        btn.addEventListener('click', function () {
          selectProduct(btn.dataset.productHandle);
        });
      }
    });

    var rightPanel = document.querySelector('.make-portrait__right');
    if (rightPanel) {
      function isPreviewScrollChoice(event) {
        return event.target.closest('.product-picker__item, .option-btn');
      }

      rightPanel.addEventListener('click', function (event) {
        if (!isPreviewScrollChoice(event)) return;
        scrollToPreviewAnchor();
      });
    }

    // CTA step 1
    var ctaStep1 = $('mp-cta-step1');
    if (ctaStep1) {
      ctaStep1.addEventListener('click', function () {
        if (!state.styleId) return;
        if (state.style && (state.style.tag || '').replace(/ /g, '-') === 'sold-out') return;
        if (!state.productHandle && !state.productCategory) selectCategory('canvas');
        goToStepFromControl(2);
      });
    }

    // Back to step 1
    var backStep1 = $('mp-back-step1');
    if (backStep1) backStep1.addEventListener('click', function () { goToStepFromControl(1); });

    // Back to step 2
    var backStep2 = $('mp-back-step2');
    if (backStep2) backStep2.addEventListener('click', function () { goToStepFromControl(2); });

    // Back to step 3
    var backStep3 = $('mp-back-step3');
    if (backStep3) backStep3.addEventListener('click', function () { goToStepFromControl(3); });

    // CTA step 2
    var ctaStep2 = $('mp-cta-step2');
    if (ctaStep2) {
      ctaStep2.addEventListener('click', function () {
        if (!state.productHandle && !state.productCategory) return;
        if (state.productCategory === 'canvas') {
          buildCanvasFrameUI();
          goToStepFromControl(3);
          syncPreviewNameForStep();
        } else {
          buildPaperDetailsThenGoToStep3(true);
        }
      });
    }

    // CTA step 3
    var ctaStep3 = $('mp-cta-step3');
    if (ctaStep3) {
      ctaStep3.addEventListener('click', function () {
        var _avMap = window.MakePortraitAvailability || {};
        var _avStatus = (state.variantId && _avMap[state.variantId]) || 'in_stock';
        if (_avStatus === 'out_of_stock') { showOutOfStockPopup(); return; }
        state.petName = ($('mp-pet-name') || {}).value || '';
        goToStepFromControl(4);
      });
    }

    // CTA order
    var ctaOrder = $('mp-cta-order');
    if (ctaOrder) ctaOrder.addEventListener('click', addToCart);

    document.querySelectorAll('.step-indicator__btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.classList.contains('completed')) {
          goToStep(parseInt(btn.dataset.step, 10));
        }
      });
    });

    // Option button groups
    initOptionGroup('mp-border-grid', 'border');
    // Re-match variant (and update preview image) when border changes
    var _borderGrid = $('mp-border-grid');
    if (_borderGrid) {
      _borderGrid.querySelectorAll('.option-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (state.product) matchVariant(state.product);
        });
      });
    }
    // initOptionGroup('mp-background-grid', 'background');  // disabled
    // initOptionGroup('mp-pets-grid', 'petCount');           // disabled

    var rate = parseFloat((Shopify.currency && Shopify.currency.rate) || 1);
    FX_RATE         = rate;
    EXTRA_PET_PRICE = Math.round(EXTRA_PET_USD * rate) * 100;
    PET_NAME_PRICE  = Math.round(PET_NAME_USD  * rate) * 100;
    initCustomOptionImages();
    initStep4Pricing(rate);
    updateSubtotals();

    // Pet name
    var petNameInput = $('mp-pet-name');
    if (petNameInput) {
      petNameInput.addEventListener('input', function () {
        state.petName = petNameInput.value;
        var feeEl = $('mp-pet-name-fee');
        if (feeEl) feeEl.hidden = !state.petName;
        updateSubtotals();
        updatePreviewImage();
      });
    }

    // File upload
    var fileInput = $('mp-file-input');
    if (fileInput) {
      fileInput.addEventListener('change', function () { handleFiles(fileInput.files); });
    }

    var uploadZone = $('mp-upload-zone');
    if (uploadZone) {
      uploadZone.addEventListener('dragover', function (e) {
        e.preventDefault();
        uploadZone.classList.add('drag-over');
      });
      uploadZone.addEventListener('dragleave', function () {
        uploadZone.classList.remove('drag-over');
      });
      uploadZone.addEventListener('drop', function (e) {
        e.preventDefault();
        uploadZone.classList.remove('drag-over');
        handleFiles(e.dataTransfer.files);
      });
    }

    // Add-on checkboxes
    document.querySelectorAll('.addon-item__check').forEach(function (check) {
      check.addEventListener('change', function () {
        state.addonTotal = 0;
        document.querySelectorAll('.addon-item__check:checked').forEach(function (c) {
          state.addonTotal += parseFloat(c.dataset.addonPrice || 0) * 100;
        });
        updateSubtotals();
      });
    });

    // Donation amounts
    function clearDonationSelection() {
      document.querySelectorAll('.donation-card__amounts .option-btn').forEach(function (b) {
        b.classList.remove('selected');
      });
      var customInput = document.querySelector('.donation-card__custom-input');
      if (customInput) customInput.value = '';
      state.donation = 0;
    }

    document.querySelectorAll('.donation-card__amounts .option-btn:not(.donation-card__custom)').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var val = parseInt(btn.dataset.donation, 10);
        if (btn.classList.contains('selected')) {
          clearDonationSelection();
        } else {
          clearDonationSelection();
          btn.classList.add('selected');
          state.donation = val;
        }
        updateSubtotals();
      });
    });

    // Custom donation input
    var customDonationInput = document.querySelector('.donation-card__custom-input');
    var customDonationLabel = document.querySelector('.donation-card__custom');
    if (customDonationInput && customDonationLabel) {
      customDonationInput.addEventListener('focus', function () {
        document.querySelectorAll('.donation-card__amounts .option-btn:not(.donation-card__custom)').forEach(function (b) {
          b.classList.remove('selected');
        });
        customDonationLabel.classList.add('selected');
      });

      customDonationInput.addEventListener('input', function () {
        var raw = parseFloat(customDonationInput.value);
        if (!isFinite(raw) || raw < 1) {
          state.donation = 0;
          customDonationLabel.classList.remove('selected');
          updateSubtotals();
          return;
        }
        var cents = Math.round(Math.abs(raw)) * 100;
        state.donation = cents;
        customDonationLabel.classList.add('selected');
        updateSubtotals();
      });

      customDonationInput.addEventListener('blur', function () {
        var raw = parseFloat(customDonationInput.value);
        if (!isFinite(raw) || raw < 1) {
          customDonationInput.value = '';
          customDonationLabel.classList.remove('selected');
          state.donation = 0;
          updateSubtotals();
        } else {
          customDonationInput.value = Math.round(Math.abs(raw));
        }
      });
    }

    // Add prints (checkbox -> expand grid)
    var printsCheck = $('mp-prints-check');
    var printOptions = $('mp-prints-options');

    function selectPrintsBtn(btn) {
      clearPrintsSelection();
      btn.classList.add('selected');
      state.prints = parseInt(btn.dataset.prints, 10);
    }

    function clearPrintsSelection() {
      document.querySelectorAll('#mp-prints-grid .option-btn').forEach(function (b) { b.classList.remove('selected'); });
      var ci = document.querySelector('.make-portrait__prints-custom-input');
      if (ci) ci.value = '';
      state.prints = 0;
    }

    function deselectPrints() {
      var addonItem = printsCheck && printsCheck.closest('.addon-item--prints');
      clearPrintsSelection();
      var cp = document.querySelector('.make-portrait__prints-custom-price');
      if (cp) cp.textContent = '+ ' + formatMoney(PRINTS_BASE_PRICE + 4 * PRINTS_EXTRA_PRICE);
      if (printOptions) printOptions.hidden = true;
      if (printsCheck) printsCheck.checked = false;
      if (addonItem) addonItem.classList.remove('selected');
    }

    if (printsCheck && printOptions) {
      printsCheck.addEventListener('change', function () {
        var addonItem = printsCheck.closest('.addon-item--prints');
        if (printsCheck.checked) {
          printOptions.hidden = false;
          if (addonItem) addonItem.classList.add('selected');
          var firstBtn = document.querySelector('#mp-prints-grid .option-btn[data-prints="1"]');
          if (firstBtn) selectPrintsBtn(firstBtn);
        } else {
          deselectPrints();
        }
        updateSubtotals();
      });
    }

    document.querySelectorAll('#mp-prints-grid .option-btn[data-prints]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.classList.contains('selected')) {
          deselectPrints();
        } else {
          selectPrintsBtn(btn);
        }
        updateSubtotals();
      });
    });

    var printCustomInput = document.querySelector('.make-portrait__prints-custom-input');
    var printCustomLabel = document.querySelector('.make-portrait__prints-custom');
    var printCustomPrice = document.querySelector('.make-portrait__prints-custom-price');
    if (printCustomInput && printCustomLabel) {
      printCustomInput.addEventListener('focus', function () {
        document.querySelectorAll('#mp-prints-grid .option-btn:not(.make-portrait__prints-custom)').forEach(function (b) { b.classList.remove('selected'); });
        printCustomLabel.classList.add('selected');
      });

      printCustomInput.addEventListener('input', function () {
        var raw = parseFloat(printCustomInput.value);
        if (!isFinite(raw) || raw < 1) {
          state.prints = 0;
          printCustomLabel.classList.remove('selected');
          if (printCustomPrice) printCustomPrice.textContent = '';
          updateSubtotals();
          return;
        }
        state.prints = Math.round(Math.abs(raw));
        printCustomLabel.classList.add('selected');
        if (printCustomPrice) printCustomPrice.textContent = '+ ' + formatMoney(getPrintsPrice());
        updateSubtotals();
      });

      printCustomInput.addEventListener('blur', function () {
        var raw = parseFloat(printCustomInput.value);
        if (!isFinite(raw) || raw < 1) {
          printCustomInput.value = '';
          printCustomLabel.classList.remove('selected');
          if (printCustomPrice) printCustomPrice.textContent = '';
          state.prints = 0;
          updateSubtotals();
        } else {
          printCustomInput.value = Math.round(Math.abs(raw));
        }
      });
    }

    // Tab product accordions -- exclusive (opening one closes others)
    var productAccordions = document.querySelectorAll('#tab-product-accordions .tab-accordion');
    productAccordions.forEach(function (details) {
      var summary = details.querySelector('.tab-accordion__summary');
      if (summary) {
        summary.addEventListener('click', lockProductAccordionScrollAnchoring, true);
        summary.addEventListener('keydown', function (event) {
          if (event.key === 'Enter' || event.key === ' ') {
            lockProductAccordionScrollAnchoring();
          }
        }, true);
      }

      details.addEventListener('toggle', function () {
        if (!details.open) return;

        productAccordions.forEach(function (other) {
          if (other !== details && other.open) other.open = false;
        });
        scrollProductAccordionIntoView(details);
      });
    });

    state.initialized = true;
  }

  /* --------------------------------------------------------------------------------
     Smart sticky right column
  -------------------------------------------------------------------------------- */
  function initSmartSticky() {
    var el = document.querySelector('.make-portrait__right');
    if (!el) return;

    var TOP_OFFSET = 94;
    var lastScrollY = window.scrollY;
    var currentTop = TOP_OFFSET;

    function update() {
      if (window.innerWidth < 800) {
        el.style.top = '';
        return;
      }

      var scrollY = window.scrollY;
      var delta = scrollY - lastScrollY;
      lastScrollY = scrollY;

      var elHeight = el.offsetHeight;
      var viewportHeight = window.innerHeight;

      if (elHeight <= viewportHeight - TOP_OFFSET) {
        // Content fits -- stick to top as normal
        currentTop = TOP_OFFSET;
      } else {
        // Content taller than viewport -- clamp between top and bottom edge
        var minTop = viewportHeight - elHeight;
        currentTop = Math.min(TOP_OFFSET, Math.max(minTop, currentTop - delta));
      }

      el.style.top = currentTop + 'px';
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', function () {
      currentTop = TOP_OFFSET;
      lastScrollY = window.scrollY;
      update();
      layoutOverviewComposite();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();

{% endjavascript %}
