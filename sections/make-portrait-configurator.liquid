{{ 'make-portrait-configurator.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable StaticStylesheetAndJavascriptTags %}
{% javascript %}
(function () {
  var state = {
    step: 1,
    styleId: null,
    style: null,
    productCategory: null,   // 'canvas' | null
    categoryMinPrice: 0,     // in local currency cents
    canvasFrameChoice: null, // 'unframed' | 'framed'
    productHandle: null,
    product: null,
    variantId: null,
    variant: null,
    selectedOptions: {},
    petCount: 1,
    petName: '',
    border: 'no-border',
    background: 'classic',
    addonTotal: 0,   // in cents
    donation: 0,     // in cents
    prints: 0,       // number of copies (0 = none)
    files: [],
    photoUrls: [],
    pendingUploads: 0,
    previewImageUrl: null,
    configuratorPreviewUrl: null,
    configuratorPreviewAlt: '',
    previewGalleryMode: 'config'
  };
  var STYLES = window.MakePortraitStyles || [];
  var FRAMED_POSTER_HANDLE = window.MakePortraitFramedPosterHandle || '';
  var COLOR_DISPLAY_NAMES = {
    'oak': 'Premium Oak',
    'premium oak': 'Premium Oak',
    'brown': 'Premium Walnut',
    'walnut': 'Premium Walnut',
    'premium walnut': 'Premium Walnut'
  };
  var PRODUCTS = window.MakePortraitProducts || [];
  var CANVAS_HANDLES = window.MakePortraitCanvasHandles || {};
  var EXTRA_PET_USD    = window.MakePortraitExtraPetUSD    || 9;
  var PET_NAME_USD     = window.MakePortraitPetNameUSD     || 5;
  var PRINTS_BASE_EUR  = window.MakePortraitPrintsBaseEUR  || 30;
  var PRINTS_EXTRA_EUR = window.MakePortraitPrintsExtraEUR || 20;
  var FX_RATE          = 1;
  var EXTRA_PET_PRICE  = EXTRA_PET_USD * 100;
  var PET_NAME_PRICE   = PET_NAME_USD  * 100;
  var PRINTS_BASE_PRICE  = PRINTS_BASE_EUR  * 100;
  var PRINTS_EXTRA_PRICE = PRINTS_EXTRA_EUR * 100;
  function optionNameKey(name) {
    var key = String(name || '').trim().toLowerCase();
    if (key === 'frame color' || key === 'frame colour' || key === 'color' || key === 'colour') return 'color';
    return key;
  }
  function isSizeOptionName(name) {
    return optionNameKey(name) === 'size';
  }
  function isColorOptionName(name) {
    return optionNameKey(name) === 'color';
  }
  function normalizeOptionValueKey(value) {
    return String(value || '')
      .toLowerCase()
      .replace(/\u00D7/g, 'x')
      .replace(/[\u2033"']/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  }
  function normalizeResolutionParts(value) {
    var parts = String(value || '').replace(/\u00D7/g, 'x').split(/x/i);
    if (parts.length !== 2) return null;
    var w = parseInt(parts[0].replace(/[^\d]/g, ''), 10);
    var h = parseInt(parts[1].replace(/[^\d]/g, ''), 10);
    if (!w || !h) return null;
    return { w: w, h: h };
  }
  function formatMoney(cents) {
    var format = window.MakePortraitMoneyFormat || '${{amount}}';
    var amount = Math.round(cents) / 100;
    var intAmount = Math.round(amount);
    return format
      .replace('{{amount}}', intAmount)
      .replace('{{amount_no_decimals}}', intAmount)
      .replace('{{amount_with_comma_separator}}', intAmount)
      .replace('{{amount_no_decimals_with_comma_separator}}', intAmount);
  }
  function getDeliveryDate() {
    var d = new Date();
    d.setDate(d.getDate() + 16);
    var dd = String(d.getDate()).padStart(2, '0');
    var mm = String(d.getMonth() + 1).padStart(2, '0');
    var yyyy = d.getFullYear();
    return dd + '/' + mm + '/' + yyyy;
  }
  function $(selector) {
    return document.getElementById(selector);
  }
  var overviewCompositeBase = { width: 1036, height: 1020 };
  var overviewCompositeBoxes = {
    photo: { x: 0, y: 154, width: 262 },
    artist: { x: 476, y: 100, width: 198 },
    wall: { x: 328, y: 542, width: 708 }
  };
  var overviewCompositeBoxesCompact = {
    photo: { x: 0, y: 154, width: 262 },
    artist: { x: 476, y: 0, width: 198 },
    wall: { x: 328, y: 542, width: 708 }
  };
  function layoutOverviewComposite() {
    var media = $('mp-overview-media');
    if (!media) return;
    var scale = media.clientWidth / overviewCompositeBase.width;
    if (!scale) return;
    var maxBottom = overviewCompositeBase.height * scale;
    var boxes = window.innerWidth < 1200 ? overviewCompositeBoxesCompact : overviewCompositeBoxes;
    Object.keys(boxes).forEach(function (slot) {
      var box = boxes[slot];
      var img = $('mp-overview-' + slot);
      var card = img && img.closest('.tab-overview__image-card');
      if (!card || card.hidden) return;
      card.style.left = (box.x * scale) + 'px';
      card.style.top = (box.y * scale) + 'px';
      card.style.width = (box.width * scale) + 'px';
      var bottom = (box.y * scale) + card.getBoundingClientRect().height;
      if (bottom > maxBottom) maxBottom = bottom;
    });
    media.style.height = Math.ceil(maxBottom) + 'px';
  }
  function setOverviewImage(slot, data) {
    var img = $('mp-overview-' + slot);
    if (!img) return;
    var card = img.closest('.tab-overview__image-card');
    if (!data || !data.src) {
      img.removeAttribute('src');
      img.alt = '';
      if (card) card.hidden = true;
      return;
    }
    img.onload = layoutOverviewComposite;
    img.src = data.src;
    img.alt = data.alt || '';
    if (card) card.hidden = false;
    window.requestAnimationFrame(layoutOverviewComposite);
  }
  function getSelectedStyleOverviewImage() {
    if (state.style && state.style.imageUrl) {
      return { src: state.style.imageUrl, alt: state.style.name || '' };
    }
    var styles = window.MakePortraitStyles || [];
    for (var i = 0; i < styles.length; i++) {
      if (styles[i] && styles[i].id === state.styleId && styles[i].imageUrl) {
        return { src: styles[i].imageUrl, alt: styles[i].name || '' };
      }
    }
    return null;
  }
  function updateOverviewImages() {
    var overviewMap = window.MakePortraitOverviewImages || {};
    var bucket = overviewMap[state.styleId] || null;
    setOverviewImage('photo', bucket && bucket.photo);
    setOverviewImage('artist', (bucket && bucket.artist) || getSelectedStyleOverviewImage());
    setOverviewImage('wall', bucket && bucket.wall);
    window.requestAnimationFrame(layoutOverviewComposite);
  }
  function initOverviewLabelParallax() {
    var media = $('mp-overview-media');
    if (!media || !window.matchMedia || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var labels = [
      { el: media.querySelector('.tab-overview__photo-label--photo'), strength: 0.026 },
      { el: media.querySelector('.tab-overview__photo-label--artist'), strength: 0.034 },
      { el: media.querySelector('.tab-overview__photo-label--wall'), strength: 0.022 }
    ].filter(function (item) {
      return item.el;
    });
    var ticking = false;
    function clamp(value, min, max) {
      return Math.min(max, Math.max(min, value));
    }
    function update() {
      ticking = false;
      var rect = media.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;
      var mediaCenter = rect.top + rect.height / 2;
      var viewportCenter = window.innerHeight / 2;
      var distanceFromCenter = viewportCenter - mediaCenter;
      labels.forEach(function (item) {
        var offset = clamp(distanceFromCenter * item.strength, -12, 12);
        item.el.style.setProperty('--overview-label-parallax', offset.toFixed(2) + 'px');
      });
    }
    function requestUpdate() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    }
    update();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  }
  function initOverviewStepsScrollbar() {
    var container = document.querySelector('.tab-overview__steps');
    var scrollbar = document.querySelector('.tab-overview__steps-scrollbar');
    var thumb = scrollbar && scrollbar.querySelector('.tab-overview__steps-scrollbar-thumb');
    if (!container || !scrollbar || !thumb) return;
    var isDragging = false;
    function update() {
      var maxScroll = container.scrollWidth - container.clientWidth;
      if (window.innerWidth >= 750 || maxScroll <= 0) {
        scrollbar.hidden = true;
        thumb.style.width = '100%';
        thumb.style.transform = 'translateX(0)';
        return;
      }
      scrollbar.hidden = false;
      var trackWidth = scrollbar.clientWidth;
      var thumbWidth = Math.max((container.clientWidth / container.scrollWidth) * trackWidth, 34);
      var left = ((trackWidth - thumbWidth) * container.scrollLeft) / maxScroll;
      thumb.style.width = thumbWidth + 'px';
      thumb.style.transform = 'translateX(' + left + 'px)';
    }
    function scrollFromScrollbar(clientX) {
      var maxScroll = container.scrollWidth - container.clientWidth;
      if (maxScroll <= 0) return;
      var rect = scrollbar.getBoundingClientRect();
      var thumbWidth = thumb.offsetWidth || 34;
      var usableWidth = Math.max(rect.width - thumbWidth, 1);
      var progress = Math.min(Math.max((clientX - rect.left - thumbWidth / 2) / usableWidth, 0), 1);
      container.scrollLeft = progress * maxScroll;
      update();
    }
    container.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', function () {
      window.requestAnimationFrame(update);
    });
    scrollbar.addEventListener('pointerdown', function (event) {
      isDragging = true;
      scrollbar.setPointerCapture && scrollbar.setPointerCapture(event.pointerId);
      scrollFromScrollbar(event.clientX);
    });
    scrollbar.addEventListener('pointermove', function (event) {
      if (!isDragging) return;
      scrollFromScrollbar(event.clientX);
    });
    function stopDragging(event) {
      isDragging = false;
      if (event && scrollbar.releasePointerCapture) {
        scrollbar.releasePointerCapture(event.pointerId);
      }
    }
    scrollbar.addEventListener('pointerup', stopDragging);
    scrollbar.addEventListener('pointercancel', stopDragging);
    window.requestAnimationFrame(update);
  }
  var sizeTableScrollbarInstances = [];
  function updateSizeTableScrollbars() {
    sizeTableScrollbarInstances.forEach(function (instance) {
      var container = instance.container;
      var scrollbar = instance.scrollbar;
      var thumb = instance.thumb;
      var maxScroll = container.scrollWidth - container.clientWidth;
      if (window.innerWidth > 599 || container.clientWidth <= 0 || maxScroll <= 0) {
        scrollbar.hidden = true;
        thumb.style.width = '100%';
        thumb.style.transform = 'translateX(0)';
        return;
      }
      scrollbar.hidden = false;
      var trackWidth = scrollbar.clientWidth;
      var thumbWidth = Math.max((container.clientWidth / container.scrollWidth) * trackWidth, 34);
      var left = ((trackWidth - thumbWidth) * container.scrollLeft) / maxScroll;
      thumb.style.width = thumbWidth + 'px';
      thumb.style.transform = 'translateX(' + left + 'px)';
    });
  }
  function scrollSizeTableFromScrollbar(instance, clientX) {
