}

.make-portrait__empty-note {
  font-size: 13px;
  color: rgba(90, 64, 53, 0.5);
  padding: 16px 0;
}

{% endstylesheet %}

{% javascript %}

(function () {

  /* ————————————————————————————————————————
     State
  ———————————————————————————————————————— */
  var state = {
    step: 1,
    styleId: null,
    style: null,
    productHandle: null,
    product: null,
    variantId: null,
    variant: null,
    selectedOptions: {},
    petCount: 1,
    petName: '',
    border: 'no-border',
    background: 'classic',
    addonTotal: 0,   // in cents
    donation: 0,     // in cents
    files: [],
    photoUrls: [],
    pendingUploads: 0
  };

  var STYLES = window.MakePortraitStyles || [];
  var PRODUCTS = window.MakePortraitProducts || [];

  /* ————————————————————————————————————————
     Utilities
  ———————————————————————————————————————— */
  function formatMoney(cents) {
    var format = window.MakePortraitMoneyFormat || '${{amount}}';
    var amount = Math.round(cents) / 100;
    var intAmount = Math.round(amount);
    return format
      .replace('{{amount}}', amount % 1 === 0 ? intAmount : amount.toFixed(2))
      .replace('{{amount_no_decimals}}', intAmount)
      .replace('{{amount_with_comma_separator}}', amount.toFixed(2).replace('.', ','))
      .replace('{{amount_no_decimals_with_comma_separator}}', intAmount);
  }

  function getDeliveryDate() {
    var d = new Date();
    d.setDate(d.getDate() + 7);
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  function $(selector) {
    return document.getElementById(selector);
  }

  /* ————————————————————————————————————————
     Delivery dates
  ———————————————————————————————————————— */
  function updateDeliveryDates() {
    var date = getDeliveryDate();
    ['mp-delivery'].forEach(function (id) {
      var el = $(id);
      if (el) el.textContent = date;
    });
  }

  /* ————————————————————————————————————————
     Subtotal
  ———————————————————————————————————————— */
  function getBasePrice() {
    if (state.variant && state.variant.price) {
      return state.variant.price; // already in cents
    }
    if (state.product && state.product.variants && state.product.variants.length) {
      return state.product.variants[0].price;
    }
    if (state.style && state.style.basePrice) {
      return state.style.basePrice * 100;
    }
    return 0;
  }

  function updateSubtotals() {
    var total = getBasePrice() + state.addonTotal + state.donation;
    var formatted = total > 0 ? formatMoney(total) : '—';
    ['mp-subtotal-1', 'mp-subtotal-2', 'mp-subtotal-3', 'mp-subtotal-4'].forEach(function (id) {
      var el = $(id);
      if (el) el.textContent = formatted;
    });
  }

  /* ————————————————————————————————————————
     Step navigation
  ———————————————————————————————————————— */
  function goToStep(step) {
    document.querySelectorAll('.make-portrait__step').forEach(function (el) {
      el.hidden = parseInt(el.dataset.step, 10) !== step;
    });

    document.querySelectorAll('.step-indicator__btn').forEach(function (btn) {
      var s = parseInt(btn.dataset.step, 10);
      btn.classList.toggle('active', s === step);
      btn.classList.toggle('completed', s < step);
    });

    state.step = step;
    updateSubtotals();
    if (step === 4) buildSummary();

    // Show/hide artist badge and product label
    var artistBadge = $('mp-artist-badge');
    var productLabel = $('mp-product-label');
    var sizeLabel = $('mp-size-label');

    if (artistBadge) artistBadge.hidden = step !== 1;
    if (productLabel) productLabel.hidden = step < 2;
    if (sizeLabel) sizeLabel.hidden = step !== 3;

    // Scroll right panel to top on mobile
    var right = document.querySelector('.make-portrait__right');
    if (right) right.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  /* ————————————————————————————————————————
     Step 1 – Style
  ———————————————————————————————————————— */
  function selectStyle(styleId) {
    state.styleId = styleId;
    state.style = STYLES.filter(function (s) { return s.id === styleId; })[0] || null;

    document.querySelectorAll('.style-picker__item').forEach(function (btn) {
      var selected = btn.dataset.styleId === styleId;
      btn.classList.toggle('selected', selected);
      btn.setAttribute('aria-selected', selected ? 'true' : 'false');
    });

    if (!state.style) return;

    // Preview image
    var img = $('mp-preview-img');
    if (img && state.style.imageUrl) {
      img.style.opacity = '0';
      img.onload = function () { img.style.opacity = '1'; };
      img.src = state.style.imageUrl;
    }

    // Artist badge
    var artistName = $('mp-artist-name');
    if (artistName) artistName.textContent = state.style.artistName || '';
    var artistPhoto = $('mp-artist-photo');
    if (artistPhoto) {
      artistPhoto.src = state.style.artistPhotoUrl || '';
      artistPhoto.alt = state.style.artistName || '';
      artistPhoto.hidden = !state.style.artistName;
    }

    // Style info
    var nameDisplay = $('mp-style-name-display');
    if (nameDisplay) nameDisplay.textContent = state.style.name || '';

    var desc = $('mp-style-description');
    if (desc) desc.innerHTML = state.style.description || '';

    updateSubtotals();
  }

  /* ————————————————————————————————————————
     Step 2 – Product
  ———————————————————————————————————————— */
  function selectProduct(handle) {
    state.productHandle = handle;
    state.product = null;
    state.variantId = null;
    state.variant = null;

    document.querySelectorAll('.product-picker__item').forEach(function (btn) {
      var selected = btn.dataset.productHandle === handle;
      btn.classList.toggle('selected', selected);
      btn.setAttribute('aria-selected', selected ? 'true' : 'false');
    });

    // Update product label
    var productLabel = $('mp-product-label');
    var matchedProduct = PRODUCTS.filter(function (p) { return p.handle === handle; })[0];
    if (productLabel && matchedProduct) productLabel.textContent = matchedProduct.title;

    // Update preview image
    if (matchedProduct && matchedProduct.featuredImage) {
      var img = $('mp-preview-img');
      if (img) {
        img.style.opacity = '0';
        img.onload = function () { img.style.opacity = '1'; };
        img.src = matchedProduct.featuredImage;
      }
    }

    // Fetch full product data for variants
    fetch('/products/' + handle + '.js')
      .then(function (r) { return r.json(); })
      .then(function (product) {
        state.product = product;
        if (product.variants && product.variants.length) {
          state.variantId = product.variants[0].id;
          state.variant = product.variants[0];
        }
        var ctaStep2 = $('mp-cta-step2');
        if (ctaStep2) ctaStep2.disabled = false;
        updateSubtotals();
      })
      .catch(function (err) {
        console.error('Failed to fetch product:', err);
      });

    updateSubtotals();
  }

  /* ————————————————————————————————————————
     Step 3 – Options
  ———————————————————————————————————————— */
  function buildOptionsUI(product) {
    var container = $('mp-options-container');
    var loading = $('mp-options-loading');
    if (!container || !product) return;

    // Clear previous
    container.innerHTML = '';
    if (loading) loading.remove();

    state.selectedOptions = {};

    if (!product.options || product.options.length === 0) {
      // No options – just use first variant
      if (product.variants && product.variants.length) {
        state.variantId = product.variants[0].id;
        state.variant = product.variants[0];
      }
      return;
    }

    product.options.forEach(function (option, optIdx) {
      var group = document.createElement('div');
      group.className = 'make-portrait__option-group';

      var label = document.createElement('p');
      label.className = 'make-portrait__option-label';
      label.textContent = option;
      group.appendChild(label);

      var grid = document.createElement('div');
      grid.className = 'option-btn-grid';

      // Collect unique values for this option position
      var seen = {};
      var values = [];
      product.variants.forEach(function (v) {
        var val = v.options[optIdx];
        if (!seen[val]) {
          seen[val] = true;
          values.push(val);
        }
      });

      values.forEach(function (value, vIdx) {
        var btn = document.createElement('button');
        btn.className = 'option-btn' + (vIdx === 0 ? ' selected' : '');
        btn.textContent = value;
        btn.type = 'button';
        btn.dataset.optionIndex = optIdx;
        btn.dataset.value = value;

        if (vIdx === 0) {
          state.selectedOptions[optIdx] = value;
        }

        btn.addEventListener('click', function () {
          grid.querySelectorAll('.option-btn').forEach(function (b) {
            b.classList.remove('selected');
          });
          btn.classList.add('selected');
          state.selectedOptions[optIdx] = value;
          matchVariant(product);
        });

        grid.appendChild(btn);
      });

      group.appendChild(grid);
      container.appendChild(group);
    });

    // Set initial defaults
    product.options.forEach(function (_, idx) {
      if (!state.selectedOptions.hasOwnProperty(idx)) {
        var firstBtn = container.querySelector('[data-option-index="' + idx + '"]');
        if (firstBtn) state.selectedOptions[idx] = firstBtn.dataset.value;
      }
    });

    matchVariant(product);
  }

  function matchVariant(product) {
    if (!product) return;
    var variant = null;
    for (var i = 0; i < product.variants.length; i++) {
      var v = product.variants[i];
      var match = true;
      for (var idx = 0; idx < v.options.length; idx++) {
        if (state.selectedOptions[idx] !== v.options[idx]) {
          match = false;
          break;
        }
      }
      if (match) { variant = v; break; }
    }

    if (variant) {
      state.variantId = variant.id;
      state.variant = variant;

      // Update size label
      var sizeLabel = $('mp-size-label');
      if (sizeLabel) sizeLabel.textContent = variant.title;

      // Update preview if variant has image
      if (variant.featured_image && variant.featured_image.src) {
        var img = $('mp-preview-img');
        if (img) {
          img.style.opacity = '0';
          img.onload = function () { img.style.opacity = '1'; };
          img.src = variant.featured_image.src;
        }
      }
    }

    updateSubtotals();
  }

  /* ————————————————————————————————————————
     Order summary (step 4)
  ———————————————————————————————————————— */
  function getSelectedLabel(gridId) {
    var btn = document.querySelector('#' + gridId + ' .option-btn.selected');
    return btn ? btn.textContent.trim() : '';
  }

  function buildSummary() {
    var container = $('mp-order-summary');
    if (!container) return;
    container.innerHTML = '';

    function addLine(label, value) {
      var p = document.createElement('p');
      p.className = 'order-summary__line';
      p.innerHTML = label + ' \u2013 <strong>' + value + '</strong>';
      container.appendChild(p);
    }

    if (state.style) addLine('Style', state.style.name);
    if (state.product) addLine('Product', state.product.title);

    var details = [];
    if (state.variant && state.variant.options) {
      state.variant.options.forEach(function (o) { if (o && o !== 'Default Title') details.push(o); });
    }
    var border = getSelectedLabel('mp-border-grid');
    var bg = getSelectedLabel('mp-background-grid');
    if (border) details.push(border);
    if (bg) details.push(bg + ' Background');
    details.push(state.petCount + ' pet' + (state.petCount > 1 ? 's' : ''));
    if (state.petName) details.push(state.petName);
    if (details.length) addLine('Details', details.join(' | '));

    var addonNames = [];
    document.querySelectorAll('.addon-item__check:checked').forEach(function (c) {
      addonNames.push(c.dataset.addonName);
    });
    if (addonNames.length) {
      var section = document.createElement('div');
      section.className = 'order-summary__section';
      var lbl = document.createElement('p');
      lbl.className = 'order-summary__section-label';
      lbl.textContent = 'Customize order';
      var val = document.createElement('p');
      val.className = 'order-summary__section-value';
      val.textContent = addonNames.join(' | ');
      section.appendChild(lbl);
      section.appendChild(val);
      container.appendChild(section);
    }

    if (state.donation > 0) {
      addLine(window.MakePortraitDonationTitle || 'Donation', formatMoney(state.donation));
    }
  }

  /* ————————————————————————————————————————
     Option button groups (border, background, pet count)
  ———————————————————————————————————————— */
  function initOptionGroup(gridId, stateKey) {
    var grid = $(gridId);
    if (!grid) return;
    grid.querySelectorAll('.option-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        grid.querySelectorAll('.option-btn').forEach(function (b) { b.classList.remove('selected'); });
        btn.classList.add('selected');
        var val = btn.dataset[stateKey];
        if (stateKey === 'petCount') {
          state.petCount = parseInt(val, 10);
        } else {
          state[stateKey] = val;
        }
      });
    });
  }

  /* ————————————————————————————————————————
     File upload
  ———————————————————————————————————————— */
  function updateOrderButton() {
    var btn = $('mp-cta-order');
    if (!btn) return;
    if (state.pendingUploads > 0) {
      btn.disabled = true;
      btn.textContent = 'Uploading photo…';
    } else {
      btn.disabled = false;
      btn.textContent = 'Order portrait';
    }
  }

  function uploadToCloudinary(file, previewEl) {
    var cfg = window.MakePortraitCloudinary;
    if (!cfg || !cfg.cloudName || !cfg.uploadPreset) return;

    state.pendingUploads++;
    updateOrderButton();

    var spinner = document.createElement('div');
    spinner.className = 'photo-preview__spinner';
    previewEl.appendChild(spinner);

    var formData = new FormData();
    formData.append('file', file);
    formData.append('upload_preset', cfg.uploadPreset);

    fetch('https://api.cloudinary.com/v1_1/' + cfg.cloudName + '/image/upload', {
      method: 'POST',
      body: formData
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.secure_url) {
          state.photoUrls.push(data.secure_url);
          previewEl.dataset.photoUrl = data.secure_url;
          spinner.remove();
        } else {
          spinner.classList.add('photo-preview__spinner--error');
          spinner.title = 'Upload failed';
        }
      })
      .catch(function () {
        spinner.classList.add('photo-preview__spinner--error');
        spinner.title = 'Upload failed';
      })
      .finally(function () {
        state.pendingUploads = Math.max(0, state.pendingUploads - 1);
        updateOrderButton();
      });
  }

  function handleFiles(files) {
    var previews = $('mp-photo-previews');
    if (!previews) return;

    Array.from(files).forEach(function (file) {
      if (!file.type.startsWith('image/')) return;
      state.files.push(file);

      var reader = new FileReader();
      reader.onload = function (e) {
        var preview = document.createElement('div');
        preview.className = 'photo-preview';

        var img = document.createElement('img');
        img.src = e.target.result;
        img.alt = 'Pet photo preview';
        preview.appendChild(img);

        var removeBtn = document.createElement('button');
        removeBtn.className = 'photo-preview__remove';
        removeBtn.type = 'button';
        removeBtn.textContent = '×';
        removeBtn.setAttribute('aria-label', 'Remove photo');
        removeBtn.addEventListener('click', function () {
          var idx = state.files.indexOf(file);
          if (idx > -1) state.files.splice(idx, 1);
          if (preview.dataset.photoUrl) {
            var urlIdx = state.photoUrls.indexOf(preview.dataset.photoUrl);
            if (urlIdx > -1) state.photoUrls.splice(urlIdx, 1);
          }
          preview.remove();
        });
        preview.appendChild(removeBtn);

        previews.appendChild(preview);

        // Mirror upload in preview area
        var mainImg = $('mp-preview-img');
        if (mainImg) {
          mainImg.style.opacity = '0';
          mainImg.onload = function () { mainImg.style.opacity = '1'; };
          mainImg.src = e.target.result;
        }

        uploadToCloudinary(file, preview);
      };
      reader.readAsDataURL(file);
    });
  }

  /* ————————————————————————————————————————
     Add to cart
  ———————————————————————————————————————— */
  function addToCart() {
    if (!state.variantId) {
      showError('Please complete all options before ordering.');
      return;
    }

    var btn = $('mp-cta-order');
    if (btn) { btn.disabled = true; btn.textContent = 'Adding to cart…'; }
    hideError();

    var detailParts = [];
    if (state.variant && state.variant.options) {
      state.variant.options.forEach(function (o) { if (o && o !== 'Default Title') detailParts.push(o); });
    }
    var borderLabel = getSelectedLabel('mp-border-grid');
    var bgLabel = getSelectedLabel('mp-background-grid');
    if (borderLabel) detailParts.push(borderLabel);
    if (bgLabel) detailParts.push(bgLabel + ' Background');
    detailParts.push(state.petCount + ' pet' + (state.petCount > 1 ? 's' : ''));
    if (state.petName) detailParts.push(state.petName);

    var properties = {
      'Style': state.style ? state.style.name : '',
      'Product': state.product ? state.product.title : '',
      'Details': detailParts.join(' | ')
    };

    var checkedAddons = [];
    document.querySelectorAll('.addon-item__check:checked').forEach(function (c) {
      checkedAddons.push(c.dataset.addonName);
    });
    if (checkedAddons.length) properties['Customize order'] = checkedAddons.join(' | ');

    if (state.donation > 0) {
      properties[window.MakePortraitDonationTitle || 'Donation'] = formatMoney(state.donation);
    }

    properties['_configuration'] = JSON.stringify({
      style: state.style ? {
        id: state.styleId,
        name: state.style.name
      } : null,
      product: state.product ? {
        id: state.product.id,
        title: state.product.title,
        handle: state.product.handle
      } : null,
      variant: state.variant ? {
        id: state.variant.id,
        title: state.variant.title,
        options: state.variant.options,
        price: state.variant.price
      } : null,
      extras: {
        petCount: state.petCount,
        petName: state.petName,
        addons: checkedAddons
      },
      photos: state.photoUrls
    });

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: state.variantId,
        quantity: 1,
        properties: properties
      })
    })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
      .then(function (result) {
        if (result.ok) {
          // Trigger cart:update so cart drawer can react
          document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true }));
          window.location.href = '/cart';
        } else {
          if (btn) { btn.disabled = false; btn.textContent = 'Order portrait'; }
          showError(result.data.description || result.data.message || 'An error occurred. Please try again.');
        }
      })
      .catch(function () {
        if (btn) { btn.disabled = false; btn.textContent = 'Order portrait'; }
        showError('An error occurred. Please try again.');
      });
  }

  function showError(msg) {
    var el = $('mp-cart-error');
    if (!el) return;
    el.textContent = msg;
    el.hidden = false;
  }

  function hideError() {
    var el = $('mp-cart-error');
    if (el) el.hidden = true;
  }

  /* ————————————————————————————————————————
     Tabs (left panel)
  ———————————————————————————————————————— */
  function initTabs() {
    document.querySelectorAll('.tab-nav__btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tabId = btn.dataset.tab;
        document.querySelectorAll('.tab-nav__btn').forEach(function (b) {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        document.querySelectorAll('.tab-panel').forEach(function (p) {
          p.hidden = p.dataset.tab !== tabId;
        });
      });
    });
  }

  /* ————————————————————————————————————————
     Init
  ———————————————————————————————————————— */
  function init() {
    updateDeliveryDates();
    initTabs();

    // Auto-select first style
    if (STYLES.length > 0) {
      selectStyle(STYLES[0].id);
    }

    // Style picker
    document.querySelectorAll('.style-picker__item').forEach(function (btn) {
      btn.addEventListener('click', function () { selectStyle(btn.dataset.styleId); });
    });

    // Product picker
    document.querySelectorAll('.product-picker__item').forEach(function (btn) {
      btn.addEventListener('click', function () { selectProduct(btn.dataset.productHandle); });
    });

    // CTA step 1
    var ctaStep1 = $('mp-cta-step1');
    if (ctaStep1) {
      ctaStep1.addEventListener('click', function () {
        if (!state.styleId) return;
        goToStep(2);
      });
    }

    // CTA step 2
    var ctaStep2 = $('mp-cta-step2');
    if (ctaStep2) {
      ctaStep2.addEventListener('click', function () {
        if (!state.productHandle) return;
        buildOptionsUI(state.product);
        goToStep(3);
      });
    }

    // CTA step 3
    var ctaStep3 = $('mp-cta-step3');
    if (ctaStep3) {
      ctaStep3.addEventListener('click', function () {
        state.petName = ($('mp-pet-name') || {}).value || '';
        goToStep(4);
      });
    }

    // CTA order
    var ctaOrder = $('mp-cta-order');
    if (ctaOrder) ctaOrder.addEventListener('click', addToCart);

    document.querySelectorAll('.step-indicator__btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.classList.contains('completed')) {
          goToStep(parseInt(btn.dataset.step, 10));
        }
      });
    });

    // Option button groups
    initOptionGroup('mp-border-grid', 'border');
    initOptionGroup('mp-background-grid', 'background');
    initOptionGroup('mp-pets-grid', 'petCount');

    // Pet name
    var petNameInput = $('mp-pet-name');
    if (petNameInput) {
      petNameInput.addEventListener('input', function () {
        state.petName = petNameInput.value;
      });
    }

    // File upload
    var fileInput = $('mp-file-input');
    if (fileInput) {
      fileInput.addEventListener('change', function () { handleFiles(fileInput.files); });
    }

    var uploadZone = $('mp-upload-zone');
    if (uploadZone) {
      uploadZone.addEventListener('dragover', function (e) {
        e.preventDefault();
        uploadZone.classList.add('drag-over');
      });
      uploadZone.addEventListener('dragleave', function () {
        uploadZone.classList.remove('drag-over');
      });
      uploadZone.addEventListener('drop', function (e) {
        e.preventDefault();
        uploadZone.classList.remove('drag-over');
        handleFiles(e.dataTransfer.files);
      });
    }

    // Add-on checkboxes
    document.querySelectorAll('.addon-item__check').forEach(function (check) {
      check.addEventListener('change', function () {
        state.addonTotal = 0;
        document.querySelectorAll('.addon-item__check:checked').forEach(function (c) {
          state.addonTotal += parseFloat(c.dataset.addonPrice || 0) * 100;
        });
        updateSubtotals();
      });
    });

    // Donation amounts
    document.querySelectorAll('.donation-card__amounts .option-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var val = parseInt(btn.dataset.donation, 10);
        if (btn.classList.contains('selected')) {
          btn.classList.remove('selected');
          state.donation = 0;
        } else {
          document.querySelectorAll('.donation-card__amounts .option-btn').forEach(function (b) {
            b.classList.remove('selected');
          });
          btn.classList.add('selected');
          state.donation = val;
        }
        updateSubtotals();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();

