<div class="dogstrust section section--page-width">
  <div class="dogstrust__stage">
    <div class="dogstrust__logo">
      <img src="{{ 'koninklijke-hondenbescherming_logos.svg' | asset_url }}" alt="" width="126" height="126">
    </div>

    <div class="dogstrust__inner">
      <div class="dogstrust__wrapper">
        <div class="dogstrust__bg">
          <img src="{{ 'bark-and-frame-foundation.png' | asset_url }}" alt="" data-parallax="-3vh" width="400" height="300">
        </div>

        <div class="dogstrust__content">
          <h2 class="dogstrust__title">
            {{ section.settings.title | replace: 'Every portrait makes a difference', 'Every portrait<br>makes a difference' }}
          </h2>

          <div class="dogstrust__text">
            <p>{{ section.settings.text }}</p>
          </div>

          <div class="dogstrust__button">
            <a href="{{ section.settings.button_url }}" class="button" target="_blank" rel="noopener noreferrer">
              {{ section.settings.button_label }}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="dogstrust__image">
    <img src="{{ 'dogstrust-icon.svg' | asset_url }}" alt="" width="400" height="300">
  </div>
</div>

<style>
  .dogstrust__inner {
    -webkit-mask-image: url({{ 'dogstrust-mask--vertical.svg' | asset_url }});
    mask-image: url({{ 'dogstrust-mask--vertical.svg' | asset_url }});
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-position: center top;
    mask-position: center top;
  }

  @media(min-width: 1200px){
    .dogstrust__inner {
      -webkit-mask-image: url({{ 'dogstrust-mask.svg' | asset_url }});
      mask-image: url({{ 'dogstrust-mask.svg' | asset_url }});
    }
  }
</style>

{% stylesheet %}
.dogstrust{
  --site-content-margin: var(--page-margin);
  margin: 120px 0;
  position: relative;

  .dogstrust__stage{
    position: relative;
  }

  .dogstrust__logo{
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 5;
    transform: translate(-50%, -50%);
    pointer-events: none;

    img{
      display: block;
      width: 90px;
      height: auto;
    }
  }

  .dogstrust__inner {
    background: var(--purple);
    aspect-ratio: 1/1;
  }

  .dogstrust__wrapper{
    display: grid;
    grid-template-columns: 1fr 2fr;
    height: 100%;

    .dogstrust__bg{
      position: relative;
      z-index: 1;

      img{
        position: absolute;
        top: -20%;
        left: calc(-18% - 150px);
        width: auto;
        max-width: none;
        height: 128%;
        object-fit: contain;
        object-position: left center;
      }
    }

    .dogstrust__content{
      padding: 30px 30px 30px 10px;
      margin: auto;
      position: relative;
      z-index: 2;
    }

    .dogstrust__title{
      font-size: 21px;
    }

    .dogstrust__text{
      color: var(--brown);
      font-size: var(--baf-text-medium-size);
    }

    .dogstrust__button{
      margin-top: 20px;

      .button{
        white-space: nowrap;
        display: inline-block;
        max-width: 100%;
        box-sizing: border-box;
        overflow-wrap: anywhere;
        white-space: normal;
        background-color: var(--beige);
        border: 1px solid var(--beige);
        color: var(--brown);

        &:hover{
          background-color: var(--purple);
          border-color: var(--brown);
        }
      }
    }
  }

  .dogstrust__image{
    position: absolute;
    right: 10px;
    bottom: -30px;

    img{
      width: 120px;
    }
  }

  @media(max-width: 749px){
    --site-content-margin: var(--page-margin) !important;

    .dogstrust__stage{
      grid-column: 1 / -1;
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }

    .dogstrust__inner{
      position: relative;
      aspect-ratio: auto;
      height: 185vw;
      min-height: 720px;
      max-height: 860px;
    }

    .dogstrust__wrapper{
      display: grid;
      grid-template-columns: 1fr 2fr;
      position: relative;
      z-index: 1;
      padding-top: 18px;
      box-sizing: border-box;

      .dogstrust__bg{
        position: absolute;
        inset: 0 auto 0 0;
        width: 46%;
        height: 100%;

        img{
          top: 8%;
          left: -34%;
          height: 72%;
        }
      }

      .dogstrust__content{
        position: absolute;
        top: 20%;
        left: 42%;
        width: 52%;
        box-sizing: border-box;
        margin: 0;
        padding: 30px 0;
        transform: none;
      }

      .dogstrust__title,
      .dogstrust__text{
        width: 100%;
        box-sizing: border-box;
        padding-right: var(--page-margin);
      }

      .dogstrust__button{
        width: 100%;
        margin-left: 0;
        text-align: center;
      }
    }

    .dogstrust__image{
      right: -8px;
      bottom: -36px;
    }
  }

  @media(min-width: 750px){
    margin: 180px auto;
    max-width: 920px;

    .dogstrust__logo{
      img{
        width: 96px;
      }
    }

    .dogstrust__inner{
      aspect-ratio: 845/520;
    }

    .dogstrust__wrapper{
      grid-template-columns: 1fr 2fr;

      .dogstrust__title{
        font-size: 36px;
        margin-bottom: 15px
      }

      .dogstrust__text{
        font-size: var(--baf-text-medium-size);
        width: 240px;
      }

      .dogstrust__button{
        margin-top: 30px
      }
    }

    .dogstrust__image{
      right: 10px;
      bottom: -30px;

      img{
        width: 240px;
      }
    }
  }

  @media(min-width: 750px) and (max-width: 1199px){
    --site-content-margin: var(--page-margin) !important;
    max-width: none;
    width: 100%;

    .dogstrust__stage{
      grid-column: 1 / -1;
      width: 80vw;
      max-width: 80vw;
      margin-left: calc(50% - 40vw);
      margin-right: calc(50% - 40vw);
    }

    .dogstrust__inner{
      position: relative;
      aspect-ratio: auto;
      height: 86vw;
      min-height: 700px;
      max-height: 920px;
    }

    .dogstrust__wrapper{
      grid-template-columns: 46% 40%;
      position: relative;
      z-index: 1;
      padding-top: 34px;
      box-sizing: border-box;

      .dogstrust__content{
        margin: auto 0;
        padding-right: 0;
      }
    }

    .dogstrust__wrapper{
      .dogstrust__bg{
        img{
          left: calc(-18% - 75px);
        }
      }
    }
  }

  @media(min-width: 1200px){
    .dogstrust__logo{
      top: 28px;
    }

    .dogstrust__wrapper{
      grid-template-columns: 5fr 6fr;

      .dogstrust__bg{
        overflow: hidden;

        img{
          position: static;
          width: calc(100% + 75px);
          max-width: none;
          height: calc(108% + 100px);
          margin: -100px 0 0 -75px;
          object-fit: cover;
          object-position: right center;
        }
      }

      .dogstrust__content{
        padding: 30px 80px 30px 0;
      }
    }
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "DogsTrust",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Every portrait makes a difference"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Dogs are family. For every personalised portrait we donate €2 to Dogs Trust. Helping provide care, protection and a second chance. Celebrating your dog should help another one too."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "DogsTrust"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ]
}
{% endschema %}
