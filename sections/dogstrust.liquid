<div class="dogstrust">
  <div class="dogstrust__stage">
    <div class="dogstrust__logo">
      <img src="{{ 'koninklijke-hondenbescherming_logos.svg' | asset_url }}" alt="" width="126" height="126">
    </div>

    <div class="dogstrust__inner">
      <div class="dogstrust__wrapper">
        <div class="dogstrust__bg">
          <img src="{{ 'bark-and-frame-foundation.png' | asset_url }}" alt="" data-parallax="-3.3vh" width="400" height="300">
        </div>

        <div class="dogstrust__content">
          <h2 class="dogstrust__title">
            {{ section.settings.title | replace: 'Every portrait makes a difference', 'Every portrait<br>makes a difference' }}
          </h2>

          <div class="dogstrust__text">
            <img class="dogstrust__text-shape" src="{{ 'bark-and-frame-foundation.png' | asset_url }}" alt="" aria-hidden="true" width="2480" height="3312">
            <p>{{ section.settings.text }}</p>
          </div>

          <div class="dogstrust__button">
            <a href="{{ section.settings.button_url }}" class="button" target="_blank" rel="noopener noreferrer">
              {{ section.settings.button_label }}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="dogstrust__image">
    <img src="{{ 'dogstrust-icon.svg' | asset_url }}" alt="" width="400" height="300">
  </div>
</div>

<style>
  .dogstrust__inner {
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-position: center top;
    mask-position: center top;
  }

  @media(max-width: 749px){
    .dogstrust__text-shape {
      -webkit-shape-outside: url("{{ 'bark-and-frame-foundation.png' | asset_url }}");
      shape-outside: url("{{ 'bark-and-frame-foundation.png' | asset_url }}");
    }
  }
</style>

{% stylesheet %}
.dogstrust{
  --site-content-margin: var(--page-margin);
  margin: 120px 0;
  position: relative;

  .dogstrust__stage{
    position: relative;
  }

  .dogstrust__logo{
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 5;
    transform: translate(-50%, -50%);
    pointer-events: none;

    img{
      display: block;
      width: 90px;
      height: auto;
    }
  }

  .dogstrust__inner {
    background: var(--purple);
    aspect-ratio: 1/1;
  }

  .dogstrust__wrapper{
    display: grid;
    grid-template-columns: 1fr 2fr;
    height: 100%;

    .dogstrust__bg{
      position: relative;
      z-index: 1;

      img{
        position: absolute;
        top: -20%;
        left: calc(-18% - 150px);
        width: auto;
        max-width: none;
        height: 128%;
        object-fit: contain;
        object-position: left center;
      }
    }

    .dogstrust__content{
      padding: 30px 30px 30px 10px;
      margin: auto;
      position: relative;
      z-index: 2;
    }

    .dogstrust__title{
      font-size: 21px;
    }

    .dogstrust__text{
      color: var(--brown);
      font-size: var(--baf-text-medium-size);
    }

    .dogstrust__text-shape{
      display: none;
    }

    .dogstrust__button{
      margin-top: 20px;

      .button{
        white-space: nowrap;
        display: inline-block;
        max-width: 100%;
        box-sizing: border-box;
        overflow-wrap: anywhere;
        white-space: normal;
        background-color: var(--beige);
        border: 1px solid var(--beige);
        color: var(--brown);

        &:hover{
          background-color: var(--purple);
          border-color: var(--brown);
        }
      }
    }
  }

  .dogstrust__image{
    position: absolute;
    right: 10px;
    bottom: -30px;

    img{
      width: 120px;
    }
  }

  @media(max-width: 749px){
    --site-content-margin: var(--page-margin) !important;

    .dogstrust__stage{
      grid-column: 1 / -1;
      width: calc(100vw - (var(--page-margin) * 2));
      max-width: calc(100vw - (var(--page-margin) * 2));
      margin-left: auto;
      margin-right: auto;
    }

    .dogstrust__inner{
      position: relative;
      aspect-ratio: auto;
      height: auto;
      min-height: 0;
      max-height: none;
      background: var(--purple);
    }

    .dogstrust__wrapper{
      display: grid;
      grid-template-columns: 42% 58%;
      position: relative;
      z-index: 1;
      min-height: max(120vw, var(--dogstrust-mobile-layout-height, 120vw));
      padding-top: 0;
      box-sizing: border-box;

      .dogstrust__bg{
        position: absolute;
        inset: 0 auto 0 0;
        width: 46%;
        height: 100%;
        overflow: visible;

        img{
          top: var(--dogstrust-mobile-image-top, 180px);
          bottom: auto;
          left: -85px;
          width: calc(60% + 308px);
          height: auto;
          object-fit: contain;
          object-position: right bottom;
        }
      }

      .dogstrust__content{
        grid-column: 1 / -1;
        position: relative;
        z-index: 2;
        width: 100%;
        box-sizing: border-box;
        margin: 0;
        padding: clamp(96px, 24vw, 124px) var(--page-margin) clamp(72px, 18vw, 104px);
        transform: none;
      }

      .dogstrust__title,
      .dogstrust__text{
        width: 100%;
        box-sizing: border-box;
        padding-right: 0;
      }

      .dogstrust__title{
        text-align: center;
      }

      .dogstrust__text{
        display: block;
        margin-bottom: 0;
        text-align: left;
      }

      .dogstrust__text-shape{
        display: block;
        float: left;
        width: var(--dogstrust-mobile-shape-width, 0px);
        max-width: none;
        height: auto;
        margin: var(--dogstrust-mobile-shape-top, 0px) 0 calc(var(--dogstrust-mobile-shape-height, 0px) * -1) var(--dogstrust-mobile-shape-left, 0px);
        opacity: 0;
        shape-margin: 5px;
        shape-image-threshold: 0.08;
        pointer-events: none;
      }

      .dogstrust__text p{
        margin-bottom: 0;
        text-align: left;
      }

      .dogstrust__button{
        display: block;
        position: absolute;
        z-index: 3;
        top: var(--dogstrust-mobile-button-top, 0px);
        left: 42%;
        right: 12px;
        width: auto;
        margin: 0;
        padding-right: 0;
        box-sizing: border-box;
        text-align: center;

        .button{
          max-width: 100%;
          padding-left: 20px;
          padding-right: 20px;
        }
      }
    }

    .dogstrust__image{
      right: -8px;
      bottom: -36px;
    }
  }

  @media(min-width: 750px){
    margin: 180px auto;
    max-width: 920px;

    .dogstrust__logo{
      img{
        width: 96px;
      }
    }

    .dogstrust__inner{
      aspect-ratio: 845/520;
    }

    .dogstrust__wrapper{
      grid-template-columns: 1fr 2fr;

      .dogstrust__title{
        font-size: 36px;
        margin-bottom: 15px
      }

      .dogstrust__text{
        font-size: var(--baf-text-medium-size);
        width: 240px;
      }

      .dogstrust__button{
        margin-top: 30px
      }
    }

    .dogstrust__image{
      right: -40px;
      bottom: -30px;

      img{
        width: 240px;
      }
    }
  }

  @media(min-width: 750px) and (max-width: 1399px) and (orientation: portrait){
    --site-content-margin: var(--page-margin) !important;
    max-width: none;
    width: 100%;
    margin: 180px 0;

    .dogstrust__stage{
      display: block;
      position: relative;
      left: 50%;
      width: calc(100vw - (var(--page-margin) * 2));
      max-width: none;
      margin: 0;
      padding-inline: 0;
      transform: translateX(-50%);
    }

    .dogstrust__inner{
      position: relative;
      left: 50%;
      width: calc(100vw - (var(--page-margin) * 2)) !important;
      max-width: none !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      transform: translateX(-50%);
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      aspect-ratio: auto;
      height: 86vw;
      min-height: 700px;
      max-height: 920px;
    }

    .dogstrust__wrapper{
      width: calc(100vw - (var(--page-margin) * 2)) !important;
      max-width: none !important;
      grid-template-columns: 46% 40%;
      position: relative;
      z-index: 1;
      padding-top: 34px;
      box-sizing: border-box;

      .dogstrust__content{
        position: relative;
        z-index: 2;
        margin: auto 0;
        padding-right: 0;
      }
    }

    .dogstrust__wrapper{
      .dogstrust__bg{
        z-index: 1;
        overflow: visible;

        img{
          top: -100px;
          left: -15px;
          width: calc(97.75% + 73.3125px);
          height: calc(105.57% + 97.75px);
          object-fit: cover;
          object-position: right center;
        }
      }
    }
  }

  @media(min-width: 1400px), (min-width: 750px) and (orientation: landscape){
    max-width: 920px;
    width: 100%;

    .dogstrust__stage{
      grid-column: 2;
      display: block;
      left: auto;
      width: auto;
      max-width: none;
      margin-left: 0;
      margin-right: 0;
      padding-inline: 0;
      transform: none;
    }

    .dogstrust__logo{
      top: 0;
    }

    .dogstrust__inner{
      width: auto;
      max-width: none;
      aspect-ratio: 845/520;
      height: auto;
      min-height: 0;
      max-height: none;
    }

    .dogstrust__wrapper{
      grid-template-columns: 5fr 6fr;
      padding-top: 0;

      .dogstrust__bg{
        overflow: hidden;

        img{
          position: static;
          width: calc(100% + 75px);
          max-width: none;
          height: calc(108% + 100px);
          margin: -100px 0 0 -75px;
          object-fit: cover;
          object-position: right center;
        }
      }

      .dogstrust__content{
        padding: 30px 80px 30px 0;
      }
    }
  }

}

{% endstylesheet %}

<script>
  (() => {
    const mobileQuery = window.matchMedia('(max-width: 749px)');
    const horizontalQuery = window.matchMedia('(min-width: 1400px), (min-width: 750px) and (orientation: landscape)');
    const bandRatio = 203 / 467;
    const stepRatio = 132 / 467;
    const imageAlphaTopRatio = 592 / 3312;

    function getDogstrustMaskUrl(width, height, isHorizontal) {
      const rects = [];

      if (isHorizontal) {
        const bandHeight = height * bandRatio;
        const radius = bandHeight / 2;

        [0, height * stepRatio, height * stepRatio * 2].forEach((top) => {
          rects.push(`<rect x="0" y="${top}" width="${width}" height="${bandHeight}" rx="${radius}" ry="${radius}" fill="white"/>`);
        });
      } else {
        const bandWidth = width * bandRatio;
        const radius = bandWidth / 2;

        [0, width * stepRatio, width * stepRatio * 2].forEach((left) => {
          rects.push(`<rect x="${left}" y="0" width="${bandWidth}" height="${height}" rx="${radius}" ry="${radius}" fill="white"/>`);
        });
      }

      const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}">${rects.join('')}</svg>`;
      return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
    }

    function getContainedImageRect(img) {
      const rect = img.getBoundingClientRect();
      const naturalWidth = img.naturalWidth || 2480;
      const naturalHeight = img.naturalHeight || 3312;
      const aspect = naturalWidth / naturalHeight;
      let width = rect.width;
      let height = width / aspect;

      if (height > rect.height && rect.height > 0) {
        height = rect.height;
        width = height * aspect;
      }

      return {
        left: rect.right - width,
        top: rect.top,
        right: rect.right,
        bottom: rect.top + height,
        width,
        height,
      };
    }

    function applyDogstrustMobileLayout() {
      document.querySelectorAll('.dogstrust__wrapper').forEach((wrapper) => {
        const img = wrapper.querySelector('.dogstrust__bg img');
        const content = wrapper.querySelector('.dogstrust__content');
        const text = wrapper.querySelector('.dogstrust__text');
        const paragraph = wrapper.querySelector('.dogstrust__text p');
        const shape = wrapper.querySelector('.dogstrust__text-shape');
        const buttonWrap = wrapper.querySelector('.dogstrust__button');
        const button = wrapper.querySelector('.dogstrust__button .button');

        if (!img || !content || !text || !paragraph || !shape || !buttonWrap || !button) return;

        if (!mobileQuery.matches) {
          wrapper.style.removeProperty('--dogstrust-mobile-layout-height');
          wrapper.style.removeProperty('--dogstrust-mobile-image-top');
          wrapper.style.removeProperty('--dogstrust-mobile-shape-width');
          wrapper.style.removeProperty('--dogstrust-mobile-shape-height');
          wrapper.style.removeProperty('--dogstrust-mobile-shape-left');
          wrapper.style.removeProperty('--dogstrust-mobile-shape-top');
          content.style.removeProperty('--dogstrust-mobile-button-top');
          return;
        }

        wrapper.style.removeProperty('--dogstrust-mobile-layout-height');

        for (let i = 0; i < 3; i += 1) {
          const wrapperRect = wrapper.getBoundingClientRect();
          const paragraphRect = paragraph.getBoundingClientRect();
          const imageRect = getContainedImageRect(img);
          const desiredVisibleTop = paragraphRect.bottom - wrapperRect.top - 40;
          const imageTop = Math.max(0, desiredVisibleTop - (imageRect.height * imageAlphaTopRatio) + 80);

          wrapper.style.setProperty('--dogstrust-mobile-image-top', `${Math.round(imageTop)}px`);

          const movedImageRect = getContainedImageRect(img);
          const textRect = text.getBoundingClientRect();

          wrapper.style.setProperty('--dogstrust-mobile-shape-width', `${Math.round(movedImageRect.width)}px`);
          wrapper.style.setProperty('--dogstrust-mobile-shape-height', `${Math.round(movedImageRect.height)}px`);
          wrapper.style.setProperty('--dogstrust-mobile-shape-left', `${Math.round(movedImageRect.left - textRect.left)}px`);
          wrapper.style.setProperty('--dogstrust-mobile-shape-top', `${Math.round(movedImageRect.top - textRect.top)}px`);
        }

        const wrapperRect = wrapper.getBoundingClientRect();
        const contentRect = content.getBoundingClientRect();
        const paragraphRect = paragraph.getBoundingClientRect();
        const imageRect = getContainedImageRect(img);
        const buttonTop = Math.round(paragraphRect.bottom - contentRect.top + 8);

        content.style.setProperty('--dogstrust-mobile-button-top', `${buttonTop}px`);

        const buttonHeight = button.getBoundingClientRect().height;
        const buttonBottom = (contentRect.top - wrapperRect.top) + buttonTop + buttonHeight;
        const imageHiddenBottom = imageRect.bottom - wrapperRect.top - 90;
        const minHeight = Math.ceil(Math.max(window.innerWidth * 1.2, buttonBottom + 84, imageHiddenBottom) + 50);

        wrapper.style.setProperty('--dogstrust-mobile-layout-height', `${minHeight}px`);
      });
    }

    function applyDogstrustMask() {
      document.querySelectorAll('.dogstrust__inner').forEach((inner) => {
        const rect = inner.getBoundingClientRect();
        const width = Math.round(rect.width);
        const height = Math.round(rect.height);

        if (!width || !height) return;

        const maskUrl = getDogstrustMaskUrl(width, height, horizontalQuery.matches);

        inner.style.setProperty('-webkit-mask-image', maskUrl);
        inner.style.setProperty('mask-image', maskUrl);
      });
    }

    let dogstrustMaskFrame = null;

    function scheduleDogstrustMask() {
      cancelAnimationFrame(dogstrustMaskFrame);
      dogstrustMaskFrame = requestAnimationFrame(() => {
        applyDogstrustMobileLayout();
        applyDogstrustMask();
        requestAnimationFrame(() => {
          applyDogstrustMobileLayout();
          applyDogstrustMask();
        });
      });
    }

    scheduleDogstrustMask();
    window.addEventListener('load', scheduleDogstrustMask);
    window.addEventListener('resize', scheduleDogstrustMask, { passive: true });
    document.addEventListener('shopify:section:load', scheduleDogstrustMask);

    if (horizontalQuery.addEventListener) {
      horizontalQuery.addEventListener('change', scheduleDogstrustMask);
    } else {
      horizontalQuery.addListener(scheduleDogstrustMask);
    }

    if (mobileQuery.addEventListener) {
      mobileQuery.addEventListener('change', scheduleDogstrustMask);
    } else {
      mobileQuery.addListener(scheduleDogstrustMask);
    }

    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(scheduleDogstrustMask);
      document.querySelectorAll('.dogstrust__inner').forEach((inner) => observer.observe(inner));
    }
  })();
</script>

{% schema %}
{
  "name": "DogsTrust",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Every portrait makes a difference"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Dogs are family. For every personalised portrait we donate €2 to Dogs Trust. Helping provide care, protection and a second chance. Celebrating your dog should help another one too."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "DogsTrust"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ]
}
{% endschema %}
