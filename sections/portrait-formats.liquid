<div class="portrait-formats section section--page-width">
  <div class=portrait-formats__inner>
    <div class="portrait-formats__bg">
      <img src="{{ 'portait-formats-bg.jpg' | asset_url }}" alt="" data-parallax width="1200" height="800">
    </div>
    <div class="portrait-formats__wrapper">
      <h2 class="portrait-formats__title">
        {{ section.settings.main-text }}
      </h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="portrait-formats__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <div class="portrait-formats__content" data-parallax>
        {% content_for 'blocks' %}
      </div>

      {% if section.settings.button_text != blank %}
        <div class="portrait-formats__button">
          <a href="{{ section.settings.button_link }}" class="button">
            {{ section.settings.button_text }}
          </a>
        </div>
      {% endif %}
    </div>
    
  </div>
</div>

{% stylesheet %}
.portrait-formats{
  margin: 120px 0;
  overflow: hidden;

  .portrait-formats__inner{
    position: relative;
    aspect-ratio: 4/5;
    width: 100%;

    .portrait-formats__bg{
      border-radius: 80px;
      overflow: hidden;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      transition: opacity .3s;

      img{
        height: 110%;
        object-fit: cover;
        object-position: center;
      }
    }

    .portrait-formats__wrapper{
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }
  }

  .portrait-formats__content{
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
  }

  .portrait-formats__title{
    padding: 40px 30px 0;
    margin-bottom: 0;
    font-size: 5vw;
    max-width: 55%;
    position: relative;
    z-index: 2;
    transition: opacity .3s;
  }

  .portrait-formats__subtitle {
    padding: 15px 30px 0;
    margin: 0;
    font-size: 14px;
    color: var(--brown);
    position: relative;
    z-index: 2;
    transition: opacity .3s;
    max-width: 50%;
    font-weight: 700;
  }

  .portrait-formats__button{
    margin-bottom: 0;
    position: absolute;
    bottom: 20px;
    width: 100%;
    transition: opacity .3s;

    .button{
      margin: 0 auto;
    }
  }

  &.hovered{
    .portrait-formats__bg, .portrait-formats__title, product-card--custom:not(:hover), .portrait-formats__button{
      opacity: .81;
    }
  }

  @media(min-width: 750px){
    .portrait-formats__inner{
      aspect-ratio: 3/2;
    }

    .portrait-formats__title{
      max-width: 40%;
    }

    .portrait-formats__subtitle{
      font-size: 18px;
      max-width: 300px;
    }
  }

  @media(min-width: 1200px){
    margin: 180px 0;

    .portrait-formats__title{
      font-size: 54px;
      padding: 60px 40px 30px;
      width: 440px;
    }

    .portrait-formats__subtitle{
      padding: 0 40px;
      max-width: 320px;
    }

    .portrait-formats__button{
      bottom: 40px;
    }
  }
}

{% endstylesheet %}

{% javascript %}
 
{% endjavascript %}

{% schema %}
{
  "name": "Portrait formats",
  "settings": [
    {
      "type": "text",
      "id": "main-text",
      "label": "Main Text",
      "default": "Each style preserves something different.<br>Not better, just different."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Podnadpis",
      "default": "Same dog. Same style. More places to love them."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "product-card--bubble"
    },
  ]
}
{% endschema %}
