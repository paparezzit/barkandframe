<link rel="stylesheet" href="{{ 'baf-section-portrait-donation-impact.css' | asset_url }}" media="print, (min-width: 990px)" onload="this.onload=null;this.media='all'">
<noscript>{{ 'baf-section-portrait-donation-impact.css' | asset_url | stylesheet_tag }}</noscript>

<div class="portrait-donation-impact">
  <div class="portrait-donation-impact__stage">
    <div class="portrait-donation-impact__logo">
      <img src="{{ 'koninklijke-hondenbescherming_logos.svg' | asset_url }}" alt="" width="126" height="126" loading="lazy" decoding="async">
    </div>

    <div class="portrait-donation-impact__inner">
      <div class="portrait-donation-impact__wrapper">
        <div class="portrait-donation-impact__bg">
          <picture>
            <source
              type="image/webp"
              media="(max-width: 749px), (min-width: 750px) and (orientation: portrait)"
              sizes="50vw"
              srcset="{{ 'bark-and-frame-foundation-mobile-520.webp' | asset_url }} 520w, {{ 'bark-and-frame-foundation-mobile-748.webp' | asset_url }} 748w"
            >
            <source
              media="(max-width: 749px), (min-width: 750px) and (orientation: portrait)"
              srcset="{{ 'bark-and-frame-foundation-mobile.png' | asset_url }}"
            >
            <source
              type="image/webp"
              sizes="480px"
              srcset="{{ 'bark-and-frame-foundation-900.webp' | asset_url }} 900w, {{ 'bark-and-frame-foundation-1200.webp' | asset_url }} 1200w"
            >
            <img src="{{ 'bark-and-frame-foundation.png' | asset_url }}" alt="" data-parallax="-3.3vh" width="400" height="300" loading="lazy" decoding="async" fetchpriority="low">
          </picture>
        </div>

        <div class="portrait-donation-impact__content">
          <h2 class="portrait-donation-impact__title">
            {{ section.settings.title | replace: 'Every portrait makes a difference', 'Every portrait<br>makes a difference' }}
          </h2>

          <div class="portrait-donation-impact__text">
            <img class="portrait-donation-impact__text-shape" src="{{ 'bark-and-frame-foundation-mobile-748.webp' | asset_url }}" alt="" aria-hidden="true" width="748" height="1000" loading="lazy" decoding="async">
            <p>{{ section.settings.text }}</p>
          </div>

          <div class="portrait-donation-impact__button">
            <a href="{{ section.settings.button_url }}" class="button" target="_blank" rel="noopener noreferrer">
              {{ section.settings.button_label | replace: 'Koninklijke Hondenbescherming', 'Koninklijke<br class="portrait-donation-impact__button-break">Hondenbescherming' }}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="portrait-donation-impact__image">
    <img src="{{ 'dogstrust-icon.svg' | asset_url }}" alt="" width="400" height="300" loading="lazy" decoding="async">
  </div>
</div>

<style>
  .portrait-donation-impact__inner {
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-position: center top;
    mask-position: center top;
  }

  .portrait-donation-impact__button-break {
    display: none;
  }

  @media(max-width: 749px), (min-width: 750px) and (orientation: portrait){
    .portrait-donation-impact__text-shape {
      -webkit-shape-outside: url("{{ 'bark-and-frame-foundation-mobile-748.webp' | asset_url }}");
      shape-outside: url("{{ 'bark-and-frame-foundation-mobile-748.webp' | asset_url }}");
    }

    .portrait-donation-impact__button-break {
      display: block;
    }
  }
</style>

<script>
  (() => {
    const horizontalQuery = window.matchMedia('(min-width: 750px) and (orientation: landscape)');
    const horizontalBandRatio = 203 / 467;
    const horizontalStepRatio = 132 / 467;
    const portraitBandRatio = 212 / 467;
    const portraitStepRatio = 127.5 / 467;

    function getPortraitDonationImpactMaskUrl(width, height, isHorizontal) {
      const rects = [];

      if (isHorizontal) {
        const bandRatio = horizontalBandRatio;
        const stepRatio = horizontalStepRatio;
        const bandHeight = height * bandRatio;
        const radius = bandHeight / 2;

        [0, height * stepRatio, height * stepRatio * 2].forEach((top) => {
          rects.push(`<rect x="0" y="${top}" width="${width}" height="${bandHeight}" rx="${radius}" ry="${radius}" fill="white"/>`);
        });
      } else {
        const bandRatio = portraitBandRatio;
        const stepRatio = portraitStepRatio;
        const bandWidth = width * bandRatio;
        const radius = bandWidth / 2;

        [0, width * stepRatio, width * stepRatio * 2].forEach((left) => {
          rects.push(`<rect x="${left}" y="0" width="${bandWidth}" height="${height}" rx="${radius}" ry="${radius}" fill="white"/>`);
        });
      }

      const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}">${rects.join('')}</svg>`;
      return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
    }

    function applyPortraitDonationImpactMask() {
      document.querySelectorAll('.portrait-donation-impact__inner').forEach((inner) => {
        const rect = inner.getBoundingClientRect();
        const width = Math.round(rect.width);
        const height = Math.round(rect.height);

        if (!width || !height) return;

        const maskUrl = getPortraitDonationImpactMaskUrl(width, height, horizontalQuery.matches);

        inner.style.setProperty('-webkit-mask-image', maskUrl);
        inner.style.setProperty('mask-image', maskUrl);
      });
    }

    let portraitDonationImpactMaskFrame = null;
    let portraitDonationImpactMaskWidth = window.innerWidth;

    function schedulePortraitDonationImpactMask() {
      cancelAnimationFrame(portraitDonationImpactMaskFrame);
      portraitDonationImpactMaskFrame = requestAnimationFrame(() => {
        applyPortraitDonationImpactMask();
      });
    }

    function handlePortraitDonationImpactResize() {
      if (Math.abs(window.innerWidth - portraitDonationImpactMaskWidth) <= 20) return;
      portraitDonationImpactMaskWidth = window.innerWidth;
      schedulePortraitDonationImpactMask();
    }

    schedulePortraitDonationImpactMask();
    window.addEventListener('load', schedulePortraitDonationImpactMask);
    window.addEventListener('resize', handlePortraitDonationImpactResize, { passive: true });
    window.addEventListener('orientationchange', () => {
      window.setTimeout(() => {
        portraitDonationImpactMaskWidth = window.innerWidth;
        schedulePortraitDonationImpactMask();
      }, 250);
    }, { passive: true });
    document.addEventListener('shopify:section:load', schedulePortraitDonationImpactMask);

    if (horizontalQuery.addEventListener) {
      horizontalQuery.addEventListener('change', schedulePortraitDonationImpactMask);
    } else {
      horizontalQuery.addListener(schedulePortraitDonationImpactMask);
    }
  })();
</script>

{% schema %}
{
  "name": "Portrait donation impact",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Every portrait makes a difference"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Dogs are family. For every personalised portrait we donate €2 to Dogs Trust. Helping provide care, protection and a second chance. Celebrating your dog should help another one too."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "DogsTrust"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ]
}
{% endschema %}
