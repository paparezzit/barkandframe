{%- liquid
  assign portrait_styles = shop.metaobjects.portrait_style.values | sort: 'order'
  assign portrait_categories = shop.metaobjects.portrait_category.values
-%}

<div class="portrait-styles section section--page-width">
  <div class="portrait-styles__inner">
    <div class="portrait-styles__wrapper">
      <h2 class="portrait-styles__title">
        {{ section.settings.main-title }}
      </h2>

      <div class="portrait-styles__content">
        <div class="portrait-grid">
          {%- for style in portrait_styles -%}
            {%- assign cat_handles = '' -%}
            {%- for cat in style.categories.value -%}
              {%- unless forloop.first -%}{%- assign cat_handles = cat_handles | append: ' ' -%}{%- endunless -%}
              {%- assign cat_handles = cat_handles | append: cat.system.handle -%}
            {%- endfor -%}
            {%- liquid
              assign portrait_style_name = style.name.value
              assign is_bestseller_style = false
              assign is_soon_style = false
              if portrait_style_name == 'La Parisienne' or portrait_style_name == 'La Parisien' or portrait_style_name == 'Pure Portrait' or portrait_style_name == 'Studio Pencil'
                assign is_bestseller_style = true
              endif
              if portrait_style_name == 'Atelier Sketch'
                assign is_soon_style = true
              endif
            -%}
            <a href="/pages/portrait?style={{ style.style_id.value | url_encode }}" class="portrait{% if is_soon_style %} portrait--soon{% endif %}" data-style="{{ cat_handles }}">
              {%- if is_bestseller_style -%}
                <span class="portrait__badge portrait__badge--bestseller" aria-hidden="true">Bestseller</span>
              {%- endif -%}
              <span class="portrait__image">
                {%- if style.preview_image.value -%}
                  <img src="{{ style.preview_image.value | image_url: width: 800 }}" alt="{{ style.name.value }}" width="800" height="1000" loading="lazy">
                {%- endif -%}
                {%- if is_soon_style -%}
                  <span class="portrait__soon" aria-hidden="true">Soon</span>
                {%- endif -%}
              </span>
              <span class="portrait__label">{{ style.name.value }}</span>
            </a>
          {%- endfor -%}
        </div>
        <div class="portrait-grid-scrollbar" aria-hidden="true">
          <span class="portrait-grid-scrollbar__thumb"></span>
        </div>

        <div class="portrait-selector">
          <p class="portrait-selector__text">
            {{ section.settings.main-text }}
          </p>

          <div class="accordion">
            {%- for i in (1..20) -%}
              {%- for cat in portrait_categories -%}
                {%- if cat.order.value == i -%}
                  <div class="accordion-item">
                    <button class="accordion-header" data-key="{{ cat.system.handle }}">{{ cat.name.value }}</button>
                    <div class="accordion-content">
                      <div class="accordion-inner">{{ cat.description.value }}</div>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
            {%- for cat in portrait_categories -%}
              {%- if cat.order.value == blank -%}
                <div class="accordion-item">
                  <button class="accordion-header" data-key="{{ cat.system.handle }}">{{ cat.name.value }}</button>
                  <div class="accordion-content">
                    <div class="accordion-inner">{{ cat.description.value }}</div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

    </div>

    {%- if section.settings.button_text != blank -%}
      <div class="portrait-styles__button">
        <a href="{{ section.settings.button_link }}" class="button">
          {{ section.settings.button_text }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
.portrait-styles{
  margin: 120px 0;

  .portrait-styles__inner{
    padding: 80px 20px 60px;
    background: #F4EFE5;
    border-radius: calc(var(--baf-radius-xl) + 40px);
  }

  .portrait-styles__title{
    text-align: center;
    margin-bottom: 0;
  }

  .portrait-grid{
    margin: 40px -20px 20px;
    overflow-x: auto;
    overflow-y: hidden;
    white-space: nowrap;
    gap: 10px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-inline: contain;

    &::-webkit-scrollbar{
      display: none;
    }

    .portrait{
      position: relative;
      aspect-ratio: 5/6;
      width: clamp(170px, 48vw, 230px);
      display: inline-block;
      margin: 0 5px;
      

      &:first-child{
        margin-left: 20px;
      }

      &:last-child{
        margin-right: 20px;
      }

      .portrait__image{
        height: 100%;
        width: 100%;
        border-radius: 20px;
        overflow: hidden;
        transition: opacity .3s, transform .3s;
        display: block;

        img{
          width: 100%;
          height: 100%;
          object-fit: cover;
          object-position: center;
        }
      }

      .portrait__badge{
        position: absolute;
        top: 0;
        left: 0;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 15px;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 500;
        line-height: 1;
        text-transform: uppercase;
        white-space: nowrap;
        pointer-events: none;
      }

      .portrait__badge--bestseller{
        background: var(--green);
        color: var(--beige);
      }

      .portrait__soon{
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 3;
        transform: translate(-50%, -50%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 15px;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 500;
        line-height: 1;
        text-transform: uppercase;
        white-space: nowrap;
        pointer-events: none;
        background: var(--brown);
        color: var(--beige);
      }

      &.portrait--soon{
        .portrait__image img{
          opacity: 0.45;
        }
      }

      .portrait__label{
        background-color: var(--beige);
        color: var(--green);
        white-space: nowrap;
        border-radius: 1000px;
        padding: 2px 8px;
        font-size: 10px;
        transition: opacity .3s;
        margin: 10px auto 0;
        display: block;
        width: fit-content;
        position: relative;
      }

      &.faded{
        .portrait__image{
          opacity: .27;
        }

        .portrait__label{
          opacity: 0;
          pointer-events: none;
        }

        .portrait__badge{
          opacity: 0;
        }

        .portrait__soon{
          opacity: 0;
        }
      }
    }
  }

  .portrait-grid-scrollbar{
    position: relative;
    height: 22px;
    margin: 0 20px 24px;
    cursor: pointer;
  }

  .portrait-grid-scrollbar::before{
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 10px;
    height: 2px;
    background: rgb(76 68 63 / 0.18);
    border-radius: 1000px;
  }

  .portrait-grid-scrollbar__thumb{
    display: block;
    position: absolute;
    left: 0;
    top: 10px;
    height: 2px;
    width: 34px;
    background: var(--brown);
    border-radius: 1000px;
    transform: translateX(0);
    transition: width 0.1s linear;
  }

  .portrait-selector{
    .portrait-selector__text{
      font-weight: 700;
    }

    .accordion{
      margin: 40px 0 30px;
      border-bottom: 1px solid var(--brown);

      .accordion-header{
        width: 100%;
        padding: 10px 0;
        font-size: var(--baf-display-small-size);
        border: none;
        border-top: 1px solid var(--brown);
        color: var(--brown);
        text-align:left;
        background: transparent;
        cursor: pointer;
        font-family: "display", "Times New Roman", serif;
        position: relative;

        &::before, &::after{
          width: 16px;
          height: 1px;
          background-color: var(--brown);
          content: "";
          display: block;
          position: absolute;
          top: 50%;
          right: 0;
          transform-origin: center;
          transition: transform .3s;
        }

        &::after{
          transform: rotate(90deg);
        }
      }

      .accordion-item.active{
        .accordion-header{
          &::before{
            transform: rotate(45deg);
          }

          &::after{
            transform: rotate(135deg);
          }
        }
      }

      .accordion-content{
        height:0;
        overflow:hidden;
        transition:height .35s ease;
      }

      .accordion-inner{
        padding: 0 0 80px;
        max-width: 420px;
      }
    }
  }

  .portrait-styles__button{
    text-align: center;

    .button{
      display: inline-block;
    }
  }

  @media(min-width: 1200px){
    .portrait-styles__inner{
      padding: 80px 40px 60px
    }

    .portrait-styles__content{
      display: flex;
      flex-direction: row-reverse;
      gap: 30px;
      margin: 60px 0 40px;

      .portrait-grid{
        flex: 6;
        margin: 0 0 auto;
        overflow: visible;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 20px 10px;

        .portrait{
          width: 130px;
          margin: 0;
        }

        &:hover{
          .portrait:not(:hover){
            .portrait__image{
              opacity: .27;
            }

            .portrait__label{
              opacity: 0;
              pointer-events: none;
            }
          }

          .portrait:hover{
            z-index: 4;
            .portrait__image{
              opacity: 1;
              transform: scale(1.55);
            }

            .portrait__label{
              opacity: 1;
              pointer-events: auto;
              z-index: 3;
              bottom: 0;
            }
          }
        }
      }

      .portrait-grid-scrollbar{
        display: none;
      }

      .portrait-selector{
        flex: 4;
      }
    }
  }

  @media(min-width: 1200px){
    margin: 90px 0; 

    .portrait-styles__inner{
      --portrait-styles-cta-top: 1064px;
      min-height: 1208px;
      padding: 130px 150px 100px;
      position: relative;
    }

    .portrait-styles__title{
      font-size: 96px;
      line-height: 100%;
      max-width: 720px;
      margin: 0 auto;
    }

    .portrait-styles__content{
      margin: 90px 0 60px;
      gap: 40px;

      .portrait-grid{
        grid-template-columns: 1fr 1fr 1fr 1fr;
        flex: 6;
        
        .portrait{
          .portrait__label{
          }
        }
      }
    }

    .portrait-selector{
      .portrait-selector__text{
        font-size: 18px;
        margin-bottom: 100px;
        color: var(--brown);
      }

      .accordion{
        .accordion-header{
          font-size: 36px;
          padding: 15px 0;

          &::before, &::after{
            width: 28px;
          }
        }
      }
    }

    .portrait-styles__button{
      position: absolute;
      top: var(--portrait-styles-cta-top);
      left: 50%;
      transform: translateX(-50%);
      width: max-content;
    }
  }
}

{% endstylesheet %}

{% javascript %}
  const headers = document.querySelectorAll(".accordion-header");
  const portraits = document.querySelectorAll(".portrait-grid .portrait");
  const portraitGrid = document.querySelector(".portrait-grid");
  const portraitGridScrollbar = document.querySelector(".portrait-grid-scrollbar");
  const portraitGridThumb = portraitGridScrollbar?.querySelector(".portrait-grid-scrollbar__thumb");

  function closeItem(item){

    const content = item.querySelector(".accordion-content");
    const inner = item.querySelector(".accordion-inner");

    content.style.height = "0px";

    requestAnimationFrame(()=>{
      content.style.height = "0px";
    });

    item.classList.remove("active");

    portraits.forEach(portrait => {
      portrait.classList.remove("faded");
    })

  }

  function openItem(item){

    const content = item.querySelector(".accordion-content");
    const inner = item.querySelector(".accordion-inner");

    content.style.height = inner.scrollHeight + "px";

    item.classList.add("active");
  }

  headers.forEach(header => {

    header.addEventListener("click", () => {

      const item = header.parentElement;
      const key = header.dataset.key;
      const isOpen = item.classList.contains("active");

      document.querySelectorAll(".accordion-item.active").forEach(open => {

        if(open !== item){
          closeItem(open);
        }

      });

      if(isOpen){
        closeItem(item);
        return;
      }

      openItem(item);

      portraits.forEach(portrait => {
        if (portrait.dataset.style.includes(header.dataset.key)) {
          portrait.classList.remove("faded");
        } else {
          portrait.classList.add("faded");
        }
      })

    });

  });

  function updatePortraitGridScrollbar(){
    if (!portraitGrid || !portraitGridScrollbar || !portraitGridThumb) return;

    const maxScroll = portraitGrid.scrollWidth - portraitGrid.clientWidth;

    if (maxScroll <= 0) {
      portraitGridScrollbar.hidden = true;
      portraitGridThumb.style.width = "100%";
      portraitGridThumb.style.transform = "translateX(0)";
      return;
    }

    portraitGridScrollbar.hidden = false;

    const trackWidth = portraitGridScrollbar.clientWidth;
    const thumbWidth = Math.max((portraitGrid.clientWidth / portraitGrid.scrollWidth) * trackWidth, 34);
    const left = ((trackWidth - thumbWidth) * portraitGrid.scrollLeft) / maxScroll;

    portraitGridThumb.style.width = `${thumbWidth}px`;
    portraitGridThumb.style.transform = `translateX(${left}px)`;
  }

  function scrollPortraitGridFromScrollbar(clientX){
    if (!portraitGrid || !portraitGridScrollbar || !portraitGridThumb) return;

    const maxScroll = portraitGrid.scrollWidth - portraitGrid.clientWidth;
    if (maxScroll <= 0) return;

    const rect = portraitGridScrollbar.getBoundingClientRect();
    const thumbWidth = portraitGridThumb.offsetWidth || 34;
    const usableWidth = Math.max(rect.width - thumbWidth, 1);
    const progress = Math.min(Math.max((clientX - rect.left - thumbWidth / 2) / usableWidth, 0), 1);

    portraitGrid.scrollLeft = progress * maxScroll;
    updatePortraitGridScrollbar();
  }

  function refreshPortraitGridScrollbar(){
    updatePortraitGridScrollbar();
    requestAnimationFrame(() => {
      updatePortraitGridScrollbar();
      requestAnimationFrame(updatePortraitGridScrollbar);
    });
  }

  let activePortraitGridScrollbar = false;

  portraitGrid?.addEventListener("scroll", updatePortraitGridScrollbar, { passive: true });

  portraitGridScrollbar?.addEventListener("pointerdown", event => {
    activePortraitGridScrollbar = true;
    portraitGridScrollbar.setPointerCapture?.(event.pointerId);
    scrollPortraitGridFromScrollbar(event.clientX);
    event.preventDefault();
  });

  document.addEventListener("pointermove", event => {
    if (!activePortraitGridScrollbar) return;
    scrollPortraitGridFromScrollbar(event.clientX);
    event.preventDefault();
  });

  document.addEventListener("pointerup", () => {
    activePortraitGridScrollbar = false;
  });

  document.addEventListener("pointercancel", () => {
    activePortraitGridScrollbar = false;
  });

  window.addEventListener("resize", refreshPortraitGridScrollbar);
  window.addEventListener("load", refreshPortraitGridScrollbar);
  refreshPortraitGridScrollbar();
{% endjavascript %}

{% schema %}
{
  "name": "Three Steps",
  "settings": [
    {
      "type": "text",
      "id": "main-text",
      "label": "Main Text",
      "default": "Each style preserves something different.<br>Not better, just different."
    },
    {
      "type": "text",
      "id": "main-title",
      "label": "Main Title",
      "default": "Every portrait tells differently"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
