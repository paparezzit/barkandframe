{%- liquid
  assign portrait_styles = shop.metaobjects.portrait_style.values | sort: 'order'
  assign portrait_categories = shop.metaobjects.portrait_category.values
-%}

<link rel="stylesheet" href="{{ 'baf-section-portrait-styles.css' | asset_url }}" media="print, (min-width: 990px)" onload="this.onload=null;this.media='all'">
<noscript>{{ 'baf-section-portrait-styles.css' | asset_url | stylesheet_tag }}</noscript>

<div class="portrait-styles section section--page-width">
  <div class="portrait-styles__inner force-full-width">
    <div class="portrait-styles__wrapper">
      {%- assign portrait_title_parts = section.settings.main-title | split: '. ' -%}
      <h2 class="portrait-styles__title">
        {%- if portrait_title_parts.size > 1 -%}
          {{- portrait_title_parts.first -}}.<span class="portrait-styles__title-space"> </span><br class="portrait-styles__title-break">
          {%- for title_part in portrait_title_parts -%}
            {%- unless forloop.first -%}
              {{- title_part -}}{%- unless forloop.last -%}. {% endunless -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {{- section.settings.main-title -}}
        {%- endif -%}
      </h2>

      <div class="portrait-styles__content">
        <div class="portrait-grid">
          {%- for style in portrait_styles -%}
            {%- assign cat_handles = '' -%}
            {%- for cat in style.categories.value -%}
              {%- unless forloop.first -%}{%- assign cat_handles = cat_handles | append: ' ' -%}{%- endunless -%}
              {%- assign cat_handles = cat_handles | append: cat.system.handle -%}
            {%- endfor -%}
            {%- liquid
              assign portrait_style_name = style.name.value
              assign is_bestseller_style = false
              assign is_soon_style = false
              assign is_studio_choice_style = false
              if portrait_style_name == 'La Parisienne' or portrait_style_name == 'La Parisien' or portrait_style_name == 'Pure Portrait' or portrait_style_name == 'Studio Pencil'
                assign is_bestseller_style = true
              endif
              if portrait_style_name == 'Atelier Sketch'
                assign is_soon_style = true
              endif
              if portrait_style_name == 'Studio Pop'
                assign is_studio_choice_style = true
              endif
            -%}
            <a href="/pages/portrait?style={{ style.style_id.value | url_encode }}" class="portrait{% if is_soon_style %} portrait--soon{% endif %}" data-style="{{ cat_handles }}">
              <span class="portrait__image">
	                <span class="portrait__media">
	                  {%- assign preview_image = style.preview_image.value -%}
	                  {%- if preview_image -%}
	                    {{
	                      preview_image
	                      | image_url: width: 320
	                      | image_tag:
	                        alt: style.name.value,
	                        width: preview_image.width,
	                        height: preview_image.height,
	                        widths: '120, 160, 200, 240, 320',
	                        sizes: '(max-width: 749px) 24vw, (max-width: 1199px) 120px, 180px',
	                        loading: 'lazy',
	                        decoding: 'async'
	                    }}
	                  {%- endif -%}
                </span>
                {%- if is_bestseller_style -%}
                  <span class="portrait__badge portrait__badge--bestseller" aria-hidden="true">Bestseller</span>
                {%- endif -%}
                {%- if is_studio_choice_style -%}
                  <span class="portrait__badge portrait__badge--studio-choice" aria-hidden="true">STUDIO CHOICE</span>
                {%- endif -%}
              </span>
              {%- if is_soon_style -%}
                <span class="portrait__soon" aria-hidden="true">Soon</span>
              {%- endif -%}
              <span class="portrait__label">{{ style.name.value }}</span>
            </a>
          {%- endfor -%}
          <div class="portrait portrait--value-card" aria-label="From €99. Free shipping">
            <span class="portrait-value-card__inner">
              <span class="portrait-value-card__price">
                <span class="portrait-value-card__prefix">from</span>
                <span class="portrait-value-card__amount">€99</span>
              </span>
              <span class="portrait-value-card__shipping">Free shipping</span>
            </span>
          </div>
        </div>
        <div class="portrait-grid-scrollbar" aria-hidden="true">
          <span class="portrait-grid-scrollbar__thumb"></span>
        </div>

        <div class="portrait-selector">
          <p class="portrait-selector__text">
            {{ section.settings.main-text }}
          </p>

          <div class="accordion">
            {%- for i in (1..20) -%}
              {%- for cat in portrait_categories -%}
                {%- if cat.order.value == i -%}
                  <div class="accordion-item">
                    <button class="accordion-header" data-key="{{ cat.system.handle }}">{{ cat.name.value }}</button>
                    <div class="accordion-content">
                      <div class="accordion-inner">{{ cat.description.value }}</div>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
            {%- for cat in portrait_categories -%}
              {%- if cat.order.value == blank -%}
                <div class="accordion-item">
                  <button class="accordion-header" data-key="{{ cat.system.handle }}">{{ cat.name.value }}</button>
                  <div class="accordion-content">
                    <div class="accordion-inner">{{ cat.description.value }}</div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

    </div>

    <div class="portrait-styles__cta-stack">
      {%- if section.settings.button_text != blank -%}
        <div class="portrait-styles__button">
          <a href="{{ section.settings.button_link }}" class="button">
            {{ section.settings.button_text }}
          </a>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

<script type="module">
  const portraitStylesSection = document.querySelector(".portrait-styles");
  const initPortraitStyles = () => {
  if (!portraitStylesSection || portraitStylesSection.dataset.portraitStylesReady === "true") return;
  portraitStylesSection.dataset.portraitStylesReady = "true";

  const headers = document.querySelectorAll(".accordion-header");
  const portraits = document.querySelectorAll(".portrait-grid .portrait");
  const portraitGrid = document.querySelector(".portrait-grid");
  const portraitGridScrollbar = document.querySelector(".portrait-grid-scrollbar");
  const portraitGridThumb = portraitGridScrollbar?.querySelector(".portrait-grid-scrollbar__thumb");

  function syncPortraitGridTileWidth(){
    if (!portraitGrid) return;

    const labels = portraitGrid.querySelectorAll(".portrait:not(.portrait--value-card) .portrait__label");
    const computed = window.getComputedStyle(portraitGrid);
    const minTileWidth = parseFloat(computed.getPropertyValue("--portrait-style-min-tile-size")) || 108;
    let labelWidth = 0;

    labels.forEach(label => {
      labelWidth = Math.max(labelWidth, Math.ceil(label.scrollWidth));
    });

    const tileWidth = Math.max(minTileWidth, labelWidth);
    portraitGrid.style.setProperty("--portrait-style-tile-size", `${tileWidth}px`);
  }

  function closeItem(item){

    const content = item.querySelector(".accordion-content");
    const inner = item.querySelector(".accordion-inner");

    content.style.height = "0px";

    requestAnimationFrame(()=>{
      content.style.height = "0px";
    });

    item.classList.remove("active");

    portraits.forEach(portrait => {
      portrait.classList.remove("faded");
    })

  }

  function openItem(item){

    const content = item.querySelector(".accordion-content");
    const inner = item.querySelector(".accordion-inner");

    content.style.height = inner.scrollHeight + "px";

    item.classList.add("active");
  }

  headers.forEach(header => {

    header.addEventListener("click", () => {

      const item = header.parentElement;
      const key = header.dataset.key;
      const isOpen = item.classList.contains("active");

      document.querySelectorAll(".accordion-item.active").forEach(open => {

        if(open !== item){
          closeItem(open);
        }

      });

      if(isOpen){
        closeItem(item);
        return;
      }

      openItem(item);

      portraits.forEach(portrait => {
        const portraitStyleGroups = portrait.dataset.style || "";

        if (portraitStyleGroups.includes(key)) {
          portrait.classList.remove("faded");
        } else {
          portrait.classList.add("faded");
        }
      })

    });

  });

  function updatePortraitGridScrollbar(){
    if (!portraitGrid || !portraitGridScrollbar || !portraitGridThumb) return;

    const maxScroll = portraitGrid.scrollWidth - portraitGrid.clientWidth;

    if (maxScroll <= 0) {
      portraitGridScrollbar.hidden = true;
      portraitGridThumb.style.width = "100%";
      portraitGridThumb.style.transform = "translateX(0)";
      return;
    }

    portraitGridScrollbar.hidden = false;

    const trackWidth = portraitGridScrollbar.clientWidth;
    const thumbWidth = Math.max((portraitGrid.clientWidth / portraitGrid.scrollWidth) * trackWidth, 34);
    const left = ((trackWidth - thumbWidth) * portraitGrid.scrollLeft) / maxScroll;

    portraitGridThumb.style.width = `${thumbWidth}px`;
    portraitGridThumb.style.transform = `translateX(${left}px)`;
  }

  function scrollPortraitGridFromScrollbar(clientX){
    if (!portraitGrid || !portraitGridScrollbar || !portraitGridThumb) return;

    const maxScroll = portraitGrid.scrollWidth - portraitGrid.clientWidth;
    if (maxScroll <= 0) return;

    const rect = portraitGridScrollbar.getBoundingClientRect();
    const thumbWidth = portraitGridThumb.offsetWidth || 34;
    const usableWidth = Math.max(rect.width - thumbWidth, 1);
    const progress = Math.min(Math.max((clientX - rect.left - thumbWidth / 2) / usableWidth, 0), 1);

    portraitGrid.scrollLeft = progress * maxScroll;
    updatePortraitGridScrollbar();
  }

  function refreshPortraitGridScrollbar(){
    syncPortraitGridTileWidth();
    updatePortraitGridScrollbar();
    requestAnimationFrame(() => {
      syncPortraitGridTileWidth();
      updatePortraitGridScrollbar();
      requestAnimationFrame(updatePortraitGridScrollbar);
    });
  }

  let activePortraitGridScrollbar = false;

  portraitGrid?.addEventListener("scroll", updatePortraitGridScrollbar, { passive: true });

  portraitGridScrollbar?.addEventListener("pointerdown", event => {
    activePortraitGridScrollbar = true;
    portraitGridScrollbar.setPointerCapture?.(event.pointerId);
    scrollPortraitGridFromScrollbar(event.clientX);
    event.preventDefault();
  });

  document.addEventListener("pointermove", event => {
    if (!activePortraitGridScrollbar) return;
    scrollPortraitGridFromScrollbar(event.clientX);
    event.preventDefault();
  });

  document.addEventListener("pointerup", () => {
    activePortraitGridScrollbar = false;
  });

  document.addEventListener("pointercancel", () => {
    activePortraitGridScrollbar = false;
  });

  window.addEventListener("resize", refreshPortraitGridScrollbar);
  window.addEventListener("load", refreshPortraitGridScrollbar);
  document.fonts?.ready?.then(refreshPortraitGridScrollbar).catch(() => {});
  refreshPortraitGridScrollbar();
  };

  if (portraitStylesSection && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      observer.disconnect();
      initPortraitStyles();
    });
    observer.observe(portraitStylesSection);
  } else if ("requestIdleCallback" in window) {
    window.requestIdleCallback(initPortraitStyles, { timeout: 3000 });
  } else {
    window.setTimeout(initPortraitStyles, 1500);
  }
</script>

{% schema %}
{
  "name": "Pick a style",
  "settings": [
    {
      "type": "text",
      "id": "main-text",
      "label": "Main Text",
      "default": "Each style preserves something different.<br>Not better, just different."
    },
    {
      "type": "text",
      "id": "main-title",
      "label": "Main Title",
      "default": "Every portrait tells differently"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
