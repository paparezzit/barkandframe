

{% liquid
  if section.settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  assign product_has_media = true
  if closest.product.media.size == 0
    assign product_has_media = false
  endif

  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif section.settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  if section.settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if section.settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  case section.settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase
%}

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="product-information section section--{{ content_width }} spacing-style color-{{ section.settings.color_scheme }} relative"
  style="{% render 'spacing-style', settings: section.settings %} --gap: {{ section.settings.gap }}px;"
>
  {% if section.settings.desktop_media_position == 'left' and product_has_media %}
    {% assign product_href = '#ProductInformation-' | append: section.id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}
  <div
    class="{{ product_grid_class }}"
    data-product-grid-content
  >
    {% assign render_order_array = render_order | split: ',' %}
    {% capture media %}
      <div
        class="product-information__media"
        data-testid="product-information-media"
      >
        {%- content_for 'block',
          type: '_product-media-gallery',
          id: 'media-gallery',
          closest.product: closest.product
        -%}
      </div>
    {% endcapture %}

    {% capture details %}
      {% content_for 'block',
        type: '_product-details',
        id: 'product-details',
        closest.product: closest.product
      %}
    {% endcapture %}

    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ details }}
      {% endif %}
    {% endfor %}

    {%- assign product_the_fabric = closest.product.metafields.custom.the_fabric -%}
    {%- assign product_the_fit = closest.product.metafields.custom.the_fit -%}
    {%- assign product_size_guide = closest.product.metafields.custom.size_guide -%}
    {%- assign product_made = closest.product.metafields.custom.made -%}
    {%- assign product_care = closest.product.metafields.custom.care -%}
    {%- assign product_handle_downcase = closest.product.handle | downcase -%}
    {%- assign product_type_downcase = closest.product.type | downcase -%}
    {%- assign product_title_downcase = closest.product.title | downcase -%}
    {%- assign is_crewneck_product = false -%}
    {%- if product_type_downcase contains 'crewneck'
      or product_type_downcase contains 'crew neck'
      or product_title_downcase contains 'crewneck'
      or product_title_downcase contains 'crew neck'
    -%}
      {%- assign is_crewneck_product = true -%}
    {%- endif -%}
    {%- assign is_tshirt_product = false -%}
    {%- if product_type_downcase contains 't-shirt'
      or product_type_downcase contains 't shirt'
      or product_title_downcase contains 't-shirt'
      or product_title_downcase contains 't shirt'
    -%}
      {%- assign is_tshirt_product = true -%}
    {%- endif -%}
    {%- assign is_cap_product = false -%}
    {%- if product_type_downcase == 'cap' or product_title_downcase contains ' cap' or product_title_downcase contains '| cap' -%}
      {%- assign is_cap_product = true -%}
    {%- endif -%}
    {%- assign is_charity_cap_product = false -%}
    {%- if is_cap_product -%}
      {%- if product_handle_downcase contains 'give-love' or product_handle_downcase contains 'charity' or product_title_downcase contains 'charity' -%}
        {%- assign is_charity_cap_product = true -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign product_detail_icon_keys = '' -%}
    {%- assign product_detail_icons_metafield = closest.product.metafields.custom.detail_icons -%}
    {%- if product_detail_icons_metafield != blank -%}
      {%- assign product_detail_icons_text = product_detail_icons_metafield.value | join: '||' | downcase -%}
      {%- if product_detail_icons_text contains '10 eur to charity' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: '10 Eur to Charity||' -%}
      {%- endif -%}
      {%- if product_detail_icons_text contains 'natural' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: 'Natural||' -%}
      {%- endif -%}
      {%- if product_detail_icons_text contains '100% organic' or product_detail_icons_text contains '100 organic' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: '100% Organic||' -%}
      {%- endif -%}
      {%- if product_detail_icons_text contains 'human friendly' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: 'Human Friendly||' -%}
      {%- endif -%}
      {%- if product_detail_icons_text contains 'quality product' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: 'Quality Product||' -%}
      {%- endif -%}
    {%- endif -%}
    {%- if product_detail_icon_keys == '' -%}
      {%- if is_charity_cap_product -%}
        {%- assign product_detail_icon_keys = '10 Eur to Charity||100% Organic||Human Friendly||' -%}
      {%- elsif is_crewneck_product -%}
        {%- assign product_detail_icon_keys = 'Natural||Human Friendly||Quality Product||' -%}
      {%- elsif is_tshirt_product or is_cap_product -%}
        {%- assign product_detail_icon_keys = '100% Organic||Human Friendly||Quality Product||' -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign has_product_tabs = false -%}
    {%- if closest.product.description != blank
      or product_the_fabric != blank
      or product_the_fit != blank
      or product_size_guide != blank
      or product_made != blank
      or product_care != blank
      or product_detail_icon_keys != blank
    -%}
      {%- assign has_product_tabs = true -%}
    {%- endif -%}

    {%- if has_product_tabs -%}
    <div class="product-information__tabs">
      {%- if closest.product.description != blank -%}
        <div class="product-information__tabs-description rte">
          {{ closest.product.description }}
        </div>
      {%- endif -%}

      {%- if product_detail_icon_keys != blank -%}
        <ul class="prod-detail-icons" role="list" aria-label="Product highlights">
          {%- assign product_detail_icon_labels = product_detail_icon_keys | split: '||' -%}
          {%- for product_detail_icon in product_detail_icon_labels -%}
            {%- assign product_detail_icon_label = product_detail_icon | strip -%}
            {%- if product_detail_icon_label != blank -%}
              {%- liquid
                assign product_detail_icon_handle = product_detail_icon_label | handleize
                assign product_detail_icon_asset = ''
                assign product_detail_icon_display = product_detail_icon_label

                case product_detail_icon_handle
                  when '100-organic'
                    assign product_detail_icon_asset = 'product-icon-100-organic.svg'
                    assign product_detail_icon_display = '100%<br>Organic'
                  when 'natural'
                    assign product_detail_icon_asset = 'product-icon-natural.svg'
                    assign product_detail_icon_display = 'Natural'
                  when 'quality-product'
                    assign product_detail_icon_asset = 'product-icon-quality-product.svg'
                    assign product_detail_icon_display = 'Quality Product'
                  when 'human-friendly'
                    assign product_detail_icon_asset = 'product-icon-human-friendly.svg'
                    assign product_detail_icon_display = 'Human Friendly'
                  when '10-eur-to-charity'
                    assign product_detail_icon_asset = 'product-icon-10-eur-to-charity.svg'
                    assign product_detail_icon_display = '10 Eur to Charity'
                endcase
              -%}
              {%- if product_detail_icon_asset != blank -%}
                <li class="prod-detail-icons__item">
                  <img
                    class="prod-detail-icons__icon"
                    src="{{ product_detail_icon_asset | asset_url }}"
                    alt=""
                    width="100"
                    height="100"
                    loading="lazy"
                  >
                  <span class="prod-detail-icons__label">{{ product_detail_icon_display }}</span>
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="prod-accordion-section__accordions" id="prod-accordions">
        {%- assign opened_product_accordion = false -%}

        {%- if product_the_fabric != blank -%}
          <accordion-custom>
            <details class="details tab-accordion" open>
              {%- assign opened_product_accordion = true -%}
              <summary class="tab-accordion__summary">
                <span>The fabric</span>
                <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
              </summary>
              <div class="details-content tab-accordion__body">
                {{ product_the_fabric | metafield_tag }}
              </div>
            </details>
          </accordion-custom>
        {%- endif -%}

        {%- if product_the_fit != blank -%}
          <accordion-custom>
            <details class="details tab-accordion"{% unless opened_product_accordion %} open{% assign opened_product_accordion = true %}{% endunless %}>
              <summary class="tab-accordion__summary">
                <span>The fit</span>
                <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
              </summary>
              <div class="details-content tab-accordion__body">
                {{ product_the_fit | metafield_tag }}
              </div>
            </details>
          </accordion-custom>
        {%- endif -%}

        {%- if product_size_guide != blank -%}
          <accordion-custom>
            <details class="details tab-accordion"{% unless opened_product_accordion %} open{% assign opened_product_accordion = true %}{% endunless %}>
              <summary class="tab-accordion__summary">
                <span>Size guide</span>
                <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
              </summary>
              <div class="details-content tab-accordion__body">
                {%- if is_crewneck_product -%}
                  <p class="baf-size-guide__intro">Body length × Chest width.</p>
                  <div class="baf-size-guide" aria-label="Crewneck size guide">
                    <h3 class="baf-size-guide__title">Crewneck</h3>
                    <table class="baf-size-guide__table">
                      <thead>
                        <tr>
                          <th scope="col"><span class="baf-size-guide__badge baf-size-guide__badge--size">SIZE</span></th>
                          <th scope="col"><span class="baf-size-guide__badge">CM</span></th>
                          <th scope="col"><span class="baf-size-guide__badge">IN</span></th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <th scope="row">S</th>
                          <td>68.5 × 84 to 91</td>
                          <td>27.0 × 33.1 to 35.8</td>
                        </tr>
                        <tr>
                          <th scope="row">M</th>
                          <td>71 × 94 to 101</td>
                          <td>28.0 × 37.0 to 39.8</td>
                        </tr>
                        <tr>
                          <th scope="row">L</th>
                          <td>73.5 × 104 to 109</td>
                          <td>29.0 × 40.9 to 42.9</td>
                        </tr>
                        <tr>
                          <th scope="row">XL</th>
                          <td>76 × 112 to 117</td>
                          <td>30.0 × 44.1 to 46.1</td>
                        </tr>
                        <tr>
                          <th scope="row">XXL</th>
                          <td>78.5 × 119 to 124</td>
                          <td>31.0 × 46.9 to 48.8</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                {%- elsif is_tshirt_product -%}
                  <p class="baf-size-guide__intro">Body length × Chest width.</p>
                  <div class="baf-size-guide" aria-label="T-Shirt size guide">
                    <h3 class="baf-size-guide__title">T-Shirt</h3>
                    <table class="baf-size-guide__table">
                      <thead>
                        <tr>
                          <th scope="col"><span class="baf-size-guide__badge baf-size-guide__badge--size">SIZE</span></th>
                          <th scope="col"><span class="baf-size-guide__badge">CM</span></th>
                          <th scope="col"><span class="baf-size-guide__badge">IN</span></th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <th scope="row">S</th>
                          <td>71 × 110</td>
                          <td>28.0 × 43.3</td>
                        </tr>
                        <tr>
                          <th scope="row">M</th>
                          <td>75 × 116</td>
                          <td>29.5 × 45.7</td>
                        </tr>
                        <tr>
                          <th scope="row">L</th>
                          <td>77 × 122</td>
                          <td>30.3 × 48.0</td>
                        </tr>
                        <tr>
                          <th scope="row">XL</th>
                          <td>79 × 128</td>
                          <td>31.1 × 50.4</td>
                        </tr>
                        <tr>
                          <th scope="row">XXL</th>
                          <td>81 × 134</td>
                          <td>31.9 × 52.8</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                {%- elsif is_cap_product -%}
                  <div class="baf-size-guide" aria-label="Cap size guide">
                    <h3 class="baf-size-guide__title">Cap</h3>
                    <table class="baf-size-guide__table baf-size-guide__table--single">
                      <thead>
                        <tr>
                          <th scope="col"><span class="baf-size-guide__badge baf-size-guide__badge--size">SIZE</span></th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td>One size · adjustable</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                {%- else -%}
                  {{ product_size_guide | metafield_tag }}
                {%- endif -%}
              </div>
            </details>
          </accordion-custom>
        {%- endif -%}

        {%- if product_made != blank -%}
          <accordion-custom>
            <details class="details tab-accordion"{% unless opened_product_accordion %} open{% assign opened_product_accordion = true %}{% endunless %}>
              <summary class="tab-accordion__summary">
                <span>Made</span>
                <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
              </summary>
              <div class="details-content tab-accordion__body">
                {{ product_made | metafield_tag }}
              </div>
            </details>
          </accordion-custom>
        {%- endif -%}

        {%- if product_care != blank -%}
          <accordion-custom>
            <details class="details tab-accordion"{% unless opened_product_accordion %} open{% assign opened_product_accordion = true %}{% endunless %}>
              <summary class="tab-accordion__summary">
                <span>Care</span>
                <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
              </summary>
              <div class="details-content tab-accordion__body">
                {{ product_care | metafield_tag }}
              </div>
            </details>
          </accordion-custom>
        {%- endif -%}

      </div>
    </div>
    {%- endif -%}
  </div>

  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .product-information {
    gap: var(--gap) 0;
    margin-block-start: 9px;
  }

  main.content-for-layout .product-information.section {
    --site-content-margin: var(--page-margin);
  }

  /* Base grid layout */
  .product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  /* Default column positions */
  .product-details {
    order: 1;
    margin: 60px 0;

    product-price{
      margin: 0 0 60px;

      .price{
        font-size: var(--baf-display-large-size);
        font-family: var(--baf-display-family) !important;
        opacity: .63;
      }
    }

    variant-picker{
      margin: 0 0 60px;

      .variant-picker__form{
        gap: 60px;

        legend{
          margin-bottom: 1em;
        }

        .variant-option--swatches{
          align-items: flex-start;
        }

          .variant-option__button-label{
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            background-color: transparent;
            overflow: visible;

          &.variant-option__button-label--has-swatch {
            width: 64px;
            overflow: visible;
            justify-content: flex-start;
          }

          &:not(.variant-option__button-label--has-swatch){
            width: 42px !important;
            height: 42px !important;
            background: var(--cream);
            color: var(--brown);
            padding: 0;
            display: flex;
            border-radius: 10px;
            border: 2px solid transparent;

            .variant-option__button-label__text{
              font-family: "display", serif;
              font-size: 21px;
              margin: auto;
            }

            &:has(:checked), &:hover{
              border-color: var(--green);
            }
          }
          
          
          .swatch{
            width: 64px;
            height: 64px;
            display: block;
            border-radius: 10px;
            border: 2px solid transparent;
          }

          .variant-option__swatch-name{
            display: block;
            font-weight: 700;
            position: static;
            left: auto;
            box-sizing: border-box;
            padding-left: 4px;
            text-align: left;
            overflow: visible;
            white-space: normal;
            line-height: 1.1;
            width: 64px;
            max-width: 64px;
            transform: none;
            opacity: .63;
          }

          &:has(:checked), &:hover {
            outline: none;

            .swatch{
              border-color: var(--green);
            }

            .variant-option__swatch-name{
              opacity: 1;
            }
          }
        }
      }
    }
  }

  .product-form-buttons{
    display: block !important;
  }

  .quantity-selector{
    width: 100%;
    margin-bottom: 10px;
    background-color: var(--cream);

    &:hover{
      background-color: var(--cream);
    }

    button{
      height: 100% !important;
      opacity: .36;
      transition: opacity .2s;

      &:hover, &:focus{
        background-color: transparent;
        opacity: 1;
      }
    }
  }

  .product-details .quantity-selector :is(.quantity-minus, .quantity-plus):active .svg-wrapper{
    transform: scale(0.9) !important;
  }

  .product-details .quantity-selector :is(.quantity-minus, .quantity-plus).quantity-button--pressed .svg-wrapper{
    transform: scale(0.9) !important;
  }

  .product-details .quantity-selector :is(.quantity-minus, .quantity-plus) .svg-wrapper svg{
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .product-details .quantity-selector :is(.quantity-minus, .quantity-plus):active .svg-wrapper svg,
  .product-details .quantity-selector :is(.quantity-minus, .quantity-plus).quantity-button--pressed .svg-wrapper svg{
    transform: scale(0.9) !important;
  }

  .add-to-cart-button{
    .add-to-cart-icon{
      display: none;
    }
  }

  .product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .product-information__media {
      grid-column: 1 / -1;
    }

    .product-details {
      grid-column: 2 / 3;
    }
  }

  /* Desktop styles */
  @media screen and (min-width: 750px) {
    .product-information__grid {
      grid-column: 2;
    }

    .product-details{
      .product-title :is(p, span, h1, h2, h3, h4, h5, h6), product-price .price{
        font-size: 36px !important;
      }
    }

    /* Position when there is no media */
    .product-information__grid.product-information--media-none,
    .product-information__grid:has(.product-information__media:empty) {
      .product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    /* Position when there is media */
    .product-information__grid:not(:has(.product-information__media:empty)) {
      /* Media on the left side */
      &.product-information--media-left {
        grid-template-columns: 3fr 2fr;
        gap: 40px;

        .product-details {
          margin: 30px 0 40px;
        }

        &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      /* Media on the right side */
      &.product-information--media-right {
        grid-template-columns: min(50vw, var(--sidebar-width)) 1fr;

        .product-information__media {
          padding-left: calc(var(--gap, 0) / 2);
          order: 1;
        }

        .product-details {
          padding-right: calc(var(--gap, 0) / 2);
          order: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      /* Equal width columns */
      &.product-information__grid--half,
      &.product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns:
          var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(
            var(--full-page-grid-central-column-width) / 2
          )
          var(--full-page-grid-margin);

        &.product-information--media-left {
          .product-information__media {
            grid-column: 2 / 3;

            &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .product-details {
            grid-column: 3 / 4;
          }
        }

        &.product-information--media-right {
          .product-information__media {
            grid-column: 3 / 4;

            &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    /* Handle full width section */
    .section--full-width {
      .product-information__grid:not(:has(.product-information__media:empty)),
      .product-information__grid:not(:has(.product-information__media:empty)) {
        &.product-information--media-left,
        &.product-information--media-right {
          grid-column: 1 / -1;
        }

        &.product-information--media-left .product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.product-information--media-right .product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.product-information__grid--half.product-information--media-left {
          .product-information__media {
            grid-column: 1 / 3;
          }

          .product-details {
            grid-column: 3 / -1;
          }
        }

        &.product-information__grid--half.product-information--media-right {
          .product-information__media {
            grid-column: 3 / -1;
          }

          .product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  /* Wider sidebar for large screens */
  @media screen and (min-width: 1200px) {
    .product-information__grid:not(
        .product-information__grid--half,
        :has(.product-information__media:empty)
      ).product-information--media-left {
      grid-template-columns: 2fr 1fr;
    }

    .product-information__grid:not(
        .product-information__grid--half,
        :has(.product-information__media:empty)
      ).product-information--media-right {
      grid-template-columns: 1fr 2fr;
    }
  }

  .product-information__grid--limit-details .product-details > .group-block {
    max-width: var(--sidebar-width);
  }

  .product-information slideshow-arrows {
    display: none;
  }

  /* If the header is sticky, make product details content stick underneath the header */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }

  /* Tabs area: description + accordion */
  .product-information__tabs {
    max-width: 520px;
    padding-bottom: 80px;
    margin: 0 auto;
  }

  @media screen and (max-width: 799px) {
    .product-information__tabs {
      grid-column: 2 / 3;
      order: 2;
      max-width: none;
      padding-top: 20px;
    }
  }

  .product-information__tabs-description {
    font-size: 14px;
    line-height: 1.6;
    color: var(--brown);
    margin-bottom: 40px;
  }

  .prod-detail-icons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 28px 32px;
    margin: 0 0 54px;
    padding: 0;
    color: var(--brown);
    list-style: none;
  }

  .prod-detail-icons__item {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .prod-detail-icons__icon {
    display: block;
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    object-fit: contain;
  }

  .prod-detail-icons__label {
    display: block;
    max-width: 82px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.15;
  }

  .baf-size-guide {
    margin: 20px 0;
    padding: 40px 20px;
    box-sizing: border-box;
    color: var(--brown);
    background: var(--cream);
    border-radius: var(--baf-radius-md);
  }

  .baf-size-guide__intro {
    margin: 0 0 18px;
    color: var(--brown);
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5;
  }

  .baf-size-guide__title {
    margin: 0 0 10px !important;
    font-family: "display", serif;
    font-size: 21px;
    font-weight: 400;
    line-height: 1;
    text-align: center;
    text-transform: none;
  }

  .baf-size-guide__table {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1fr);
    width: 100%;
  }

  .baf-size-guide__table thead,
  .baf-size-guide__table tbody,
  .baf-size-guide__table tr {
    display: contents;
  }

  .baf-size-guide__table--single {
    grid-template-columns: 1fr;
  }

  .baf-size-guide__table th,
  .baf-size-guide__table td {
    padding: 0;
    text-align: left;
    vertical-align: middle;
  }

  .baf-size-guide__table thead th {
    display: flex;
    align-items: center;
  }

  .baf-size-guide__table thead th:not(:first-child) {
    justify-content: center;
  }

  .baf-size-guide__table tbody th,
  .baf-size-guide__table tbody td {
    padding: 14px 0;
  }

  .baf-size-guide__table tbody th {
    display: flex;
    flex-direction: column;
    gap: 3px;
    justify-content: center;
    padding-right: 8px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
  }

  .baf-size-guide__table tbody td {
    display: flex;
    justify-content: center;
    align-items: center;
    border-left: 1px solid var(--brown);
    padding-inline: 16px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .baf-size-guide__table tbody td:last-child {
    border-right: 1px solid var(--brown);
  }

  .baf-size-guide__table.baf-size-guide__table--single tbody td {
    justify-content: flex-start;
    border-left: 0;
    border-right: 0;
    padding-inline: 0;
    text-align: left;
    font-weight: 500;
  }

  .baf-size-guide__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin: 20px 0;
    padding: 2px 8px;
    border-radius: 999px;
    color: var(--cream);
    background: var(--green);
    font-size: 10px;
    font-weight: 500;
    line-height: 1;
  }

  .baf-size-guide__badge--size {
    background: var(--brown);
  }

  .baf-size-guide__table thead th:not(:first-child) .baf-size-guide__badge {
    margin-inline: 0;
  }

  @media screen and (max-width: 749px) {
    .prod-detail-icons {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px 10px;
      margin-bottom: 44px;
    }

    .prod-detail-icons__item {
      min-width: 0;
      gap: 8px;
    }

    .prod-detail-icons__icon {
      width: 30px;
      height: 30px;
      flex-basis: 30px;
    }

    .prod-detail-icons__label {
      max-width: none;
      font-size: 11px;
    }

    .baf-size-guide {
      padding: 40px 20px;
      border-radius: var(--baf-radius-md);
    }

    .baf-size-guide__table {
      grid-template-columns: 44px minmax(0, 1fr) minmax(0, 1fr);
    }

    .baf-size-guide__table tbody td {
      padding-inline: 10px;
    }
  }

  @media screen and (min-width: 750px) {
    .baf-size-guide {
      padding: 40px;
    }
  }

  /* Three-area grid: left (media) | right (details sticky) / tabs (description+accordion) */
  @media screen and (min-width: 750px) {
    .product-information__grid.product-information--media-left {
      grid-template-columns: 3fr 2fr;
      grid-template-areas: "left right" "tabs right";
      gap: 40px;
      align-items: start;
    }

    .product-information__grid.product-information--media-left .product-information__media {
      grid-area: left;
      padding-right: 0;
    }

    .product-information__grid.product-information--media-left .product-details {
      grid-area: right;
      position: sticky;
      top: 94px;
      padding-left: 0;
      padding-bottom: 40px;
    }

    .product-information__tabs {
      grid-area: tabs;
      align-self: start;
    }
  }

  @media screen and (min-width: 1200px) {
    .product-information__grid.product-information--media-left {
      grid-template-columns: 3fr 420px;
      gap: 60px 120px !important;
    }
  }
{% endstylesheet %}

{% javascript %}
(function () {
  var accordions = document.querySelectorAll('#prod-accordions .tab-accordion');
  accordions.forEach(function (details) {
    details.addEventListener('toggle', function () {
      if (details.open) {
        accordions.forEach(function (other) {
          if (other !== details && other.open) other.open = false;
        });
      }
    });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
