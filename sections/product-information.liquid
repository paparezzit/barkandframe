

{% liquid
  if section.settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  assign product_has_media = true
  if closest.product.media.size == 0
    assign product_has_media = false
  endif

  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif section.settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  if section.settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if section.settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  case section.settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase
%}

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="product-information section section--{{ content_width }} spacing-style color-{{ section.settings.color_scheme }} relative"
  style="{% render 'spacing-style', settings: section.settings %} --gap: {{ section.settings.gap }}px;"
>
  {% if section.settings.desktop_media_position == 'left' and product_has_media %}
    {% assign product_href = '#ProductInformation-' | append: section.id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}
  <div
    class="{{ product_grid_class }}"
    data-product-grid-content
  >
    {% assign render_order_array = render_order | split: ',' %}
    {% capture media %}
      <div
        class="product-information__media"
        data-testid="product-information-media"
      >
        {%- content_for 'block',
          type: '_product-media-gallery',
          id: 'media-gallery',
          closest.product: closest.product
        -%}
      </div>
    {% endcapture %}

    {% capture details %}
      {% content_for 'block',
        type: '_product-details',
        id: 'product-details',
        closest.product: closest.product
      %}
    {% endcapture %}

    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ details }}
      {% endif %}
    {% endfor %}

    {%- assign product_the_fabric = closest.product.metafields.custom.the_fabric -%}
    {%- assign product_the_fit = closest.product.metafields.custom.the_fit -%}
    {%- assign product_size_guide = closest.product.metafields.custom.size_guide -%}
    {%- assign product_made = closest.product.metafields.custom.made -%}
    {%- assign product_care = closest.product.metafields.custom.care -%}
    {%- assign product_handle_downcase = closest.product.handle | downcase -%}
    {%- assign product_type_downcase = closest.product.type | downcase -%}
    {%- assign product_title_downcase = closest.product.title | downcase -%}
    {%- assign is_crewneck_product = false -%}
    {%- if product_type_downcase contains 'crewneck'
      or product_type_downcase contains 'crew neck'
      or product_title_downcase contains 'crewneck'
      or product_title_downcase contains 'crew neck'
    -%}
      {%- assign is_crewneck_product = true -%}
    {%- endif -%}
    {%- assign is_tshirt_product = false -%}
    {%- if product_type_downcase contains 't-shirt'
      or product_type_downcase contains 't shirt'
      or product_title_downcase contains 't-shirt'
      or product_title_downcase contains 't shirt'
    -%}
      {%- assign is_tshirt_product = true -%}
    {%- endif -%}
    {%- assign is_cap_product = false -%}
    {%- if product_type_downcase == 'cap' or product_title_downcase contains ' cap' or product_title_downcase contains '| cap' -%}
      {%- assign is_cap_product = true -%}
    {%- endif -%}
    {%- assign is_charity_cap_product = false -%}
    {%- if is_cap_product -%}
      {%- if product_handle_downcase contains 'give-love' or product_handle_downcase contains 'charity' or product_title_downcase contains 'charity' -%}
        {%- assign is_charity_cap_product = true -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign product_detail_icon_keys = '' -%}
    {%- assign product_detail_icons_metafield = closest.product.metafields.custom.detail_icons -%}
    {%- if product_detail_icons_metafield != blank -%}
      {%- assign product_detail_icons_text = product_detail_icons_metafield.value | join: '||' | downcase -%}
      {%- if product_detail_icons_text contains '10 eur to charity' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: '10 Eur to Charity||' -%}
      {%- endif -%}
      {%- if product_detail_icons_text contains 'natural' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: 'Natural||' -%}
      {%- endif -%}
      {%- if product_detail_icons_text contains '100% organic' or product_detail_icons_text contains '100 organic' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: '100% Organic||' -%}
      {%- endif -%}
      {%- if product_detail_icons_text contains 'human friendly' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: 'Human Friendly||' -%}
      {%- endif -%}
      {%- if product_detail_icons_text contains 'quality product' -%}
        {%- assign product_detail_icon_keys = product_detail_icon_keys | append: 'Quality Product||' -%}
      {%- endif -%}
    {%- endif -%}
    {%- if product_detail_icon_keys == '' -%}
      {%- if is_charity_cap_product -%}
        {%- assign product_detail_icon_keys = '10 Eur to Charity||100% Organic||Human Friendly||' -%}
      {%- elsif is_crewneck_product -%}
        {%- assign product_detail_icon_keys = 'Natural||Human Friendly||Quality Product||' -%}
      {%- elsif is_tshirt_product or is_cap_product -%}
        {%- assign product_detail_icon_keys = '100% Organic||Human Friendly||Quality Product||' -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign has_product_tabs = false -%}
    {%- if closest.product.description != blank
      or product_the_fabric != blank
      or product_the_fit != blank
      or product_size_guide != blank
      or product_made != blank
      or product_care != blank
      or product_detail_icon_keys != blank
    -%}
      {%- assign has_product_tabs = true -%}
    {%- endif -%}

    {%- if has_product_tabs -%}
    <div class="product-information__tabs">
      {%- if closest.product.description != blank -%}
        <div class="product-information__tabs-description rte">
          {{ closest.product.description }}
        </div>
      {%- endif -%}

      {%- if product_detail_icon_keys != blank -%}
        <ul class="prod-detail-icons" role="list" aria-label="Product highlights">
          {%- assign product_detail_icon_labels = product_detail_icon_keys | split: '||' -%}
          {%- for product_detail_icon in product_detail_icon_labels -%}
            {%- assign product_detail_icon_label = product_detail_icon | strip -%}
            {%- if product_detail_icon_label != blank -%}
              {%- liquid
                assign product_detail_icon_handle = product_detail_icon_label | handleize
                assign product_detail_icon_asset = ''
                assign product_detail_icon_display = product_detail_icon_label

                case product_detail_icon_handle
                  when '100-organic'
                    assign product_detail_icon_asset = 'product-icon-100-organic.svg'
                    assign product_detail_icon_display = '100%<br>Organic'
                  when 'natural'
                    assign product_detail_icon_asset = 'product-icon-natural.svg'
                    assign product_detail_icon_display = 'Natural'
                  when 'quality-product'
                    assign product_detail_icon_asset = 'product-icon-quality-product.svg'
                    assign product_detail_icon_display = 'Quality Product'
                  when 'human-friendly'
                    assign product_detail_icon_asset = 'product-icon-human-friendly.svg'
                    assign product_detail_icon_display = 'Human Friendly'
                  when '10-eur-to-charity'
                    assign product_detail_icon_asset = 'product-icon-10-eur-to-charity.svg'
                    assign product_detail_icon_display = '10 Eur to Charity'
                endcase
              -%}
              {%- if product_detail_icon_asset != blank -%}
                <li class="prod-detail-icons__item">
                  <img
                    class="prod-detail-icons__icon"
                    src="{{ product_detail_icon_asset | asset_url }}"
                    alt=""
                    width="100"
                    height="100"
                    loading="lazy"
                  >
                  <span class="prod-detail-icons__label">{{ product_detail_icon_display }}</span>
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="prod-accordion-section__accordions" id="prod-accordions">
        {%- assign opened_product_accordion = false -%}

        {%- if product_the_fabric != blank -%}
          <accordion-custom>
            <details class="details tab-accordion" open>
              {%- assign opened_product_accordion = true -%}
              <summary class="tab-accordion__summary">
                <span>The fabric</span>
                <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
              </summary>
              <div class="details-content tab-accordion__body">
                {{ product_the_fabric | metafield_tag }}
              </div>
            </details>
          </accordion-custom>
        {%- endif -%}

        {%- if product_the_fit != blank -%}
          <accordion-custom>
            <details class="details tab-accordion"{% unless opened_product_accordion %} open{% assign opened_product_accordion = true %}{% endunless %}>
              <summary class="tab-accordion__summary">
                <span>The fit</span>
                <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
              </summary>
              <div class="details-content tab-accordion__body">
                {{ product_the_fit | metafield_tag }}
              </div>
            </details>
          </accordion-custom>
        {%- endif -%}

        {%- if product_size_guide != blank -%}
          <accordion-custom>
            <details class="details tab-accordion"{% unless opened_product_accordion %} open{% assign opened_product_accordion = true %}{% endunless %}>
              <summary class="tab-accordion__summary">
                <span>Size guide</span>
                <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
              </summary>
              <div class="details-content tab-accordion__body">
                {%- if is_crewneck_product -%}
                  <p class="baf-size-guide__intro">Body length × Chest width.</p>
                  <div class="baf-size-guide" aria-label="Crewneck size guide">
                    <h3 class="baf-size-guide__title">Crewneck</h3>
                    <table class="baf-size-guide__table">
                      <thead>
                        <tr>
                          <th scope="col"><span class="baf-size-guide__badge baf-size-guide__badge--size">SIZE</span></th>
                          <th scope="col"><span class="baf-size-guide__badge">CM</span></th>
                          <th scope="col"><span class="baf-size-guide__badge">IN</span></th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <th scope="row">S</th>
                          <td>68.5 × 84 to 91</td>
                          <td>27.0 × 33.1 to 35.8</td>
                        </tr>
                        <tr>
                          <th scope="row">M</th>
                          <td>71 × 94 to 101</td>
                          <td>28.0 × 37.0 to 39.8</td>
                        </tr>
                        <tr>
                          <th scope="row">L</th>
                          <td>73.5 × 104 to 109</td>
                          <td>29.0 × 40.9 to 42.9</td>
                        </tr>
                        <tr>
                          <th scope="row">XL</th>
                          <td>76 × 112 to 117</td>
                          <td>30.0 × 44.1 to 46.1</td>
                        </tr>
                        <tr>
                          <th scope="row">XXL</th>
                          <td>78.5 × 119 to 124</td>
                          <td>31.0 × 46.9 to 48.8</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                {%- elsif is_tshirt_product -%}
                  <p class="baf-size-guide__intro">Body length × Chest width.</p>
                  <div class="baf-size-guide" aria-label="T-Shirt size guide">
                    <h3 class="baf-size-guide__title">T-Shirt</h3>
                    <table class="baf-size-guide__table">
                      <thead>
                        <tr>
                          <th scope="col"><span class="baf-size-guide__badge baf-size-guide__badge--size">SIZE</span></th>
                          <th scope="col"><span class="baf-size-guide__badge">CM</span></th>
                          <th scope="col"><span class="baf-size-guide__badge">IN</span></th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <th scope="row">S</th>
                          <td>71 × 110</td>
                          <td>28.0 × 43.3</td>
                        </tr>
                        <tr>
                          <th scope="row">M</th>
                          <td>75 × 116</td>
                          <td>29.5 × 45.7</td>
                        </tr>
                        <tr>
                          <th scope="row">L</th>
                          <td>77 × 122</td>
                          <td>30.3 × 48.0</td>
                        </tr>
                        <tr>
                          <th scope="row">XL</th>
                          <td>79 × 128</td>
                          <td>31.1 × 50.4</td>
                        </tr>
                        <tr>
                          <th scope="row">XXL</th>
                          <td>81 × 134</td>
                          <td>31.9 × 52.8</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                {%- elsif is_cap_product -%}
                  <div class="baf-size-guide" aria-label="Cap size guide">
                    <h3 class="baf-size-guide__title">Cap</h3>
                    <table class="baf-size-guide__table baf-size-guide__table--single">
                      <thead>
                        <tr>
                          <th scope="col"><span class="baf-size-guide__badge baf-size-guide__badge--size">SIZE</span></th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td>One size · adjustable</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                {%- else -%}
                  {{ product_size_guide | metafield_tag }}
                {%- endif -%}
              </div>
            </details>
          </accordion-custom>
        {%- endif -%}

        {%- if product_made != blank -%}
          <accordion-custom>
            <details class="details tab-accordion"{% unless opened_product_accordion %} open{% assign opened_product_accordion = true %}{% endunless %}>
              <summary class="tab-accordion__summary">
                <span>Made</span>
                <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
              </summary>
              <div class="details-content tab-accordion__body">
                {{ product_made | metafield_tag }}
              </div>
            </details>
          </accordion-custom>
        {%- endif -%}

        {%- if product_care != blank -%}
          <accordion-custom>
            <details class="details tab-accordion"{% unless opened_product_accordion %} open{% assign opened_product_accordion = true %}{% endunless %}>
              <summary class="tab-accordion__summary">
                <span>Care</span>
                <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
              </summary>
              <div class="details-content tab-accordion__body">
                {{ product_care | metafield_tag }}
              </div>
            </details>
          </accordion-custom>
        {%- endif -%}

      </div>
    </div>
    {%- endif -%}
  </div>

  {% content_for 'blocks' %}
</div>

{{ 'product-information.css' | asset_url | stylesheet_tag }}

{% javascript %}
(function () {
  var accordions = document.querySelectorAll('#prod-accordions .tab-accordion');
  accordions.forEach(function (details) {
    details.addEventListener('toggle', function () {
      if (details.open) {
        accordions.forEach(function (other) {
          if (other !== details && other.open) other.open = false;
        });
      }
    });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
