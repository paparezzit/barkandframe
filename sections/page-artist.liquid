{%- assign all_artists = shop.metaobjects['artist'].values -%}

<div class="artists-page">

  <div class="artists-heading">
    <h1 class="artists-heading__title">{{ section.settings.hero_title }}</h1>
  </div>

  {%- if section.settings.intro_image != blank or section.settings.intro_text != blank -%}
  <div class="artists-page__intro">
    <div class="artists-page__intro-image">
      {%- if section.settings.intro_image != blank -%}
        {{- section.settings.intro_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '450, 600, 900' -}}
      {%- endif -%}
    </div>
    <div class="artists-page__content">
      {%- if section.settings.intro_text != blank -%}
        <div class="artists-page__body rte">{{ section.settings.intro_text }}</div>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}

  {%- unless all_artists == empty -%}
  <div class="artists-page__list section section--page-width">
    {%- for artist in all_artists -%}
      <div class="artists-page__item">
        {%- render 'artist-card', artist: artist -%}

        {%- assign artist_handle = artist.system.handle -%}
        {%- assign has_styles = false -%}
        {%- for style in shop.metaobjects['portrait_style'].values -%}
          {%- if style.artist.value.system.handle == artist_handle -%}
            {%- assign has_styles = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_styles -%}
          <div class="artists-page__styles-section">
            <h3 class="artists-page__styles-title">Styles by {{ artist.name.value | split: ' ' | first }}</h3>
            <div class="artists-page__styles">
              {%- for style in shop.metaobjects['portrait_style'].values -%}
                {%- if style.artist.value.system.handle == artist_handle -%}
                  <div class="artists-page__style-card">
                    {%- if style.name.value != blank -%}
                      <span class="artists-page__style-name">{{ style.name.value }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- endunless -%}

</div>

{% stylesheet %}
  .artists-heading {
    padding: 80px var(--page-margin) 70px;
    text-align: center;
  }

  .artists-heading__title {
    font-family: "display", serif;
    font-size: clamp(48px, 8vw, 96px);
    line-height: 1;
    color: var(--brown);
    margin: 0 auto;
    font-weight: 400;
    max-width: 520px;
  }

  .artists-page__intro{
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 40px var(--page-margin);
    max-width: calc(1060px + (2 * var(--page-margin)));
    margin: 0 auto;
  }

  .artists-page__intro-image {
    overflow: hidden;
    width: 70%;
    margin: 0 auto 40px;
  }

  .artists-page__intro-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .artists-page__list {
    display: flex;
    flex-direction: column;
    gap: 80px;
    padding: 60px var(--page-margin) 100px;
    max-width: calc(1060px + (2 * var(--page-margin)));
    margin: 0 auto;
  }

  .artists-page__item {
    .artist-card{
      border-radius: 80px;
      align-items: start;
      background-color: color-mix(var(--purple) 45%);
    }

    .artist-card__body{
      max-width: none;
    }
  }

  .artists-page__styles-section {
    display: flex;
    gap: 20px;
    padding: 20px;
  }

  .artists-page__styles-title {
    font-size: 14px;
    color: var(--brown);
    margin: 0;
    flex: 1;
    line-height: 36px;
  }

  .artists-page__styles {
    flex: 1;
  }

  .artists-page__style-card {
    width: 100%;
  }

  .artists-page__style-name {
    font-size: 21px;
    color: var(--brown);
    font-family: "display", serif;
    line-height: 36px;
  }

  @media screen and (min-width: 750px) {
    .artists-page__intro{
      flex-direction: row;
      margin-bottom: 60px;

      .artists-page__intro-image{
        flex: 1;
        margin: 0;

        img{
          max-width: 270px;
          object-fit: contain;
          margin: auto;
        }
      }

      .artists-page__content{
        flex: 1;
      }
    }

    .artists-page__list{
      flex-direction: row;
      flex-wrap: wrap;
      align-items: start;
      justify-content: center;

      .artists-page__item{
        width: calc(50% - 40px);
      }
    }
  }

  @media screen and (min-width: 1200px) {
    .artists-heading{
      padding: 180px 0 100px;
    }

    .artists-page__intro{
      margin: 60px auto 150px;
    }

    .artists-page__list{
      gap: 100px 200px;

      .artists-page__item{
        width: calc(50% - 100px);
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Artist Page",
  "settings": [
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero – nadpis",
      "default": "Our Artists"
    },
    {
      "type": "header",
      "content": "Intro sekce"
    },
    {
      "type": "image_picker",
      "id": "intro_image",
      "label": "Obrázek vlevo"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Text vpravo",
      "default": "<p>Zde napište text o umělcích.</p>"
    }
  ]
}
{% endschema %}
