{%- assign all_artists = shop.metaobjects['artist'].values -%}
{%- assign sorted_names = all_artists | map: 'name' | map: 'value' | sort | reverse -%}
{%- assign _portrait_styles = shop.metaobjects['portrait_style'].values | sort: 'order' -%}

<div class="artists-page">

  <div class="artists-heading">
    <h1 class="artists-heading__title">{{ section.settings.hero_title }}</h1>
  </div>

  {%- if section.settings.intro_image != blank or section.settings.intro_text != blank -%}
  <div class="artists-page__intro">
    <div class="artists-page__intro-image">
      {%- if section.settings.intro_image != blank -%}
        {{- section.settings.intro_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '450, 600, 900' -}}
      {%- endif -%}
    </div>
    <div class="artists-page__content">
      {%- if section.settings.intro_text != blank -%}
        <div class="artists-page__body rte">{{ section.settings.intro_text }}</div>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}

  {%- unless all_artists == empty -%}
  <div class="artists-page__list section section--page-width">
    {%- for artist_name in sorted_names -%}
      {%- assign artist = nil -%}
      {%- for a in all_artists -%}
        {%- if a.name.value == artist_name -%}
          {%- assign artist = a -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if artist == nil -%}{%- continue -%}{%- endif -%}
      <div class="artists-page__item">
        {%- render 'artist-card', artist: artist -%}

        {%- assign artist_handle = artist.system.handle -%}
        {%- assign has_styles = false -%}
        {%- for style in _portrait_styles -%}
          {%- if style.artist.value.system.handle == artist_handle -%}
            {%- assign has_styles = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_styles -%}
          <div class="artists-page__styles-section">
            <h3 class="artists-page__styles-title">Styles by {{ artist.name.value | split: ' ' | first }}</h3>
            <div class="artists-page__styles">
              {%- for style in _portrait_styles -%}
                {%- if style.artist.value.system.handle == artist_handle -%}
                  <a href="/pages/portrait?style={{ style.style_id.value | url_encode }}"
                    class="artists-page__style-card"
                    data-image="{%- if style.preview_image.value -%}{{ style.preview_image.value | image_url: width: 400 }}{%- endif -%}"
                    data-name="{{ style.name.value | escape }}">
                    {%- if style.name.value != blank -%}
                      <span class="artists-page__style-name">{{ style.name.value }}</span>
                    {%- endif -%}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- assign has_collections = false -%}
        {%- for col in collections -%}
          {%- if col.metafields.custom.artist.value.system.handle == artist_handle -%}
            {%- assign has_collections = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_collections -%}
          <div class="artists-page__styles-section">
            <h3 class="artists-page__styles-title">Collection by {{ artist.name.value | split: ' ' | first }}</h3>
            <div class="artists-page__collections">
              {%- for col in collections -%}
                {%- if col.metafields.custom.artist.value.system.handle == artist_handle -%}
                  <a href="{{ col.url }}" class="button-secondary artists-page__collection-btn">{{ col.title }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- endunless -%}

  <div class="artists-page__end-spacer" aria-hidden="true"></div>
</div>

<div class="artists-overlay" id="artists-overlay"></div>
<div class="artists-cursor-follower" id="artists-cursor-follower" aria-hidden="true">
  <span class="artists-cursor-follower__image"><img src="" alt="" width="400" height="500" loading="eager"></span>
  <span class="artists-cursor-follower__label"></span>
</div>

{% stylesheet %}
  .artists-heading {
    padding: 80px var(--page-margin) 70px;
    text-align: center;
  }

  .artists-heading__title {
    font-family: "display", serif;
    font-size: clamp(48px, 8vw, 96px);
    line-height: 1;
    color: var(--brown);
    margin: 0 auto;
    font-weight: 400;
    max-width: 520px;
  }

  .artists-page__intro{
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 40px var(--page-margin);
    max-width: calc(1060px + (2 * var(--page-margin)));
    margin: 0 auto;
  }

  .artists-page__intro-image {
    overflow: hidden;
    width: 70%;
    margin: 0 auto 40px;
  }

  .artists-page__intro-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .artists-page__list {
    display: flex;
    flex-direction: column;
    gap: 80px;
    padding: 60px var(--page-margin) 0;
    max-width: calc(1413px + (2 * var(--page-margin)));
    margin: 0 auto;
  }

  .artists-page__end-spacer {
    height: 240px;
  }

  .artists-page__item {
    .artist-card{
      border-radius: 80px;
      align-items: start;
      background-color: color-mix(in srgb, var(--purple) 45%, transparent);
    }

    .artist-card__body{
      max-width: none;
    }
  }

  .artists-page__styles-section {
    display: flex;
    gap: 20px;
    padding: 30px 20px;
  }

  .artists-page__styles-title {
    font-family: var(--baf-text-family);
    font-size: var(--baf-text-medium-size);
    font-weight: var(--baf-text-weight);
    color: var(--brown);
    margin: 0;
    flex: .7;
    line-height: 1.2;
  }

  .artists-page__styles {
    flex: 1;
  }

  .artists-page__style-card {
    width: 100%;
    cursor: pointer;
    text-decoration: none;
    display: block;
  }

  .artists-page__style-name {
    font-size: 21px;
    color: var(--brown);
    font-family: "display", serif;
    line-height: 36px;
  }

  .artists-page__collections {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .artists-page__collection-btn {
    color: var(--brown);
    border: 1px solid var(--brown);
    border-radius: 1000px;
    background-color: transparent;
    min-height: 0;
    padding-block: 8px;
    line-height: 1;
  }

  .artists-page__collection-btn:hover {
    background-color: var(--purple);
  }

  @media (hover: hover) {
    .artists-page__style-card {
      position: relative;
    }

    .artists-page__style-card:hover {
      z-index: 200;
    }

    .artists-overlay {
      position: fixed;
      inset: 0;
      background: #fff;
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s;
      z-index: 100;
    }

    .artists-overlay.is-active {
      opacity: .45;
    }

    .artists-cursor-follower {
      position: fixed;
      width: 180px;
      aspect-ratio: 5/6;
      pointer-events: none;
      z-index: 300;
      opacity: 0;
      visibility: hidden;
      transition: opacity .3s, visibility .3s;
      transform: translate(100px, -50%);
      top: 0;
      left: 0;
    }

    .artists-cursor-follower.is-active {
      opacity: 1;
      visibility: visible;
    }

    .artists-cursor-follower__image {
      position: absolute;
      inset: 0;
      border-radius: 10px;
      overflow: hidden;
    }

    .artists-cursor-follower__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .artists-cursor-follower__label {
      position: absolute;
      bottom: 10px;
      left: 50%;
      transform: translateX(-50%);
      background-color: var(--beige);
      color: var(--green);
      white-space: nowrap;
      border-radius: 1000px;
      padding: 3px 12px;
      font-size: var(--baf-text-small-size);
    }
  }

  @media screen and (min-width: 750px) {
    .artists-page__intro{
      flex-direction: row;
      margin-bottom: 60px;

      .artists-page__intro-image{
        flex: 1;
        margin: 0;

        img{
          max-width: 270px;
          object-fit: contain;
          margin: auto;
        }
      }

      .artists-page__content{
        flex: 1;
      }
    }

    .artists-page__list{
      flex-direction: row;
      flex-wrap: wrap;
      align-items: start;
      justify-content: center;

      .artists-page__item{
        width: calc(50% - 40px);
      }
    }
  }

  @media screen and (max-width: 749px) {
    .artists-page__end-spacer {
      height: 160px;
    }
  }

  @media screen and (min-width: 1200px) {
    .artists-heading{
      padding: 180px 0 100px;
    }

    .artists-page__intro{
      margin: 60px auto 150px;
    }

    .artists-page__list{
      gap: 100px 200px;

      .artists-page__item{
        width: calc(50% - 100px);
      }
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const overlay = document.getElementById('artists-overlay');
    const follower = document.getElementById('artists-cursor-follower');
    if (!overlay || !follower) return;

    const followerImg = follower.querySelector('.artists-cursor-follower__image img');
    const followerLabel = follower.querySelector('.artists-cursor-follower__label');

    const isTouchDevice = window.matchMedia('(hover: none)').matches;
    if (isTouchDevice) return;

    document.addEventListener('mousemove', (e) => {
      follower.style.left = e.clientX + 'px';
      follower.style.top = e.clientY + 'px';
    });

    document.querySelectorAll('.artists-page__style-card').forEach(card => {
      card.addEventListener('mouseenter', () => {
        const imgUrl = card.dataset.image;
        const name = card.dataset.name;

        followerLabel.textContent = name;

        if (imgUrl) {
          followerImg.src = imgUrl;
          follower.querySelector('.artists-cursor-follower__image').style.display = 'block';
        } else {
          follower.querySelector('.artists-cursor-follower__image').style.display = 'none';
        }

        overlay.classList.add('is-active');
        follower.classList.add('is-active');
      });

      card.addEventListener('mouseleave', () => {
        overlay.classList.remove('is-active');
        follower.classList.remove('is-active');
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Artist Page",
  "settings": [
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero – nadpis",
      "default": "Our Artists"
    },
    {
      "type": "header",
      "content": "Intro sekce"
    },
    {
      "type": "image_picker",
      "id": "intro_image",
      "label": "Obrázek vlevo"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Text vpravo",
      "default": "<p>Zde napište text o umělcích.</p>"
    }
  ]
}
{% endschema %}
