{%- liquid
  assign floating_title = section.settings['main-text'] | default: 'Bark & Frame, beyond portraits.'
  assign floating_title_html = floating_title | escape | replace: ', ', ',<br>' | replace: ',beyond', ',<br>beyond'
-%}

<div class="floating-images">
  <div class="floating-images__stage">
    <div class="floating-images__content">
      <div class="floating-images__content__inner">
        <div class="floating-images__icon">
          <img src="{{ 'logo-icon.svg' | asset_url }}" alt="Logo" width="800" height="800">
        </div>

        <h2 class="floating-images__title">
          {{ floating_title_html }}
        </h2>

        {%- if section.settings.subtitle != blank -%}
          <p class="floating-images__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        <div class="floating-images__button">
          <a href="{{ section.settings.button_link }}" class="button">
            {{ section.settings.button_text }}
          </a>
        </div>
      </div>
    </div>

    <div class="floating-images__fake-title" aria-hidden="true">
      <div class="floating-images__content__inner">
        <div class="floating-images__icon floating-images__fake-spacer">
          <img src="{{ 'logo-icon.svg' | asset_url }}" alt="" width="800" height="800">
        </div>

        <div class="floating-images__title">
          {{ floating_title_html }}
        </div>

        {%- if section.settings.subtitle != blank -%}
          <p class="floating-images__subtitle floating-images__fake-spacer">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        <div class="floating-images__button floating-images__fake-spacer">
          <span class="button">
            {{ section.settings.button_text }}
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="floating-images__holder">
    {% content_for 'blocks' %}
  </div>
</div>

{% javascript %}
{% endjavascript %}

{{ 'floating-images.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Floating Images",
  "settings": [
    {
      "type": "text",
      "id": "main-text",
      "label": "Main Text",
      "default": "Turn your favorite moments into timeless art"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Text pod nadpisem",
      "default": "A small collection of dog people essentials, designed by our artists."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
  ],
  "blocks": [
    {
      "type": "product-card--floating"
    },
  ]
}
{% endschema %}
