<div class="floating-images">
  <div class="floating-images__content">
    <div class="floating-images__content__inner">
      <div class="floating-images__icon">
        <img src="{{ 'logo-icon.svg' | asset_url }}" alt="Logo" width="800" height="800">
      </div>

      <h2 class="floating-images__title">
        <svg class="title__svg" width=400 height="90" viewBox="0 0 400 90">
          <text x="200" y="30" text-anchor="middle" fill="#4C443F" stroke-width="1">
            <tspan x="200" dy="0">Bark &amp; Frame,</tspan><tspan x="200" dy="35">beyond portraits.</tspan>
          </text>
        </svg>
      </h2>

      {%- if section.settings.subtitle != blank -%}
        <p class="floating-images__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <div class="floating-images__button">
        <a href="{{ section.settings.button_link }}" class="button">
          {{ section.settings.button_text }}
        </a>
      </div>
    </div>
  </div>

  <div class="floating-images__fake-title" aria-hidden="true">
    <svg class="fake-title__svg" width=400 height="90" viewBox="0 0 400 90">
      <text x="200" y="30" text-anchor="middle" fill="transparent" stroke="#4C443F" stroke-width="1">
        <tspan x="200" dy="0">Bark &amp; Frame,</tspan><tspan x="200" dy="35">beyond portraits.</tspan>
      </text>
    </svg>
  </div>

  <div class="floating-images__holder" data-parallax="-20dvh">
    {% content_for 'blocks' %}
  </div>
</div>

{% javascript %}
  
{% endjavascript %}

{% stylesheet %}
  .floating-images{
    color: var(--brown);
    margin: 0 0 120px;
    text-align: center;

    .floating-images__content{
      padding: 0 var(--page-margin);
      margin: 0 auto;
      min-height: calc(100dvh - var(--header-height));
      position: sticky;
      top: var(--header-height);
      display: flex;
      flex-direction: column;
      justify-content: center;

      .floating-images__content__inner{
        background: #F4EFE5;
        padding: 40px 20px;
        border-radius: 80px;
        width: 100%;
        height: 70dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      .floating-images__icon{
        img{
          height: 70px;
        }
      }

      .floating-images__title{
        line-height: 36px;
        font-size: 36px;
        margin: 30px auto 0;
        width: min(400px, 80vw);

        svg {
          width: min(400px, 80vw);
          height: auto;
        }
      }

      .floating-images__subtitle {
        margin: 0 auto 40px;
        font-size: 14px;
        font-weight: 700;
        color: var(--brown);
        text-align: center;
        max-width: 300px;
        transition: opacity .3s;
      }

      .floating-images__button{
        width: fit-content;
        margin: 0 auto;
      }
    }

    .floating-images__fake-title{
      line-height: 1em;
      font-size: 36px;
      font-family: "display", "Times New Roman", serif !important;
      position: sticky;
      top: var(--header-height);
      height: calc(100dvh - var(--header-height));
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding-top: 0;
      color: #fff;
      margin-top: calc(-100dvh + var(--header-height));
      z-index: 1;
      pointer-events: none;
      transform: translate(0px, -11px);

      svg {
        width: min(400px, 80vw);
        height: auto;
      }
    }

    .floating-images__holder{
      padding: 0 calc(var(--page-margin)*2) 80vh;
      display: flex;
      flex-direction: column;
      gap: 60px;
      margin: -33dvh auto 0;
      pointer-events: none;

      product-card--floating{
        pointer-events: auto;
        &:nth-child(even){
          margin-left: auto;
        }

        &:nth-child(1){
          .product-title{
            left: 35%;
          }
        }

        &:nth-child(2){
          .product-title{
            left: 50%;
            top: 50%;
          }
        }

        &:nth-child(3){
          .product-title{
            left: 50%;
            top: 45%;
          }
        }

        &:nth-child(4){
          .product-title{
            left: 50%;
            top: 80%;
          }
        }

        &:nth-child(5){
          .product-title{
            left: 35%;
            top: 85%;
          }
        }
      }
    }

    &.hovered{
      product-card--floating:not(:hover){
        opacity: .27;
      }
    }
  }

  .floating-images__holder product-card--floating.product-card--floating{
    display: block !important;
    width: var(--floating-card-width, 300px) !important;
    max-width: min(60vw, var(--floating-card-width, 300px)) !important;
  }

  .floating-images__holder product-card--floating.product-card--floating .image-block{
    display: block !important;
    width: 100% !important;
    height: auto !important;
    aspect-ratio: var(--ratio) !important;
    border-radius: 40px !important;
    overflow: hidden !important;
    line-height: 0;
  }

  .floating-images__holder product-card--floating.product-card--floating .image-block__image{
    display: block !important;
    width: 100% !important;
    height: auto !important;
    max-width: 100% !important;
    aspect-ratio: var(--ratio) !important;
    object-fit: contain !important;
    border-radius: 40px !important;
    content-visibility: visible !important;
    contain-intrinsic-size: none !important;
  }

  @media(min-width: 1200px){
    .floating-images{
      .floating-images__content{
        max-width: 1280px;

        .floating-images__content__inner{
          border-radius: 270px;
        }

        .floating-images__title{
          margin: 120px 0 50px;
          max-width: 600px;

          svg{
            transform: scale(calc(96/36));

            text{
              stroke-width: .333333;
            }
          }
        }

        .floating-images__subtitle{
          font-size: 18px;
          max-width: 400px;
          margin: 0 auto 68px;
        }
      }

      .floating-images__holder{
        max-width: 1280px;
        gap: 0;
        padding: 0 calc(var(--page-margin)*3) 0;

        .product-card--floating{
          &:nth-child(1){
            .product-title{
              left: 25%;
            }
          }

          &:nth-child(2){
            margin-top: -100px;

            .product-title{
              left: 65%;
            }
          }

          &:nth-child(3){
            margin-left: 100px;
            margin-top: -100px
          }

          &:nth-child(4){
            margin-right: 50px;
            margin-top: -100px;

            .product-title{
              left: 45%;
            }
          }

          &:nth-child(5){
            margin-top: -50px;

            .product-title{
              left: 30%;
            }
          }
        }
      }

      .floating-images__fake-title{
        svg{
          transform: scale(calc(96/36));

          text{
            stroke-width: .333333;
          }
        }
      }

      .floating-images-title .title_svg{
        
      }
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Floating Images",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "main-text",
      "label": "Main Text",
      "default": "Turn your favorite moments into timeless art"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Text pod nadpisem",
      "default": "A small collection of dog people essentials, designed by our artists."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
  ],
  "blocks": [
    {
      "type": "product-card--floating"
    },
  ]
}
{% endschema %}
