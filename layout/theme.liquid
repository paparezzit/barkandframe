<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if request.page_type == 'product' -%}
      {%- capture baf_configurator_product_redirect_url -%}
        {%- render 'configurator-product-url', product: product -%}
      {%- endcapture -%}
      {%- assign baf_configurator_product_redirect_url = baf_configurator_product_redirect_url | strip -%}
      {%- if baf_configurator_product_redirect_url != blank -%}
        <meta name="robots" content="noindex, nofollow">
        <script>
          window.location.replace({{ baf_configurator_product_redirect_url | json }});
        </script>
        <noscript>
          <meta http-equiv="refresh" content="0;url={{ baf_configurator_product_redirect_url }}">
        </noscript>
      {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'index' -%}
      <link
        rel="preload"
        as="image"
        href="{{ 'hero-banner-mobile-640.webp' | asset_url }}"
        imagesrcset="{{ 'hero-banner-mobile-640.webp' | asset_url }} 640w"
        imagesizes="100vw"
        media="(max-width: 749px)"
        type="image/webp"
        fetchpriority="high"
      >
      <link
        rel="preload"
        as="image"
        href="{{ 'hero-banner-desktop-1600.webp' | asset_url }}"
        imagesrcset="{{ 'hero-banner-desktop-1600.webp' | asset_url }} 1600w, {{ 'hero-banner-desktop-2215.webp' | asset_url }} 2215w"
        imagesizes="100vw"
        media="(min-width: 750px)"
        type="image/webp"
        fetchpriority="high"
      >
    {%- endif -%}

    {%- render 'stylesheets' -%}
    <!-- BAF cache bust: hero content top 20260717b -->
    <style id="baf-overscroll-canvas">
      html {
        background: var(--beige, #fffaf1) !important;
      }

      html.is-baf-bottom-overscroll {
        background: var(--baf-footer-overscroll-background, #dbdbff) !important;
      }

      body {
        background: var(--beige, #fffaf1) !important;
      }

      html.is-baf-bottom-overscroll body {
        background: var(--baf-footer-overscroll-background, #dbdbff) !important;
      }

      #header-group,
      main.content-for-layout {
        background: var(--beige, #fffaf1);
      }

      footer.shopify-section-group-footer-group {
        background-color: var(--beige, #fffaf1);
        isolation: isolate;
        position: relative;
      }

      footer.shopify-section-group-footer-group::before {
        content: '';
        position: absolute;
        z-index: -3;
        top: 0;
        left: 0;
        right: 0;
        height: 160px;
        background: var(--beige, #fffaf1);
        pointer-events: none;
      }
    </style>
    <script>
      (() => {
        const syncOverscrollCanvas = () => {
          const root = document.documentElement;
          const body = document.body;
          if (!body) return;

          const scrollTop = Math.max(window.scrollY || root.scrollTop || body.scrollTop || 0, 0);
          const viewportHeight = window.innerHeight || root.clientHeight || 0;
          const scrollHeight = Math.max(root.scrollHeight, body.scrollHeight, root.offsetHeight, body.offsetHeight);
          const scrollableDistance = scrollHeight - viewportHeight;
          const remainingDistance = scrollHeight - (scrollTop + viewportHeight);

          root.classList.toggle(
            'is-baf-bottom-overscroll',
            scrollTop > 8 && scrollableDistance > 16 && remainingDistance <= 96
          );
        };

        let frame = null;
        const queueOverscrollCanvas = () => {
          if (frame !== null) return;
          frame = window.requestAnimationFrame(() => {
            frame = null;
            syncOverscrollCanvas();
          });
        };

        document.addEventListener('DOMContentLoaded', syncOverscrollCanvas, { once: true });
        window.addEventListener('scroll', queueOverscrollCanvas, { passive: true });
        window.addEventListener('resize', queueOverscrollCanvas, { passive: true });
        window.addEventListener('orientationchange', queueOverscrollCanvas, { passive: true });
        window.visualViewport?.addEventListener('scroll', queueOverscrollCanvas, { passive: true });
        window.visualViewport?.addEventListener('resize', queueOverscrollCanvas, { passive: true });
        window.addEventListener('pageshow', queueOverscrollCanvas);
      })();
    </script>

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {%- unless request.page_type == 'index' -%}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >
    {%- endunless -%}

    {%- if request.page_type == 'index' -%}
      <script>
        (() => {
          const motionScripts = [
            {{ 'Gsap.min.js' | asset_url | json }},
            {{ 'ScrollTrigger.min.js' | asset_url | json }},
            'https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js',
            {{ 'main.js' | asset_url | append: '&baf_cache=overscroll-20260616' | json }}
          ];
          const isMobileLike = window.matchMedia('(max-width: 749px), (hover: none), (pointer: coarse)').matches;
          let loadingStarted = false;

          const loadScript = (src) => new Promise((resolve) => {
            const script = document.createElement('script');
            script.src = src;
            script.defer = true;
            script.onload = resolve;
            script.onerror = resolve;
            document.head.appendChild(script);
          });

          const loadMotion = () => {
            if (loadingStarted) return;
            loadingStarted = true;
            motionScripts.reduce((chain, src) => chain.then(() => loadScript(src)), Promise.resolve());
          };

          const triggerEvents = ['pointerdown', 'touchstart', 'keydown', 'wheel'];
          triggerEvents.forEach((eventName) => {
            window.addEventListener(eventName, loadMotion, { once: true, passive: true });
          });

          window.addEventListener('load', () => {
            window.setTimeout(loadMotion, isMobileLike ? 30000 : 2500);
          }, { once: true });
        })();
      </script>
    {%- else -%}
      <script src="{{ 'Gsap.min.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer="defer"></script>
      <script src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js" defer></script>
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {%- unless request.page_type == 'index' -%}
      <script src="{{ 'main.js' | asset_url | append: '&baf_cache=overscroll-20260616' }}" defer="defer"></script>
    {%- endunless -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% render 'klaviyo-popup' %}
  </body>
</html>
